<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="SUB_REPORT_V_15_4" language="groovy" pageWidth="555" pageHeight="802" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_TONGHOP" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_NGAYBC" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT A.DESCRIPT, A.ACCOUNT, A.FIRST_PRE_AMT, A.LAST_PRE_AMT FROM
((SELECT 'Vốn nhận tài trợ, uỷ thác đầu tư, cho vay bằng VND' DESCRIPT,NULL ACCOUNT,
DN_TK_SBV($P{PARA_NGAYBC},$P{PARA_MAPGD},$P{PARA_TONGHOP},'441','P') LAST_PRE_AMT,
DN_TK_SBV(ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_MAPGD},$P{PARA_TONGHOP},'441','P') FIRST_PRE_AMT,1 SEQ FROM DUAL)
UNION
(SELECT 'Vốn nhận tài trợ, uỷ thác đầu tư, cho vay bằng vàng, ngoại tệ' DESCRIPT,NULL ACCOUNT,
DN_TK_SBV($P{PARA_NGAYBC},$P{PARA_MAPGD},$P{PARA_TONGHOP},'442','P') LAST_PRE_AMT,
DN_TK_SBV(ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_MAPGD},$P{PARA_TONGHOP},'4034','P') FIRST_PRE_AMT,2 SEQ FROM DUAL)
) A ORDER BY A.SEQ]]>
	</queryString>
	<field name="DESCRIPT" class="java.lang.String"/>
	<field name="ACCOUNT" class="java.lang.String"/>
	<field name="FIRST_PRE_AMT" class="java.math.BigDecimal"/>
	<field name="LAST_PRE_AMT" class="java.math.BigDecimal"/>
	<variable name="LAST_PRE_AMT_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{LAST_PRE_AMT}]]></variableExpression>
	</variable>
	<variable name="FIRST_PRE_AMT_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{FIRST_PRE_AMT}]]></variableExpression>
	</variable>
