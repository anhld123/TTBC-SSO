<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="LEND_24" language="groovy" pageWidth="595" pageHeight="842" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="560" leftMargin="20" rightMargin="15" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="POS_CD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="CONS_FLAG" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["D:\\NEWREPORTS\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
A.MPI_ORG_POS_CD,
G.MIM_INVESTOR_ID IDB_INVESTOR_ID,
G.MIM_INVESTOR_NAME IDB_INVESTOR_NAME,
SUBSTR(A. COMMUNE_ID,1,6) COMMUNE_ID ,
SUBSTR(A. COMMUNE_ID,1,6)  ||'-'||H.DESCR COMMUNE_DESC,
A.MPI_CUST_ID IDB_INVESTOR_CIF,
A.MPI_LEGACY_ID,
A.MPI_GROUP_ID,
SUBSTR(D.PSP_SPEC_DESC,1,instr(D.PSP_SPEC_DESC,'-',1)-1)  SPECIFIC_PRD,
MPF_PRIN_BALANCE,
E.HDPP_INST_INT_PAID,
E.HDSP_SUBINT_PAID,
TO_CHAR(LAST_DAY(ADD_MONTHS(PC_BUSINESS_DT,0)),'DD/MM/YYYY') BUSDT
FROM
(
    select  a.rec_st,a.mpi_cls_dt,a.mpi_legacy_id,a.mpi_cust_id,a.mpi_sprd_cd,a.mpi_prod_cd,a.mpi_con_id,a.mpi_proj_id,a.mpi_org_pos_cd,
    a.mpi_group_id || ' - ' || b.mass_org mpi_group_id, nvl(b.commune_id,(select SP_CIF_GET_COMMUNE_ID(MPI_CUST_ID) from dual)) commune_id
    from M_PROJ_INFO A, gm001mb b,PO850MB Y,
    (SELECT POS_FLAG, MAIN_POS, POS_CD FROM PO850MB WHERE POS_CD = $P{POS_CD}) Z
    where a.mpi_group_id = b.group_id (+)
    and b.br_cd(+)='BR0001'
    AND mpi_org_pos_cd = Y.POS_CD
    AND DECODE(Z.POS_FLAG,'H',1,'S',Y.POS_CD, Y.MAIN_POS) = DECODE(Z.POS_FLAG,'H',1,Z.POS_CD)
    AND DECODE('Y',$P{CONS_FLAG},1,Y.POS_CD) = DECODE('Y',$P{CONS_FLAG},1,$P{POS_CD})
) A, M_CUST_UDF B,
 M_PROJ_FINBAL_VIEW C ,P_SPECIFIC_PRD D,
    (
    SELECT HDPP_CUST_ID,HDPP_CON_ID,HDPP_PROJ_ID,
           NVL(H.HDPP_INST_INT_PAID,0)+NVL(H.HDPP_OVD_INT_PAID,0)  HDPP_INST_INT_PAID,
           NVL(K.HDSP_SUBINT_PAID,0)    HDSP_SUBINT_PAID
    FROM   H_PROJ_PAYMENT J,H_DISB_PROJ_PAYMENT H , H_DISB_SUBSIDY_PAYMENT K , P_CTRL
    WHERE J.HPP_PKEY = H.HDPP_PKEY
    AND   NVL(J.HPP_PAY_REV_FLAG,'Z') <>'P'
    AND  NVL( H.HDPP_STATUS ,'A')<> 'R'
        AND  NVL( K.HDSP_STATUS ,'A')<> 'R'
    AND   J.HPP_CUST_ID          = H.HDPP_CUST_ID
    AND   J.HPP_CON_ID           = H.HDPP_CON_ID
    AND   J.HPP_PROJ_ID          = H.HDPP_PROJ_ID
    AND (NVL(J.HPP_INST_INT,0) + NVL(J.HPP_INT_PREPAID,0) + NVL(J.HPP_INT_OS,0) + NVL(J.HPP_OO_TAX,0) ) > 0
    AND   J.HPP_CUST_ID       = K.HDSP_CUST_ID (+)
    AND   J.HPP_CON_ID        = K.HDSP_CON_ID(+)
    AND   J.HPP_PROJ_ID       = K.HDSP_PROJ_ID(+)
    AND   J.HPP_PKEY           = K.HDSP_PKEY(+)
    AND   J.HPP_TRAN_DT   BETWEEN TRUNC (add_months(PC_MON_END_DT,1), 'MON') AND  LAST_DAY(add_months(PC_MON_END_DT,1))
    UNION ALL
    SELECT  HDSP_CUST_ID ,HDSP_CON_ID,HDSP_PROJ_ID,0 HDSP_INT_PAID,
    NVL(H.HDSP_SUBINT_PAID,0) HDSP_SUBINT_PAID
    FROM
    H_DISB_SUBSIDY_PAYMENT H , P_CTRL
    WHERE NOT EXISTS( SELECT 'X' FROM H_PROJ_PAYMENT  J
    WHERE   J.HPP_CUST_ID       = H.HDSP_CUST_ID
    AND   J.HPP_CON_ID        = H.HDSP_CON_ID
    AND   J.HPP_PROJ_ID       = H.HDSP_PROJ_ID
    AND   J.HPP_PKEY          = H.HDSP_PKEY
    AND   J.HPP_TRAN_DT    BETWEEN TRUNC (add_months(PC_MON_END_DT,1), 'MON') AND  LAST_DAY(add_months(PC_MON_END_DT,1))
    )
    AND   H.HDSP_TRAN_DT   BETWEEN TRUNC (add_months(PC_MON_END_DT,1), 'MON') AND  LAST_DAY(add_months(PC_MON_END_DT,1))
    AND  NVL( H.HDSP_STATUS ,'A')<> 'R'
) E , P_CTRL F,   M_INVESTOR_MAST G  , GR036MB H
WHERE (A.REC_ST = 'A' OR LAST_DAY (A.MPI_CLS_DT) =  last_day(add_months(pc_business_dt,0)))
AND   A.MPI_CUST_ID          = B.MCD_CUST_ID
AND   A.MPI_CON_ID           = B.MCD_CON_ID
AND   A.MPI_PROJ_ID          = B.MCD_PROJ_ID
--AND   B.MCD_INVESTOR_ID      IS NOT NULL
AND   A.MPI_CUST_ID          = C.MPF_CUST_ID
AND   A.MPI_CON_ID           = C.MPF_CON_ID
AND   A.MPI_PROJ_ID          = C.MPF_PROJ_ID
AND   A.MPI_PROD_CD          = D.PSP_PROD_CD
AND   A.MPI_SPRD_CD          = D.PSP_SPEC_CD
AND   A.MPI_CUST_ID          = E.HDPP_CUST_ID
AND   A.MPI_CON_ID           = E.HDPP_CON_ID
AND   A.MPI_PROJ_ID          = E.HDPP_PROJ_ID
--and mpi_legacy_id='6000009000000234'
AND    H.SRCH_1   = 'ADD_WARD'
AND    H.VALUE   = SUBSTR(A.COMMUNE_ID,1,6)
--AND   B.MCD_INVESTOR_ID      = G.MIM_INVESTOR_ID
AND MCD_COL_NAME = 'MC_PROJ_58'
AND    NVL(B.MCD_COL_VALUE,'X') = NVL(G.MIM_INVESTOR_ID,'Y')
order by 2,4,10]]>
	</queryString>
