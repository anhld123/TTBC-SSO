	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_TONGHOP" class="java.lang.String"/>
	<parameter name="PARA_DENNGAY" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString language="plsql">
		<![CDATA[SELECT A.GIATRI DTTH, A.KHOA_2 MA_DTTH,
case when GQVL_NGUONVON = '1' then 'Quỹ GQVL do TW'
       when GQVL_NGUONVON = '2' then 'Quỹ GQVL do ĐP'
end as NG_VON,
NVL(sum(GQVL_D1)/1000000,0) DS_CHOVAYT,
NVL(sum(GQVL_D2)/1000000,0) DS_CHOVAYN,
NVL(sum(GQVL_D3)/1000000,0) DS_THUNOT,
NVL(sum(GQVL_D4)/1000000,0) DS_THUNON,
NVL(sum(GQVL_D5)/1000000,0) DS_XOANOT,
NVL(sum(GQVL_D6)/1000000,0) DS_XOANON,
NVL(sum(GQVL_D7)/1000000,0) TONG_DN,
NVL(sum(GQVL_D8)/1000000,0) NO_THAN,
NVL(sum(GQVL_D9)/1000000,0) NO_QHAN,
NVL(sum(GQVL_D10)/1000000,0) NO_KHOANH,
NVL(sum(GQVL_D11)/1000000,0) NO_NGANHAN,
NVL(sum(GQVL_D12)/1000000,0) NO_TRUNGHAN,
NVL(sum(GQVL_D13)/1000000,0) NO_DAIHAN,
NVL(sum(GQVL_D14),0) SKH_DUNO,
NVL(sum(GQVL_D15),0) SKH_VVON,
NVL(sum(GQVL_D19),0) SKH_XKLD
FROM DMKHAC A, BCTD_GQVL_DTTH B,DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z
WHERE A.KHOA_1= '16'
AND (A.KHOA_2 = '07' OR A.KHOA_2 = '11' OR A.KHOA_2 = '21')
AND GQVL_MAPGD = Y.PO_MA
AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA)
AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD})
AND GQVL_DTTH = A.KHOA_2
AND GQVL_NGAYBC = TO_DATE($P{PARA_DENNGAY})
group by B.GQVL_NGUONVON,A.KHOA_2, A.GIATRI
order by B.GQVL_NGUONVON,A.KHOA_2]]>
	</queryString>
