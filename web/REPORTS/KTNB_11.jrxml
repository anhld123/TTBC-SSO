	</parameter>
	<parameter name="para_tonghop" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select Y.main_pos,DECODE($P{para_mapgd},'000100',ADD_CITY,'Tổng cộng') ADD_CITY,ma_pgd, POS_DESC, NVL(NUMBER_1,0) NUMBER_1,NVL(NUMBER_2,0) NUMBER_2,NVL(NUMBER_3,0) NUMBER_3,NVL(NUMBER_4,0) NUMBER_4,
NVL(NUMBER_5,0) NUMBER_5,NVL(NUMBER_6,0) NUMBER_6,
NVL(NUMBER_7,0) NUMBER_7,NVL(NUMBER_8,0) NUMBER_8,NVL(NUMBER_9,0) NUMBER_9,
NVL(NUMBER_10,0) NUMBER_10,NVL(NUMBER_11,0) NUMBER_11,NVL(NUMBER_12,0) NUMBER_12,NVL(NUMBER_13,0) NUMBER_13,
NVL(NUMBER_14,0) NUMBER_14,NVL(NUMBER_15,0) NUMBER_15,NVL(NUMBER_16,0) NUMBER_16, text_1
 from bcnt_data a, PO850MB Y,
(SELECT POS_FLAG, MAIN_POS, POS_CD FROM PO850MB WHERE POS_CD = $P{para_mapgd}) Z where
  MA_BC = 'KTKT_04' and MA_PGD = y.pos_cd
AND DECODE(Z.POS_FLAG,'H',1,'S',Y.POS_CD, Y.MAIN_POS) = DECODE(Z.POS_FLAG,'H',1,Z.POS_CD)
AND DECODE('Y',$P{para_tonghop},1,Y.POS_CD) = DECODE('Y',$P{para_tonghop},1,$P{para_mapgd})
and NGAY_GT between $P{para_tungay} and $P{para_denngay}]]>
	</queryString>
