	<subDataset name="dataset1" uuid="12221836-b19f-466c-a46d-499facf7fa07">
		<parameter name="PARA_STT" class="java.lang.String"/>
		<parameter name="LOAITO" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT STT1, STT, LOAITO FROM
(select trim(TO_CHAR($P{PARA_STT}+1,'RN')) STT1, 0 STT, $P{LOAITO} LOAITO from dual WHERE $P{LOAITO} = '01'
UNION ALL
select '' STT1, $P{PARA_STT}+1 STT, $P{LOAITO} LOAITO from dual WHERE $P{LOAITO} = '02' )]]>
		</queryString>
		<field name="STT1" class="java.lang.String"/>
		<field name="STT" class="java.math.BigDecimal"/>
		<field name="LOAITO" class="java.lang.String"/>
	</subDataset>
	<subDataset name="dataset2" uuid="1ea11b00-d2e1-4bcc-82b8-4fcc734ed7b5">
		<parameter name="PARA_STT" class="java.lang.String"/>
		<parameter name="LOAITO" class="java.lang.String"/>
		<parameter name="PARA_COUNT" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select (case when $P{LOAITO} IN ('01','99') then to_char($P{PARA_STT}+ 1) else to_char($P{PARA_COUNT})||'.'||to_char($P{PARA_STT}+1)  end ) COUNT_KH  from dual]]>
		</queryString>
		<field name="COUNT_KH" class="java.lang.String"/>
	</subDataset>
