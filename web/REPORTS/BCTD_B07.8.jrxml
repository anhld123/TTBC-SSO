	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_TONGHOP" class="java.lang.String"/>
	<parameter name="PARA_DENNGAY" class="java.lang.String"/>
	<queryString language="plsql">
		<![CDATA[SELECT case when (THUTU <> 4 AND THUTU <>  11 AND THUTU <> 12 AND THUTU <>  15) then GIATRI
                   when THUTU = 4 then 'Cho vay đối tượng chính sách đi XKLĐ NN'
                   when THUTU = 11 then 'Cho vay hộ đồng bào DTTS ĐBKK theo QĐ số 32 và QĐ số 54'
                   when THUTU = 12 then 'Cho vay ĐB DTTS nghèo, khó khăn theo QĐ số 74 và QĐ số 29'
                   when THUTU = 15 then 'Cho vay một số dự án vốn nước ngoài khác'
end as CHTRINH,
KHOA_2 MACT, GIATRI TENCT, THUTU STT,
(select NVL(sum(NDH_D1)/1000000,0) from BCTD_NDH, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE NDH_MAPGD = Y.PO_MA AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND NDH_MAQD = A.KHOA_2 AND NDH_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) DS_NODH,
(select NVL(sum(NDH_D2)/1000000,0) from BCTD_NDH, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE NDH_MAPGD = Y.PO_MA AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND NDH_MAQD = A.KHOA_2 AND NDH_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) TDS_NODH,
(select NVL(sum(NDH_D3)/1000000,0) from BCTD_NDH, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE NDH_MAPGD = Y.PO_MA AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND NDH_MAQD = A.KHOA_2 AND NDH_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) DS_TNTH,
(select NVL(sum(NDH_D4)/1000000,0) from BCTD_NDH, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE NDH_MAPGD = Y.PO_MA AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND NDH_MAQD = A.KHOA_2 AND NDH_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) TDS_TNTH
FROM DMKHAC A,  BCTD_NDH B
WHERE KHOA_1 = '07'
group by A.THUTU,A.KHOA_2, A.GIATRI
order by A.THUTU]]>
	</queryString>
