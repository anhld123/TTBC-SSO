					<paragraph lineSpacing="Single" firstLineIndent="27"/>
				</textElement>
				<textFieldExpression><![CDATA["Kính gửi: Ông/bà " + $P{PARA_TENKH}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement uuid="fce5aac3-d5e2-4d1e-a1d0-f1704560c51e" mode="Transparent" x="0" y="18" width="539" height="138" isRemoveLineWhenBlank="true" forecolor="#000000" backcolor="#FFFFFF"/>
				<box leftPadding="3">
					<pen lineWidth="0.0" lineColor="#666666"/>
					<topPen lineWidth="0.0" lineColor="#666666"/>
					<leftPen lineWidth="0.0" lineColor="#666666"/>
					<bottomPen lineWidth="0.0" lineColor="#666666"/>
					<rightPen lineWidth="0.0" lineColor="#666666"/>
				</box>
				<textElement textAlignment="Justified" verticalAlignment="Top" rotation="None" markup="none">
					<font fontName="Times New Roman" size="12" isBold="false" isItalic="false" isUnderline="false" isStrikeThrough="false" pdfEncoding="Identity-H" isPdfEmbedded="false"/>
					<paragraph lineSpacing="Single" firstLineIndent="27"/>
				</textElement>
				<textFieldExpression><![CDATA[($P{PARA_KYBC}=='N'&&$P{PARA_CNQHFLG}=='A')? "Địa chỉ:" + $P{PARA_DIACHI} + '\n' + "Căn cứ hồ sơ vay vốn số:  " + $P{PARA_SOKU} + ", lập ngày " + $P{PARA_NGAYVAY}  + '\n' + "Đến ngày " + $P{PARA_NGAYDH} +  ", Ông/Bà đến hạn trả nợ tiền vay Ngân hàng Chính sách xã hội (NHCSXH) với số tiền gốc  " + (new DecimalFormat("#,###")).format($P{PARA_GOCDH}) + " đồng và số tiền lãi phát sinh."  + '\n' +  "Kính mời Ông/Bà đến Điểm giao dịch xã theo ngày trực cố định hoặc đến trụ sở " + $P{PARA_TENPGD} + " để thực hiện trả nợ số tiền trên."  + '\n'+ $P{PARA_TENPGD} + " trân trọng thông báo.":"Địa chỉ:" + $P{PARA_DIACHI} + '\n' + "Căn cứ hồ sơ vay vốn số:  " + $P{PARA_SOKU} + ", lập ngày " + $P{PARA_NGAYVAY}  + '\n' +  "Ông/Bà đã đến hạn trả nợ tiền vay Ngân hàng Chính sách xã hội (NHCSXH) với số tiền gốc  " + (new DecimalFormat("#,###")).format($P{PARA_GOCDH}) + " đồng và số tiền lãi phát sinh."  + '\n' +  "Kính mời Ông/Bà đến Điểm giao dịch xã theo ngày trực cố định hoặc đến trụ sở " + $P{PARA_TENPGD} + " để thực hiện trả nợ số tiền trên."  + '\n' +  "Nếu ngày " + $P{PARA_NGAYDH} + " Ông/Bà không đến trả nợ thì toàn bộ số tiền gốc " + (new DecimalFormat("#,###")).format($P{PARA_GOCDH}) + " sẽ chuyển sang nợ quá hạn. Từ ngày  chuyển nợ quá hạn, Ông/Bà phải chịu lãi suất phạt bằng 130% lãi suất cho vay." + '\n' + $P{PARA_TENPGD} + " trân trọng thông báo."]]></textFieldExpression>
			</textField>
