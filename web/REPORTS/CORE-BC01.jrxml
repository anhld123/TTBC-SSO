	<queryString language="plsql">
		<![CDATA[SELECT TO_DATE($P{PARA_NGAYBC},'DD-MON-YYYY') EOD_DT, (SELECT PO_TEN FROM DMPOS WHERE PO_MA =$P{PARA_MAPGD}) POS_DESC,
 decode((SELECT IU_TEN FROM I_USER WHERE UPPER(IU_MA) = UPPER($P{PARA_GDVIEN}) AND IU_MAPGD = $P{PARA_MAPGD}),'',$P{PARA_GDVIEN},(SELECT IU_TEN FROM I_USER WHERE UPPER(IU_MA) = UPPER($P{PARA_GDVIEN}) AND IU_MAPGD =$P{PARA_MAPGD}))  TELLER_NAME
 FROM DUAL]]>
	</queryString>
	<field name="EOD_DT" class="java.sql.Timestamp"/>
	<field name="POS_DESC" class="java.lang.String"/>
	<field name="TELLER_NAME" class="java.lang.String"/>
