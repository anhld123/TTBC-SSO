					<paragraph firstLineIndent="27"/>
				</textElement>
				<text><![CDATA[Ngân hàng Chính sách xã hội (NHCSXH) đề nghị ông/bà thông báo, đôn đốc các hộ vay có nợ đến hạn theo danh sách dưới đây đến Điểm giao dịch xã vào ngày trực giao dịch cố định hoặc đến trụ sở NHCSXH nơi cho vay để thực hiện nghĩa vụ trả nợ vay theo cam kết.]]></text>
			</staticText>
