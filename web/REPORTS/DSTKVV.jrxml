<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="DSTTKVV" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="07ec2208-76cf-4c56-bed5-17a7e0b3f5ae">
	<property name="ireport.zoom" value="1.3310000000000004"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="52"/>
	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<parameter name="PARA_MAPGD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_MAXA" class="java.lang.String"/>
	<parameter name="PARA_MATO" class="java.lang.String"/>
	<queryString>
		<![CDATA[select macn,
        (SELECT TEN
            FROM DMTINH
           WHERE MA = SUBSTR (macn, 3, 2)) TEN_TINH,
        mapgd,
        (SELECT TEN
            FROM DMHUYEN
           WHERE MA = SUBSTR (mapgd, 3, 4)) TEN_HUYEN,
         maxa,
        (SELECT TEN
            FROM DMXA
           WHERE MA = maxa) TEN_XA,
        MATO MA_TO,
        (SELECT TO_TENTT
            FROM HSTO C
           WHERE TO_MATO = MATO AND TO_MAPGD = MAPGD AND C.TRANGTHAI = 'A')
            TEN_TT,
        makh ma_kh,
        (select KH_TENKH from hskh where kh_mapgd = mapgd and kh_makh = makh) TEN_KH,
        (select KH_DIACHI from hskh where kh_mapgd = mapgd and kh_makh = makh) DIA_CHI,
        TONG_DNO,
        TIEN_GUI,
        to_char(to_date($P{PARA_NGAYBC}), 'DD/MM/YYYY') NGAYBC
    from
        (select macn, mapgd, maxa, madp, mato, makh, sum(DUNO) TONG_DNO,sum(DUTK) TIEN_GUI
            from
            (SELECT KU_MACN MACN,
                   KU_MAPGD MAPGD,
                   SUBSTR(TO_MADP,1,6) MAXA,
                   TO_MADP MADP,
                   KU_MATO MATO,
                   KU_MAKH MAKH,
                   KU_DNOTHAN + KU_DNOQHAN + KU_DNOKHOANH DUNO,
                   KU_DNOTHAN DNOTHAN,
                   KU_DNOQHAN DNOQHAN,
                   KU_DNOKHOANH DNOKHOANH,
                   0 DUTK
                FROM HSKU, HSTO
                WHERE KU_MATO = TO_MATO
                    AND KU_MATO IS NOT NULL
                    AND KU_MAPGD = TO_MAPGD
                    AND TO_MAPGD = $P{PARA_MAPGD}
                    AND TRANGTHAI = 'A'
                    AND TO_LOAITO = '01'
                    AND KU_NGAYBC = TO_DATE($P{PARA_NGAYBC})
                    AND nvl(KU_TTMONVAY, 'OPEN') <> 'CLOSE'
                    AND KU_DNOTHAN + KU_DNOQHAN + KU_DNOKHOANH >0
                    and ku_mato in
                        (SELECT MATO FROM
                            (SELECT KU_MACN MACN,
                                   KU_MAPGD MAPGD,
                                   SUBSTR(TO_MADP,1,6) MAXA,
                                   TO_MADP MADP,
                                   KU_MATO MATO,
                                   KU_MAKH MAKH,
                                   KU_DNOTHAN + KU_DNOQHAN + KU_DNOKHOANH DUNO,
                                   KU_DNOTHAN DNOTHAN,
                                   KU_DNOQHAN DNOQHAN,
                                   KU_DNOKHOANH DNOKHOANH,
                                   0 DUTK
                                FROM HSKU, HSTO
                                WHERE KU_MATO = TO_MATO
                                    AND KU_MATO IS NOT NULL
                                    AND KU_MAPGD = TO_MAPGD
                                    AND TO_MAPGD = $P{PARA_MAPGD}
                                    and decode(nvl($P{PARA_MAXA}, '000000'), '000000', '1', SUBSTR(KU_MADP, 1, 6)) = decode(nvl($P{PARA_MAXA}, '000000'), '000000', '1', $P{PARA_MAXA})
                                    and decode(nvl($P{PARA_MATO}, '0'), '0', '1', KU_MATO) = decode(nvl($P{PARA_MATO}, '0'), '0', '1', $P{PARA_MATO})
                                    AND TRANGTHAI = 'A'
                                    AND TO_LOAITO = '01'
                                    AND KU_NGAYBC = TO_DATE($P{PARA_NGAYBC})
                                    AND nvl(KU_TTMONVAY, 'OPEN') <> 'CLOSE'
                                    AND KU_DNOTHAN + KU_DNOQHAN + KU_DNOKHOANH >0
                            UNION ALL
                            SELECT CS_MACN MACN,
                                        CS_MAPGD MAPGD,
                                        SUBSTR(CS_MADP,1,6) MAXA,
                                        TO_MADP MADP,
                                        CS_MATO MATO,
                                        CS_MAKH MAKH,
                                        0 DUNO,
                                        0 DNOTHAN,
                                        0 DNOQHAN,
                                        0 DNOKHOANH,
                                        CS_SODU_TK DUTK
                                FROM CASA, HSTO
                                WHERE CS_MATO = TO_MATO
                                    AND TO_MAPGD = $P{PARA_MAPGD}
                                    AND CS_MATO IS NOT NULL
                                    AND TO_LOAITO = '01'
                                    and decode(nvl($P{PARA_MAXA}, '000000'), '000000', '1', SUBSTR(CS_MADP, 1, 6)) = decode(nvl($P{PARA_MAXA}, '000000'), '000000', '1', $P{PARA_MAXA})
                                    and decode(nvl($P{PARA_MATO}, '0'), '0', '1', CS_MATO) = decode(nvl($P{PARA_MATO}, '0'), '0', '1', $P{PARA_MATO})
                                    AND TRANGTHAI = 'A'
                                    AND CS_SP_TK = '105'
                                    AND nvl(CS_TTSO_TK, 'A') <>'C'
                                    AND CS_MAPGD = TO_MAPGD
                                    AND CS_NGAYBC = $P{PARA_NGAYBC})
                        GROUP BY MACN, MAPGD, MAXA, MADP, MATO)
            union all
            SELECT CS_MACN MACN,
                        CS_MAPGD MAPGD,
                        SUBSTR(CS_MADP,1,6) MAXA,
                        TO_MADP MADP,
                        CS_MATO MATO,
                        CS_MAKH MAKH,
                        0 DUNO,
                        0 DNOTHAN,
                        0 DNOQHAN,
                        0 DNOKHOANH,
                        CS_SODU_TK DUTK
                FROM CASA, HSTO
                WHERE CS_MATO = TO_MATO
                    AND TO_MAPGD = $P{PARA_MAPGD}
                    AND CS_MATO IS NOT NULL
                    AND TO_LOAITO = '01'
                    AND TRANGTHAI = 'A'
                    AND CS_SP_TK = '105'
                    AND nvl(CS_TTSO_TK, 'A') <>'C'
                    AND CS_MAPGD = TO_MAPGD
                    AND CS_NGAYBC = $P{PARA_NGAYBC}
                    and cs_mato in
                        (SELECT MATO FROM
                            (SELECT KU_MACN MACN,
                                   KU_MAPGD MAPGD,
                                   SUBSTR(TO_MADP,1,6) MAXA,
                                   TO_MADP MADP,
                                   KU_MATO MATO,
                                   KU_MAKH MAKH,
                                   KU_DNOTHAN + KU_DNOQHAN + KU_DNOKHOANH DUNO,
                                   KU_DNOTHAN DNOTHAN,
                                   KU_DNOQHAN DNOQHAN,
                                   KU_DNOKHOANH DNOKHOANH,
                                   0 DUTK
                                FROM HSKU, HSTO
                                WHERE KU_MATO = TO_MATO
                                    AND KU_MATO IS NOT NULL
                                    AND KU_MAPGD = TO_MAPGD
                                    AND TO_MAPGD = $P{PARA_MAPGD}
                                    and decode(nvl($P{PARA_MAXA}, '000000'), '000000', '1', SUBSTR(KU_MADP, 1, 6)) = decode(nvl($P{PARA_MAXA}, '000000'), '000000', '1',$P{PARA_MAXA})
                                    and decode(nvl($P{PARA_MATO}, '0'), '0', '1', KU_MATO) = decode(nvl($P{PARA_MATO}, '0'), '0', '1', $P{PARA_MATO})
                                    AND TRANGTHAI = 'A'
                                    AND TO_LOAITO = '01'
                                    AND KU_NGAYBC = TO_DATE($P{PARA_NGAYBC})
                                    AND nvl(KU_TTMONVAY, 'OPEN') <> 'CLOSE'
                                    AND KU_DNOTHAN + KU_DNOQHAN + KU_DNOKHOANH >0
                            UNION ALL
                            SELECT CS_MACN MACN,
                                        CS_MAPGD MAPGD,
                                        SUBSTR(CS_MADP,1,6) MAXA,
                                        TO_MADP MADP,
                                        CS_MATO MATO,
                                        CS_MAKH MAKH,
                                        0 DUNO,
                                        0 DNOTHAN,
                                        0 DNOQHAN,
                                        0 DNOKHOANH,
                                        CS_SODU_TK DUTK
                                FROM CASA, HSTO
                                WHERE CS_MATO = TO_MATO
                                    AND TO_MAPGD = $P{PARA_MAPGD}
                                    AND CS_MATO IS NOT NULL
                                    AND TO_LOAITO = '01'
                                    and decode(nvl($P{PARA_MAXA}, '000000'), '000000', '1', SUBSTR(CS_MADP, 1, 6)) = decode(nvl($P{PARA_MAXA}, '000000'), '000000', '1', $P{PARA_MAXA})
                                    and decode(nvl($P{PARA_MATO}, '0'), '0', '1', CS_MATO) = decode(nvl($P{PARA_MATO}, '0'), '0', '1', $P{PARA_MATO})
                                    AND TRANGTHAI = 'A'
                                    AND CS_SP_TK = '105'
                                    AND nvl(CS_TTSO_TK, 'A') <>'C'
                                    AND CS_MAPGD = TO_MAPGD
                                    AND CS_NGAYBC = $P{PARA_NGAYBC})
                        GROUP BY MACN, MAPGD, MAXA, MADP, MATO))
                 group by macn, mapgd, maxa, madp, mato, makh)
        ORDER BY MACN, MAPGD, MAXA, MATO, makh]]>
	</queryString>
	<field name="MACN" class="java.lang.String"/>
	<field name="TEN_TINH" class="java.lang.String"/>
	<field name="MAPGD" class="java.lang.String"/>
	<field name="TEN_HUYEN" class="java.lang.String"/>
	<field name="MAXA" class="java.lang.String"/>
	<field name="TEN_XA" class="java.lang.String"/>
	<field name="MA_TO" class="java.lang.String"/>
	<field name="TEN_TT" class="java.lang.String"/>
	<field name="MA_KH" class="java.lang.String"/>
	<field name="TEN_KH" class="java.lang.String"/>
	<field name="DIA_CHI" class="java.lang.String"/>
	<field name="TONG_DNO" class="java.math.BigDecimal"/>
	<field name="TIEN_GUI" class="java.math.BigDecimal"/>
	<field name="NGAYBC" class="java.lang.String"/>
	<variable name="TONG_DNO_1" class="java.math.BigDecimal" resetType="Group" resetGroup="to" calculation="Sum">
		<variableExpression><![CDATA[$F{TONG_DNO}]]></variableExpression>
	</variable>
	<variable name="MA_KH_1" class="java.lang.Integer" resetType="Group" resetGroup="to" calculation="Count">
		<variableExpression><![CDATA[$F{MA_KH}]]></variableExpression>
	</variable>
	<variable name="TIEN_GUI_1" class="java.math.BigDecimal" resetType="Group" resetGroup="to" calculation="Sum">
		<variableExpression><![CDATA[$F{TIEN_GUI}]]></variableExpression>
	</variable>
	<group name="to" isStartNewPage="true" isResetPageNumber="true" isReprintHeaderOnEachPage="true">
