	<parameter name="PARA_TONGHOP" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["D:\\2. Bao cao\\BC dia phuong\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT DISTINCT NDT_PNKT5 PNKT, TEN
FROM BCTD_NDT A ,
     PO850MB Y,
     (SELECT POS_FLAG, MAIN_POS, POS_CD FROM PO850MB WHERE POS_CD = $P{PARA_MAPGD}) Z,
     DM_PNKT
WHERE
  A.NDT_MAPGD = Y.POS_CD
 AND DECODE(Z.POS_FLAG,'H',1,'S',Y.POS_CD, Y.MAIN_POS) = DECODE(Z.POS_FLAG,'H',1,Z.POS_CD)
 AND DECODE('Y',$P{PARA_TONGHOP},1,Y.POS_CD) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD})
 AND NDT_NGAYBC = $P{PARA_DENNGAY}
 AND NDT_PNKT5 = PNKT]]>
	</queryString>
	<field name="PNKT" class="java.lang.String"/>
	<field name="TEN" class="java.lang.String"/>
	<group name="GRP_PNKT">
		<groupExpression><![CDATA[$F{PNKT}]]></groupExpression>
