<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="mainpos_subpos2" language="groovy" pageWidth="300" pageHeight="842" columnWidth="300" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="258974ee-337e-4e51-864d-c5e0d286d18c">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="POS_CD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="CONS_FLAG" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select pos_desc, decode($P{POS_CD},'000101','Sở giao dịch','000196','TT Công nghệ thông tin','000197','TT Đào tạo','000199','Ban tài vụ', add_city) add_city, VBSP_PUBLIC_FUNCTION.F_GET_REPORT_GRADE($P{POS_CD},$P{CONS_FLAG}) CAP_BC, ADD_STREET1 from po850mb where pos_cd = $P{POS_CD}]]>
	</queryString>
	<field name="POS_DESC" class="java.lang.String"/>
	<field name="ADD_CITY" class="java.lang.String"/>
	<field name="CAP_BC" class="java.math.BigDecimal"/>
	<field name="ADD_STREET1" class="java.lang.String"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="32" splitType="Stretch">
			<textField isBlankWhenNull="true">
				<reportElement uuid="8d29f44a-67ae-48f8-9841-74404b573e9a" x="0" y="15" width="300" height="17"/>
				<textElement textAlignment="Justified" verticalAlignment="Top">
					<font fontName="Times New Roman" size="10" isBold="true" pdfEncoding="Identity-H"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{CAP_BC} == 1 ? $F{POS_DESC}.toUpperCase() : $F{CAP_BC} == 2 ? $F{ADD_CITY}.toUpperCase() : ""]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement uuid="034e579a-fef6-40a4-98a1-05f5031955dc" x="0" y="1" width="299" height="17"/>
				<textElement textAlignment="Justified" verticalAlignment="Top" markup="styled">
					<font fontName="Times New Roman" size="11" isBold="false" pdfEncoding="Identity-H"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{CAP_BC} == 2 ? "NGÂN HÀNG CHÍNH SÁCH XÃ HỘI" : $F{CAP_BC} == 3 ?
"<style isBold='true'>" + $F{ADD_CITY}.toUpperCase() + "</style>" : $F{CAP_BC} == 1 && ($P{POS_CD}.equals("000101") || $P{POS_CD}.equals("000196") || $P{POS_CD}.equals("000197") || $P{POS_CD}.equals("000199")) ? "" : $F{ADD_CITY}.toUpperCase()]]></textFieldExpression>
			</textField>
		</band>
	</title>
</jasperReport>
