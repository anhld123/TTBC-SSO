	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="21"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["D:\\2. Bao cao\\1. Rui ro\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="POS_CD" class="java.lang.String"/>
	<parameter name="CONS_FLAG" class="java.lang.String"/>
	<parameter name="PARA_DOTRR" class="java.lang.String"/>
	<parameter name="PARA_NAM" class="java.lang.String"/>
	<queryString>
		<![CDATA[select distinct
            RR_SOKU  LOAN_ID,
            KU_MAKH  CUSTOMER_ID,
            KH_TENKH CUSTOMER_NAME ,
            RR_MAPGD  ,
            GIATRI LOAN_PROGRAM_DESC,
            KU_CHTRINH LOAN_PROGRAM,
             d.ten DISTRICT_ADDRESS,
            NVL(RR_GOCDN,0)  PRIN_AMT,
            NVL(RR_SOTHGDN,0) EXTENSION_MONTHS,
            G.TEN RES_CITY,
            d.TEN  CUSTOMER_ADDRESS,
           '01' MRIA_DECISION_NO,
           '30/04/2014' MRIA_DECISION_DT
 from
            hsku a,
            hsrr b,
            hskh c,
            DMXA d,
            dmhuyen g,
            dmthon k,
            (select * from DMKHAC where khoa_1 = '07') e
where RR_SOKU= KU_SOKU
         and KU_MAKH = KH_MAKH
         and KU_MAPGD = KH_MAPGD
         and RR_MAPGD = KU_MAPGD
         and KU_CHTRINH = KHOA_2
         and substr(KU_MADP,1,6) = d.MA
         and substr(RR_MAPGD,3,6) = G.MA
         and KU_MADP = k.ma
        AND RR_TTDUYET = 2
    AND RR_NHOMNO ='03'
        AND RR_DOT = 1]]>
	</queryString>
