	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_MANGANHANG" class="java.lang.String"/>
	<parameter name="PARA_NGAYGIAINGAN" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select distinct b.kh_tenkh BORROWER_NAME,
c.sv_tensv STU_NAME,
a.ku_soku LOAN_NO,
 c.sv_cmt_sv CITIZEN_ID,
 c.sv_so_atm PS_STU_ATMACC,
 KU_M_GNGAN DISB_AMT,
 ' ' REMARKS
 ,KU_NGAYGNCC
  from hsku a, hskh b , hssv c
where a.ku_makh = b.kh_makh and a.ku_mapgd = b.kh_mapgd
and a.ku_soku = c.sv_soku and a.ku_mapgd = c.sv_mapgd
and a.ku_mapgd = $P{PARA_MAPGD}
and KU_M_GNGAN <> 0
and c.SV_DVCAPTHE = $P{PARA_MANGANHANG}
and a.ku_ttmonvay = 'OPEN'
and c.SV_REC_ST = 'A'
AND TO_CHAR(KU_NGAYGNCC,'DD-MON-YYYY') = $P{PARA_NGAYGIAINGAN}
ORDER BY b.kh_tenkh]]>
	</queryString>
	<field name="BORROWER_NAME" class="java.lang.String"/>
	<field name="STU_NAME" class="java.lang.String"/>
	<field name="CITIZEN_ID" class="java.lang.String"/>
