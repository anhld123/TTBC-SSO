	<field name="REMARKS" class="java.lang.String"/>
	<variable name="TOT_DISB_AMT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{DISB_AMT}]]></variableExpression>
	</variable>
