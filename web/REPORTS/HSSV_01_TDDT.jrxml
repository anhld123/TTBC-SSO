<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="HSSV_01_DTTH" language="groovy" pageWidth="1224" pageHeight="555" orientation="Landscape" columnWidth="1224" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="para_denngay" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT 'Theo trình độ Đào tạo' grp,tddt DT, giatri DTTH,ROUND(SUM(KHPT)/1000000,2) KE_HOACH,ROUND(SUM(KHPT_KCON)/1000000,2) KH_KCON,
ROUND(SUM(KHPT_KCUOI)/1000000,2) KH_KCUOI,
ROUND(( SUM(A.AN_HAN) + SUM(A.GIA_HAN) +  SUM(QUA_HAN) + SUM(A.DUNG_PKY) + SUM(A.TRUOC_PKY) + SUM(A.KYCON_KYCUOI) + SUM(A.KYCUOI))/1000000,2) TONG,
ROUND(SUM(TONG_LAI)/1000000,2) THUC,
 ROUND(SUM(A.AN_HAN)/1000000,2) AN_HAN,
ROUND(SUM(A.GIA_HAN)/1000000,2) GIA_HAN,ROUND(SUM(QUA_HAN)/1000000,2) QUA_HAN,
ROUND(SUM(A.DUNG_PKY)/1000000,2) DUNG_PKY,ROUND(SUM(A.TRUOC_PKY)/1000000,2) TRUOC_PKY,
ROUND(SUM(A.KYCON_KYCUOI)/1000000,2) KYCON_KYCUOI, ROUND(SUM(A.KYCUOI)/1000000,2) KYCUOI FROM
DLGB_HSSV A, dmkhac
WHERE
tddt = khoa_2
and khoa_1 =36
 and NGAY_BC = $P{para_denngay}
and TONG_LAI + khpt+qua_han >0
group by tddt, giatri order by 2]]>
	</queryString>
