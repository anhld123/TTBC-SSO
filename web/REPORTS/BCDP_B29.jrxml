<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="BCDP-B29" language="groovy" pageWidth="595" pageHeight="842" orientation="Landscape" columnWidth="560" leftMargin="20" rightMargin="15" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_TONGHOP" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_DENNGAY" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT KHOA_2 HDT, GIATRI TENHDT, KU_SOHO, KU_SOTO, TK_SOHO, TK_SOTO, ROUND(DUTK / 1000000, 2) DUTK
FROM DMKHAC,
(
    SELECT NVL(KU_HDT, TK_HDT) TC_HDT, NVL(KU_SOHO, 0) KU_SOHO, NVL(KU_SOTO, 0) KU_SOTO,
                NVL(TK_SOHO, 0) TK_SOHO, NVL(TK_SOTO, 0) TK_SOTO, NVL(DUTK, 0) DUTK
    FROM
        (
        SELECT NVL(TO_DVUT, '1') KU_HDT, COUNT(DISTINCT KU_MAKH) KU_SOHO, COUNT(DISTINCT KU_MATO) KU_SOTO
        FROM HSKU, HSTO
        WHERE KU_MATO = TO_MATO (+) AND KU_MATO IS NOT NULL AND
          KU_NGAYBC = TO_DATE($P{PARA_DENNGAY}) AND DECODE($P{PARA_TONGHOP}, 'Y', 1, KU_MAPGD) = DECODE($P{PARA_TONGHOP}, 'Y', 1, $P{PARA_MAPGD})
        GROUP BY NVL(TO_DVUT, '1')
        ) KU
    FULL OUTER JOIN
        (
        SELECT NVL(TO_DVUT, '1') TK_HDT, COUNT(DISTINCT CS_MAKH) TK_SOHO,
                    COUNT(DISTINCT CS_MATO) TK_SOTO, SUM(NVL(CS_SODU_TK, 0)) DUTK
        FROM CASA, HSTO, DMPOS Y, (SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z
        WHERE CS_MATO = TO_MATO (+) AND CS_MATO IS NOT NULL
            AND CS_NGAYBC = TO_DATE($P{PARA_DENNGAY})
            AND CS_MAPGD =  Y.PO_MA
            AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA)
            AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD})
          AND NVL(CS_SODU_TK, 0) > 0 AND CS_SP_TK = '105' AND CS_TTSO_TK='A'
        GROUP BY NVL(TO_DVUT, '1')
        ) TK
    ON KU_HDT = TK_HDT
) TC
WHERE KHOA_2 = TC_HDT (+) AND KHOA_1 = 17  AND KHOA_2 NOT IN ('10', '20')
ORDER BY KHOA_2]]>
	</queryString>
	<field name="HDT" class="java.lang.String"/>
	<field name="TENHDT" class="java.lang.String"/>
	<field name="KU_SOHO" class="java.math.BigDecimal"/>
	<field name="KU_SOTO" class="java.math.BigDecimal"/>
	<field name="TK_SOHO" class="java.math.BigDecimal"/>
	<field name="TK_SOTO" class="java.math.BigDecimal"/>
	<field name="DUTK" class="java.math.BigDecimal"/>
	<variable name="STT" class="java.lang.Integer" incrementType="Report">
		<variableExpression><![CDATA[$V{STT} + 1]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="KU_SOTO_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{KU_SOTO}]]></variableExpression>
	</variable>
	<variable name="TK_SOTO_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TK_SOTO}]]></variableExpression>
	</variable>
	<variable name="DUTK_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{DUTK}]]></variableExpression>
	</variable>
	<variable name="KU_SOHO_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{KU_SOHO}]]></variableExpression>
	</variable>
	<variable name="TK_SOHO_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TK_SOHO}]]></variableExpression>
	</variable>
	<variable name="TYLE" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$V{TK_SOHO_1} / ($V{KU_SOHO_1} > 0 ? $V{KU_SOHO_1} : 1) * 100]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="BQ" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$V{DUTK_1} / ($V{TK_SOHO_1} > 0 ? $V{TK_SOHO_1} : 1)]]></variableExpression>
	</variable>
