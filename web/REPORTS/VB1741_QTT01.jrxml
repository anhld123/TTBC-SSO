	<property name="ireport.zoom" value="1.1"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="136"/>
	<parameter name="PARA_TUNGAY" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_DENNGAY" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select PROVINCE macn, b.ten tentinh, DISTRICT pos_cd, c.ten tenhuyen , COMMUNE, d.ten tenxa,
POOR_ID ,POOR_NAME, AMOUNT,
(select FULL_ADDRESS from QTT_MASTER where id = POOR_ID and rownum <2) FULL_ADDRESS,
(select count(distinct POOR_ID) from QTT_TRANSACTION where tran_dt between to_date($P{PARA_TUNGAY}) and to_date($P{PARA_DENNGAY}) ) POOR_TOTAL ,0 DONATOR_TOTAL , 0 STT, POOR_NAME name,
(select LEGACY_AC from QTT_MASTER where id = POOR_ID and rownum <2) SOTK,
(select CONTACT from QTT_MASTER where id = POOR_ID and rownum <2) dt,
'Từ tháng ' || to_char(to_date($P{PARA_TUNGAY}),'MM/YYYY') || ' đến tháng ' || to_char(to_date($P{PARA_DENNGAY}),'MM/YYYY') ngaythang,
'(Đợt  )' DOTXL
from QTT_TRANSACTION a, dmtinh b, dmhuyen c , dmxa d
where tran_dt between to_date($P{PARA_TUNGAY}) and to_date($P{PARA_DENNGAY})
and   PROVINCE = b.ma
and   PROVINCE||DISTRICT = c.ma
and  PROVINCE || DISTRICT || COMMUNE = d.ma
and (trim("COMMENT") is  null or trim("COMMENT") = '')
ORDER BY PROVINCE, DISTRICT, COMMUNE,POOR_ID]]>
	</queryString>
