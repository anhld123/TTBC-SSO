<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="VB1741_QTT05" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="NoDataSection" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="559befbd-2820-4081-982d-45b8f9264eb0">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_TONGHOP" class="java.lang.String"/>
	<queryString language="plsql">
		<![CDATA[select  ID, NAME, BIRTHYEAR, ADDRESS_1, a.ten tentinh, ADDRESS_2, b.ten tenhuyen,
ADDRESS_3, c.ten tenxa,FULL_ADDRESS,PROTECTOR_NAME,CONTACT
from QTT_MASTER k, dmtinh a, dmhuyen b, dmxa c,
DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z
               WHERE  k.POS_CD = Y.PO_MA
                     AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA)
                     AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD})
and ADDRESS_1 = a.ma
and ADDRESS_1||ADDRESS_2 = b.ma
and ADDRESS_1||ADDRESS_2||ADDRESS_3 = c.ma
and AC_NO is null
order by ADDRESS_1,ADDRESS_2,ID]]>
	</queryString>
	<field name="ID" class="java.lang.String"/>
	<field name="NAME" class="java.lang.String"/>
	<field name="BIRTHYEAR" class="java.lang.String"/>
	<field name="ADDRESS_1" class="java.lang.String"/>
	<field name="TENTINH" class="java.lang.String"/>
	<field name="ADDRESS_2" class="java.lang.String"/>
	<field name="TENHUYEN" class="java.lang.String"/>
	<field name="ADDRESS_3" class="java.lang.String"/>
	<field name="TENXA" class="java.lang.String"/>
	<field name="FULL_ADDRESS" class="java.lang.String"/>
	<field name="PROTECTOR_NAME" class="java.lang.String"/>
	<field name="CONTACT" class="java.lang.String"/>
