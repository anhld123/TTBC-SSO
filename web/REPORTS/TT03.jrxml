<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="BCGB_HSSV" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="NoDataSection" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="0.9090909090909105"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_QUY" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["E:\\01.Working\\05.Jasper Report\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT vungkt, DECODE (
                      vungkt,
                      '01', 'Đồng bằng sông Hồng',
                      '02', 'Trung du và miền núi phía Bắc',
                      '03', 'Bắc Trung Bộ và Duyên hải miền Trung',
                      '04', 'Tây Nguyên',
                      '05', 'Đông Nam Bộ',
                      '06', 'Đồng bằng sông Cửu Long'
) TENVUNG,
A.TT03_MACN MA_CN,TEN,
NVL(SUM(DECODE(TT03_THVAY,'S',NVL(TT03_CHOVAY_QUY,0))/1000000),0) CV_NHAN ,
NVL(SUM(DECODE(TT03_THVAY,'S',NVL(TT03_KH_VAY,0))),0) KH_VAY_NHAN ,
NVL(SUM(DECODE(TT03_THVAY,'M',NVL(TT03_CHOVAY_QUY,0))/1000000),0) CV_THAN ,
NVL(SUM(DECODE(TT03_THVAY,'M',NVL(TT03_KH_VAY,0))),0) KH_VAY_THAN ,
NVL(SUM(DECODE(TT03_THVAY,'L',NVL(TT03_CHOVAY_QUY,0))/1000000),0) CV_DHAN ,
NVL(SUM(DECODE(TT03_THVAY,'L',NVL(TT03_KH_VAY,0))),0) KH_VAY_DHAN ,
NVL(SUM(DECODE(TT03_THVAY,'S',NVL(TT03_DUNO,0))/1000000),0) DUNO_NHAN ,
NVL(SUM(DECODE(TT03_THVAY,'S',NVL(TT03_KH_DUNO,0))),0) KH_DUNO_NHAN ,
NVL(SUM(DECODE(TT03_THVAY,'M',NVL(TT03_DUNO,0))/1000000),0) DUNO_THAN ,
NVL(SUM(DECODE(TT03_THVAY,'M',NVL(TT03_KH_DUNO,0))),0) KH_DUNO_THAN ,
NVL(SUM(DECODE(TT03_THVAY,'L',NVL(TT03_DUNO,0))/1000000),0) DUNO_DHAN ,
NVL(SUM(DECODE(TT03_THVAY,'L',NVL(TT03_KH_DUNO,0))),0) KH_DUNO_DHAN
FROM BCTD_TT03 A, PO850MB D,dmtinh
WHERE  A.TT03_MACN = D.MAIN_POS
and MA = SUBSTR(A.TT03_MACN,3,2)
and TT03_NGAYBC = TO_DATE((SELECT
CASE WHEN SUBSTR($P{PARA_QUY},6,1) = 1 THEN '31-MAR'
    WHEN SUBSTR($P{PARA_QUY},6,1) = 2 THEN '30-JUN'
    WHEN SUBSTR($P{PARA_QUY},6,1) = 3 THEN '30-SEP'
    WHEN SUBSTR($P{PARA_QUY},6,1) = 4 THEN '31-DEC'
    ELSE ''
END  || '-' || SUBSTR($P{PARA_QUY},1,4)
FROM DUAL))
AND POS_FLAG ='M'
group by vungkt, vungkt ,
A.TT03_MACN,TEN
ORDER BY 1,3]]>
	</queryString>
