<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="CORE-BC02A_SUBREPORT" language="groovy" pageWidth="595" pageHeight="842" columnWidth="595" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_NGAYBC" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_TONGHOP" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString language="plsql">
		<![CDATA[select gdv TELLER_NAME, sbt REF_NO, tk ACCOUNT_NO, DECODE(noco,'D','Nợ','Có') DR_CR_FLG, sotien CCY_AMT, ghichu_1 INTERNAL_REMARKS, 'VND' CCY_DESC,sotien LCY_AMT
  from hsbt,dmpos y, (select po_posflg,po_ma,po_macn from dmpos where po_ma = $P{PARA_MAPGD}) z
 where MAPGD = Y.PO_MA
    AND substr(tk,1,2) in ('95','96')
     AND ngaybc = $P{PARA_NGAYBC}
    AND DECODE(z.PO_POSFLG,'H',1,'S',y.PO_MA, y.PO_MACN) = DECODE(z.PO_POSFLG,'H',1,z.po_ma)
    AND DECODE('Y',$P{PARA_TONGHOP},1,y.po_ma) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD})
    order by TELLER_NAME,REF_NO]]>
	</queryString>
	<field name="TELLER_NAME" class="java.lang.String"/>
	<field name="REF_NO" class="java.lang.String"/>
	<field name="ACCOUNT_NO" class="java.lang.String"/>
	<field name="DR_CR_FLG" class="java.lang.String"/>
	<field name="CCY_AMT" class="java.math.BigDecimal"/>
	<field name="INTERNAL_REMARKS" class="java.lang.String"/>
	<field name="CCY_DESC" class="java.lang.String"/>
	<field name="LCY_AMT" class="java.math.BigDecimal"/>
	<variable name="TOTAL_DEBIT" class="java.math.BigDecimal" resetType="Group" resetGroup="TELLER NAME" calculation="Sum">
		<variableExpression><![CDATA[$F{DR_CR_FLG}.equals("Nợ")?$F{LCY_AMT}:new BigDecimal(0)]]></variableExpression>
	</variable>
	<variable name="TOTAL_CREDIT" class="java.math.BigDecimal" resetType="Group" resetGroup="TELLER NAME" calculation="Sum">
		<variableExpression><![CDATA[$F{DR_CR_FLG}.equals("Có")?$F{LCY_AMT}:new BigDecimal(0)]]></variableExpression>
	</variable>
	<variable name="TOTAL_SUM_OF_DEBIT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{DR_CR_FLG}.equals("Nợ")?$F{LCY_AMT}:new BigDecimal(0)]]></variableExpression>
	</variable>
	<variable name="TOTAL_SUM_OF_CREDIT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{DR_CR_FLG}.equals("Có")?$F{LCY_AMT}:new BigDecimal(0)]]></variableExpression>
	</variable>
