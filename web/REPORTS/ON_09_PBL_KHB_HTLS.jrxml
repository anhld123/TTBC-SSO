<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ON_09_PBL_KHB-HTLS" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="807" leftMargin="20" rightMargin="15" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_TONGHOP" class="java.lang.String"/>
	<parameter name="PARA_NGAY" class="java.lang.String"/>
	<queryString>
		<![CDATA[select distinct  DT_MAPGD POS_CD,
DT_MADT IDB_INVESTOR_ID,
DT_TENDT IDB_INVESTOR_NAME,
  DT_DTTH IDB_BEN_TYPE,
  DT_TK_NO IDB_DR_AC_NO,
  DT_TK_CO IDB_CR_AC_NO,
  DT_TYLETH IDB_BEN_PERCENT,
   SUM(ROUND(DT_VONDT*DT_TYLETH/100,0)) INV_BEN_AMT ,
  0   TOTAL_SUBSIDY_INTEREST
  from hsdt a , DMPOS Y,
  (SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z
  where
  A.DT_MAPGD = Y.PO_MA
   AND  DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA, Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA)
AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD})
 AND TO_CHAR((SELECT distinct trunc(LAST_DAY(ADD_MONTHS(NG_CAPNHAT,-1))) FROM hsdt),'DD-MON-YYYY') = $P{PARA_NGAY}
  GROUP BY DT_MAPGD,DT_MADT,DT_TENDT,DT_DTTH, DT_TK_NO,DT_TK_CO, DT_TYLETH,NG_CAPNHAT
  ORDER BY 1,3,5]]>
	</queryString>
