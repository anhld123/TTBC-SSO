	<field name="IDB_INVESTOR_ID" class="java.lang.String"/>
	<field name="IDB_INVESTOR_NAME" class="java.lang.String"/>
	<field name="IDB_BEN_TYPE" class="java.lang.String"/>
	<field name="IDB_DR_AC_NO" class="java.lang.String"/>
	<field name="IDB_CR_AC_NO" class="java.lang.String"/>
	<field name="IDB_BEN_PERCENT" class="java.math.BigDecimal"/>
	<field name="INV_BEN_AMT" class="java.math.BigDecimal"/>
	<field name="TOTAL_SUBSIDY_INTEREST" class="java.math.BigDecimal"/>
	<variable name="TOT_SUB_INT" class="java.math.BigDecimal" incrementType="Group" incrementGroup="POS_INVES" calculation="Sum">
		<variableExpression><![CDATA[$F{TOTAL_SUBSIDY_INTEREST}]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="TOT_AMT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{INV_BEN_AMT}]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="SUB_SUB_AMT" class="java.math.BigDecimal" resetType="None">
		<variableExpression><![CDATA[$F{TOTAL_SUBSIDY_INTEREST}]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="SUB_AMT" class="java.math.BigDecimal" resetType="Group" resetGroup="POS_INVES" calculation="Sum">
		<variableExpression><![CDATA[$F{INV_BEN_AMT}]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
