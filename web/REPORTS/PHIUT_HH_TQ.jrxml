<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="PHIUT_HH_TQ" language="groovy" pageWidth="1000" pageHeight="595" orientation="Landscape" columnWidth="960" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="5fc5f136-fdc1-41d9-b46c-5141d0dc88d2">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_FROM_DT" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["D:\\Official dispatch of IT\\Xay dung CSDL\\jasper report\\Bao cao dia phuong\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_TO_DT" class="java.lang.String"/>
	<queryString>
		<![CDATA[/* Formatted on 9/6/2018 10:24:27 AM (QP5 v5.252.13127.32867) */
SELECT AA.*,
       BB.TONGDN/1000000 TONGDN,
       CC.TONG_LAITT/1000000 TONG_LAITT,
       CC.TONG_UTLAITT/1000000 TONG_UTLAITT,
       CC.UT_CAPTW/1000000 UT_CAPTW,
       CC.UT_CAPTINH/1000000 UT_CAPTINH,
       CC.UT_CAPHUYEN/1000000 UT_CAPHUYEN,
       CC.UT_CAPXA/1000000 UT_CAPXA,
       CC.TONG_UTDNBQ/1000000 TONG_UTDNBQ,
       DD.HH_LAITT/1000000 HH_LAITT,
       DD.HH_DN/1000000 HH_DN,
       DD.HH_TK/1000000 HH_TK
  FROM                                                        --DM TINH,VUNGKT
      (  SELECT B.KHOA_2,
                B.GIATRI,
                A.MA,
                A.TEN
           FROM DMTINH A,
                (SELECT *
                   FROM DMKHAC
                  WHERE KHOA_1 = '23') B
          WHERE A.VUNGKT = B.KHOA_2 AND MA NOT IN ('01')
       ORDER BY B.KHOA_2, A.MA) AA
       LEFT JOIN                                                     --TONG DN
                (  SELECT DP_MACN, SUM (DP_D7) TONGDN
                     FROM BCTD_DMDP
                    WHERE DP_NGAYBC = $P{PARA_TO_DT} AND DP_MACN NOT IN ('000101')
                 GROUP BY DP_MACN
                 ORDER BY DP_MACN) BB
          ON AA.MA = SUBSTR (BB.DP_MACN, 3, 2)
       LEFT JOIN                                                      --PHI UT
       (  SELECT UT_MACN,
                 SUM (TONG_LAITT) TONG_LAITT,
                 SUM (TONG_UTLAITT) TONG_UTLAITT,
                 SUM (UT_CAPTW) UT_CAPTW,
                 SUM (UT_CAPTINH) UT_CAPTINH,
                 SUM (UT_CAPHUYEN) UT_CAPHUYEN,
                 SUM (UT_CAPXA) UT_CAPXA,
                 SUM (TONG_UTDNBQ) TONG_UTDNBQ
            FROM (  SELECT UT_MACN,
                           UT_NGAYBC,
                           NVL (
                              SUM (
                                 CASE
                                    WHEN UT_FLAG IN ('1', '3') THEN UT_TONGTIEN
                                    ELSE 0
                                 END),
                              0)
                              TONG_LAITT,
                           NVL (
                              SUM (
                                 CASE
                                    WHEN UT_FLAG IN ('1', '3') THEN UT_TONGPHIUT
                                    ELSE 0
                                 END),
                              0)
                              TONG_UTLAITT,
                           NVL (
                              SUM (
                                 CASE
                                    WHEN UT_FLAG IN ('1', '3') THEN UT_UTTW
                                    ELSE 0
                                 END),
                              0)
                              UT_CAPTW,
                           NVL (
                              SUM (
                                 CASE
                                    WHEN UT_FLAG IN ('1', '3') THEN UT_UTTINH
                                    ELSE 0
                                 END),
                              0)
                              UT_CAPTINH,
                           NVL (
                              SUM (
                                 CASE
                                    WHEN UT_FLAG IN ('1', '3') THEN UT_UTHUYEN
                                    ELSE 0
                                 END),
                              0)
                              UT_CAPHUYEN,
                           NVL (
                              SUM (
                                 CASE
                                    WHEN UT_FLAG IN ('1', '3') THEN UT_UTXA
                                    ELSE 0
                                 END),
                              0)
                              UT_CAPXA,
                           NVL (
                              SUM (
                                 CASE
                                    WHEN UT_FLAG IN ('2') THEN UT_TONGPHIUT
                                    ELSE 0
                                 END),
                              0)
                              TONG_UTDNBQ
                      FROM PHIUT
                     WHERE UT_NGAYBC BETWEEN $P{PARA_FROM_DT} AND $P{PARA_TO_DT}
                  GROUP BY UT_MACN, UT_NGAYBC
                  ORDER BY UT_NGAYBC, UT_MACN)
        GROUP BY UT_MACN
        ORDER BY UT_MACN) CC
          ON AA.MA = SUBSTR (UT_MACN, 3, 2)
       LEFT JOIN                                                   -- HOA HONG
       (  SELECT GL_MACN,
                 SUM (HH_LAITT) HH_LAITT,
                 SUM (HH_DN) HH_DN,
                 SUM (HH_TK) HH_TK
            FROM (  SELECT GL_MACN,
                           GL_NGAYBC,
                           NVL (
                              SUM (
                                 CASE
                                    WHEN GL_TK = '9314017049' THEN GL_DC_NO
                                    ELSE 0
                                 END),
                              0)
                              HH_LAITT,
                           NVL (
                              SUM (
                                 CASE
                                    WHEN GL_TK = '9314027042' THEN GL_DC_NO
                                    ELSE 0
                                 END),
                              0)
                              HH_DN,
                           NVL (
                              SUM (
                                 CASE
                                    WHEN GL_TK = '9314037045' THEN GL_DC_NO
                                    ELSE 0
                                 END),
                              0)
                              HH_TK
                      FROM GL_VBSP_TH
                     WHERE     GL_CAPTH = 'M'
                           AND GL_KYBC = 'M'
                           AND GL_NGAYBC = $P{PARA_TO_DT}
                           AND GL_MACN NOT IN ('000101',
                                               '000196',
                                               '000197',
                                               '000199')
                  GROUP BY GL_MACN, GL_NGAYBC
                  ORDER BY GL_NGAYBC, GL_MACN)
        GROUP BY GL_MACN
        ORDER BY GL_MACN) DD
          ON AA.MA = SUBSTR (DD.GL_MACN, 3, 2)]]>
	</queryString>
