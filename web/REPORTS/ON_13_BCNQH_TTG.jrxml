<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="13_LOAN_STATUS_REPORT_CONSOLIDATED" language="groovy" pageWidth="842" pageHeight="625" orientation="Landscape" columnWidth="803" leftMargin="20" rightMargin="19" topMargin="20" bottomMargin="20" uuid="d8e8656e-c045-495d-a6f1-41639c04ee3f">
	<property name="ireport.zoom" value="0.75"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_TONGHOP" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<queryString>
		<![CDATA[select distinct PR_TEN SPEC_PRODUCT,
 SUM(CASE WHEN (TO_DATE(ku_ngaybc,'DD-MM-YYYY') - DECODE(PR_CNQHFLG,'A', TO_DATE(ku_ngaycnqh,'DD-MM-YYYY'),'P',TO_DATE(ku_ngaycnqh,'DD-MM-YYYY'))) <= 90 AND
                      (TO_DATE(ku_ngaybc,'DD-MM-YYYY') -DECODE(PR_CNQHFLG,'A', TO_DATE(ku_ngaycnqh,'DD-MM-YYYY'),'P',TO_DATE(ku_ngaycnqh,'DD-MM-YYYY'))) > 0 THEN 1 ELSE 0 END) OLEM_CNT,
                SUM(CASE WHEN (TO_DATE(ku_ngaybc,'DD-MM-YYYY') - DECODE(PR_CNQHFLG,'A', TO_DATE(ku_ngaycnqh,'DD-MM-YYYY'),'P',TO_DATE(ku_ngaycnqh,'DD-MM-YYYY'))) <= 90 AND
                      (TO_DATE(ku_ngaybc,'DD-MM-YYYY') -DECODE(PR_CNQHFLG,'A', TO_DATE(ku_ngaycnqh,'DD-MM-YYYY'),'P',TO_DATE(ku_ngaycnqh,'DD-MM-YYYY'))) > 0 THEN KU_CHUYENQH ELSE 0 END) OLEM_DAYS,
                SUM(CASE WHEN (TO_DATE(ku_ngaybc,'DD-MM-YYYY') - DECODE(PR_CNQHFLG,'A', TO_DATE(ku_ngaycnqh,'DD-MM-YYYY'),'P',TO_DATE(ku_ngaycnqh,'DD-MM-YYYY'))) <= 180 AND
                      (TO_DATE(ku_ngaybc,'DD-MM-YYYY') -DECODE(PR_CNQHFLG,'A', TO_DATE(ku_ngaycnqh,'DD-MM-YYYY'),'P',TO_DATE(ku_ngaycnqh,'DD-MM-YYYY'))) > 90 THEN 1 ELSE 0 END) SUBST_CNT,
                SUM(CASE WHEN (TO_DATE(ku_ngaybc,'DD-MM-YYYY') - DECODE(PR_CNQHFLG,'A', TO_DATE(ku_ngaycnqh,'DD-MM-YYYY'),'P',TO_DATE(ku_ngaycnqh,'DD-MM-YYYY'))) <= 180 AND
                      (TO_DATE(ku_ngaybc,'DD-MM-YYYY') -DECODE(PR_CNQHFLG,'A', TO_DATE(ku_ngaycnqh,'DD-MM-YYYY'),'P',TO_DATE(ku_ngaycnqh,'DD-MM-YYYY'))) > 90 THEN KU_CHUYENQH ELSE 0 END) SUBST_DAYS,
                SUM(CASE WHEN (TO_DATE(ku_ngaybc,'DD-MM-YYYY') - DECODE(PR_CNQHFLG,'A', TO_DATE(ku_ngaycnqh,'DD-MM-YYYY'),'P',TO_DATE(ku_ngaycnqh,'DD-MM-YYYY'))) <= 360 AND
                      (TO_DATE(ku_ngaybc,'DD-MM-YYYY') -DECODE(PR_CNQHFLG,'A', TO_DATE(ku_ngaycnqh,'DD-MM-YYYY'),'P',TO_DATE(ku_ngaycnqh,'DD-MM-YYYY'))) > 180 THEN 1 ELSE 0 END) DOUBT_CNT,
                SUM(CASE WHEN (TO_DATE(ku_ngaybc,'DD-MM-YYYY') - DECODE(PR_CNQHFLG,'A', TO_DATE(ku_ngaycnqh,'DD-MM-YYYY'),'P',TO_DATE(ku_ngaycnqh,'DD-MM-YYYY'))) <= 360 AND
                      (TO_DATE(ku_ngaybc,'DD-MM-YYYY') -DECODE(PR_CNQHFLG,'A', TO_DATE(ku_ngaycnqh,'DD-MM-YYYY'),'P',TO_DATE(ku_ngaycnqh,'DD-MM-YYYY'))) > 180 THEN KU_CHUYENQH ELSE 0 END) DOUBT_DAYS,
                SUM(CASE WHEN (TO_DATE(ku_ngaybc,'DD-MM-YYYY') -DECODE(PR_CNQHFLG,'A', TO_DATE(ku_ngaycnqh,'DD-MM-YYYY'),'P',TO_DATE(ku_ngaycnqh,'DD-MM-YYYY'))) > 360 THEN 1 ELSE 0 END) LEGAL_CNT,
                SUM(CASE WHEN (TO_DATE(ku_ngaybc,'DD-MM-YYYY') -DECODE(PR_CNQHFLG,'A', TO_DATE(ku_ngaycnqh,'DD-MM-YYYY'),'P',TO_DATE(ku_ngaycnqh,'DD-MM-YYYY'))) > 360 THEN KU_CHUYENQH ELSE 0 END) LEGAL_DAYS
from hsku a, dm_product b,  dmpos Y,
     (SELECT PO_POSFLG, PO_MACN, PO_MA FROM dmpos WHERE PO_MA = $P{PARA_MAPGD}) Z
where     A.KU_PROD_CD = b.pr_ma
      AND KU_TTMONVAY = 'OPEN'
      and KU_TTHAINO='OLEM'
      AND KU_CHUYENQH > 0
      and ku_ngaybc=$P{PARA_NGAYBC}
       AND a.ku_mapgd = Y.PO_MA
   AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA, Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA)
   AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD})
   group by PR_TEN
   order by PR_TEN]]>
	</queryString>
	<field name="SPEC_PRODUCT" class="java.lang.String"/>
	<field name="OLEM_CNT" class="java.math.BigDecimal"/>
	<field name="OLEM_DAYS" class="java.math.BigDecimal"/>
	<field name="SUBST_CNT" class="java.math.BigDecimal"/>
	<field name="SUBST_DAYS" class="java.math.BigDecimal"/>
	<field name="DOUBT_CNT" class="java.math.BigDecimal"/>
	<field name="DOUBT_DAYS" class="java.math.BigDecimal"/>
	<field name="LEGAL_CNT" class="java.math.BigDecimal"/>
	<field name="LEGAL_DAYS" class="java.math.BigDecimal"/>
	<variable name="TOT_OLEM_DAYS" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{OLEM_DAYS}]]></variableExpression>
	</variable>
	<variable name="TOT_SUBST_DAYS" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{SUBST_DAYS}]]></variableExpression>
	</variable>
	<variable name="TOT_DOUBT_DAYS" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{DOUBT_DAYS}]]></variableExpression>
	</variable>
	<variable name="TOT_LEGAL_DAYS" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{LEGAL_DAYS}]]></variableExpression>
	</variable>
	<variable name="TOT_OLEM_CNT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{OLEM_CNT}]]></variableExpression>
	</variable>
	<variable name="TOT_SUBST_CNT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{SUBST_CNT}]]></variableExpression>
	</variable>
	<variable name="TOT_DOUBT_CNT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{DOUBT_CNT}]]></variableExpression>
	</variable>
	<variable name="TOT_LEGAL_CNT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{LEGAL_CNT}]]></variableExpression>
	</variable>
