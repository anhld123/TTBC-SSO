<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="mainpos_subpos1" language="groovy" pageWidth="266" pageHeight="842" columnWidth="266" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="a1cc02f9-df49-477c-9a7b-d10996f0489b">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="POS_CD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="CONS_FLAG" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select VBSP_PUBLIC_FUNCTION.F_GET_REPORT_GRADE($P{POS_CD},$P{CONS_FLAG}) CAP_BC, POS_FLAG from po850mb where pos_cd = $P{POS_CD}]]>
	</queryString>
	<field name="CAP_BC" class="java.math.BigDecimal"/>
	<field name="POS_FLAG" class="java.lang.String"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="17" splitType="Stretch">
			<textField>
				<reportElement uuid="0bf90bbd-acc8-4860-9760-b671f84d620c" x="0" y="0" width="265" height="17"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" isBold="true" pdfEncoding="Identity-H"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{CAP_BC} == 1 && $F{POS_FLAG} =='S' ? "TỔ TRƯỞNG TỔ KẾ TOÁN" : $F{CAP_BC} == 1 && $F{POS_FLAG} =='M' ? "TRƯỞNG PHÒNG KẾ TOÁN" : $F{CAP_BC} == 2 ? "TRƯỞNG PHÒNG KẾ TOÁN" : $F{CAP_BC} == 3 ? "KẾ TOÁN TRƯỞNG" : ""]]></textFieldExpression>
			</textField>
		</band>
	</title>
