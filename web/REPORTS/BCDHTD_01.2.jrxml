	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_TONGHOP" class="java.lang.String"/>
	<parameter name="PARA_DENNGAY" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString language="plsql">
		<![CDATA[SELECT case when (KHOA_2 = '92' OR KHOA_2 = '93' OR KHOA_2 = '94' OR KHOA_2 = '96') then 'Cho vay một số dự án vốn nước ngoài khác'
            else GIATRI
end as CHTRINH,
KHOA_2 MACT, GIATRI TENCT, THUTU STT,
NVL(sum(CTR_D1)/1000000,0) DS_CHOVAYT,
NVL(sum(CTR_D2)/1000000,0) DS_CHOVAYN,
NVL(sum(CTR_D3)/1000000,0) DS_THUNOT,
NVL(sum(CTR_D4)/1000000,0) DS_THUNON,
NVL(sum(CTR_D5)/1000000,0) DS_XOANOT,
NVL(sum(CTR_D6)/1000000,0) DS_XOANON,
NVL(sum(CTR_D7)/1000000,0) TONG_DN,
NVL(sum(CTR_D8)/1000000,0) NO_THAN,
NVL(sum(CTR_D9)/1000000,0) NO_QHAN,
NVL(sum(CTR_D10)/1000000,0) NO_KHOANH,
NVL(sum(CTR_D11)/1000000,0) NO_NGANHAN,
NVL(sum(CTR_D12)/1000000,0) NO_TRUNGHAN,
NVL(sum(CTR_D13)/1000000,0) NO_DAIHAN,
NVL(sum(CTR_D14),0) SKH_DUNO,
NVL(sum(CTR_D15),0) SKH_VVON
FROM DMKHAC A, BCTD_CHTRINH B, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z
WHERE KHOA_1 = '07'
AND CTR_CHTRINH = A.KHOA_2
AND B.CTR_MAPGD = Y.PO_MA
AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA)
AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD})
AND CTR_NGAYBC = TO_DATE ($P{PARA_DENNGAY})
group by KHOA_2,GIATRI, THUTU
order by THUTU, KHOA_2]]>
	</queryString>
