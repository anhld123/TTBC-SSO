<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="BCDHTD_01.2" language="groovy" pageWidth="1050" pageHeight="750" orientation="Landscape" columnWidth="1012" leftMargin="20" rightMargin="18" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="0.75"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_DENNGAY" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT A.GIATRI ECO_AREA,  A.KHOA_2, B.TEN POS_DESCRIPTION, B.MA,
(select NVL(sum(DTTH_D1)/1000000,0) from BCTD_DTTH WHERE  DTTH_MAPGD in (Select giatri from dmkhac where khoa_1 = '42' and substr(khoa_2,3,2) = B.MA) AND DTTH_NGAYBC = TO_DATE ($P{PARA_DENNGAY})) DS_CHOVAYT,
(select NVL(sum(DTTH_D2)/1000000,0) from BCTD_DTTH WHERE  DTTH_MAPGD in (Select giatri from dmkhac where khoa_1 = '42' and substr(khoa_2,3,2) = B.MA) AND DTTH_NGAYBC = TO_DATE ($P{PARA_DENNGAY})) DS_CHOVAYN,
(select NVL(sum(DTTH_D3)/1000000,0) from BCTD_DTTH WHERE  DTTH_MAPGD in (Select giatri from dmkhac where khoa_1 = '42' and substr(khoa_2,3,2) = B.MA)  AND DTTH_NGAYBC = TO_DATE ($P{PARA_DENNGAY})) DS_THUNOT,
(select NVL(sum(DTTH_D4)/1000000,0) from BCTD_DTTH WHERE  DTTH_MAPGD in (Select giatri from dmkhac where khoa_1 = '42' and substr(khoa_2,3,2) = B.MA)  AND DTTH_NGAYBC = TO_DATE ($P{PARA_DENNGAY})) DS_THUNON,
(select NVL(sum(DTTH_D5)/1000000,0) from BCTD_DTTH WHERE  DTTH_MAPGD in (Select giatri from dmkhac where khoa_1 = '42' and substr(khoa_2,3,2) = B.MA)  AND DTTH_NGAYBC = TO_DATE ($P{PARA_DENNGAY})) DS_XOANOT,
(select NVL(sum(DTTH_D6)/1000000,0) from BCTD_DTTH WHERE  DTTH_MAPGD in (Select giatri from dmkhac where khoa_1 = '42' and substr(khoa_2,3,2) = B.MA)  AND DTTH_NGAYBC = TO_DATE ($P{PARA_DENNGAY})) DS_XOANON,
(select NVL(sum(DTTH_D7)/1000000,0) from BCTD_DTTH WHERE  DTTH_MAPGD in (Select giatri from dmkhac where khoa_1 = '42' and substr(khoa_2,3,2) = B.MA)  AND DTTH_NGAYBC = TO_DATE ($P{PARA_DENNGAY})) TONG_DN,
(select NVL(sum(DTTH_D8)/1000000,0) from BCTD_DTTH WHERE  DTTH_MAPGD in (Select giatri from dmkhac where khoa_1 = '42' and substr(khoa_2,3,2) = B.MA)  AND DTTH_NGAYBC = TO_DATE ($P{PARA_DENNGAY})) NO_THAN,
(select NVL(sum(DTTH_D9)/1000000,0) from BCTD_DTTH WHERE  DTTH_MAPGD in (Select giatri from dmkhac where khoa_1 = '42' and substr(khoa_2,3,2) = B.MA)  AND DTTH_NGAYBC = TO_DATE ($P{PARA_DENNGAY})) NO_QHAN,
(select NVL(sum(DTTH_D10)/1000000,0) from BCTD_DTTH WHERE  DTTH_MAPGD in (Select giatri from dmkhac where khoa_1 = '42' and substr(khoa_2,3,2) = B.MA)  AND DTTH_NGAYBC = TO_DATE ($P{PARA_DENNGAY})) NO_KHOANH,
(select NVL(sum(DTTH_D11)/1000000,0) from BCTD_DTTH WHERE  DTTH_MAPGD in (Select giatri from dmkhac where khoa_1 = '42' and substr(khoa_2,3,2) = B.MA)  AND DTTH_NGAYBC = TO_DATE ($P{PARA_DENNGAY})) NO_NGANHAN,
(select NVL(sum(DTTH_D12)/1000000,0) from BCTD_DTTH WHERE  DTTH_MAPGD in (Select giatri from dmkhac where khoa_1 = '42' and substr(khoa_2,3,2) = B.MA)  AND DTTH_NGAYBC = TO_DATE ($P{PARA_DENNGAY})) NO_TRUNGHAN,
(select NVL(sum(DTTH_D13)/1000000,0) from BCTD_DTTH WHERE  DTTH_MAPGD in (Select giatri from dmkhac where khoa_1 = '42' and substr(khoa_2,3,2) = B.MA)  AND DTTH_NGAYBC = TO_DATE ($P{PARA_DENNGAY})) NO_DAIHAN,
(select NVL(sum(DTTH_D14),0) from BCTD_DTTH WHERE  DTTH_MAPGD in (Select giatri from dmkhac where khoa_1 = '42' and substr(khoa_2,3,2) = B.MA)  AND DTTH_NGAYBC = TO_DATE ($P{PARA_DENNGAY})) SKH_DUNO,
(select NVL(sum(DTTH_D15),0) from BCTD_DTTH WHERE  DTTH_MAPGD in (Select giatri from dmkhac where khoa_1 = '42' and substr(khoa_2,3,2) = B.MA)  AND DTTH_NGAYBC = TO_DATE ($P{PARA_DENNGAY})) SKH_VVON
FROM DMKHAC A, (Select distinct(MA), TEN, MOTA VUNG from DMTINH, DMKHAC where MA = substr(KHOA_2,3,2) AND KHOA_1 = '42') B
WHERE A.KHOA_1 = '43'
AND  B.VUNG = A.KHOA_2
GROUP BY A.KHOA_2,A.GIATRI, B.TEN, B.MA
ORDER BY A.KHOA_2, B.TEN]]>
	</queryString>
