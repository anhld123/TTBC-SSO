				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="false" isItalic="false"/>
					<paragraph leftIndent="5"/>
				</textElement>
				<textFieldExpression><![CDATA["NHCSXH cấp tỉnh tự kiểm tra, đánh giá phiên GDX: Tỷ lệ: "+$F{CNTYLE}+ " % tăng/ giảm: "+($F{CNTYLE}-$F{CNTYLE1})+"%; Điểm: "+$F{CNDIEM}+" điểm, tăng/giảm: "+($F{CNDIEM}-$F{CNDIEM1})+" điểm."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement uuid="dab994df-3ffe-4841-b7eb-db0af37fbe58" x="46" y="45" width="794" height="20"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="false"/>
					<paragraph leftIndent="5"/>
