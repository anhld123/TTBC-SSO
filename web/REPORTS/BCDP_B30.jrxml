	<subDataset name="dataset1">
		<parameter name="POS_CD" class="java.lang.String"/>
		<parameter name="PARA_NGAYBC" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT ADD_CITY PROVINCE ,POS_CD HEAD_POS , POS_DESC POS_DESC ,TO_CHAR( $P{PARA_NGAYBC},'DD/MM/YYYY') NGA_BC, TO_CHAR(LAST_DAY(ADD_MONTHS(PC_BUSINESS_DT,-1)),'DD/MM/YYYY') BUSDT FROM PO850MB , P_CTRL
WHERE  POS_CD = $P{POS_CD}]]>
		</queryString>
		<field name="PROVINCE" class="java.lang.String"/>
		<field name="HEAD_POS" class="java.lang.String"/>
		<field name="POS_DESC" class="java.lang.String"/>
		<field name="NGA_BC" class="java.lang.String"/>
		<field name="BUSDT" class="java.lang.String"/>
	</subDataset>
	<subDataset name="dataset2"/>
	<parameter name="PARA_MACN" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT TO_DVUT,ten_dvut,KU_MAPGD,PO_TEN,sum(KU_LAI_TT) KU_LAI_TT, sum(sotien) sotien,KU_NGAYBC FROM (
SELECT A.KU_MATO,A.KU_NGAYBC,C.TO_DVUT,A.KU_SOKU,A.KU_LAI_TT,B.SOTIEN,A.KU_MACN,D.PO_TEN,A.KU_MAPGD,B.SBT,B.ngaygd,
case when TO_DVUT = '11' then 'Hội ND'
       when TO_DVUT = '12' then 'Hội PN'
       when TO_DVUT = '13' then 'Hội CCB'
       when TO_DVUT = '14' then 'Đoàn TN'
end as ten_dvut
FROM HSKU A,HSBT B, HSTO C, DMPOS D
WHERE A.KU_SOKU = B.SBT
AND A.KU_MATO = C.TO_MATO
AND A.KU_MACN = $P{PARA_MACN}
AND A.KU_MAPGD = D.PO_MA
AND TRUNC(A.KU_NGAYBC) = TRUNC(TO_DATE($P{PARA_NGAYBC},'DD-MON-YYYY'))
AND b.NOCO = 'D'
AND B.TK = '9314017049'
AND TO_CHAR(b.NGAYGD,'MM') = TO_CHAR(TO_DATE($P{PARA_NGAYBC},'DD-MON-YYYY'),'MM')
AND B.GHICHU_1= 'PREPAYNORMAL'
AND C.TO_DVUT IN ('11','12','13','14')) group by TO_DVUT, KU_MAPGD,PO_TEN,ten_dvut,KU_NGAYBC order by TO_DVUT]]>
	</queryString>
	<field name="TO_DVUT" class="java.lang.String"/>
	<field name="TEN_DVUT" class="java.lang.String"/>
	<field name="KU_MAPGD" class="java.lang.String"/>
	<field name="PO_TEN" class="java.lang.String"/>
	<field name="KU_LAI_TT" class="java.math.BigDecimal"/>
	<field name="SOTIEN" class="java.math.BigDecimal"/>
	<field name="KU_NGAYBC" class="java.sql.Timestamp"/>
	<variable name="TOT_SOTIEN" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$F{SOTIEN}]]></variableExpression>
	</variable>
	<variable name="TOT_DVUT_SOTIEN" class="java.math.BigDecimal" resetType="Group" resetGroup="DVUT" calculation="Sum">
		<variableExpression><![CDATA[$F{KU_LAI_TT}]]></variableExpression>
	</variable>
	<variable name="TOT_LAI_TT" class="java.math.BigDecimal" resetType="Group" resetGroup="DVUT" calculation="Sum">
		<variableExpression><![CDATA[$F{KU_LAI_TT}]]></variableExpression>
	</variable>
	<variable name="SOTIEN" class="java.lang.String" calculation="Sum"/>
	<variable name="TK_COUNT" class="java.lang.Integer" resetType="Group" resetGroup="DVUT" incrementType="Group" incrementGroup="DVUT" calculation="Count">
		<variableExpression><![CDATA[$F{TO_DVUT}]]></variableExpression>
	</variable>
	<variable name="KU_LAI_TT_1" class="java.math.BigDecimal" resetType="Group" resetGroup="DVUT" calculation="Sum">
		<variableExpression><![CDATA[$F{KU_LAI_TT}]]></variableExpression>
	</variable>
	<variable name="KU_LAI_TT_2" class="java.math.BigDecimal" resetType="Group" resetGroup="DVUT" calculation="Sum">
		<variableExpression><![CDATA[$F{KU_LAI_TT}]]></variableExpression>
	</variable>
	<variable name="SOTIEN_1" class="java.math.BigDecimal" resetType="Group" resetGroup="DVUT" calculation="Sum">
		<variableExpression><![CDATA[$F{SOTIEN}]]></variableExpression>
	</variable>
	<variable name="KU_LAI_TT_3" class="java.math.BigDecimal" resetType="Page" calculation="Sum">
		<variableExpression><![CDATA[$F{KU_LAI_TT}]]></variableExpression>
	</variable>
	<variable name="SOTIEN_2" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{SOTIEN}]]></variableExpression>
	</variable>
	<group name="DVUT">
		<groupExpression><![CDATA[$F{TO_DVUT}]]></groupExpression>
