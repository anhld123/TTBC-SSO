					<font fontName="Times New Roman" size="14" isBold="false" isItalic="false" isUnderline="false" isStrikeThrough="false" pdfEncoding="Identity-H" isPdfEmbedded="false"/>
					<paragraph lineSpacing="1_1_2" lineSpacingSize="1.3" firstLineIndent="105"/>
				</textElement>
				<textFieldExpression><![CDATA["Cho "+ $F{SOMON_XOA}+ " món vay, số tiền " +
$F{SOTIEN_XOA} +
" đồng. Trong đó: Gốc " +
$F{GOC_XOA} +
" đồng, lãi "+
$F{LAI_XOA}+ " đồng. Thời gian, số tiền được xóa nợ của từng món vay theo danh sách chi tiết đính kèm. "]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement uuid="38be5bbb-46ba-4ee1-a93a-8386d713e610" positionType="Float" x="0" y="152" width="483" height="19"/>
				<box leftPadding="0"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="14" isBold="true" isUnderline="false" pdfEncoding="Identity-H"/>
					<paragraph lineSpacing="1_1_2" firstLineIndent="40"/>
				</textElement>
				<text><![CDATA[3. Tổ chức thực hiện]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement uuid="4e91a8b9-7a81-4bd6-a194-645859a42850" positionType="Float" x="0" y="261" width="483" height="20"/>
				<box leftPadding="0"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="14" pdfEncoding="Identity-H"/>
					<paragraph lineSpacing="1_1_2" lineSpacingSize="1.3" firstLineIndent="40"/>
				</textElement>
				<textFieldExpression><![CDATA["Sau khi hạch toán các khoản nợ bị rủi ro do nguyên nhân khách quan nêu trên, NHCSXH nơi cho vay thực hiện thông báo công khai tại điểm giao dịch xã theo đúng quy định, lập báo cáo mẫu số 13, 14/XLN gửi chi nhánh tỉnh để tổng hợp gửi Hội sở  chính (Ban Quản lý và xử lý nợ rủi ro) trước ngày " +$F{NGAY_GUIBC}+ ". Căn cứ báo cáo của chi nhánh Hội sở chính sẽ chuyển tiền cho đơn vị tất toán số tiền xoá nợ gốc các khoản vay."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement uuid="ff1a0cad-83e2-4e15-9b8c-e6c7c5fcf2e0" positionType="Float" x="-1" y="178" width="483" height="70"/>
				<box leftPadding="0"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="14" pdfEncoding="Identity-H"/>
					<paragraph lineSpacing="1_1_2" lineSpacingSize="1.3" firstLineIndent="40"/>
				</textElement>
				<textFieldExpression><![CDATA["Tổng Giám đốc giao Giám đốc chi nhánh NHCSXH" +
$F{TEN} +
" chỉ đạo Giám đốc NHCSXH nơi cho vay rà soát lại hồ sơ pháp lý và chịu trách nhiệm về tính chính xác, hợp pháp, hợp lệ của tất cả các khoản nợ được xử lý theo thông báo này."]]></textFieldExpression>
			</textField>
		</band>
