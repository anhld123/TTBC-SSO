				</textElement>
				<text><![CDATA[- Như trên;
- Tổng Giám đốc;
- Trưởng Ban kiểm soát;
- Các Phó Tổng Giám đốc;
- Kế toán trưởng;
- Các Ban CMNV tại HSC;
- Lưu: VT, Ban QLN.
]]></text>
			</staticText>
			<textField>
				<reportElement uuid="914a1d26-bd91-4a09-824e-f92a9c116972" positionType="FixRelativeToBottom" x="250" y="99" width="234" height="27"/>
