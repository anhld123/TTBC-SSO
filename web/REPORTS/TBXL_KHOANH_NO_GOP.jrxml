					<paragraph lineSpacing="1_1_2" firstLineIndent="40"/>
				</textElement>
				<text><![CDATA[- Đối với khoanh nợ lần đầu: Khoanh nợ từ ngày khách hàng gặp rủi ro.]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="1173b25c-2fbe-41a9-8b82-8e000f0a2a8f" positionType="Float" x="0" y="92" width="508" height="21"/>
				<box leftPadding="0" rightPadding="0"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="14" isBold="false" isUnderline="false" pdfEncoding="Identity-H"/>
					<paragraph lineSpacing="1_1_2" firstLineIndent="40"/>
				</textElement>
				<text><![CDATA[- Đối với khoanh nợ bổ sung: Khoanh nợ từ ngày hết thời gian khoanh lần trước.]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="3abdef64-662e-48ff-b5e7-95faab70eaef" positionType="Float" x="0" y="123" width="105" height="19"/>
				<box leftPadding="0"/>
				<textElement verticalAlignment="Top">
					<font fontName="Times New Roman" size="14" isBold="true" isUnderline="false" pdfEncoding="Identity-H"/>
					<paragraph lineSpacing="1_1_2" firstLineIndent="40"/>
				</textElement>
				<text><![CDATA[2. Xóa nợ: ]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement uuid="4904edc1-dab7-4e27-ad1b-98aefd0cf756" positionType="Float" mode="Transparent" x="0" y="123" width="483" height="20" forecolor="#000000" backcolor="#FFFFFF"/>
				<box leftPadding="0"/>
