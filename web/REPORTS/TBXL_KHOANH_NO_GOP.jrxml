			</textField>
			<staticText>
				<reportElement uuid="957dc15c-a3e4-4bd2-af8d-ddea7d98101e" positionType="Float" x="0" y="3" width="105" height="19"/>
				<box leftPadding="0"/>
				<textElement verticalAlignment="Top">
					<font fontName="Times New Roman" size="14" isBold="true" isUnderline="false" pdfEncoding="Identity-H"/>
					<paragraph lineSpacing="1_1_2" firstLineIndent="40"/>
				</textElement>
				<text><![CDATA[1. Xóa nợ: ]]></text>
			</staticText>
		</band>
		<band height="140">
			<printWhenExpression><![CDATA[$F{SOMON_KHOANH} =="0" || $F{SOMON_XOA} =="0"]]></printWhenExpression>
			<staticText>
				<reportElement uuid="cba6897b-e053-4108-b841-8380fff0f610" positionType="Float" x="0" y="3" width="483" height="19"/>
				<box leftPadding="0"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="14" isBold="true" isUnderline="false" pdfEncoding="Identity-H"/>
					<paragraph lineSpacing="1_1_2" firstLineIndent="40"/>
				</textElement>
				<text><![CDATA[2. Tổ chức thực hiện]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement uuid="fd84f9bd-8228-4e37-b782-e3f49adbe108" positionType="Float" x="0" y="92" width="484" height="20">
					<printWhenExpression><![CDATA[$F{SOMON_KHOANH} != '0']]></printWhenExpression>
				</reportElement>
				<box leftPadding="0"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="14" pdfEncoding="Identity-H"/>
					<paragraph lineSpacing="Proportional" lineSpacingSize="1.2" firstLineIndent="40"/>
				</textElement>
				<textFieldExpression><![CDATA["Sau khi hạch toán các khoản nợ bị rủi ro do nguyên nhân khách quan nêu trên, NHCSXH nơi cho vay thực hiện thông báo công khai tại điểm giao dịch xã theo đúng quy định, lập báo cáo mẫu số 13/XLN gửi chi nhánh tỉnh để tổng hợp gửi Hội sở  chính (Ban Quản lý và xử lý nợ rủi ro) trước ngày " +$F{NGAY_GUIBC}+ "."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement uuid="aa811afb-97d9-4a78-b597-4755db42b0da" positionType="Float" x="-1" y="120" width="484" height="20"/>
				<box leftPadding="0"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="14" pdfEncoding="Identity-H"/>
					<paragraph lineSpacing="Proportional" lineSpacingSize="1.2" firstLineIndent="40"/>
				</textElement>
				<textFieldExpression><![CDATA["Nhận được công văn này, yêu cầu chi nhánh NHCSXH" + $F{TEN}+ " triển khai thực hiện. Quá trình thực hiện nếu có vướng mắc phản ánh về Hội sở chính (Ban Quản lý và xử lý nợ rủi ro) để xem xét, giải quyết./."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement uuid="005ed7a8-a8f5-4ff6-a22c-7c97e2871d87" positionType="Float" x="0" y="22" width="483" height="70"/>
				<box leftPadding="0"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="14" pdfEncoding="Identity-H"/>
					<paragraph lineSpacing="Proportional" lineSpacingSize="1.2" firstLineIndent="40"/>
				</textElement>
				<textFieldExpression><![CDATA["Tổng Giám đốc giao Giám đốc chi nhánh NHCSXH" +
$F{TEN} +
" chỉ đạo Giám đốc NHCSXH nơi cho vay rà soát lại hồ sơ pháp lý và chịu trách nhiệm về tính chính xác, hợp pháp, hợp lệ của tất cả các khoản nợ được xử lý theo thông báo này."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement uuid="402ea51e-8be2-4ef7-9417-4d16911c7a70" positionType="Float" x="0" y="92" width="484" height="20">
					<printWhenExpression><![CDATA[$F{SOMON_XOA} != '0']]></printWhenExpression>
				</reportElement>
				<box leftPadding="0"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="14" pdfEncoding="Identity-H"/>
					<paragraph lineSpacing="Proportional" lineSpacingSize="1.2" firstLineIndent="40"/>
				</textElement>
				<textFieldExpression><![CDATA["Sau khi hạch toán các khoản nợ bị rủi ro do nguyên nhân khách quan nêu trên, NHCSXH nơi cho vay thực hiện thông báo công khai tại điểm giao dịch xã theo đúng quy định, lập báo cáo mẫu số 14/XLN gửi chi nhánh tỉnh để tổng hợp gửi Hội sở  chính (Ban Quản lý và xử lý nợ rủi ro) trước ngày " +$F{NGAY_GUIBC}+ ". Căn cứ báo cáo của chi nhánh Hội sở chính sẽ chuyển tiền cho đơn vị tất toán số tiền xoá nợ gốc các khoản vay."]]></textFieldExpression>
			</textField>
		</band>
		<band height="126">
			<printWhenExpression><![CDATA[$F{SOMON_KHOANH} =="0" || $F{SOMON_XOA} =="0"]]></printWhenExpression>
			<staticText>
				<reportElement uuid="164d7064-cdac-44db-81ce-7a9d41bc3863" positionType="Float" x="248" y="8" width="235" height="30"/>
				<textElement textAlignment="Center" verticalAlignment="Top">
					<font fontName="Times New Roman" size="13" isBold="true" isItalic="false" isUnderline="false" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[KT. TỔNG GIÁM ĐỐC
PHÓ TỔNG GIÁM ĐỐC
]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="6cd8d6f7-fdd9-497a-861f-9b4cb2ddae0d" positionType="Float" x="0" y="8" width="154" height="15"/>
				<textElement verticalAlignment="Top">
					<font fontName="Times New Roman" size="12" isBold="true" isItalic="true" isUnderline="false" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[Nơi nhận:
- Như trên;
- Tổng Giám đốc;
- Trưởng Ban kiểm soát;
- Các Phó Tổng Giám đốc;
- Kế toán trưởng;
- Các Ban CMNV tại HSC;
- Lưu: VT, QLN.
]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="86f896d4-d1a4-402b-b014-39bc5a19bd44" positionType="Float" x="-1" y="23" width="154" height="103"/>
