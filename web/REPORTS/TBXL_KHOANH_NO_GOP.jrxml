					<paragraph lineSpacing="1_1_2" lineSpacingSize="1.3" firstLineIndent="40" tabStopWidth="20"/>
				</textElement>
				<textFieldExpression><![CDATA["Căn cứ Quyết định số " + $P{PARA_SOQD} + "/QĐ-HĐQT ngày " +  $F{NGAY} + " của Chủ tịch Hội đồng quản trị Ngân hàng Chính sách xã hội (NHCSXH) về việc xử lý nợ bị rủi ro do nguyên nhân khách quan đợt " + $F{DOTRR} + " năm " +$P{PARA_NAMBC} +" trong hệ thống NHCSXH. "]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
