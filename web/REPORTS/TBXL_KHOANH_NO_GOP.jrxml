				</textElement>
				<text><![CDATA[Thời điểm tính khoanh nợ:]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="15ab86b9-d5fd-4297-8389-f79c87195e2c" positionType="Float" x="0" y="66" width="483" height="19"/>
