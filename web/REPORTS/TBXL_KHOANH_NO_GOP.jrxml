					<paragraph lineSpacing="1_1_2" firstLineIndent="40"/>
				</textElement>
				<text><![CDATA[1. Khoanh nợ: ]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement uuid="2e519d20-6c7e-42c6-8c5e-6ac8da58ad09" positionType="Float" x="2" y="9" width="481" height="20"/>
				<box leftPadding="0"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="14" pdfEncoding="Identity-H"/>
					<paragraph lineSpacing="1_1_2" lineSpacingSize="1.3" firstLineIndent="126"/>
				</textElement>
				<textFieldExpression><![CDATA["Cho " + $F{SOMON_KHOANH} +" món vay, số tiền " +$F{SOTIEN_KHOANH} +
" đồng. Trong đó: Gốc " +$F{GOC_KHOANH} +" đồng, lãi " +
$F{LAI_KHOANH}+ " đồng. Thời gian, số tiền được khoanh nợ của từng món vay theo danh sách chi tiết đính kèm."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement uuid="d16798ad-f052-471e-823d-a66fdc2f23ac" positionType="Float" x="0" y="38" width="483" height="17"/>
				<box leftPadding="0"/>
