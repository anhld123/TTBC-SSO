				<textFieldExpression><![CDATA["Tổng Giám đốc NHCSXH thông báo xử lý nợ bị rủi ro do nguyên nhân khách quan đợt " + $F{DOTRR} + " năm " +$P{PARA_NAMBC} + " của chi nhánh như sau: "]]></textFieldExpression>
			</textField>
