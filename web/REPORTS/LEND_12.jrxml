<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="LEND_12" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="15" bottomMargin="15">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_NGAYBC" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT DISTINCT *
  FROM (SELECT a.KU_MATO,
               a.KU_MAKH,
               C.KH_TENKH,
               b.SBT,
               a.KU_SOKU,
             a.KU_NGAYDHAN_3,
               KU_TKTHAN,
               B.SOTIEN,
               B.TK_NO,
               B.TK_CO,
               B.NOCO,
               B.GHICHU_2,
               B.GHICHU_1,
	    substr(C.KH_MADP,1,6)  MAXA,
	 A.KU_NGAYDHAN_3 TXN_DT
	    FROM HSKU A
               INNER JOIN HSBT B
                  ON A.KU_SOKU = B.sbt
       AND a.KU_NGAYDHAN_3 = TO_DATE($P{PARA_NGAYBC})
             AND B.ngaygd = TO_DATE($P{PARA_NGAYBC})
                     AND a.ku_mapgd = $P{PARA_MAPGD}
		AND KU_NGAYBC = TO_DATE($P{PARA_NGAYBC})
                     AND B.noco = 'D'
                     AND SUBSTR (B.tk, 5, 1) IN (6, 7)
                     AND SUBSTR (B.tk, 1, 3) IN (913, 914, 915, 916)
                     AND B.Ghichu_1 = 'PARDLBALMOV'
               INNER JOIN HSKh C
                  ON A.KU_MAKH = C.KH_MAKH AND A.KU_MAKH = C.KH_MAKH) ORDER BY KU_MATO,KU_MAKH,KH_TENKH,KU_SOKU]]>
	</queryString>
	<field name="KU_MATO" class="java.lang.String"/>
	<field name="KU_MAKH" class="java.lang.String"/>
	<field name="KH_TENKH" class="java.lang.String"/>
	<field name="SBT" class="java.lang.String"/>
	<field name="KU_SOKU" class="java.lang.String"/>
	<field name="KU_NGAYDHAN_3" class="java.sql.Timestamp"/>
	<field name="KU_TKTHAN" class="java.lang.String"/>
	<field name="SOTIEN" class="java.math.BigDecimal"/>
	<field name="TK_NO" class="java.lang.String"/>
	<field name="TK_CO" class="java.lang.String"/>
	<field name="NOCO" class="java.lang.String"/>
	<field name="GHICHU_2" class="java.lang.String"/>
	<field name="GHICHU_1" class="java.lang.String"/>
	<field name="MAXA" class="java.lang.String"/>
	<field name="TXN_DT" class="java.sql.Timestamp"/>
	<variable name="customer_count" class="java.lang.Integer" incrementType="Group" incrementGroup="customer_id_group" calculation="Count">
		<variableExpression><![CDATA[$V{customer_count}++]]></variableExpression>
		<initialValueExpression><![CDATA[new Integer(1)]]></initialValueExpression>
	</variable>
	<variable name="TOT_PRIN_MOVING_AMT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{SOTIEN}]]></variableExpression>
	</variable>
	<group name="group_id_grp">
		<groupExpression><![CDATA[$F{KU_MAKH}]]></groupExpression>
	</group>
	<group name="customer_id_group">
		<groupExpression><![CDATA[$F{KU_MAKH}]]></groupExpression>
	</group>
