<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="RR_M02TB" language="groovy" pageWidth="595" pageHeight="842" orientation="Landscape" columnWidth="535" leftMargin="35" rightMargin="25" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_DOTRR" class="java.lang.String"/>
	<parameter name="PARA_NAMRR" class="java.lang.String"/>
	<queryString>
		<![CDATA[Select * from
(SELECT RR_DOTRR DOTRR, TO_NUMBER(TO_CHAR(RR_NGAYBC, 'YYYY')) NAMRR, B.MA MA, B.TEN TINH,
COUNT (CASE WHEN RR_NHOMRR = '02'
                    THEN RR_SOKU ELSE ''
                    END) SOMON_KHOANH,
TO_CHAR(SUM (CASE WHEN RR_NHOMRR = '02'
                    THEN (NVL(RR_XL_DUNO,0)+NVL(RR_XL_LAI,0)) ELSE 0
                    END),'99,999,999,999') SOTIEN_KHOANH,
TO_CHAR(SUM (CASE WHEN RR_NHOMRR = '02'
                    THEN (NVL(RR_XL_DUNO,0)) ELSE 0
                    END),'99,999,999,999') GOC_KHOANH,
TO_CHAR(SUM (CASE WHEN RR_NHOMRR = '02'
                    THEN (NVL(RR_XL_LAI,0)) ELSE 0
                    END),'9,999,999,999') LAI_KHOANH,
COUNT (CASE WHEN RR_NHOMRR = '03'
                    THEN RR_SOKU ELSE ''
                    END) SOMON_XOA,
TO_CHAR(SUM (CASE WHEN RR_NHOMRR = '03'
                    THEN (NVL(RR_XL_DUNO,0)+NVL(RR_XL_LAI,0)) ELSE 0
                    END),'99,999,999,999') SOTIEN_XOA,
TO_CHAR(SUM (CASE WHEN RR_NHOMRR = '03'
                    THEN (NVL(RR_XL_DUNO,0)) ELSE 0
                    END),'99,999,999,999') GOC_XOA,
TO_CHAR(SUM (CASE WHEN RR_NHOMRR = '03'
                    THEN (NVL(RR_XL_LAI,0)) ELSE 0
                    END),'9,999,999,999') LAI_XOA
FROM HSRR_WB A, DMTINH B
WHERE B.MA = SUBSTR(RR_MACN,3,2)
AND RR_DOTRR = $P{PARA_DOTRR}
AND TO_NUMBER(TO_CHAR(RR_NGAYBC, 'YYYY'))  = $P{PARA_NAMRR}
AND RR_TRANGTHAI = 'D'
AND RR_PDUYET_NGAY_TW is not null
GROUP BY B.MA, B.TEN, RR_DOTRR,RR_NGAYBC
ORDER BY B.MA, B.TEN
)
where (SOMON_KHOANH + SOMON_XOA) > 0]]>
	</queryString>
	<field name="DOTRR" class="java.math.BigDecimal"/>
	<field name="NAMRR" class="java.math.BigDecimal"/>
	<field name="MA" class="java.lang.String"/>
	<field name="TINH" class="java.lang.String"/>
	<field name="SOMON_KHOANH" class="java.math.BigDecimal"/>
	<field name="SOTIEN_KHOANH" class="java.lang.String"/>
	<field name="GOC_KHOANH" class="java.lang.String"/>
	<field name="LAI_KHOANH" class="java.lang.String"/>
	<field name="SOMON_XOA" class="java.math.BigDecimal"/>
	<field name="SOTIEN_XOA" class="java.lang.String"/>
	<field name="GOC_XOA" class="java.lang.String"/>
	<field name="LAI_XOA" class="java.lang.String"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="10" splitType="Stretch"/>
	</title>
	<pageHeader>
		<band splitType="Stretch"/>
	</pageHeader>
	<detail>
		<band height="700">
			<textField>
				<reportElement mode="Transparent" x="0" y="346" width="536" height="39" forecolor="#000000" backcolor="#CCCCCC"/>
				<box topPadding="3" leftPadding="3" bottomPadding="3" rightPadding="3"/>
				<textElement verticalAlignment="Top" rotation="None" markup="none">
					<font fontName="Times New Roman" size="14" isBold="false" isItalic="false" isUnderline="false" isStrikeThrough="false" pdfEncoding="Identity-H" isPdfEmbedded="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["        Không xóa nợ cho " + $F{SOMON_XOA}+" món vay, số tiền "+$F{SOTIEN_XOA}+" đồng. Trong đó, gốc "+ $F{GOC_XOA} + " đồng, lãi "+ $F{LAI_XOA} + " đồng."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement mode="Transparent" x="0" y="280" width="536" height="41" forecolor="#000000" backcolor="#CCCCCC"/>
				<box topPadding="3" leftPadding="3" bottomPadding="3" rightPadding="3"/>
				<textElement verticalAlignment="Top" rotation="None" markup="none">
					<font fontName="Times New Roman" size="14" isBold="false" isItalic="false" isUnderline="false" isStrikeThrough="false" pdfEncoding="Identity-H" isPdfEmbedded="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["        Không khoanh nợ cho "+$F{SOMON_KHOANH}+ " món vay, số tiền " + $F{SOTIEN_KHOANH} +" đồng. Trong đó, gốc " + $F{GOC_KHOANH} + " đồng, lãi " + $F{LAI_KHOANH} + " đồng."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="412" width="536" height="50"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="14" isBold="false" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[        Căn cứ nguyên nhân không được chấp thuận đề nghị Giám đốc chi nhánh NHCSXH cấp tỉnh chỉ đạo NHCSXH nơi cho vay rà soát lại nếu đủ điều kiện xử lý nợ rủi ro thì bổ sung thủ tục và trình xử lý rủi ro theo quy định. ]]></text>
			</staticText>
			<staticText>
				<reportElement x="360" y="671" width="150" height="18"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="13" isBold="true" isItalic="false" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[NGUYỄN VĂN LÝ]]></text>
			</staticText>
			<staticText>
				<reportElement x="360" y="530" width="150" height="30"/>
