				</textElement>
				<text><![CDATA[KT. TỔNG GIÁM ĐỐC
PHÓ TỔNG GIÁM ĐỐC]]></text>
			</staticText>
			<staticText>
				<reportElement x="18" y="530" width="150" height="19"/>
