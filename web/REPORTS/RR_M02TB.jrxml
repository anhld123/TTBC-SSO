				</textElement>
				<text><![CDATA[Nơi nhận:]]></text>
			</staticText>
			<staticText>
				<reportElement x="18" y="549" width="150" height="134"/>
				<textElement verticalAlignment="Top">
					<font fontName="Times New Roman" size="12" isBold="false" isItalic="false" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[- Như trên;
- Tổng Giám đốc;
- Trưởng Ban Kiểm soát;
- Các Phó Tổng Giám đốc;
- Kế toán trưởng;
- Các Ban CMNV tại HSC;
- Lưu: VT, Ban QLN.]]></text>
			</staticText>
			<staticText>
				<reportElement x="253" y="0" width="282" height="36"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="13" isBold="true" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM
Độc lập - Tự do -Hạnh phúc]]></text>
			</staticText>
			<textField>
				<reportElement mode="Transparent" x="112" y="132" width="423" height="26" forecolor="#000000" backcolor="#CCCCCC"/>
				<textElement textAlignment="Left" verticalAlignment="Middle" rotation="None" markup="none">
					<font fontName="Times New Roman" size="14" isBold="false" isItalic="false" isUnderline="false" isStrikeThrough="false" pdfEncoding="Identity-H" isPdfEmbedded="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["Kính gửi: Giám đốc chi nhánh NHCSXH tỉnh/TP " + $F{TINH}]]></textFieldExpression>
			</textField>
			<line>
				<reportElement x="338" y="41" width="117" height="1"/>
				<graphicElement>
					<pen lineWidth="0.25"/>
				</graphicElement>
			</line>
			<textField>
				<reportElement mode="Transparent" x="253" y="54" width="283" height="26" forecolor="#000000" backcolor="#CCCCCC"/>
				<textElement textAlignment="Center" verticalAlignment="Middle" rotation="None" markup="none">
					<font fontName="Times New Roman" size="14" isBold="false" isItalic="true" isUnderline="false" isStrikeThrough="false" pdfEncoding="Identity-H" isPdfEmbedded="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["Hà Nội, ngày       tháng      năm " + $F{NAMRR}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement mode="Transparent" x="0" y="61" width="170" height="70" forecolor="#000000" backcolor="#CCCCCC"/>
				<textElement textAlignment="Center" verticalAlignment="Middle" rotation="None" markup="none">
					<font fontName="Times New Roman" size="13" isBold="false" isItalic="false" isUnderline="false" isStrikeThrough="false" pdfEncoding="Identity-H" isPdfEmbedded="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["V/v thông báo không chấp thuận xử lý nợ bị rủi ro đợt " + $F{DOTRR} + " năm " + $F{NAMRR}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement mode="Transparent" x="0" y="164" width="536" height="57" forecolor="#000000" backcolor="#CCCCCC"/>
				<box topPadding="3" leftPadding="3" bottomPadding="3" rightPadding="3"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle" rotation="None" markup="none">
					<font fontName="Times New Roman" size="14" isBold="false" isItalic="false" isUnderline="false" isStrikeThrough="false" pdfEncoding="Identity-H" isPdfEmbedded="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["        Căn cứ Quyết định số 15/QĐ-HĐQT ngày 27/01/2011 của Chủ tịch Hội đồng quản trị Ngân hàng Chính sách xã hội (NHCSXH) về Ban hành Quy định xử lý nợ bị rủi ro trong hệ thống NHCSXH;"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement mode="Transparent" x="0" y="223" width="536" height="57" forecolor="#000000" backcolor="#CCCCCC"/>
				<box topPadding="3" leftPadding="3" bottomPadding="3" rightPadding="3"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle" rotation="None" markup="none">
					<font fontName="Times New Roman" size="14" isBold="false" isItalic="false" isUnderline="false" isStrikeThrough="false" pdfEncoding="Identity-H" isPdfEmbedded="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["        Sau khi xem xét Tờ trình và Biểu tổng hợp đề nghị xử lý nợ rủi ro đợt  " + $F{DOTRR} + " năm " + $F{NAMRR} + " chi nhánh gửi Hội sở chính, Tổng Giám đốc thông báo không chấp nhận xử lý nợ bị rủi ro của Chi nhánh đợt " + $F{DOTRR} + " năm " + $F{NAMRR} + " như sau:"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement mode="Transparent" x="-1" y="321" width="537" height="25" forecolor="#000000" backcolor="#CCCCCC"/>
				<box topPadding="3" leftPadding="3" bottomPadding="3" rightPadding="3"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle" rotation="None" markup="none">
					<font fontName="Times New Roman" size="14" isBold="false" isItalic="false" isUnderline="false" isStrikeThrough="false" pdfEncoding="Identity-H" isPdfEmbedded="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["         Nguyên nhân không được chấp thuận theo danh sách chi tiết đính kèm."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement mode="Transparent" x="0" y="385" width="535" height="25" forecolor="#000000" backcolor="#CCCCCC"/>
				<box topPadding="3" leftPadding="3" bottomPadding="3" rightPadding="3"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle" rotation="None" markup="none">
					<font fontName="Times New Roman" size="14" isBold="false" isItalic="false" isUnderline="false" isStrikeThrough="false" pdfEncoding="Identity-H" isPdfEmbedded="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["         Nguyên nhân không được chấp thuận theo danh sách chi tiết đính kèm."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement mode="Transparent" x="0" y="465" width="537" height="55" forecolor="#000000" backcolor="#CCCCCC"/>
				<box topPadding="3" leftPadding="3" bottomPadding="3" rightPadding="3"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle" rotation="None" markup="none">
					<font fontName="Times New Roman" size="14" isBold="false" isItalic="false" isUnderline="false" isStrikeThrough="false" pdfEncoding="Identity-H" isPdfEmbedded="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["         Nhận được công văn này, yêu cầu Giám đốc chi nhánh NHCSXH  " + $F{TINH} + " triển khai thực hiện. Quá trình thực hiện nếu có vướng mắc đề nghị phản ánh về Hội Sở chính (Ban Quản lý và xử lý nợ rủi ro) để xem xét, giải quyết./."]]></textFieldExpression>
			</textField>
