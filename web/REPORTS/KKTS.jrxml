<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="KKTS_NEW" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="f491849c-88e8-43f3-b972-2c71096890e6">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_TIEUDE" class="java.lang.String"/>
	<parameter name="PARA_NGAYKK" class="java.lang.String"/>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<parameter name="PARA_PHONGBAN" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT  $P{PARA_TIEUDE} TIEUDE, 'KK 0h ngày ' || $P{PARA_NGAYKK} NGAYKK,  A.MA_TS, A.TEN_TS, A.TENPHONG PHONGBAN
      FROM qt_tscc A
--           INTELLECT.FA040MB@VBSPSYNCLINK B,
--           INTELLECT.FA006MB@VBSPSYNCLINK C
     WHERE     --A.MA_TS = B.ASSET_ID
--           AND B.CUSTODIAN_ID = C.USER_ID
--           AND A.POS_CD = B.POS_CD
--           AND B.POS_CD = C.POS_CD
            NGAYBC = $P{PARA_NGAYBC}
           AND A.POS_CD = $P{PARA_MAPGD}
           AND LOAI_TS != 'M'
           AND trim(MAPHONG) = $P{PARA_PHONGBAN}
    ORDER BY A.POS_CD, A.TENPHONG,A.LOAI_TS, A.MA_TS]]>
	</queryString>
	<field name="TIEUDE" class="java.lang.String"/>
	<field name="NGAYKK" class="java.lang.String"/>
	<field name="MA_TS" class="java.lang.String"/>
	<field name="TEN_TS" class="java.lang.String"/>
	<field name="PHONGBAN" class="java.lang.String"/>
