<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="SUB_REPORT_V_15_5" language="groovy" pageWidth="555" pageHeight="802" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_TONGHOP" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_NGAYBC" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT A.DESCRIPT, A.ACCOUNT, A.FIRST_PRE_AMT, A.LAST_PRE_AMT,A.GROUP_TYPE,A.GROUP_NAME
FROM
((SELECT 'Các khoản phải trả nội bộ' DESCRIPT,'TK 46' ACCOUNT,
DN_TK_SBV($P{PARA_NGAYBC},$P{PARA_MAPGD},$P{PARA_TONGHOP},'46','P') LAST_PRE_AMT,
DN_TK_SBV(ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_MAPGD},$P{PARA_TONGHOP},'46','P') FIRST_PRE_AMT, 1 GROUP_TYPE,
'' GROUP_NAME, 1 SEQ FROM DUAL)
UNION
(SELECT 'Các khoản phải trả bên ngoài' DESCRIPT,'TK 45' ACCOUNT,
DN_TK_SBV($P{PARA_NGAYBC},$P{PARA_MAPGD},$P{PARA_TONGHOP},'45','P') LAST_PRE_AMT,
DN_TK_SBV(ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_MAPGD},$P{PARA_TONGHOP},'45','P') FIRST_PRE_AMT, 2 GROUP_TYPE,
'' GROUP_NAME, 1 SEQ FROM DUAL)
UNION
(SELECT '- Dự phòng đối với các cam kết đưa ra' DESCRIPT,NULL ACCOUNT,
NULL FIRST_PRE_AMT,
NULL LAST_PRE_AMT, 3 GROUP_TYPE,
'Dự phòng rủi ro khác:' GROUP_NAME, 1 SEQ FROM DUAL)
UNION
(SELECT '- Dự phòng cho các dịch vụ thanh toán' DESCRIPT,'TK 4891' ACCOUNT,
DN_TK_SBV($P{PARA_NGAYBC},$P{PARA_MAPGD},$P{PARA_TONGHOP},'4891','P') LAST_PRE_AMT,
DN_TK_SBV(ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_MAPGD},$P{PARA_TONGHOP},'4891','P') FIRST_PRE_AMT, 3 GROUP_TYPE,
'Dự phòng rủi ro khác:' GROUP_NAME, 2 SEQ FROM DUAL)
UNION
(SELECT '- Dự phòng rủi ro khác (dự phòng rủi ro hoạt động,… không bao gồm dự phòng khác đối với tài sản có nội bảng)' DESCRIPT,'TK 485, 4899' ACCOUNT,
(DN_TK_SBV($P{PARA_NGAYBC},$P{PARA_MAPGD},$P{PARA_TONGHOP},'485','P')+
DN_TK_SBV(ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_MAPGD},$P{PARA_TONGHOP},'4899','P')) LAST_PRE_AMT,
(DN_TK_SBV($P{PARA_NGAYBC},$P{PARA_MAPGD},$P{PARA_TONGHOP},'485','P')+
DN_TK_SBV(ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_MAPGD},$P{PARA_TONGHOP},'4899','P')) FIRST_PRE_AMT, 3 GROUP_TYPE,
'Dự phòng rủi ro khác:' GROUP_NAME, 3 SEQ FROM DUAL)
) A ORDER BY A.GROUP_TYPE,A.SEQ]]>
	</queryString>
	<field name="DESCRIPT" class="java.lang.String"/>
	<field name="ACCOUNT" class="java.lang.String"/>
	<field name="FIRST_PRE_AMT" class="java.math.BigDecimal"/>
	<field name="LAST_PRE_AMT" class="java.math.BigDecimal"/>
	<field name="GROUP_TYPE" class="java.math.BigDecimal"/>
	<field name="GROUP_NAME" class="java.lang.String"/>
	<variable name="LAST_PRE_AMT_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{LAST_PRE_AMT}]]></variableExpression>
	</variable>
	<variable name="FIRST_PRE_AMT_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{FIRST_PRE_AMT}]]></variableExpression>
	</variable>
	<group name="GROUP_TYPE">
		<groupExpression><![CDATA[$F{GROUP_TYPE}]]></groupExpression>
		<groupHeader>
			<band height="20">
				<textField isBlankWhenNull="true">
