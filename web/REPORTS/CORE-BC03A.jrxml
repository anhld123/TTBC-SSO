	<queryString language="plsql">
		<![CDATA[SELECT  PO_TEN ,TO_DATE($P{PARA_NGAYBC},'DD-MON-YYYY') EOD_DT,$P{PARA_TONGHOP} CONS_FLAG FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}]]>
