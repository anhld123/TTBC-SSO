	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<parameter name="PARA_PHONGBAN" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT A.pos_cd, B.CUSTODIAN_ID, C.DEPARTMENT, A.LOAI_TS, A.TEN_LOAI_TS, A.MA_TS, A.TEN_TS,A.TEN_NHANHIEU_TS, A.NGUYEN_GIA, A.SO_LUONG, A.NGAY_MUA
 FROM qt_tscc A,
      INTELLECT.FA040MB@VBSPSYNCLINK B,
      INTELLECT.FA006MB@VBSPSYNCLINK C
WHERE     A.MA_TS = B.ASSET_ID
      AND B.CUSTODIAN_ID = C.USER_ID
      AND A.POS_CD = B.POS_CD
      AND B.POS_CD = C.POS_CD
      AND ngaybc = $P{PARA_NGAYBC}
      AND trim(B.CUSTODIAN_ID) = $P{PARA_PHONGBAN}
      AND loai_ts <> 'M'
ORDER BY A.pos_cd, B.CUSTODIAN_ID,A.LOAI_TS,  A.TEN_NHANHIEU_TS]]>
	</queryString>
