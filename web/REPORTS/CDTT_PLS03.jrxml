<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="CDTT_PLS03" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="e5b2469b-846b-40a6-b6ed-c7e60c4a2d8b">
	<property name="ireport.zoom" value="1.3310000000000004"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="style1" markup="styled" fontName="Times New Roman" isBold="false" isItalic="false" isUnderline="false" isStrikeThrough="false" pdfEncoding="Identity-H">
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{TT_HIENTHI}=="I"||$F{TT_HIENTHI}=="II"|| $F{TT_HIENTHI}== "X"]]></conditionExpression>
			<style markup="styled" fontName="Times New Roman" isBold="true" isItalic="false" isUnderline="false" isStrikeThrough="false" pdfEncoding="Identity-H"/>
		</conditionalStyle>
	</style>
	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<queryString>
		<![CDATA[select * from
(
select
 (case when thutu between 1 and 13 then thutu
      when thutu = 14 then 18
      when thutu = 15 then 24
      when thutu = 16 then 25 end) thutu,
      tt_hienthi,TEN,NVL(to_number(D1),0) MAX_DIEM,
(case when MA in ('CDTT0301','CDTT030106','CDTT030201','CDTT030202','CDTT030203') then ''
     when ma in ('CDTT030101','CDTT030102') then 'phút'
     when ma in ('CDTT030103','CDTT030104','CDTT030105','CDTT030106','CDTT03010601') then '%'
     when ma in ('CDTT03010602','CDTT030203') then 'lỗi' end) DVTINH,D5,NVL(to_number(D10),0) DIEM,D13,NVL(to_number(D12),0) D12,
     case when TT_HIENTHI = 'X' THEN NVL(to_number(D10),0) END  TOTAL_DIEMTT, case when TT_HIENTHI = 'X' THEN NVL(to_number(D12),0) END TOTAL_DIEMLD
     from  DULIEU_NT where MACN <> '999999' and KHOA = 'CDTT_CNTT' and ngaybc = $P{PARA_NGAYBC}
     union all
     select 14, '1.1'TT_HIENTHI,
     'Thực hiện đào tạo, bồi dưỡng cán bộ thường xuyên, 100% cán bộ thuộc đơn vị đáp ứng tốt yêu cầu công việc: 30 điểm' TEN,
     0 MAX_DIEM, '' DVTINH,'' D5,case when NVL(to_number(D10),0) = 30 then NVL(to_number(D10),0) else 0 end DIEM,D13,NVL(to_number(D12),0) D12,
     case when TT_HIENTHI = 'X' THEN NVL(to_number(D10),0) END  TOTAL_DIEMTT, case when TT_HIENTHI = 'X' THEN NVL(to_number(D12),0) END TOTAL_DIEMLD
     from  DULIEU_NT where MACN <> '999999' and KHOA = 'CDTT_CNTT' and ngaybc = $P{PARA_NGAYBC}
     and MA = 'CDTT030201'
     union all
     select 15, '1.2' TT_HIENTHI,
     'Thực hiện đào tạo, bồi dưỡng cán bộ thường xuyên nhưng vẫn có cán bộ chưa đáp ứng được tốt yêu cầu công việc: 25 điểm' TEN,
     0 MAX_DIEM, '' DVTINH,'' D5,case when NVL(to_number(D10),0) = 25 then NVL(to_number(D10),0) else 0 end DIEM,D13,NVL(to_number(D12),0) D12,
     case when TT_HIENTHI = 'X' THEN NVL(to_number(D10),0) END  TOTAL_DIEMTT, case when TT_HIENTHI = 'X' THEN NVL(to_number(D12),0) END TOTAL_DIEMLD
     from  DULIEU_NT where MACN <> '999999' and KHOA = 'CDTT_CNTT' and ngaybc = '30-sep-2019'
      and MA = 'CDTT030201'
      union all
     select 16, '1.3' TT_HIENTHI,
     'Có thực hiện đào tạo, bồi dưỡng cán bộ nhưng không thường xuyên: 15 điểm' TEN,
     0 MAX_DIEM, '' DVTINH,'' D5,case when NVL(to_number(D10),0) = 15 then NVL(to_number(D10),0) else 0 end DIEM,D13,NVL(to_number(D12),0) D12,
     case when TT_HIENTHI = 'X' THEN NVL(to_number(D10),0) END  TOTAL_DIEMTT, case when TT_HIENTHI = 'X' THEN NVL(to_number(D12),0) END TOTAL_DIEMLD
     from  DULIEU_NT where MACN <> '999999' and KHOA = 'CDTT_CNTT' and ngaybc = $P{PARA_NGAYBC}
      and MA = 'CDTT030201'
        union all
     select 17, '1.4' TT_HIENTHI,
     'Không thực hiện đào tạo, bồi dưỡng cán bộ: 0 điểm' TEN,
     0 MAX_DIEM, '' DVTINH,'' D5,case when NVL(to_number(D10),0) = 0 then NVL(to_number(D10),0) else 0 end DIEM,D13,NVL(to_number(D12),0) D12,
     case when TT_HIENTHI = 'X' THEN NVL(to_number(D10),0) END  TOTAL_DIEMTT, case when TT_HIENTHI = 'X' THEN NVL(to_number(D12),0) END TOTAL_DIEMLD
     from  DULIEU_NT where MACN <> '999999' and KHOA = 'CDTT_CNTT' and ngaybc = '30-sep-2019'
      and MA = 'CDTT030201'
     union all
     select 19, '2.1' TT_HIENTHI,
     'Thực hiện tốt : 30 điểm' TEN,
     0 MAX_DIEM, '' DVTINH,'' D5,case when NVL(to_number(D10),0) = 30 then NVL(to_number(D10),0) else NVL(to_number(D10),0) end DIEM,D13,NVL(to_number(D12),0) D12,
     case when TT_HIENTHI = 'X' THEN NVL(to_number(D10),0) END  TOTAL_DIEMTT, case when TT_HIENTHI = 'X' THEN NVL(to_number(D12),0) END TOTAL_DIEMLD
     from  DULIEU_NT where MACN <> '999999' and KHOA = 'CDTT_CNTT' and ngaybc = $P{PARA_NGAYBC}
      and MA = 'CDTT030202'
       union all
     select 20, '2.2' TT_HIENTHI,
     'Tổng Giám đốc nhắc nhở, đã kịp thời khắc phục, sửa chữa: 20 điểm' TEN,
     0 MAX_DIEM, '' DVTINH,'' D5,case when NVL(to_number(D10),0) = 20 then NVL(to_number(D10),0) else 0 end DIEM,D13,NVL(to_number(D12),0) D12,
     case when TT_HIENTHI = 'X' THEN NVL(to_number(D10),0) END  TOTAL_DIEMTT, case when TT_HIENTHI = 'X' THEN NVL(to_number(D12),0) END TOTAL_DIEMLD
     from  DULIEU_NT where MACN <> '999999' and KHOA = 'CDTT_CNTT' and ngaybc = '30-sep-2019'
      and MA = 'CDTT030202'
         union all
     select 21, '2.3' TT_HIENTHI,
     'Tổng Giám đốc nhắc nhở, chưa kịp thời khắc phục sửa chữa: 10 điểm' TEN,
     0 MAX_DIEM, '' DVTINH,'' D5,case when NVL(to_number(D10),0) = 10 then NVL(to_number(D10),0) else 0 end DIEM,D13,NVL(to_number(D12),0) D12,
     case when TT_HIENTHI = 'X' THEN NVL(to_number(D10),0) END  TOTAL_DIEMTT, case when TT_HIENTHI = 'X' THEN NVL(to_number(D12),0) END TOTAL_DIEMLD
     from  DULIEU_NT where MACN <> '999999' and KHOA = 'CDTT_CNTT' and ngaybc = $P{PARA_NGAYBC}
      and MA = 'CDTT030202'
          union all
     select 22, '2.4' TT_HIENTHI,
     'Tổng Giám đốc phê bình bằng văn bản: 0 điểm' TEN,
     0 MAX_DIEM, '' DVTINH,'' D5,case when NVL(to_number(D10),0) = 0 then NVL(to_number(D10),0) else 0 end DIEM,D13,NVL(to_number(D12),0) D12,
     case when TT_HIENTHI = 'X' THEN NVL(to_number(D10),0) END  TOTAL_DIEMTT, case when TT_HIENTHI = 'X' THEN NVL(to_number(D12),0) END TOTAL_DIEMLD
     from  DULIEU_NT where MACN <> '999999' and KHOA = 'CDTT_CNTT' and ngaybc = $P{PARA_NGAYBC}
      and MA = 'CDTT030202'
      ) order by thutu]]>
	</queryString>
	<field name="THUTU" class="java.math.BigDecimal"/>
	<field name="TT_HIENTHI" class="java.lang.String"/>
	<field name="TEN" class="java.lang.String"/>
	<field name="MAX_DIEM" class="java.math.BigDecimal"/>
	<field name="DVTINH" class="java.lang.String"/>
	<field name="D5" class="java.lang.String"/>
	<field name="DIEM" class="java.math.BigDecimal"/>
	<field name="D13" class="java.lang.String"/>
	<field name="D12" class="java.math.BigDecimal"/>
	<field name="TOTAL_DIEMTT" class="java.math.BigDecimal"/>
	<field name="TOTAL_DIEMLD" class="java.math.BigDecimal"/>
	<variable name="TTCHAM" class="java.lang.Number" incrementType="Report" calculation="Sum">
		<variableExpression><![CDATA[$F{DIEM}]]></variableExpression>
	</variable>
	<variable name="DIEM_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TT_HIENTHI}== "X" ?$F{DIEM} : 0]]></variableExpression>
	</variable>
	<variable name="D12_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TT_HIENTHI}== 'X' ? $F{D12} : 0]]></variableExpression>
	</variable>
