<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="CDTT_PLS07" language="groovy" pageWidth="802" pageHeight="595" orientation="Landscape" columnWidth="762" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="4673fe13-575c-4e52-9322-55af43ba4e44">
	<property name="ireport.zoom" value="1.1"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="style1" markup="styled" fontName="Times New Roman" isBold="false" isItalic="false" isUnderline="false" isStrikeThrough="false" pdfEncoding="Identity-H">
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{FONTFORMAT}== '1']]></conditionExpression>
			<style markup="styled" fontName="Times New Roman" isBold="true" isItalic="false" isUnderline="false" isStrikeThrough="false" pdfEncoding="Identity-H"/>
		</conditionalStyle>
	</style>
	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<parameter name="PARA_PHONGBAN" class="java.lang.String"/>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT (SELECT UPPER(TEN) FROM DMTINH WHERE MA=SUBSTR($P{PARA_MAPGD},3,2)) TENTINH,
(SELECT UPPER(GIATRI) FROM DMKHAC WHERE KHOA_1='80' AND KHOA_2=$P{PARA_PHONGBAN})TENPB,A.THUTU,
(case when A.thutu is null then  to_char(ROW_NUMBER () OVER(PARTITION BY A.TT_HIENTHI ORDER BY A.MA)) else A.TT_HIENTHI  end)  TT_HIENTHI,TEN,D1,
to_number(D10) D10,to_number(D12) D12,D13,
GIATRI PHONG_BAN,(case when TT_HIENTHI in ('A','B','I','II','x') then '1' end) FONTFORMAT,
'Tháng '||to_char(ngaybc,'mm')||' năm '||to_char(ngaybc,'yyyy') THANG
   FROM
        DULIEU_NT A,---người nhập
        DMKHAC C -- phòng ban
WHERE KHOA = 'CDTT_CMNV07'
and khoa_1 = 80
and c.THUTU = 81
and D14 = $P{PARA_PHONGBAN}
and D14 = KHOA_2
AND NGAYBC = $P{PARA_NGAYBC}
AND  SUBSTR(MACN,3,2)=SUBSTR($P{PARA_MAPGD},3,2)
ORDER BY MA,THUTU]]>
	</queryString>
	<field name="TENTINH" class="java.lang.String"/>
	<field name="TENPB" class="java.lang.String"/>
	<field name="THUTU" class="java.math.BigDecimal"/>
	<field name="TT_HIENTHI" class="java.lang.String"/>
	<field name="TEN" class="java.lang.String"/>
	<field name="D1" class="java.lang.String"/>
	<field name="D10" class="java.math.BigDecimal"/>
	<field name="D12" class="java.math.BigDecimal"/>
	<field name="D13" class="java.lang.String"/>
	<field name="PHONG_BAN" class="java.lang.String"/>
	<field name="FONTFORMAT" class="java.lang.String"/>
	<field name="THANG" class="java.lang.String"/>
	<variable name="D10_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TT_HIENTHI}=='x'?$F{D10}:0]]></variableExpression>
	</variable>
	<variable name="D12_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TT_HIENTHI}=='x'?$F{D12}:0]]></variableExpression>
	</variable>
	<background>
		<band splitType="Stretch"/>
	</background>
