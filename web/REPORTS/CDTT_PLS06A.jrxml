	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<parameter name="PARA_PHONGBAN" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
to_char(THUTU) tt,
 MA,KHOA,(CASE WHEN TEN IS NOT NULL THEN TEN ELSE D2 END)TEN,THUTU,D2,D3,D4,D5,D6,
DECODE(D7,'Y','Đạt','N','Không đạt','') D7,
DECODE(D8,'Y','Đạt','N','Không đạt','') D8,
DECODE(D9,'Y','Đạt','N','Không đạt','NULL','',D9) D9,
DECODE(D10,'Y','Đạt','N','Không đạt','NULL','',D10)D10,
D12,
D11,FONTFORMAT FROM  DULIEU_NT
WHERE KHOA = 'CDTT_CMNV06A'
and  D14 = $P{PARA_PHONGBAN} and NGAYBC = $P{PARA_NGAYBC} AND  SUBSTR(MACN,3,2)=SUBSTR($P{PARA_MAPGD},3,2)
ORDER BY MA,THUTU]]>
	</queryString>
	<field name="TT" class="java.lang.String"/>
	<field name="MA" class="java.lang.String"/>
	<field name="KHOA" class="java.lang.String"/>
	<field name="TEN" class="java.lang.String"/>
	<field name="THUTU" class="java.math.BigDecimal"/>
	<field name="D2" class="java.lang.String"/>
	<field name="D3" class="java.lang.String"/>
