	</variable>
	<variable name="TOT_PRIN" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{PRINCIPAL_BALANCE}]]></variableExpression>
	</variable>
	<variable name="TOT_INT_PAID" class="java.math.BigDecimal" calculation="Sum">
