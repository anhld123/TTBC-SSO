	<field name="SAVINGS_BAL" class="java.math.BigDecimal"/>
	<variable name="GRP_TOT_PRIN" class="java.math.BigDecimal" resetType="Group" resetGroup="cust_id" calculation="Sum">
		<variableExpression><![CDATA[$F{PRINCIPAL_BALANCE}]]></variableExpression>
	</variable>
