<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ON_BKDC_sub" language="groovy" pageWidth="940" pageHeight="680" orientation="Landscape" columnWidth="940" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MATO" class="java.lang.String"/>
	<queryString>
		<![CDATA[ select distinct KU_MAKH mpi_cust_id,
 KH_TENKH CUSTOMER_NAME,
 KU_MATO GROUP_ID,
 KU_SOKU legacy_id,
 KU_LAI_DT interest_paid,
 KU_DNOTHAN + KU_DNOQHAN +  KU_DNOQHAN principal_balance,
 KU_SPRD_CD specific_product_code,
0 savings_bal
  from hsku a, hskh b , DM_SPRODUCT e
 where a.ku_makh = b.kh_makh
 and KU_TTMONVAY = 'OPEN'
 and KU_DNOTHAN > 0
 and KU_SPRD_CD = e.SP_MA
 and KU_MATO = $P{PARA_MATO}
  -- AND b.sub_prod_cd = '105'
 and KU_NGAYVAY <= KU_NGAYBC
 order by 1]]>
	</queryString>
