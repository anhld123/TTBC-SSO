<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="LEND_06" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="792" leftMargin="30" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT HH_MAPGD MAPGD, MAXA, HH_TENXA TENXA, HH_MATO MATO, HH_TENTT TENTT, HH_TKCASA TK, DUDAU, NVL(HH_TONGTIEN, 0)*2 - NVL(DUDAU, 0) DUCUOI, HH_TONGTIEN DNBQ, HH_SOTIENHH SOTIEN
FROM
    HOAHONG HH,
    (SELECT
            SUBSTR(CS_MADP, 1, 6) MAXA,
            CS_MATO MATO,
            SUM(NVL(DUDAU, 0)) DUDAU,
            SUM(NVL(CS_SODU_TK, 0)) DUCUOI
        FROM CASA AA,
                (
                SELECT CS_SO_TK, NVL(CS_SODU_TK, 0) DUDAU
                FROM CASA
                WHERE CS_MAPGD = $P{PARA_MAPGD}
                    AND CS_SP_TK = '105'
					AND NVL(TRIM(CS_TTSO_TK), 'A') = 'A'
                    AND CS_NGAYBC = LAST_DAY(ADD_MONTHS(TO_DATE($P{PARA_NGAYBC}), -1))
                ) BB
        WHERE AA.CS_SO_TK = BB.CS_SO_TK (+)
            AND CS_SP_TK = '105'
            AND CS_MAPGD = $P{PARA_MAPGD}
            AND CS_NGAYBC = TO_DATE($P{PARA_NGAYBC})
        GROUP BY SUBSTR(CS_MADP, 1, 6), CS_MATO
    ) TK
WHERE TK.MATO = HH_MATO AND HH_FLAG = '3'
ORDER BY HH_MAPGD, MAXA, HH_MATO]]>
	</queryString>
	<field name="MAPGD" class="java.lang.String"/>
	<field name="MAXA" class="java.lang.String"/>
	<field name="TENXA" class="java.lang.String"/>
	<field name="MATO" class="java.lang.String"/>
	<field name="TENTT" class="java.lang.String"/>
	<field name="TK" class="java.lang.String"/>
	<field name="DUDAU" class="java.math.BigDecimal"/>
	<field name="DUCUOI" class="java.math.BigDecimal"/>
	<field name="DNBQ" class="java.math.BigDecimal"/>
	<field name="SOTIEN" class="java.math.BigDecimal"/>
	<variable name="STT" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$V{STT} + 1]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="DUDAU_1" class="java.math.BigDecimal" resetType="Group" resetGroup="XA" calculation="Sum">
		<variableExpression><![CDATA[$F{DUDAU}]]></variableExpression>
	</variable>
	<variable name="DUCUOI_1" class="java.math.BigDecimal" resetType="Group" resetGroup="XA" calculation="Sum">
		<variableExpression><![CDATA[$F{DUCUOI}]]></variableExpression>
	</variable>
	<variable name="DNBQ_1" class="java.math.BigDecimal" resetType="Group" resetGroup="XA" calculation="Sum">
		<variableExpression><![CDATA[$F{DNBQ}]]></variableExpression>
	</variable>
	<variable name="SOTIEN_1" class="java.math.BigDecimal" resetType="Group" resetGroup="XA" calculation="Sum">
