<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="BCDP_53" language="groovy" pageWidth="730" pageHeight="842" whenNoDataType="AllSectionsNoDetail" columnWidth="695" leftMargin="20" rightMargin="15" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.3310000000000008"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="9"/>
	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<parameter name="PARA_MACN" class="java.lang.String"/>
	<queryString language="plsql">
		<![CDATA[select * FROM
(SELECT A.*,B.GIATRI TEN_CT,to_char(to_date($P{PARA_NGAYBC},'DD-MON-YYYY'),'DD/MM/YYYY') ngay_bc FROM
(select   KU_CHTRINH,NVL(count(KU_MAKH),0) SOHOVAY, NVL(SUM(KU_M_GNGAN),0) SOTIENGN, KU_MACN  from hsku
 where  KU_MACN =$P{PARA_MACN}
 and KU_M_LUUVU = 0
 and KU_M_GNGAN > 0
 and KU_M_GNGAN = (KU_DNOTHAN+KU_DNOQHAN +KU_DNOKHOANH)
 AND trunc(KU_NGAYBC)   BETWEEN  TRUNC(TO_DATE( $P{PARA_NGAYBC},'DD-MON-YYYY'),'YEAR')  and trunc(to_date( $P{PARA_NGAYBC},'DD-MM-YYYY'))
 AND trunc(KU_NGAYVAY)   BETWEEN  TRUNC(TO_DATE( $P{PARA_NGAYBC},'DD-MON-YYYY'),'YEAR')  and trunc(to_date( $P{PARA_NGAYBC},'DD-MM-YYYY'))
 group by  KU_CHTRINH, KU_MACN ORDER BY KU_CHTRINH) A, ( SELECT * FROM DMKHAC WHERE KHOA_1 = '07' ) B
 WHERE A.KU_CHTRINH = B.KHOA_2 ) C
LEFT join
 (select KU_MACN,KU_CHTRINH,SUM(KU_M_TNTHAN+KU_M_TNQHAN+KU_M_TNKHOANH) TONG_TN from hsku where KU_MACN = $P{PARA_MACN}
 AND trunc(KU_NGAYBC)   BETWEEN  TRUNC(TO_DATE( $P{PARA_NGAYBC},'DD-MON-YYYY'),'YEAR')  and trunc(to_date( $P{PARA_NGAYBC},'DD-MM-YYYY'))
 AND trunc(KU_NGAYVAY)   BETWEEN  TRUNC(TO_DATE( $P{PARA_NGAYBC},'DD-MON-YYYY'),'YEAR')  and trunc(to_date( $P{PARA_NGAYBC},'DD-MM-YYYY'))
  group by KU_MACN,KU_CHTRINH  order by KU_CHTRINH) D
  on C.KU_MACN =  D.KU_MACN and C.KU_CHTRINH = D.KU_CHTRINH]]>
	</queryString>
	<field name="KU_CHTRINH" class="java.lang.String"/>
	<field name="SOHOVAY" class="java.math.BigDecimal"/>
	<field name="SOTIENGN" class="java.math.BigDecimal"/>
	<field name="KU_MACN" class="java.lang.String"/>
	<field name="TEN_CT" class="java.lang.String"/>
	<field name="NGAY_BC" class="java.lang.String"/>
	<field name="TONG_TN" class="java.math.BigDecimal"/>
	<variable name="SOHOVAY_1" class="java.math.BigDecimal" resetType="Page" calculation="Sum">
		<variableExpression><![CDATA[$F{SOHOVAY}]]></variableExpression>
	</variable>
	<variable name="SOTIENGN_1" class="java.math.BigDecimal" resetType="Page" calculation="Sum">
		<variableExpression><![CDATA[$F{SOTIENGN}]]></variableExpression>
	</variable>
	<variable name="TONG_TN_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TONG_TN}]]></variableExpression>
	</variable>
