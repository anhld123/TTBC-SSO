	<parameter name="PARA_MAPGD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<parameter name="PARA_TONGHOP" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT UT_DVUT DVUT, TEN_DVUT, UT_TINH || UT_HUYEN MAHUYEN, PO_TEN, UT_FLAG,
            SUM(NVL(UT_TONGTIEN, 0)) TONGTIEN,
            SUM(NVL(UT_TONGPHIUT, 0)) TONGPHIUT,
            SUM(NVL(UT_UTXA, 0)) XA,
            SUM(NVL(UT_UTHUYEN, 0)) HUYEN,
            SUM(NVL(UT_UTTINH, 0)) TINH,
            SUM(NVL(UT_UTTW, 0)) TW
FROM PHIUT, DMPOS Y, (SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z,
        (SELECT KHOA_2, GIATRI TEN_DVUT FROM DMKHAC WHERE KHOA_1=17 AND KHOA_2 NOT IN ('10', '20')) B
WHERE '00' || UT_TINH || UT_HUYEN = Y.PO_MA AND UT_DVUT = KHOA_2 AND UT_NGAYBC = TO_DATE($P{PARA_NGAYBC}) AND
            DECODE(Z.PO_POSFLG, 'H', 1, 'S', Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG, 'H', 1, Z.PO_MA) AND
            DECODE($P{PARA_TONGHOP}, 'Y', 1, Y.PO_MA) = DECODE($P{PARA_TONGHOP}, 'Y', 1, '003401') AND UT_FLAG IN ('1', '2')
GROUP BY  UT_DVUT, TEN_DVUT, UT_TINH, UT_HUYEN, PO_TEN, UT_FLAG
ORDER BY UT_DVUT, UT_TINH, UT_HUYEN, UT_FLAG]]>
	</queryString>
