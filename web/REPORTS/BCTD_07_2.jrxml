<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="BCDHTD_07.2" language="groovy" pageWidth="610" pageHeight="900" orientation="Landscape" columnWidth="571" leftMargin="20" rightMargin="19" topMargin="20" bottomMargin="20" uuid="0da75053-0060-4ece-a001-a6ff2eabbbc9">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_TONGHOP" class="java.lang.String"/>
	<parameter name="PARA_DENNGAY" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
	MA_NGDT, NGDT,
	MA_TDDT, TDDT,
	NVL(sum(HSSV_D7)/1000000,0) TONG_DN,
	NVL(sum(HSSV_D16),0) SOHSSV_DN,
	NVL(sum(HSSV_D1)/1000000,0) ST_GN,
	NVL(sum(HSSV_D17),0) SOHSSV_GN,
	NVL(sum(HSSV_D18)/1000000,0) ST_GN_LD,
	NVL(sum(HSSV_D19),0) SOHSSV_GN_LD
FROM (
	SELECT A.KHOA_2	MA_NGDT,
		A.GIATRI NGDT,
		DECODE(B.KHOA_2,'07', '01',B.KHOA_2) MA_TDDT,
		DECODE(B.KHOA_2,'07', 'Đại học',B.GIATRI) TDDT,
		HSSV_D7,
		HSSV_D16,
		HSSV_D1,
		HSSV_D17,
		HSSV_D18,
		HSSV_D19
	FROM (SELECT * FROM DMKHAC WHERE KHOA_1 = '04') A,
		(SELECT * FROM DMKHAC WHERE KHOA_1 = '03') B,
		BCTD_HSSV_TDDT C,
		DMPOS Y,
		(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z
	WHERE
		HSSV_MAPGD = Y.PO_MA
		AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA)
		AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD})
		AND HSSV_TDDT = B.KHOA_2
		AND HSSV_NGDT = A.KHOA_2
		AND HSSV_NGAYBC = TO_DATE ($P{PARA_DENNGAY})
	)
GROUP BY MA_NGDT, NGDT, MA_TDDT, TDDT
ORDER BY MA_NGDT, MA_TDDT]]>
	</queryString>
