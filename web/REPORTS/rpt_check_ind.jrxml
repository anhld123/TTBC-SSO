						<font fontName="Times New Roman" size="10" isBold="true" pdfEncoding="Identity-H"/>
					</textElement>
					<textFieldExpression class="java.lang.String"><![CDATA[$F{POS_CD}+" - " +$F{POS_DESC}]]></textFieldExpression>
				</textField>
