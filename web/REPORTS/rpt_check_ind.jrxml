	<variable name="PV_EOD_DT" class="java.util.Date">
		<variableExpression><![CDATA[new Date($P{PARA_NGAYBC})]]></variableExpression>
	</variable>
	<group name="POS_CD">
		<groupExpression><![CDATA[$F{POS_CD}]]></groupExpression>
