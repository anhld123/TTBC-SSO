	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<queryString>
		<![CDATA[select A.H30A_TINH, B.TEN TENTINH, A.H30A_HUYEN, C.TEN  TENHUYEN,ROUND(SUM(NVL(A.H30A_D1,0))/1000000,2) H30A_D1, ROUND(SUM(NVL(A.H30A_D2,0))/1000000,2) H30A_D2, ROUND(SUM(NVL(A.H30A_D3,0))/1000000,2) H30A_D3, ROUND(SUM(NVL(A.H30A_D4,0))/1000000,2) H30A_D4 , ROUND(SUM(NVL(A.H30A_D5,0))/1000000,2) H30A_D5, ROUND(SUM(NVL(A.H30A_D6,0))/1000000,2) H30A_D6 , ROUND(SUM(NVL(A.H30A_D7,0))/1000000,2) H30A_D7 , ROUND(SUM(NVL(A.H30A_D8,0))/1000000,2) H30A_D8, ROUND(SUM(NVL(A.H30A_D9,0))/1000000,2) H30A_D9, ROUND(SUM(NVL(A.H30A_D10,0))/1000000,2) H30A_D10, ROUND(SUM(NVL(A.H30A_D11,0))/1000000,2) H30A_D11, ROUND(SUM(NVL(A.H30A_D12,0))/1000000,2) H30A_D12, ROUND(SUM(NVL(A.H30A_D13,0))/1000000,2)H30A_D13,
SUM(NVL(A.H30A_D14,0)) H30A_D14,SUM(NVL(A.H30A_D15,0)) H30A_D15, A.H30A_NGAYBC FROM BCTD_HUYEN30A A, DMTINH B, DMHUYEN C WHERE A.H30A_NGAYBC=$P{PARA_NGAYBC} and A.h30a_tinh=B.ma AND A.H30A_TINH = SUBSTR(C.MA,1,2) AND A.H30A_HUYEN = SUBSTR(C.MA,3,2) GROUP BY A.H30A_TINH, A.H30A_HUYEN, B.TEN, A.H30A_NGAYBC, C.TEN order by 1,3]]>
	</queryString>
