<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ON_14_BK_CCNHNQH" language="groovy" printOrder="Horizontal" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<subDataset name="dataset1">
		<parameter name="POS_CD" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT A.PO_TEN PROVINCE , A1.PO_TEN POS_DESC, TO_CHAR(PC_BUSINESS_DT,'DD/MM/YYYY') BUSDT FROM DMPOS A , DMPOS A1 , P_CTRL@report59
WHERE A.PO_MA = A1.PO_MACN AND A1.PO_MA =  $P{POS_CD}]]>
		</queryString>
		<field name="PROVINCE" class="java.lang.String"/>
		<field name="POS_DESC" class="java.lang.String"/>
		<field name="BUSDT" class="java.lang.String"/>
	</subDataset>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<queryString>
		<![CDATA[select distinct ku_mato MPI_GROUP_ID, ku_makh MPI_CUST_ID,
b.kh_tenkh LL_NAME, ku_soku MPI_LEGACY_ID,
TO_CHAR(KU_NGAYCNQH,'DD/MM/YYYY') OVERDUE_MOVE_DT,
KU_PROD_CD MPI_PROD_CD,
KU_CHUYENQH MPF_OVERDUE_AMT
 from hsku a, hskh b, hsto c
where a.ku_makh = b.kh_makh
and a.ku_mapgd = b.kh_mapgd
and a.ku_mato = c.to_mato
and a.ku_mapgd = c.to_mapgd
and KU_CHUYENQH <> '0'
and A.KU_TTMONVAY = 'OPEN'
and ku_mapgd = $P{PARA_MAPGD}
AND NOT EXISTS (SELECT 'X' FROM hsqh WHERE qh_mapgd = ku_mapgd and qh_soku = ku_soku)
order by ku_mato,ku_makh,ku_soku]]>
	</queryString>
	<field name="MPI_GROUP_ID" class="java.lang.String"/>
	<field name="MPI_CUST_ID" class="java.lang.String"/>
	<field name="LL_NAME" class="java.lang.String"/>
	<field name="MPI_LEGACY_ID" class="java.lang.String"/>
	<field name="OVERDUE_MOVE_DT" class="java.lang.String"/>
	<field name="MPI_PROD_CD" class="java.lang.String"/>
	<field name="MPF_OVERDUE_AMT" class="java.math.BigDecimal"/>
	<variable name="TOT_AMT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{MPF_OVERDUE_AMT}]]></variableExpression>
	</variable>
	<variable name="INIT_CUST_ID" class="java.lang.String">
		<variableExpression><![CDATA[$F{MPI_CUST_ID}]]></variableExpression>
		<initialValueExpression><![CDATA[]]></initialValueExpression>
	</variable>
	<variable name="SEC_CUST_ID" class="java.lang.String">
		<variableExpression><![CDATA[$F{MPI_CUST_ID}]]></variableExpression>
		<initialValueExpression><![CDATA[$V{INIT_CUST_ID}]]></initialValueExpression>
	</variable>
	<variable name="TOT_OVERDUE_AMT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{MPF_OVERDUE_AMT}]]></variableExpression>
	</variable>
