	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select distinct KU_MAKH CUSTOMER_CODE,
 KH_TENKH CUSTOMER_NAME,
 KU_SOKU LOAN_CODE,
 KU_NGAYVAY DISBURSAL_DATE,
 KU_NGAYDHAN_1 MATURITY_DATE,
 KU_GNGAN  DISB_AMT,
 KU_DNOTHAN PRIN_BALANCE,
 KU_DNOQHAN OVERDUE_BALANCE,
 KU_DNOKHOANH FREEZE_BALANCE,
 KU_TON_RPA RPA_BALANCE,
 KU_A_LAI_DT INT_DUE_BALANCE,
 KU_NGAYGDGN LAST_TRAN_DATE,
 C.MA COMMUNE_ID,
 C.TEN COMMUNE_NAME,
 KU_SPRD_CD SPEC_CD,
 e.SP_TEN SPEC_DESC
  from hsku a, hskh b , dmxa c, dmthon d , DM_SPRODUCT e
 where a.ku_makh = b.kh_makh
 and b.KH_MADP = d.MA
 and c.ma = d.xa
 and KU_MAPGD = $P{PARA_MAPGD}
 and KU_TTMONVAY = 'OPEN'
 and KU_DNOTHAN > 0
 and KU_SPRD_CD = e.SP_MA
 order by KU_SPRD_CD, C.MA,KU_SOKU]]>
	</queryString>
