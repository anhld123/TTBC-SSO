<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="RR_06XLN_NVQ" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["D:\\2. Bao cao\\1. Rui ro\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="POS_CD" class="java.lang.String"/>
	<parameter name="FROM_DT" class="java.lang.String"/>
	<parameter name="TO_DT" class="java.lang.String"/>
	<parameter name="CONS_FLAG" class="java.lang.String"/>
	<queryString language="plsql">
		<![CDATA[SELECT NVL (A.LOAN_PROGRAM_DESC, B.LOAN_PROGRAM_DESC) CT_DN,
                  B.LOAN_PROGRAM_DESC CT_CN,
                  NVL (A.POS_DESCRIPTION, B.POS_DESCRIPTION) POS_DN,
                  B.POS_DESCRIPTION POS_CN,
                  NVL (A.COL5_CNT, 0) + NVL (B.COL5_CNT, 0) SOHO_DN,
                  NVL (B.COL5_CNT, 0) SOHO_CN,
                  NVL (A.COL6_AMT, 0) + NVL (B.COL6_AMT, 0) SOTIEN_DN,
                  NVL (B.COL6_AMT, 0) SOTIEN_CN
             FROM    ( SELECT UPPER (PCS_CRDT_SCHCD_DESC) LOAN_PROGRAM_DESC,
                               POS_DESC POS_DESCRIPTION,
                               COUNT (NVL (MPI_CUST_ID, 0)) COL5_CNT,
                               SUM (NVL (MRIA_PRIN_AMT, 0)) COL6_AMT
                          FROM M_PROJ_INFO A,
                               M_RISK_INFO_ADV C,
                               P_CREDIT_SCHEME D,
                               PO850MB Y,
                               (SELECT POS_FLAG, MAIN_POS, POS_CD
                                  FROM PO850MB
                                 WHERE POS_CD = $P{POS_CD}) Z
                         WHERE     MPI_CUST_ID = MRIA_CUST_ID
                               AND MPI_CON_ID = MRIA_CON_ID
                               AND MPI_PROJ_ID = MRIA_PROJ_ID
                               AND MPI_CRDT_SCH_CD = PCS_CRDT_SCHCD
                               AND MPI_PROD_CD = PCS_CRDT_SCHCD_PRDCD
                               AND MRIA_STATUS IN ('MR', 'AN')
                               AND MRIA_AUTH_ID2 IS NOT NULL
                               AND MRIA_AUTH_ID3 IS NOT NULL
                               AND MRIA_RISK_TYPE = 'EXTENSION'
                               AND MRIA_AUTH_POS_FLAG = (select POS_FLAG from PO850mb where POS_CD =$P{POS_CD})
                               AND MPI_ORG_POS_CD = Y.POS_CD
                               AND MRIA_AUTH_DT3 >= $P{FROM_DT}
                               AND MRIA_AUTH_DT3 <= $P{TO_DT}
                               AND DECODE (Z.POS_FLAG,
                                           'H', 1,
                                           'S', Y.POS_CD,
                                           Y.MAIN_POS) =
                                      DECODE (Z.POS_FLAG, 'H', 1, Z.POS_CD)
                               AND DECODE ('Y', $P{CONS_FLAG}, 1, Y.POS_CD) =
                                      DECODE ('Y', $P{CONS_FLAG}, 1, $P{POS_CD})
                      GROUP BY PCS_CRDT_SCHCD_DESC, POS_DESC) A
                  FULL OUTER JOIN
                     (  SELECT UPPER (PCS_CRDT_SCHCD_DESC) LOAN_PROGRAM_DESC,
                               POS_DESC POS_DESCRIPTION,
                               COUNT (NVL (MPI_CUST_ID, 0)) COL5_CNT,
                               SUM (NVL (MRIA_PRIN_AMT, 0)) COL6_AMT
                          FROM M_PROJ_INFO A,
                               M_RISK_INFO_ADV C,
                               P_CREDIT_SCHEME D,
                               PO850MB Y,
                               (SELECT POS_FLAG, MAIN_POS, POS_CD
                                  FROM PO850MB
                                 WHERE POS_CD = $P{POS_CD}) Z
                         WHERE     MPI_CUST_ID = MRIA_CUST_ID
                               AND MPI_CON_ID = MRIA_CON_ID
                               AND MPI_PROJ_ID = MRIA_PROJ_ID
                               AND MPI_CRDT_SCH_CD = PCS_CRDT_SCHCD
                               AND MPI_PROD_CD = PCS_CRDT_SCHCD_PRDCD
                               AND MRIA_STATUS IN ('AR')
                               AND MRIA_RISK_TYPE = 'EXTENSION'
                               AND MRIA_AUTH_POS_FLAG = (select POS_FLAG from PO850mb where POS_CD =$P{POS_CD})
                               AND MPI_ORG_POS_CD = Y.POS_CD
                               AND MRIA_AUTH_DT3 >= $P{FROM_DT}
                               AND MRIA_AUTH_DT3 <= $P{TO_DT}
                               AND DECODE (Z.POS_FLAG,
                                           'H', 1,
                                           'S', Y.POS_CD,
                                           Y.MAIN_POS) =
                                      DECODE (Z.POS_FLAG, 'H', 1, Z.POS_CD)
                               AND DECODE ('Y', $P{CONS_FLAG}, 1, Y.POS_CD) =
                                      DECODE ('Y', $P{CONS_FLAG}, 1, $P{POS_CD})
                      GROUP BY PCS_CRDT_SCHCD_DESC, POS_DESC) B
                  ON A.LOAN_PROGRAM_DESC = B.LOAN_PROGRAM_DESC
                     AND A.POS_DESCRIPTION = B.POS_DESCRIPTION
         ORDER BY ct_dn, pos_dn]]>
	</queryString>
	<field name="CT_DN" class="java.lang.String"/>
	<field name="CT_CN" class="java.lang.String"/>
