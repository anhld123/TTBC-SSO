		<![CDATA[select 'Giá trị còn lại của TSCĐ hữu hình tạm thời không được sử dụng vào sản suất kinh doanh' b1 from dual
union
select 'Nguyên giá TSCĐ hữu hình đã khấu hao hết nhưng vẫn còn sử dụng' b1  from dual
union
select 'Giá trị còn lại của TSCĐ hữu hình đang chờ thanh lý' b1 from dual
union
select 'Các thay đổi khác' b1 from dual]]>
	</queryString>
