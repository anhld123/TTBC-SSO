				</textElement>
				<text><![CDATA[3- Mức phí quản lý được hưởng: ……….]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="5447964a-65a9-4be5-8297-7d2ec2485964" x="0" y="73" width="700" height="18"/>
