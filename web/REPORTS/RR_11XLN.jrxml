<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="RR_11XLN" language="groovy" pageWidth="652" pageHeight="930" columnWidth="612" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.331000000000001"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["D:\\2. Bao cao\\1. Rui ro\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_MACN" class="java.lang.String"/>
	<parameter name="PARA_TONGHOP" class="java.lang.String"/>
	<parameter name="PARA_DOTRR" class="java.lang.String"/>
	<parameter name="PARA_NAM" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT DISTINCT
        E.TEN RES_CITY,
        KH_MAKH CUSTOMER_ID,
        KH_TENKH CUSTOMER_NAME,
        G.TEN DISTRICT_ADDRESS,
        H.TEN CUSTOMER_ADDRESS,
        RR_SOKU LOAN_ID,
         NVL(RR_GOCDN,0) + NVL(RR_LAIDN,0) PRIN_INT_AMT,
         NVL(RR_GOCDN,0) PRIN_AMT,
         NVL(RR_LAIDN,0) INT_AMT,
         TO_CHAR(RR_NGAYDN,'DD/MM/YYYY') RISK_DT,
         NVL(RR_SOTHGDN,0) EXTENSION_MONTHS,
     CASE
            WHEN RR_SOTHGDN <=36 THEN 1
       ELSE 2
       END FREEZE_GRP,
       CASE
            WHEN RR_SOKU IN (SELECT RR_SOKU FROM HSRR WHERE RR_TTDUYET = 2  GROUP BY RR_SOKU HAVING COUNT (RR_SOKU) > 1) THEN 2
       ELSE 1
       END FREEZE_TIMES,
     KU_CHTRINH LOAN_PROGRAM,
     GIATRI LOAN_PROGRAM_DESC,
     '01' MRIA_DECISION_NO,
     '03/04/2014' MRIA_DECISION_DT
       FROM (SELECT DISTINCT * FROM HSKU) A,
       HSKH B,
       HSRR C,
       (SELECT * FROM DMKHAC WHERE KHOA_1 = '07') D,
       DMTINH E,
       DMHUYEN G,
       DMXA H,
       PO850MB Y,
       (SELECT POS_FLAG, MAIN_POS, POS_CD FROM PO850MB WHERE POS_CD = $P{PARA_MACN}) Z
       WHERE
               RR_SOKU= KU_SOKU
         AND KU_MAKH = KH_MAKH
         AND KU_MAPGD = KH_MAPGD
         AND RR_MAPGD = KU_MAPGD
         AND KU_CHTRINH = KHOA_2
         AND RR_MACN = $P{PARA_MACN}
        AND SUBSTR(KU_MADP,1,6) = H.MA
         AND SUBSTR(RR_MAPGD,3,6) = G.MA
          AND SUBSTR(RR_MAPGD,3,2) = E.MA
      --     and KU_MADP = E.ma
          AND RR_TTDUYET = 2
       AND RR_NHOMNO ='03'
       AND RR_DOT = $P{PARA_DOTRR}
        ORDER BY  E.TEN,FREEZE_GRP,FREEZE_TIMES,LOAN_PROGRAM_DESC, H.TEN,CUSTOMER_ID]]>
	</queryString>
