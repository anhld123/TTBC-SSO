	<field name="STT" class="java.lang.String"/>
	<field name="TENPB" class="java.lang.String"/>
	<field name="DL_TL" class="java.math.BigDecimal"/>
	<field name="DL_DIEM" class="java.math.BigDecimal"/>
	<field name="TDHTCV_TL" class="java.math.BigDecimal"/>
