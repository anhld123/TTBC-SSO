<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="CDTT_PLS07_TH" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="841b338f-3784-418e-aaaf-2342f905d33c">
	<property name="ireport.zoom" value="1.331000000000002"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="112"/>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<queryString>
		<![CDATA[select
(SELECT UPPER(TEN) FROM DMTINH WHERE MA=SUBSTR(MACN,3,2)) TENTINH,
substr(D14,-1,1) STT,
(SELECT GIATRI FROM DMKHAC WHERE KHOA_1='80' AND KHOA_2=D14)TENPB,
sum(case when KHOA = 'CDTT_CMNV07' and TT_HIENTHI = 'I' then D9 end) DL_TL,
sum(case when KHOA = 'CDTT_CMNV07' and TT_HIENTHI = 'I' then D10 end) DL_DIEM,
sum(case when KHOA = 'CDTT_CMNV06A' and thutu = 1 then D10 end )/2 TDHTCV_TL,
sum(case when KHOA = 'CDTT_CMNV07' and MA = '400004' then D10 end) TDHTCV_DIEM,
sum(case when KHOA = 'CDTT_CMNV06A' and thutu = 2 then D10 end )/2 CLHTCV_TL,
sum(case when KHOA = 'CDTT_CMNV07' and MA = '500005' then D10 end) CLHTCV_DIEM,
sum(case when KHOA = 'CDTT_CMNV07' and MA = '700007' and D10 = 30 then D10 end) BDCB_1,
sum(case when KHOA = 'CDTT_CMNV07' and MA = '700007' and D10 = 25 then D10 end) BDCB_2,
sum(case when KHOA = 'CDTT_CMNV07' and MA = '700007' and D10 = 15 then D10 end) BDCB_3,
sum(case when KHOA = 'CDTT_CMNV07' and MA = '700007' and D10 = 0 then D10 end) BDCB_4,
sum(case when KHOA = 'CDTT_CMNV07' and MA = '800008' and D10 = 30 then D10 end) PHCV_1,
sum(case when KHOA = 'CDTT_CMNV07' and MA = '800008' and D10 = 25 then D10 end) PHCV_2,
sum(case when KHOA = 'CDTT_CMNV07' and MA = '800008' and D10 = 15 then D10 end) PHCV_3,
sum(case when KHOA = 'CDTT_CMNV07' and MA = '800008' and D10 = 0 then D10 end) PHCV_4,
sum(case when KHOA = 'CDTT_CMNV07' and MA = '900009' and D10 = 40 then D10 end) NQLD_MAX_DIEM,
sum(case when KHOA = 'CDTT_CMNV07' and MA = '900009' and D10 < 40 then (40- D10)/2 end) NQLD_LOI,
sum(case when KHOA = 'CDTT_CMNV07' and MA = '900009' and D10 < 40 then (40- D10) end) NQLD_TRU,
sum(case when KHOA = 'CDTT_CMNV07' and MA = '900009' and D10 < 40 then D10 end) NQLD_DIEM,
sum(case when KHOA = 'CDTT_CMNV07' and MA = '990010'  then D10 end) TOTAL_DIEM_PB,
(CASE when  sum(case when KHOA = 'CDTT_CMNV07' and MA = '990010' then D10 end ) > 450 then 'Loại A'
      when  sum(case when KHOA = 'CDTT_CMNV07' and MA = '990010' then D10 end ) > 400
            and sum(case when KHOA = 'CDTT_CMNV07' and MA = '990010' then D10 end ) <= 450 then 'Loại B'
      when  sum(case when KHOA = 'CDTT_CMNV07' and MA = '990010' then D10 end ) > 350
            and sum(case when KHOA = 'CDTT_CMNV07' and MA = '990010' then D10 end ) <= 400 then 'Loại C'
      when  sum(case when KHOA = 'CDTT_CMNV07' and MA = '990010' then D10 end ) <= 350 then 'Loại D'
      END) XEP_LOAI_PB,
sum(case when KHOA = 'CDTT_CMNV07' and MA = '990010'  then D17 end) TOTAL_DIEM_HD,
(CASE when  sum(case when KHOA = 'CDTT_CMNV07' and MA = '990010' then D17 end ) > 450 then 'Loại A'
      when  sum(case when KHOA = 'CDTT_CMNV07' and MA = '990010' then D17 end ) > 400
            and sum(case when KHOA = 'CDTT_CMNV07' and MA = '990010' then D17 end ) <= 450 then 'Loại B'
      when  sum(case when KHOA = 'CDTT_CMNV07' and MA = '990010' then D17 end ) > 350
            and sum(case when KHOA = 'CDTT_CMNV07' and MA = '990010' then D10 end ) <= 400 then 'Loại C'
      when  sum(case when KHOA = 'CDTT_CMNV07' and MA = '990010' then D17 end ) <= 350 then 'Loại D'
      END) XEP_LOAI_HD
from DULIEU_NT
where mapgd = $P{PARA_MAPGD} and ngaybc = $P{PARA_NGAYBC} and khoa in( 'CDTT_CMNV07','CDTT_CMNV06A') AND MACN = $P{PARA_MAPGD}
group by MACN,D14 order by D14]]>
	</queryString>
