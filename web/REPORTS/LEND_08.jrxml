<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="LEND_08" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="807" leftMargin="20" rightMargin="15" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.2078825000000006"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_NGAY" class="java.lang.String"/>
	<queryString>
		<![CDATA[select * from (
SELECT KU_MANDT,
       DT_TYLETH,
       SUM (KU_LAI_TT) laidt,
       SUM (ROUND (KU_LAI_TT * DT_TYLETH / 100, 0)) SOTIEN,
       KU_MAPGD,
       DT_TENDT,
       DT_DTTH,
       DT_TK_NO,
       DT_TK_CO,
     KU_NGAYBC as BUSDT
FROM
(SELECT A.KU_MANDT,
        A.KU_LAI_TT,
        A.KU_MAPGD,
        A.KU_NGAYBC,
        B.DT_TENDT,
        B.DT_DTTH,
        B.DT_TYLETH,
        B.DT_TK_NO,
        B.DT_TK_CO
       FROM HSKU A, HSDT B
WHERE A.KU_MANDT = B.DT_MADT
AND A.KU_MAPGD = B.DT_MAPGD
AND  A.KU_NGAYBC =  TO_DATE($P{PARA_NGAY})
AND A.KU_MAPGD = $P{PARA_MAPGD})
GROUP BY DT_TYLETH,KU_MANDT,DT_TENDT,DT_DTTH,DT_TK_NO,DT_TK_CO ,KU_MAPGD,KU_NGAYBC)
WHERE  laidt > 0  ORDER BY 1,5,7]]>
	</queryString>
