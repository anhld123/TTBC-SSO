<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="KHTD_XA_NGUONVON" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="9ef5cb36-fa64-43de-9c4d-5947a4cd1c59">
	<property name="ireport.zoom" value="1.2100000000000006"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["D:\\02. Official dispatch of IT\\04. CHI TIEU\\XD chi tieu thon xa\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[/* Formatted on 16/11/2016 1:21:39 PM (QP5 v5.252.13127.32847) */
select a.*,nvl(B.KH_DUNO,0) KH_DUNO, (NVL(B.KH_DUNO,0) - NVL(A.TONGDN,0) ) CHENH_LECH
from (
(  SELECT MACN,MAPGD,D1 NGUONVON,
         SUBSTR (MADP, 1, 6) MADP,
         TEN,
         D15 MAQD,
         GIATRI,
         NVL(SUM (D9),0)/1000000 DSCV,
         SUM (D6 + D7 + D8)/1000000 DSTN,
         SUM (D13)/1000000 DSCV_LK,
         SUM (D10 + D11 + D12)/1000000 DSTN_LK,
         SUM (D3 + D4 + D5)/1000000 TONGDN,
         SUM (D4)/1000000 NOQH,
         SUM (D5)/1000000 NOKHOANH,
            SUM(D16) SOKH_DN
    FROM BCTD_DAILY,
         (SELECT KHOA_2, GIATRI
            FROM DMKHAC
           WHERE KHOA_1 = '07'),
         (SELECT *
            FROM DMXA
           WHERE PGD_QL = $P{PARA_MAPGD})
   WHERE     KHOA = 'BCTD_CHTRINH'
         AND NGAYBC = $P{PARA_NGAYBC}
         AND MAPGD = $P{PARA_MAPGD}
         AND D15 = KHOA_2
         AND SUBSTR (MADP, 1, 6) = MA
GROUP BY MACN,MAPGD,SUBSTR (MADP, 1, 6),
         TEN,
         D1,
         D15,
         GIATRI
ORDER BY SUBSTR (MADP, 1, 6), D1, D15) A
left join
  (SELECT KH_MAPGD,
         (CASE WHEN SUBSTR (KH_MA_DD, 4, 1) = 'A' THEN 1 ELSE 2 END) NGUONVON,
         KH_MAQD,
         SUM (CASE WHEN KH_LOAI_NV = 'XDKH_XA' THEN KH_KH_NAM END) KH_DUNO
    FROM KHNV
   WHERE     SUBSTR ( $P{PARA_MAPGD}, 3, 4) = SUBSTR (KH_MAPGD, 1, 4)
         AND KH_MAQD IS NOT NULL
         AND KH_NAMBC = TO_CHAR (TO_DATE ( $P{PARA_NGAYBC}, 'DD-MON-YYYY'), 'YYYY')
GROUP BY KH_MAPGD,
         (CASE WHEN SUBSTR (KH_MA_DD, 4, 1) = 'A' THEN 1 ELSE 2 END),
         KH_MAQD
ORDER BY KH_MAPGD,
         (CASE WHEN SUBSTR (KH_MA_DD, 4, 1) = 'A' THEN 1 ELSE 2 END),
         KH_MAQD) B
ON A.MADP = trim(B.KH_MAPGD) and trim(A.NGUONVON) = trim(B.NGUONVON) and  trim(A.MAQD) = trim(B.KH_MAQD) )
order by A.MADP,A.NGUONVON,A.MAQD]]>
	</queryString>
