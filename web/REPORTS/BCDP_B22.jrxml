	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_TONGHOP" class="java.lang.String"/>
	<parameter name="PARA_DENNGAY" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["F:\\Trang's work\\2014\\04.2014\\Thiet ke report_TTBC tuong lai\\REPORTS\\"]]></defaultValueExpression>
	</parameter>
	<queryString language="plsql">
		<![CDATA[SELECT  KU_MAKH MAKH,
        KH_TENKH TENKH,
        KU_SOKU SOKU,
        KU_MATO MATO,
        TO_TENTT TENTT,
        SUBSTR(TO_MADP, 1, 6) MAXA,
        D.TEN TENXA,
        SUBSTR(TO_MAPGD, 3, 4) MAHUYEN,
        C.TEN TENHUYEN,
        TO_CHAR(KU_NGAYVAY,'DD/MM/YYYY') NGAYVAY,
        TO_CHAR(KU_NGAYDHAN_3,'DD/MM/YYYY') NGAYDHAN,
        KU_SCHEM_CD SCHEM_CD,
        B.SC_TENVT CHTRINH,
        TO_CHAR(KU_NGAYCNQH,'DD/MM/YYYY') NGAYCNQH,
        KU_GNGAN GNGAN,
        KU_DNOTHAN+KU_DNOQHAN+KU_DNOKHOANH DUNO,
        KU_DNOQHAN DNOQHAN,
        KU_LAITONTHAN+KU_LAITONQHAN LAITON
FROM 	hsku,
        hsto,
        hskh,
        DM_SCHEME B,
        DMHUYEN C,
        DMXA D
WHERE 	SUBSTR(TO_MADP, 1, 6) = D.MA
		AND SUBSTR(TO_MAPGD, 3, 4) = C.MA
		AND KU_SCHEM_CD = B.SC_MA
		AND KU_MAKH = KH_MAKH
		AND KU_MATO = TO_MATO
		AND DECODE($P{PARA_TONGHOP},'Y',SUBSTR(TO_MAPGD,3,2),SUBSTR(TO_MAPGD,3,4))
			= DECODE($P{PARA_TONGHOP},'Y',SUBSTR($P{PARA_MAPGD},3,2),SUBSTR($P{PARA_MAPGD},3,4))
		AND KU_DNOQHAN >0
		AND KU_PROD_CD NOT IN ('P00A01', 'P00A02')
		AND TRUNC (KU_NGAYBC) =
				(SELECT MAX (TRUNC (A.KU_NGAYBC))
					FROM hsku A
					WHERE A.KU_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY})))
ORDER BY MAXA, MATO, MAKH, SOKU]]>
	</queryString>
