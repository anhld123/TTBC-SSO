<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="TT21_16B" language="groovy" pageWidth="1190" pageHeight="842" orientation="Landscape" columnWidth="1150" leftMargin="20" rightMargin="20" topMargin="30" bottomMargin="20">
	<property name="ireport.zoom" value="1.4615378250000015"/>
	<property name="ireport.x" value="1024"/>
	<property name="ireport.y" value="302"/>
	<parameter name="PARA_NGAYBC" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString language="plsql">
		<![CDATA[SELECT A.*,B.*, NVL((SELECT  NVL(CT_GIATRI,0) LAI_NN FROM CT_SBV WHERE CT_MACT = '3A41100' AND CT_NGAYBC =$P{PARA_NGAYBC}),0) LAI_NN,
NVL((SELECT NVL(CT_GIATRI,0) LAI_TDHAN FROM CT_SBV WHERE CT_MACT = '3A41000' AND CT_NGAYBC =$P{PARA_NGAYBC}),0) LAI_TDHAN FROM
(select 1 STT,sum(decode(substr(CT_MACT,4,1),1,CT_GIATRI,0)) S08_NGANHAN,sum(decode(substr(CT_MACT,4,1),1,0,CT_GIATRI)) S08_TDHAN ,sum(CT_GIATRI) S08_TONGDN
from ct_vbsp a where CT_CAPTH ='H' and CT_MACN ='000100'
        and trunc(CT_NGAYBC) = $P{PARA_NGAYBC}
        and CT_MACT like '1A1%'
        and substr(CT_MACT,6,2) = '08' ) A,
(select 1 STT,sum(decode(substr(CT_MACT,4,1),1,CT_GIATRI,0)) ALL_NGANHAN,sum(decode(substr(CT_MACT,4,1),1,0,CT_GIATRI)) ALL_TDHAN ,sum(CT_GIATRI) ALL_TONGDN
from ct_vbsp a where CT_CAPTH ='H' and CT_MACN ='000100'
        and trunc(CT_NGAYBC) = $P{PARA_NGAYBC}
        and CT_MACT like '1A1%') B]]>
	</queryString>
	<field name="STT" class="java.math.BigDecimal"/>
	<field name="S08_NGANHAN" class="java.math.BigDecimal"/>
	<field name="S08_TDHAN" class="java.math.BigDecimal"/>
	<field name="S08_TONGDN" class="java.math.BigDecimal"/>
	<field name="ALL_NGANHAN" class="java.math.BigDecimal"/>
	<field name="ALL_TDHAN" class="java.math.BigDecimal"/>
	<field name="ALL_TONGDN" class="java.math.BigDecimal"/>
	<field name="LAI_NN" class="java.lang.String"/>
	<field name="LAI_TDHAN" class="java.lang.String"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="97" splitType="Stretch">
			<staticText>
				<reportElement x="193" y="23" width="806" height="37"/>
				<textElement textAlignment="Center" verticalAlignment="Bottom">
					<font fontName="Times New Roman" size="14" isBold="true" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[BÁO CÁO DƯ NỢ TÍN DỤNG, ĐẦU TƯ TRÁI PHIẾU CHO DOANH NGHIỆP,CHO VAY, ĐẦU TƯ THEO
HỢP ĐỒNG NHẬN ỦY THÁC VÀ LÃI SUẤT CHO VAY ĐỐI VỚI NHỮNG LĨNH VỰC HỖ TRỢ ƯU TIÊN PHÁT TRIỂN
]]></text>
			</staticText>
