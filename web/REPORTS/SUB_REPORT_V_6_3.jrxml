<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="SUB_REPORT_V_6_3" language="groovy" pageWidth="555" pageHeight="802" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_TONGHOP" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_NGAYBC" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT A.DESCRIPT, A.ACCOUNT, A.FIRST_PRE_AMT, A.LAST_PRE_AMT,ABS(A.FIRST_PRE_AMT) FIRST_PRE_AMT_ABS,ABS(A.LAST_PRE_AMT) LAST_PRE_AMT_ABS FROM
((SELECT 'Nợ ngắn hạn' DESCRIPT,'DN: TK 211, 251, 291, 252107, 252111, 252113, 252151, 252407, 252411, 252413, 252451, 253, 27.' ACCOUNT,
(SELECT SUM(LCY_OPEN_DR) FIRST_PRE_AMT FROM(
SELECT GL_DD_NO LCY_OPEN_dR
  FROM GL_VBSP, DMPOS Y,(SELECT PO_POSFLG, PO_MA, PO_MACN
                FROM DMPOS
               WHERE PO_MA = $P{PARA_MAPGD}) Z
 WHERE     GL_TK LIKE '9131%'
       AND GL_MAPGD = Y.PO_MA
       AND GL_NGAYBC = ADD_MONTHS ( $P{PARA_NGAYBC}, -12)
       AND DECODE (Z.PO_POSFLG,  'H', 1,  'S', Y.PO_MA,  Y.PO_MACN) =
            DECODE (Z.PO_POSFLG, 'H', 1, Z.PO_MA)
       AND DECODE ('Y', $P{PARA_TONGHOP}, 1, Y.PO_MA) =
            DECODE ('Y', $P{PARA_TONGHOP}, 1, $P{PARA_MAPGD})
UNION
SELECT GL_DD_NO LCY_OPEN_dR
  FROM GL_VBSP, DMPOS Y,(SELECT PO_POSFLG, PO_MA, PO_MACN
                FROM DMPOS
               WHERE PO_MA = $P{PARA_MAPGD}) Z
 WHERE     GL_TK LIKE '9141%'
       AND GL_MAPGD = Y.PO_MA
       AND GL_NGAYBC = ADD_MONTHS ( $P{PARA_NGAYBC}, -12)
       AND DECODE (Z.PO_POSFLG,  'H', 1,  'S', Y.PO_MA,  Y.PO_MACN) =
            DECODE (Z.PO_POSFLG, 'H', 1, Z.PO_MA)
       AND DECODE ('Y', $P{PARA_TONGHOP}, 1, Y.PO_MA) =
            DECODE ('Y', $P{PARA_TONGHOP}, 1, $P{PARA_MAPGD})
UNION
