					<font fontName="Times New Roman" size="11" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[Báo cáo quyết toán số cấp bù chênh lệch lãi suất và chi phí quản lý; Báo cáo
]]></text>
			</staticText>
