					<font fontName="Times New Roman" size="11" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[Về cơ bản NHCSXH tuân thủ các chuẩn mực kế toán Việt Nam ngoại trừ chuẩn mực doanh

]]></text>
			</staticText>
