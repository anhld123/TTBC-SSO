					<font fontName="Times New Roman" size="11" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[là kế toán bằng máy vi tính.

]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="714f60f9-d9a2-4934-80bb-4e02856a69f3" x="14" y="195" width="86" height="17"/>
