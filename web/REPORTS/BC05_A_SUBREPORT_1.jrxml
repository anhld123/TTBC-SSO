				<text><![CDATA[II - Kỳ kế toán, đơn vị tiền tệ sử dụng trong kế toán]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="449f6ca4-e50a-479e-b5a2-a897a5e7ddf9" x="14" y="42" width="377" height="36"/>
