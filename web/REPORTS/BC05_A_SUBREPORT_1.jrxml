				</textElement>
				<text><![CDATA[   - Hợp nhất báo cáo:

]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="2ebd10a6-7d9b-4822-9a7c-9245471bf2b4" x="14" y="138" width="144" height="14"/>
				<textElement>
					<font fontName="Times New Roman" size="11" isBold="true" isItalic="true" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[   - Hình thức kế toán áp dụng:

]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="61e98e97-3066-4e72-a91e-0d0bd36b043b" x="14" y="226" width="534" height="17"/>
				<textElement textAlignment="Justified">
					<font fontName="Times New Roman" size="11" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[quyết toán quỹ tiền lương và các biên bản kiểm tra (có phát hiện sai sót về hạch toán kế toán).
]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="716033c9-e4b7-4634-aac4-467fa843358b" x="14" y="124" width="534" height="15"/>
				<textElement textAlignment="Justified">
					<font fontName="Times New Roman" size="11" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[thu và chuẩn mực chi phí (Dự phòng rủi ro).]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="5856e9f6-4417-457c-8a09-00451a395b8e" x="14" y="151" width="534" height="17"/>
				<textElement textAlignment="Justified">
					<font fontName="Times New Roman" size="11" isBold="true" isItalic="true" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[   - Các cơ sở đánh giá được sử dụng trong quá trình lập BCTC và các ước tính kế toán quan trọng:]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="8c943184-4c3a-4ea2-a039-ef51b0fe5c36" x="114" y="195" width="434" height="17"/>
				<textElement textAlignment="Justified">
					<font fontName="Times New Roman" size="11" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[NHCSXH không có

]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="cbe5c188-3f5a-48af-b43e-6c8198fa5faa" x="14" y="242" width="295" height="15"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" isBold="true" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[IV - Chính sách kế toán áp dụng tại tổ chức tín dụng]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="7af6b060-920a-462f-a511-41ed0906b2e7" x="14" y="427" width="534" height="16"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[tính và hạch toán, lãi vẫn được chi trả
]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="53c5174d-0fc3-41da-b025-656fb23e0205" x="14" y="470" width="534" height="49" isRemoveLineWhenBlank="true"/>
				<box leftPadding="1" rightPadding="1"/>
				<textElement textAlignment="Justified">
					<font fontName="Times New Roman" size="11" pdfEncoding="Identity-H"/>
					<paragraph lineSpacing="Proportional" lineSpacingSize="1.3"/>
				</textElement>
				<text><![CDATA[   - Nguyên tắc ghi nhận khoản vay: Theo giá gốc.
    + Các khoản cho vay được thể hiện trong BCTC là số nợ gốc trừ đi bất kỳ các khoản dự phòng khó đòi nào.
   - Các nguyên tắc phân loại nợ và đánh giá rủi ro tín dụng: Nợ bị rủi ro của NHCSXH bao gồm các loại sau:
   ]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="01f8aee6-a88a-4db1-946a-b19e87ee2798" x="14" y="396" width="534" height="17"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[   - Kế toán chi phí lãi: Theo phương pháp dự chi, là việc tính và hạch toán dần vào tài khoản chi phí theo định ]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="a75fbc06-06bc-46d5-90c0-91402bc44148" x="232" y="442" width="316" height="15"/>
				<textElement>
					<font fontName="Times New Roman" size="11" isBold="false" isItalic="false" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[Theo số phí và hoa hồng thực thu.]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="58fea0cf-3a7a-4f7f-9314-348bbfbf8d73" x="14" y="456" width="253" height="15"/>
				<textElement>
					<font fontName="Times New Roman" size="11" isBold="true" isItalic="true" isUnderline="false" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[   6. Kế toán đối với cho vay khách hàng]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="edb5e18e-bf05-4cbd-9f3c-3f015d5e7892" x="14" y="336" width="534" height="47"/>
				<textElement>
					<font fontName="Times New Roman" size="11" isBold="true" isItalic="true" pdfEncoding="Identity-H"/>
					<paragraph lineSpacing="Proportional" lineSpacingSize="1.3"/>
				</textElement>
				<text><![CDATA[    2. Nguyên tắc thực hiện hợp nhất báo cáo tài chính: NHCSXH không có
    3. Công cụ tài chính phái sinh và kế toán phòng ngừa rủi ro: NHCSXH không có
   4. Kế toán thu nhập lãi, chi phí lãi và ngừng dự thu lãi:]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="da347f31-ce45-4381-9be5-4c2df2d17fc5" x="14" y="442" width="253" height="15"/>
				<textElement>
					<font fontName="Times New Roman" size="11" isBold="true" isItalic="true" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[   5. Kế toán các khoản thu từ phí và hoa hồng:]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="b14660c2-cfc5-4def-990b-e6edbfc5cd00" x="14" y="270" width="534" height="67"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" pdfEncoding="Identity-H"/>
					<paragraph lineSpacing="Proportional" lineSpacingSize="1.3"/>
				</textElement>
				<text><![CDATA[    Các nghiệp vụ phát sinh bằng ngoại tệ trong năm được ghi theo nguyên tệ và quy đổi ra đồng Việt Nam theo
tỷ giá do Ngân hàng Nhà nước Việt Nam công bố tại thời điểm lập báo cáo tài chính. Chênh lệch tỷ giá thực tế
phát sinh trong kỳ và chênh lệch tỷ giá do đánh giá lại số dư các khoản mục tiền tệ tại thời điểm cuối năm được
kết chuyển vào doanh thu hoặc chi phí trong năm tài chính.]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="2550fcea-62f9-4966-b7e2-4d5b856a1a39" x="14" y="382" width="534" height="15"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[   - Kế toán thu nhập lãi: Theo phương pháp thực thu.

]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="fc83fcb2-324e-4815-9ac2-1391a915ab9b" x="14" y="256" width="102" height="15"/>
				<textElement>
					<font fontName="Times New Roman" size="11" isBold="true" isItalic="true" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[    1. Chuyển đổi tiền tệ: ]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="3e4f78d2-4e4d-4e6c-8936-0260bc279a88" x="14" y="412" width="534" height="16"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[kỳ những khoản lãi sẽ phải trả tại một thời điểm nhất định trong tương lai, không phụ thuộc việc tại thời điểm
]]></text>
			</staticText>
