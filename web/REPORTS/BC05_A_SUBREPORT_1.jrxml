				</textElement>
				<text><![CDATA[III - Chuẩn mực và Chế độ kế toán áp dụng]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="0a7a7a44-e9b0-4252-a3b6-605cf2809417" x="14" y="91" width="534" height="34"/>
