<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="RR_M011TB" language="groovy" pageWidth="595" pageHeight="842" orientation="Landscape" columnWidth="535" leftMargin="35" rightMargin="25" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="296"/>
	<parameter name="PARA_DOTRR" class="java.lang.String"/>
	<parameter name="PARA_NAMRR" class="java.lang.String"/>
	<queryString>
		<![CDATA[Select * from
(SELECT RR_DOTRR DOTRR, TO_NUMBER(TO_CHAR(RR_NGAYBC, 'YYYY')) NAMRR, B.MA MA, B.TEN TINH,-- UPPER(RR_TENQD) RR_TENQD, TO_CHAR(RR_PDUYET_NGAY_TW,'DD/MM/YYYY') RR_PDUYET_NGAY_TW,
COUNT (CASE WHEN RR_NHOMRR = '02'
                    THEN RR_SOKU ELSE ''
                    END) SOMON_KHOANH,
TO_CHAR(SUM (CASE WHEN RR_NHOMRR = '02'
                    THEN (NVL(RR_XL_DUNO,0)+NVL(RR_XL_LAI,0)) ELSE 0
                    END),'99,999,999,999') SOTIEN_KHOANH,
TO_CHAR(SUM (CASE WHEN RR_NHOMRR = '02'
                    THEN (NVL(RR_XL_DUNO,0)) ELSE 0
                    END),'99,999,999,999') GOC_KHOANH,
TO_CHAR(SUM (CASE WHEN RR_NHOMRR = '02'
                    THEN (NVL(RR_XL_LAI,0)) ELSE 0
                    END),'9,999,999,999') LAI_KHOANH,
COUNT (CASE WHEN RR_NHOMRR = '03'
                    THEN RR_SOKU ELSE ''
                    END) SOMON_XOA,
TO_CHAR(SUM (CASE WHEN RR_NHOMRR = '03'
                    THEN (NVL(RR_XL_DUNO,0)+NVL(RR_XL_LAI,0)) ELSE 0
                    END),'99,999,999,999') SOTIEN_XOA,
TO_CHAR(SUM (CASE WHEN RR_NHOMRR = '03'
                    THEN (NVL(RR_XL_DUNO,0)) ELSE 0
                    END),'99,999,999,999') GOC_XOA,
TO_CHAR(SUM (CASE WHEN RR_NHOMRR = '03'
                    THEN (NVL(RR_XL_LAI,0)) ELSE 0
                    END),'9,999,999,999') LAI_XOA
FROM HSRR_WB A, DMTINH B
WHERE B.MA = SUBSTR(RR_MACN,3,2)
AND RR_DOTRR = $P{PARA_DOTRR}
AND TO_NUMBER(TO_CHAR(RR_NGAYBC, 'YYYY'))  = $P{PARA_NAMRR}
AND RR_TRANGTHAI = 'A'
AND RR_PDUYET_NGAY_TW is not null
GROUP BY B.MA, B.TEN, RR_DOTRR,RR_NGAYBC --,UPPER(RR_TENQD), RR_PDUYET_NGAY_TW
ORDER BY B.MA, B.TEN
)
where (SOMON_KHOANH + SOMON_XOA) > 0]]>
	</queryString>
	<field name="DOTRR" class="java.math.BigDecimal"/>
	<field name="NAMRR" class="java.math.BigDecimal"/>
	<field name="MA" class="java.lang.String"/>
	<field name="TINH" class="java.lang.String"/>
	<field name="SOMON_KHOANH" class="java.math.BigDecimal"/>
	<field name="SOTIEN_KHOANH" class="java.lang.String"/>
	<field name="GOC_KHOANH" class="java.lang.String"/>
	<field name="LAI_KHOANH" class="java.lang.String"/>
	<field name="SOMON_XOA" class="java.math.BigDecimal"/>
	<field name="SOTIEN_XOA" class="java.lang.String"/>
	<field name="GOC_XOA" class="java.lang.String"/>
	<field name="LAI_XOA" class="java.lang.String"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band splitType="Stretch"/>
	</title>
	<pageHeader>
		<band splitType="Stretch"/>
	</pageHeader>
	<detail>
		<band height="791">
			<textField>
				<reportElement mode="Transparent" x="0" y="164" width="537" height="54" forecolor="#000000" backcolor="#CCCCCC"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle" rotation="None" markup="none">
					<font fontName="Times New Roman" size="14" isBold="false" isItalic="false" isUnderline="false" isStrikeThrough="false" pdfEncoding="Identity-H" isPdfEmbedded="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["         Căn cứ Quyết định số       /QĐ-HĐQT ngày     /     /          " + " của Chủ tịch Hội đồng quản trị Ngân hàng Chính sách xã hội (NHCSXH) về việc xử lý nợ bị rủi ro do nguyên nhân khách quan đợt " + $F{DOTRR} + " năm " + $F{NAMRR}+" trong hệ thống NHCSXH."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement mode="Transparent" x="0" y="218" width="538" height="40" forecolor="#000000" backcolor="#CCCCCC"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle" rotation="None" markup="none">
					<font fontName="Times New Roman" size="14" isBold="false" isItalic="false" isUnderline="false" isStrikeThrough="false" pdfEncoding="Identity-H" isPdfEmbedded="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["         Tổng Giám đốc NHCSXH thông báo xử lý nợ bị rủi ro do nguyên nhân khách quan đợt " + $F{DOTRR} + " năm " + $F{NAMRR} + " của chi nhánh như sau:"]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement mode="Transparent" x="124" y="377" width="413" height="22" forecolor="#000000" backcolor="#CCCCCC"/>
				<textElement textAlignment="Justified" verticalAlignment="Top" rotation="None" markup="none">
					<font fontName="Times New Roman" size="14" isBold="false" isItalic="false" isUnderline="false" isStrikeThrough="false" pdfEncoding="Identity-H" isPdfEmbedded="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["cho " + $F{SOMON_XOA}+" món vay, số tiền "+$F{SOTIEN_XOA}+" đồng."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement mode="Transparent" x="41" y="258" width="108" height="22" forecolor="#000000" backcolor="#CCCCCC"/>
				<textElement textAlignment="Justified" verticalAlignment="Top" rotation="None" markup="none">
					<font fontName="Times New Roman" size="14" isBold="true" isItalic="false" isUnderline="false" isStrikeThrough="false" pdfEncoding="Identity-H" isPdfEmbedded="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["1. Khoanh nợ: "]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement mode="Transparent" x="144" y="258" width="393" height="22" forecolor="#000000" backcolor="#CCCCCC"/>
				<textElement textAlignment="Justified" verticalAlignment="Top" rotation="None" markup="none">
					<font fontName="Times New Roman" size="14" isBold="false" isItalic="false" isUnderline="false" isStrikeThrough="false" pdfEncoding="Identity-H" isPdfEmbedded="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["cho "+$F{SOMON_KHOANH}+ " món vay, số tiền " + $F{SOTIEN_KHOANH} +" đồng."]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="40" y="319" width="497" height="58"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="14" isBold="false" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[- Thời điểm tính khoanh nợ:
+ Đối với khoanh nợ lần đầu: khoanh nợ từ ngày khách hàng gặp rủi ro.
+ Đối với khoanh nợ bổ sung: khoanh nợ từ ngày hết thời gian khoanh lần trước.]]></text>
			</staticText>
			<staticText>
				<reportElement x="40" y="435" width="150" height="23"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="14" isBold="true" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[3. Tổ chức thực hiện.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="458" width="535" height="56"/>
				<box topPadding="3" leftPadding="3" bottomPadding="3" rightPadding="3"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="14" isBold="false" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[         Tổng Giám đốc giao Giám đốc chi nhánh NHCSXH cấp tỉnh chỉ đạo Giám đốc NHCSXH nơi cho vay rà soát lại hồ sơ pháp lý và chịu trách nhiệm về tính chính xác, hợp pháp, hợp lệ của tất cả các khoản nợ được xử lý theo thông báo này.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="512" width="535" height="103"/>
				<box topPadding="3" leftPadding="3" bottomPadding="3" rightPadding="3"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="14" isBold="false" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[         Sau khi hạch toán các khoản nợ bị rủi ro do nguyên nhân khách quan nêu trên, NHCSXH nơi cho vay thực hiện thông báo công khai tại điểm giao dịch xã theo đúng quy định, lập báo cáo mẫu 13, 14/XLN gửi chi nhánh tỉnh để tổng hợp gửi Hội Sở chính (Ban Quản lý nợ và xử lý rủi ro) và truyền file mềm theo chương trình Thông tin báo cáo trước ngày      /     /         . Căn cứ báo cáo của chi nhánh, Hội Sở chính sẽ chuyển tiền cho đơn vị số tiền xóa nợ gốc các khoản vay.]]></text>
			</staticText>
			<textField>
				<reportElement mode="Transparent" x="41" y="280" width="496" height="38" forecolor="#000000" backcolor="#CCCCCC"/>
				<textElement textAlignment="Justified" verticalAlignment="Top" rotation="None" markup="none">
					<font fontName="Times New Roman" size="14" isBold="false" isItalic="false" isUnderline="false" isStrikeThrough="false" pdfEncoding="Identity-H" isPdfEmbedded="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["Trong đó, gốc " + $F{GOC_KHOANH} + " đồng, lãi " + $F{LAI_KHOANH} + " đồng. Thời gian, số tiền được khoanh nợ của từng món vay theo danh sách chi tiết đính kèm."]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement mode="Transparent" x="41" y="377" width="103" height="22" forecolor="#000000" backcolor="#CCCCCC"/>
				<textElement textAlignment="Justified" verticalAlignment="Top" rotation="None" markup="none">
					<font fontName="Times New Roman" size="14" isBold="true" isItalic="false" isUnderline="false" isStrikeThrough="false" pdfEncoding="Identity-H" isPdfEmbedded="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["2. Xóa nợ: "]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement mode="Transparent" x="41" y="399" width="496" height="41" forecolor="#000000" backcolor="#CCCCCC"/>
				<box rightPadding="3"/>
				<textElement textAlignment="Justified" verticalAlignment="Top" rotation="None" markup="none">
					<font fontName="Times New Roman" size="14" isBold="false" isItalic="false" isUnderline="false" isStrikeThrough="false" pdfEncoding="Identity-H" isPdfEmbedded="false"/>
					<paragraph lineSpacing="Single"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["Trong đó, gốc "+ $F{GOC_XOA} + " đồng, lãi "+ $F{LAI_XOA} + " đồng theo danh sách chi tiết đính kèm."]]></textFieldExpression>
			</textField>
