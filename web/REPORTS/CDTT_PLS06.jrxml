<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="CDTT_PLS06" language="groovy" pageWidth="802" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="4673fe13-575c-4e52-9322-55af43ba4e44">
	<property name="ireport.zoom" value="1.2100000000000006"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="style1">
		<conditionalStyle>
			<conditionExpression><![CDATA[$F{FONTFORMAT} == '1']]></conditionExpression>
			<style fill="Solid" markup="styled" fontName="Times New Roman" isBold="true" isItalic="false" isUnderline="false" isStrikeThrough="false" pdfEncoding="Identity-H"/>
		</conditionalStyle>
	</style>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<parameter name="PARA_PHONGBAN" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT (SELECT UPPER(TEN) FROM DMTINH WHERE MA=SUBSTR($P{PARA_MAPGD},3,2)) TENTINH,
(SELECT UPPER(GIATRI) FROM DMKHAC WHERE KHOA_1='80' AND KHOA_2=$P{PARA_PHONGBAN})TENPB,
(case when TT_HIENTHI in ('I','II') then TT_HIENTHI
when ma not in ('200001','300001') then to_Char(ROW_NUMBER () OVER(PARTITION BY substr(ma,1,1) ORDER BY MA )-1) end) tt,
 MA,KHOA,(CASE WHEN TEN IS NOT NULL THEN TEN ELSE D2 END)TEN,THUTU,D2,D3,
case when substr(D14,1,2)= '81' then DECODE(D4,'B','Chi nhánh','P','Phòng','')
else  DECODE(D4,'B','Lãnh đạo NHCS','P','Ban','') end D4,
D5,D6,
DECODE(D7,'Y','Đạt tiến độ','N','Chậm tiến độ','') D7,
DECODE(D8,'Y','Đảm bảo','N','Không đảm bảo','') D8,
DECODE(D9,'Y','Đạt tiến độ','N','Chậm tiến độ','NULL','',D9) D9,
DECODE(D10,'Y','Đảm bảo','N','Không đảm bảo','NULL','',D9)D10,
D12,D19,D20,
D11,FONTFORMAT, to_char(ngaybc,'mm') THANG FROM  DULIEU_NT
WHERE KHOA = 'CDTT_CMNV06' AND MAPGD <> 999999 AND D14 = $P{PARA_PHONGBAN} and ngaybc = $P{PARA_NGAYBC} AND SUBSTR(MACN,3,2)=SUBSTR($P{PARA_MAPGD},3,2)
ORDER BY MA,THUTU]]>
	</queryString>
	<field name="TENTINH" class="java.lang.String"/>
	<field name="TENPB" class="java.lang.String"/>
	<field name="TT" class="java.lang.String"/>
	<field name="MA" class="java.lang.String"/>
	<field name="KHOA" class="java.lang.String"/>
	<field name="TEN" class="java.lang.String"/>
	<field name="THUTU" class="java.math.BigDecimal"/>
