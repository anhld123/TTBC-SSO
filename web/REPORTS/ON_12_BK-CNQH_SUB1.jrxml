<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ON_12_BK-CBQH_SUB1" language="groovy" pageWidth="595" pageHeight="842" orientation="Landscape" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="2"/>
	<parameter name="PARA_MATO" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_MATT" class="java.lang.String"/>
	<parameter name="PARA_MADIACHI" class="java.lang.String"/>
	<parameter name="PARA_MATOCHUCHOI" class="java.lang.String"/>
	<parameter name="REPORTDATE" class="java.lang.String"/>
	<parameter name="PARA_TUNGAY" class="java.lang.String"/>
	<parameter name="PARA_DENNGAY" class="java.lang.String"/>
	<queryString>
		<![CDATA[select distinct KU_MAKH MPI_CUST_ID,
 KH_TENKH MC_CUST_NAME_LOCAL,
 KU_SOKU MPI_LEGACY_ID,
 TO_CHAR(KU_NGAYDHAN_1 ,'DD-MM-YYYY')  MPI_MAT_DT,
  KU_GOCDHAN MPF_OVERDUE_AMT,
  KU_MAPGD,
  KU_MATO,
  TO_CHAR(KU_NGAYCNQH ,'DD-MM-YYYY') OVERDUE_DATE
    from hsku a, hskh b
 where a.ku_makh = b.kh_makh
 and KU_TTMONVAY = 'OPEN'
 and KU_MATO = $P{PARA_MATO}
 and KU_GOCDHAN > 0
 AND  TO_DATE(TO_CHAR(KU_NGAYCNQH ,'DD-MON-YYYY'),'DD-MON-YYYY') BETWEEN $P{PARA_TUNGAY} AND $P{PARA_DENNGAY}
  order by KU_MAKH]]>
	</queryString>
	<field name="MPI_CUST_ID" class="java.lang.String"/>
	<field name="MC_CUST_NAME_LOCAL" class="java.lang.String"/>
	<field name="MPI_LEGACY_ID" class="java.lang.String"/>
	<field name="MPI_MAT_DT" class="java.lang.String"/>
	<field name="MPF_OVERDUE_AMT" class="java.math.BigDecimal"/>
	<field name="KU_MAPGD" class="java.lang.String"/>
	<field name="KU_MATO" class="java.lang.String"/>
	<field name="OVERDUE_DATE" class="java.lang.String"/>
	<variable name="customer_count" class="java.lang.Integer" incrementType="Group" incrementGroup="cust_id_group" calculation="Count">
		<variableExpression><![CDATA[$V{customer_count}++]]></variableExpression>
		<initialValueExpression><![CDATA[new Integer(1)]]></initialValueExpression>
	</variable>
	<variable name="TOT_MPF_OVERDUE_AMT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{MPF_OVERDUE_AMT}]]></variableExpression>
	</variable>
	<filterExpression><![CDATA[!$F{MPI_CUST_ID}.isEmpty()]]></filterExpression>
	<group name="cust_id_group">
		<groupExpression><![CDATA[$F{MPI_CUST_ID}]]></groupExpression>
	</group>
