	<summary>
		<band height="200" splitType="Stretch">
			<staticText>
				<reportElement uuid="b3f3aa0b-3306-4176-a62a-7bcc46ca11f8" positionType="Float" x="248" y="147" width="206" height="15"/>
				<textElement textAlignment="Center" verticalAlignment="Top">
					<font fontName="Times New Roman" size="13" isBold="true" isItalic="false" isUnderline="false" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[Bùi Quang Vinh]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="164d7064-cdac-44db-81ce-7a9d41bc3863" positionType="Float" x="248" y="29" width="206" height="30"/>
				<textElement textAlignment="Center" verticalAlignment="Top">
					<font fontName="Times New Roman" size="13" isBold="true" isItalic="false" isUnderline="false" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[KT. TỔNG GIÁM ĐỐC
PHÓ TỔNG GIÁM ĐỐC
]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="6cd8d6f7-fdd9-497a-861f-9b4cb2ddae0d" positionType="Float" x="0" y="29" width="183" height="15"/>
				<textElement verticalAlignment="Top">
					<font fontName="Times New Roman" size="13" isBold="true" isItalic="true" isUnderline="false" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[Nơi nhận:
- Như trên;
- Tổng Giám đốc;
- Trưởng Ban kiểm soát;
- Các Phó Tổng Giám đốc;
- Kế toán trưởng;
- Các Ban CMNV tại HSC;
- Lưu: VT, QLN.
]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="86f896d4-d1a4-402b-b014-39bc5a19bd44" positionType="Float" x="0" y="44" width="183" height="118"/>
				<textElement verticalAlignment="Top">
					<font fontName="Times New Roman" size="13" isBold="false" isItalic="true" isUnderline="false" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[- Như trên;
- Tổng Giám đốc;
- Trưởng Ban kiểm soát;
- Các Phó Tổng Giám đốc;
- Kế toán trưởng;
- Các Ban CMNV tại HSC;
- Lưu: VT, QLN.
]]></text>
			</staticText>
			<textField isStretchWithOverflow="true">
				<reportElement uuid="a6980ab4-413f-4fb3-a849-36efd5e954b7" positionType="Float" x="0" y="0" width="454" height="20"/>
				<box leftPadding="0"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="14" pdfEncoding="Identity-H"/>
					<paragraph lineSpacing="1_1_2" lineSpacingSize="1.3" firstLineIndent="20"/>
				</textElement>
				<textFieldExpression><![CDATA["Nhận được công văn này, yêu cầu chi nhánh NHCSXH tỉnh (thành phố). " + $F{TEN}+ " triển khai thực hiện. Quá trình thực hiện nếu có vướng mắc phản ánh về Hội sở chính (Ban Quản lý và xử lý nợ rủi ro) để xem xét, giải quyết./."]]></textFieldExpression>
			</textField>
		</band>
	</summary>
</jasperReport>
