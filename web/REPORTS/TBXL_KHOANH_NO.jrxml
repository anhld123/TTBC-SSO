					<font fontName="Times New Roman" size="13" isBold="true" isUnderline="false" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[CỘNG HÒA XÃ HỘI CHỦ NGHĨA VIỆT NAM
Độc lập - Tự do - Hạnh phúc
]]></text>
			</staticText>
		</band>
	</detail>
