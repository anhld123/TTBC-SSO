					<paragraph lineSpacing="AtLeast" lineSpacingSize="1.5" firstLineIndent="30" spacingBefore="3" spacingAfter="3"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA[$F{TENPGD} + " thông báo về tình hình vay vốn của học sinh, sinh viên mồ côi và đề nghị nhà trường phối hợp thông báo, nhắc nhở HSSV mồ côi về trách nhiệm sử dụng vốn vay đúng mục đích. Nếu HSSV mồ côi bỏ học, thôi học, kỷ luật … nhà trường thông báo ngay cho " + $F{TENPGD} +
" theo địa chỉ: " + $F{DC_PGD} + " biết, để có biện pháp xử lý kịp thời (số điện thoại: " + $F{MOBI_PGD} + ", số fax: " + $F{FAX_PGD} + ")."]]></textFieldExpression>
