				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["   Địa chỉ cư trú trước khi nhập trường tại: " + $F{TENTHON}+ ", " +$F{TENXA} + ", " + $F{TENHUYEN}+ ", " +$F{TENTINH} + "."]]></textFieldExpression>
			</textField>
