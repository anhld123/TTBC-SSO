					<font fontName="Times New Roman" size="9" isBold="true" pdfEncoding="Identity-H"/>
				</textElement>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{LAST_PRE_AMT_1}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0" isBlankWhenNull="true">
				<reportElement x="422" y="0" width="130" height="17"/>
				<box rightPadding="3"/>
