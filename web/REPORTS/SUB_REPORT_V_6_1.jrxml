					<font fontName="Times New Roman" size="9" isBold="true" pdfEncoding="Identity-H"/>
				</textElement>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{FIRST_PRE_AMT_1}]]></textFieldExpression>
			</textField>
