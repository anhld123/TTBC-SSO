<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="sub_cur_date_new" language="groovy" pageWidth="250" pageHeight="820" columnWidth="250" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="54416afd-d8a0-4d8c-9f59-1767aec14655">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select ten from
(select 'Hà Nội' ten from dual where substr($P{PARA_MAPGD},3,4)in ('0100','0101')
 union all
 select ten from DMTINH where ma = substr($P{PARA_MAPGD},3,2) and  ma not in ( '01','00'))]]>
	</queryString>
	<field name="TEN" class="java.lang.String"/>
	<variable name="CUR_DATE" class="java.util.Date">
		<variableExpression><![CDATA[new Date()]]></variableExpression>
	</variable>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="17" splitType="Stretch">
			<textField evaluationTime="Report">
				<reportElement uuid="a99360a3-fce4-494d-abb6-efb701b681da" x="0" y="0" width="250" height="17"/>
				<textElement textAlignment="Right" verticalAlignment="Bottom">
					<font fontName="Times New Roman" size="11" isBold="false" isItalic="true" pdfEncoding="Identity-H"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{TEN}+", ngày ..... tháng ..... năm "   + ($V{CUR_DATE}.getYear()+1900).toString()]]></textFieldExpression>
			</textField>
		</band>
	</title>
</jasperReport>
