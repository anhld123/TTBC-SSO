	</variable>
	<variable name="DNKHOANH_2" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{DNKHOANH}]]></variableExpression>
	</variable>
	<variable name="DNKHOANH_SOHO_2" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{DNKHOANH_SOHO}]]></variableExpression>
	</variable>
