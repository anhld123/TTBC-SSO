<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="BCDP-B20" language="groovy" pageWidth="1100" pageHeight="800" orientation="Landscape" columnWidth="1065" leftMargin="20" rightMargin="15" topMargin="20" bottomMargin="20" uuid="89123948-6f27-46ab-9fcf-3aad573f5b7a">
	<property name="ireport.zoom" value="1.5"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_TONGHOP" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_DENNGAY" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT a.DT_MADT MADT, a.DT_TENDT TENDT, NVL(DT_VONDT,0) VONDT,
        NVL(sum(KU_DNOTHAN),0) DNTHAN,
        COUNT (DISTINCT
                    CASE WHEN (NVL(KU_DNOTHAN,0) > 0)
                    THEN KU_MAKH ELSE ''
                    END) DNTHAN_SOHO,
        NVL(sum(KU_DNOQHAN),0) DNQHAN,
        COUNT (DISTINCT
                    CASE WHEN (NVL(KU_DNOQHAN,0) > 0)
                    THEN KU_MAKH ELSE ''
                    END) DNQHAN_SOHO,
        NVL(sum(KU_DNOKHOANH),0) DNKHOANH,
        COUNT (DISTINCT
                    CASE WHEN (NVL(KU_DNOKHOANH,0) > 0)
                    THEN KU_MAKH ELSE ''
                  END)  DNKHOANH_SOHO
FROM
(SELECT DISTINCT DT_MADT,DT_TENDT , DT_VONDT FROM HSDT,  DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA =  $P{PARA_MAPGD}) Z  WHERE DT_MAPGD = Y.PO_MA
AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA)
AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) GROUP BY DT_MADT, DT_TENDT,DT_VONDT) a,
HSKU b, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z
WHERE a.DT_MADT = b.KU_MANDT
AND KU_TTMONVAY = 'OPEN'
AND KU_MAPGD = Y.PO_MA
AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA)
AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD})
AND KU_NGAYBC = TO_DATE ( $P{PARA_DENNGAY})
GROUP BY DT_MADT, DT_TENDT,DT_VONDT]]>
	</queryString>
	<field name="MADT" class="java.lang.String"/>
	<field name="TENDT" class="java.lang.String"/>
	<field name="VONDT" class="java.math.BigDecimal"/>
	<field name="DNTHAN" class="java.math.BigDecimal"/>
	<field name="DNTHAN_SOHO" class="java.math.BigDecimal"/>
	<field name="DNQHAN" class="java.math.BigDecimal"/>
	<field name="DNQHAN_SOHO" class="java.math.BigDecimal"/>
	<field name="DNKHOANH" class="java.math.BigDecimal"/>
	<field name="DNKHOANH_SOHO" class="java.math.BigDecimal"/>
	<variable name="VONDT_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{VONDT}]]></variableExpression>
	</variable>
	<variable name="DNTHAN_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{DNTHAN}]]></variableExpression>
	</variable>
	<variable name="DNTHAN_SOHO_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{DNTHAN_SOHO}]]></variableExpression>
	</variable>
	<variable name="DNQHAN_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{DNQHAN}]]></variableExpression>
	</variable>
	<variable name="DNQHAN_SOHO_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{DNQHAN_SOHO}]]></variableExpression>
	</variable>
	<variable name="DNKHOANH_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{DNKHOANH}]]></variableExpression>
	</variable>
	<variable name="DNKHOANH_SOHO_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{DNKHOANH_SOHO}]]></variableExpression>
	</variable>
	<variable name="VONDT_2" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{VONDT}]]></variableExpression>
	</variable>
	<variable name="DNTHAN_2" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{DNTHAN}]]></variableExpression>
	</variable>
	<variable name="DNTHAN_SOHO_2" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{DNTHAN_SOHO}]]></variableExpression>
	</variable>
	<variable name="DNQHAN_2" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{DNQHAN}]]></variableExpression>
	</variable>
	<variable name="DNQHAN_SOHO_2" class="java.math.BigDecimal" calculation="Sum">
