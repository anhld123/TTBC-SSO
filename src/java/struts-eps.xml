<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE struts PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
        "http://struts.apache.org/dtds/struts-2.0.dtd">

<struts>
    <package name="eps" extends="struts-default,json-default">
        <!--Cấp CN và TW-->
        <action name="redirect_loadIndex" class="vbsp.ims.eps.epsAction">
            <result name="success">/EPS/epsReIndex.jsp</result>
        </action>    
        <action name="loadIndex" class="vbsp.ims.eps.epsAction" method="getAllData">
            <result name="success">/EPS/epsDetails.jsp</result>
        </action>
        <action name="openlock" class="vbsp.ims.eps.epsAction" method="openlock">
            <result name="success">/EPS/epsDetails.jsp</result>
        </action>
        <action name="updateintellect" class="vbsp.ims.eps.epsAction" method="updateintellect">
            <result name="success" type="stream">
                <param name="contentType">text/html</param>
                <param name="inputName">pageResult</param>
            </result>
        </action>
        
        <!--Cấp PGD-->
        <action name="redirect_load_pgd" class="vbsp.ims.eps.epsAction">
            <result name="success">/EPS/epsReIndex_pgd.jsp</result>
        </action> 
        <action name="xemsleps" class="vbsp.ims.eps.epsAction" method="xemsleps">
            <result name="success">/EPS/epsDetails_pgd.jsp</result>
        </action>  
        <action name="luusleps" class="vbsp.ims.eps.epsAction" method="luusleps">
            <result name="success">/EPS/epsDetails_pgd.jsp</result>
        </action>  
        <action name="xacnhansleps" class="vbsp.ims.eps.epsAction" method="xacnhansleps">
            <result name="success">/EPS/epsDetails_pgd.jsp</result>
        </action>
        <action name="getpgdfromcn" class="vbsp.ims.eps.epsAction" method="getCNToPGD">
            <result type="json" />
        </action>
    </package>
</struts>
