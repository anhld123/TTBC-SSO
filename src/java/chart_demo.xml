<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE struts PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
        "http://struts.apache.org/dtds/struts-2.0.dtd">
<struts>    
    <package name="demo_chart"  extends="struts-default">
        <action name="pie_chart_demo" class="vbsp.ims.chart.ChartAction" method="pie_chart_demo">
            <result name="success">/Chart/pie_chart.jsp</result>
        </action>        
        
        <action name="bar_chart_demo" class="vbsp.ims.chart.ChartAction" method="pie_chart_demo">
            <result name="success">/Chart/bar_chart.jsp</result>
        </action> 
        
        <action name="bubble_chart_demo" class="vbsp.ims.chart.ChartAction" method="pie_chart_demo">
            <result name="success">/Chart/bubble_chart.jsp</result>
        </action> 
    </package>
    
    <package extends="struts-default,json-default" name="ajax-package" namespace="/ajax">
         
            <action class="vbsp.ims.chart.AjaxActions" method="getData" name="getChartData">
                <result type="json">
            </result></action>
 
    </package>
</struts>
