<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE struts PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
        "http://struts.apache.org/dtds/struts-2.0.dtd">

<struts>
    <package name="inputcommune" extends="struts-default">
        <action name="loadIndCommuneMain" class="vbsp.ims.action.ActionCommuneInput">
            <result name="success">/inputcommune/input-commune.jsp</result>
            <result name="error">/error.jsp</result>
        </action>        
        <action name="loadDataCommune" class="vbsp.ims.action.ActionCommuneInput" method="loadDataCommune">
            <result name="success">/inputcommune/input-table-data.jsp</result>
            <result name="error">/inputcommune/error.jsp</result>
        </action>
        <action name="saveInputCommune" class="vbsp.ims.action.ActionCommuneInput" method="saveInputCommune">
            <result name="success">/inputcommune/error.jsp</result>
            <result name="error">/inputcommune/error.jsp</result>
        </action>
        
        <action name="loadIndCommuneMainAuth" class="vbsp.ims.action.ActionCommuneAuth">
            <result name="success">/inputcommune/auth-commune.jsp</result>
            <result name="error">/error.jsp</result>
        </action>
        
        <action name="loadIndCommuneMainAuthPgd" class="vbsp.ims.action.ActionCommuneAuthPgd">
            <result name="success">/inputcommune/auth-commune-pgd.jsp</result>
            <result name="error">/error.jsp</result>
        </action>
        
        <action name="loadDataCommuneAuthPgd" class="vbsp.ims.action.ActionCommuneAuthPgd" method="loadDataCommuneAuthPgd">
            <result name="success">/inputcommune/auth-table-data.jsp</result>
            <result name="error">/inputcommune/error.jsp</result>
        </action>
        
        <action  name="COMMUNE_AUTH_PGD" class="vbsp.ims.action.ActionCommuneAuthPgd"
                  method="saveInputCommuneAuthPgd">
            <result name="success">/inputcommune/result-auth-table-data.jsp</result> 
            <result name="notdata">/inputcommune/err-auth-table-data.jsp</result>
            <result name="error">/inputcommune/error.jsp</result> 
         </action> 

        <action name="loadIndCommuneMainReject" class="vbsp.ims.action.ActionCommuneReject">
            <result name="success">/inputcommune/reject-commune.jsp</result>
            <result name="error">/error.jsp</result>
        </action>
        
        
        <action name="loadDataCommuneReject" class="vbsp.ims.action.ActionCommuneReject"
                method="loadDataCommuneReject">
            <result name="success">/inputcommune/error.jsp</result>
            <result name="error">/inputcommune/error.jsp</result>
        </action>
        
          <action  name="COMMUNE_REJECT" class="vbsp.ims.action.ActionCommuneReject"
                  method="loadDataCommuneUnReject">
            <result name="success">/inputcommune/error.jsp</result> 
            <result name="error">/inputcommune/error.jsp</result> 
         </action> 
         
         <action  name="COMMUNE_CHECK" class="vbsp.ims.action.ActionCommuneReject"
                  method="loadDataCommuneCHECK">
            <result name="success">/inputcommune/chec-table-data-tw.jsp</result> 
         </action>
         
         <action name="COMMUNE_REJECT_CN" class="vbsp.ims.action.ActionCommuneAuth"
                method="loadDataCommuneRejectCN">
            <result name="success">/inputcommune/error.jsp</result>
            <result name="error">/inputcommune/error.jsp</result>
        </action>
        
          <action  name="COMMUNE_UNREJECT_CN" class="vbsp.ims.action.ActionCommuneAuth"
                  method="loadDataCommuneUnRejectCN">
            <result name="success">/inputcommune/error.jsp</result> 
            <result name="error">/inputcommune/error.jsp</result> 
         </action> 
        
        <action name="loadDataCommuneAuth" class="vbsp.ims.action.ActionCommuneAuth" method="loadDataCommuneAuth">
            <result name="success">/inputcommune/auth-table-data.jsp</result>
            <result name="error">/inputcommune/error.jsp</result>
        </action>
        
        
        
         <action  name="COMMUNE_AUTH" class="vbsp.ims.action.ActionCommuneAuth"
                  method="saveInputCommuneAuth">
            <result name="success">/inputcommune/result-auth-table-data.jsp</result> 
            <result name="notdata">/inputcommune/err-auth-table-data.jsp</result>
            <result name="error">/inputcommune/error.jsp</result> 
         </action> 
         
         <action  name="COMMUNE_SEND" class="vbsp.ims.action.ActionCommuneAuth"
                  method="saveInputCommuneSend">
            <result name="success">/inputcommune/error.jsp</result> 
            <result name="error">/inputcommune/error.jsp</result> 
         </action>       
        
        
                                          
     </package>
     
     
</struts>