<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE struts PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
        "http://struts.apache.org/dtds/struts-2.0.dtd">
<struts>           
    <package name="main_nghiquyet11cp" extends="struts-default,json-default">                       
        <action name="loadAllNghiquyet11cp" class="vbsp.ims.nghiquyet11cp.ActionNghiquyet11cpMain"  method="execute">
            <result name="success" type="json"></result>        
        </action>   
        
        <action name="LoadParaNghiquyet11cp" class="vbsp.ims.nghiquyet11cp.ActionNghiquyet11cpMain"  method="loadParaBaocao">
            <result name="nghiquyet11cp_01">/nghiquyet11cp/para_nghiquyet11cp.jsp</result>
            <result name="nghiquyet11cp_01_kh">/nghiquyet11cp/para_nghiquyet11cp_01_kh.jsp</result>
            <result name="nghiquyet11cp_04_kh">/nghiquyet11cp/para_nghiquyet11cp_04_kh.jsp</result>
            <result name="nghiquyet11cp_02_sk">/nghiquyet11cp/para_nghiquyet11cp_02_sk.jsp</result>
            <result name="error">/nghiquyet11cp/success.jsp</result>        
        </action>  
        
        <action name="NQ11CP_001" class="vbsp.ims.nghiquyet11cp.NQ11CP_001"  method="load">
            <result name="success">/nghiquyet11cp/table_nq11cp_htls.jsp</result>                 
            <result name="cap2_chot">/nghiquyet11cp/table_nghiquyet11cp_cnchot.jsp</result> 
            <result name="error">/nhaptay-cn/success.jsp</result>       
        </action>
        
        <action name="SAVE_NQ11CP_001" class="vbsp.ims.nghiquyet11cp.NQ11CP_001"  method="save">
            <result name="success">/BCQT/success.jsp</result>
            <result name="error">/BCQT/success.jsp</result>        
        </action>
        
        <action name="HTL_NQ11CP_001" class="vbsp.ims.nghiquyet11cp.NQ11CP_001"  method="save_htl">
            <result name="success">/BCQT/success.jsp</result>
            <result name="error">/BCQT/success.jsp</result>        
        </action>
        
        <!--01 kế hoạch-->
        <action name="NQ11CP_01KH" class="vbsp.ims.nghiquyet11cp.NQ11CP_01KH"  method="load">
                <result name="success">/nghiquyet11cp/table_nq11cp_01_kehoach.jsp</result>                 
                <result name="cap2_chot">/nghiquyet11cp/table_nghiquyet11cp_cnchot.jsp</result> 
                <result name="error">/nhaptay-cn/success.jsp</result>       
        </action>

        <action name="SAVE_NQ11CP_01KH" class="vbsp.ims.nghiquyet11cp.NQ11CP_01KH"  method="save">
                <result name="success">/BCQT/success.jsp</result>
                <result name="error">/BCQT/success.jsp</result>        
        </action>                
        
        <!--02 Sao kê-->
        <action name="NQ11CP_02SK" class="vbsp.ims.nghiquyet11cp.NQ11CP_02SK"  method="load">
                <result name="success">/nghiquyet11cp/table_nq11cp_02_saoke.jsp</result>                 
                <result name="cap2_chot">/nghiquyet11cp/table_nghiquyet11cp_cnchot.jsp</result> 
                <result name="error">/nhaptay-cn/success.jsp</result>       
        </action>

        <action name="SAVE_NQ11CP_02SK" class="vbsp.ims.nghiquyet11cp.NQ11CP_02SK"  method="save">
                <result name="success">/BCQT/success.jsp</result>
                <result name="error">/BCQT/success.jsp</result>        
        </action> 
        
        <!--Upload file-->
        
        <action name="nq11_04kh_open_upload" class="vbsp.ims.nghiquyet11cp.NQ11CP_04KH" method="openExcelUpload">
            <result name="success">  
                /nghiquyet11cp/upload-file-nq11cp.jsp
            </result>               
            <result name="error">  
                /chamdiem_canhan/success.jsp
            </result>  
        </action>
        
        <action name="saveUploadKH04" class="vbsp.ims.nghiquyet11cp.NQ11CP_04KH"  method="saveUploadKH04">
            <interceptor-ref name="fileUpload">
                <param name="maximumSize">209715200</param>
            </interceptor-ref>
            <interceptor-ref name="defaultStack"></interceptor-ref>
            <result name="success">/WEB-INF/datawarehouse_input-log.jsp</result>
            <result name="error">/error.jsp</result>            
        </action>
        
        <!--Mẫu 04KH-->
        
        <action name="NQ11CP_04KH" class="vbsp.ims.nghiquyet11cp.NQ11CP_04KH"  method="load">
                <result name="success">/nghiquyet11cp/table_nq11cp_04_kehoach.jsp</result>                                 
                <result name="error">/nhaptay-cn/success.jsp</result>       
        </action>

        <action name="SAVE_NQ11CP_04KH" class="vbsp.ims.nghiquyet11cp.NQ11CP_04KH"  method="save">
                <result name="success">/BCQT/success.jsp</result>
                <result name="error">/BCQT/success.jsp</result>        
        </action>      
                                      
    </package>
    
</struts>
