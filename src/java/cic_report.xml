<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE struts PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
        "http://struts.apache.org/dtds/struts-2.0.dtd">
<struts>    
    <package name="CIC_Report" extends="struts-default,json-default">           
        <action  name="CIC_viewAction" class="vbsp.ims.action.CICReportAction"
                  method="view">
            <result name="success">/WEB-INF/rptCIC-view.jsp</result>             
        </action>                
        <action  name="CIC_viewlogAction" class="vbsp.ims.action.CICReportAction"
                  method="viewLog">
            <result name="success">/WEB-INF/rptCIC-view_log.jsp</result>             
        </action>                
        <action  name="CIC_searchAction" class="vbsp.ims.action.CICReportAction"
                  method="search">
            <result name="success">/WEB-INF/rptCIC-view.jsp</result>             
            <result name="input">/WEB-INF/rptCIC-view_log.jsp</result>             
        </action>                
        <action  name="CIC_createjobAction" class="vbsp.ims.action.CICReportAction"
                  method="createJobs">
            <result name="success">/WEB-INF/message.jsp</result>             
        </action>                
    </package>
</struts>
