<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE struts PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
        "http://struts.apache.org/dtds/struts-2.0.dtd">
<struts>
    <package name="huydongtk" extends="struts-default,json-default">
        <action name="rehuydongtk" class="vbsp.ims.huydongtk.TKActionSupport" method="index">
            <result name="success">/huydongtiengui/template.jsp</result>
        </action> 
        <action name="viewdata" class="vbsp.ims.huydongtk.TKActionSupport" method="viewdata">
            <result name="success">/huydongtiengui/viewdata.jsp</result>
        </action>  
        <action name="savedata" class="vbsp.ims.huydongtk.TKActionSupport" method="savedata">
            <result name="success" type="stream">
                <param name="contentType">text/html</param>
                <param name="inputName">pageResult</param>
            </result>
        </action>  
    </package>
</struts>