<!DOCTYPE struts PUBLIC
"-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
"http://struts.apache.org/dtds/struts-2.0.dtd">

<!-- Author: Home -->
 
<struts>
     <!-- Configuration for the default package. -->
    <package name="giatrichitieu" extends="struts-default,json-default">
        <action name="mainchitieu" class="vbsp.ims.dmctieu.dmctieu_action">
            <result name="thanhcong">maingtchitieu.jsp</result>
        </action>
        <action name="excloact" class="vbsp.ims.dmctieu.dmctieu_action" method="excloact">
            <result name="thanhcong">DMChitieu/subchitieu.jsp</result>
        </action>
        <action name="exchitieu" class="vbsp.ims.dmctieu.dmctieu_action" method="exchitieu">
            <result name="thanhcong">DMChitieu/subchitieu.jsp</result>
        </action>
        <action name="exchitieu" class="vbsp.ims.dmctieu.dmctieu_action" method="exchitieu">
            <result name="thanhcong" type="stream">
                <param name="contentType">application/octet-stream</param>
                <param name="inputName">fileInputStream</param>
                <param name="contentDisposition">attachment;filename="${PFile}"</param>
                <param name="bufferSize">1024</param>
            </result>
        </action>   
    </package>
</struts>
