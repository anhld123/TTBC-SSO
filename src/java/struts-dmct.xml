<struts>
     <!-- Configuration for the default package. -->
    <package name="dmct" extends="struts-default,json-default">
        <action name="loadctnhcsxh" class="vbsp.ims.action.ChiTieuNHCSXH">
            <result name="success">/chitieu/Treeview.jsp</result>
        </action>
        <action name="loadctnhnn" class="vbsp.ims.action.ChiTieuNHNN">
            <result name="success">/chitieu/Treeview.jsp</result>
        </action>
        <action name="loadchitieu" class="vbsp.ims.action.LoadChiTieu">
            <result name="success">/chitieu/loadchitieu.jsp</result>
        </action>
        <action name="loatruyvan" class="vbsp.ims.action.LoadTruyVanCT">
