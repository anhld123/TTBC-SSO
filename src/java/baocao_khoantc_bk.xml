<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE struts PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
        "http://struts.apache.org/dtds/struts-2.0.dtd">
<struts>           
    <package name="main_khoantc" extends="struts-default,json-default">                       
        <action name="loadAllKhoantc" class="vbsp.ims.khoantc.action.ActionKhoantcMain"  method="execute">
            <result name="success" type="json"></result>        
        </action>   
        
        <action name="LoadParaKhoantc" class="vbsp.ims.khoantc.action.ActionKhoantcMain"  method="loadPataKhoantc">
            <result name="success">/khoan_tc/para-khoantc-main.jsp</result>
            <result name="error">/khoan_tc/success.jsp</result>        
        </action>  
        
        <!--gui so lieu -->
        <action name="sendKHOANTC" class="vbsp.ims.khoantc.action.ActionKhoantcMain"  method="sendKHOANTC">
            <result name="success">/BCQT/success.jsp</result>
            <result name="error">/BCQT/success.jsp</result>        
        </action>
        
        <action name="KHOANTC001_reload" class="vbsp.ims.khoantc.action.KHOANTC001"  method="reload">
            <result name="success">/khoan_tc/table_khoantc_01.jsp</result>
            <result name="error">/khoan_tc/success.jsp</result>        
        </action>   
        
        
        
        
        
        <!--Chi phan khoa va mo khoa gui du lieu-->
        <action name="LoadParaKhoantc_unlock" class="vbsp.ims.khoantc.action.ActionKhoantcMain"  method="LoadParaKhoantc_unlock">
            <result name="success">/khoan_tc/para-khoantc-main_unlock.jsp</result>
            <result name="error">/khoan_tc/success.jsp</result>        
        </action>
        
        <action name="UNLOCK_KHOANTC" class="vbsp.ims.khoantc.action.ActionKhoantcMain"  method="LoadStatusSendCnKhoantc">
            <result name="success">/khoan_tc/table_unlock.jsp</result>
            <result name="error">/BCQT/success.jsp</result>        
        </action> 
        
        <action name="OPEN_PGD_bka" class="vbsp.ims.khoantc.action.ActionKhoantcMain"  method="OpenPgd">
            <result name="success" type="redirectAction">
                <param name="actionName">UNLOCK_KHOANTC</param>
                <!--<param name="namespace">/genReport</param>-->
                <param name="khoa_khoantc">${khoa_khoantc}</param>
                <param name="ngay_bc">${ngay_bc}</param>
                <param name="macn">${macn}</param>
                <!--<param name="type_bcqt">${type_bcqt}</param>-->
            </result>
            <result name="error">/BCQT/success.jsp</result>        
        </action>
        
    </package>
    
</struts>
