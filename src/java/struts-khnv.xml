<struts>
    <!-- Configuration for the default package. -->
    <package name="json_khnv" extends="struts-default,json-default">
        <interceptors>
            <interceptor-stack name="defaultStack">
                <interceptor-ref name="json">
                    <param name="enableSMD">true</param>
                </interceptor-ref>
            </interceptor-stack>
        </interceptors>
        
        <action name="populatePos" class="vbsp.ims.action.khnv.DieuChinhKHActionSupport" method="populatePos">
            <result type="json"/>
        </action>        
        
     
        
        <action  name="machitieuCheck" class="vbsp.ims.action.khnv.ChitieuTindungXaAction" method="machitieuCheck">
            <result name="success" type="json"/>
            <result  name="error">  
                /kehoachnguonvon/error.jsp
            </result>  
        </action>
    </package>
    
