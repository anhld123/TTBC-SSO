<!DOCTYPE struts PUBLIC
"-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
"http://struts.apache.org/dtds/struts-2.0.dtd">

<struts>
    <package name="sso-package" namespace="/" extends="struts-default">
        <action name="beforeLogin_Proccess" class="vbsp.ims.sso.BeforeLoginAction">
            <result name="success" type="redirectAction">homeAction</result>  
            <result name="select_combined">/select_combined_sso.jsp</result>
            <result name="error">loginerror.jsp</result>  
        </action>
    
        <action name="selectCombinedAction" class="vbsp.ims.sso.BeforeLoginAction" method="selectCombinedAndBuildMenu">
            <result name="success" type="redirectAction">homeAction</result>
            <result name="error">/select_combined_sso.jsp</result>
        </action>

        <action name="homeAction" class="vbsp.ims.sso.SessionAction">
            <result name="success">loginsuccess.jsp</result>
            <result name="login">/login.jsp</result>
        </action>
    
        <action name="getSsoConfig" class="vbsp.ims.sso.SsoUrlAction" method="getSsoUrl">
        </action>
    </package>
</struts>