<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE struts PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
        "http://struts.apache.org/dtds/struts-2.0.dtd">

<struts>
    <package name="Report_Bctlsl" extends="struts-default,json-default">                
        <action name="bctlsl_list_report" 
                class="vbsp.ims.tlsl.ReportViewAction"
        method="execute">
            <result name="success">/WEB-INF/datawarehouse_report-tbl.jsp</result>
            <result name="error">/error.jsp</result>
        </action>       
                           
        <action name="bctlsl_generate_report" 
                class="vbsp.ims.tlsl.ReportViewAction"
        method="generate_data">
            <result name="success">downfile_bcnhanh.jsp</result>    
            <result name="error">/WEB-INF/pure_message_T.jsp</result>        
        </action>                          
        
        <action  name="bctlsl_build_group_combo" 
                 class="vbsp.ims.tlsl.ReportViewAction"
                 method="build_group_combo" >                                            
            <result name="populate" type="json"></result>                          
        </action>  
                                                                                      
        <action  name="bctlsl_build_period_combo" 
                 class="vbsp.ims.tlsl.ReportViewAction"
                 method="build_period_combo" >                                            
            <result name="success" type="json"></result>                          
        </action>                                                                                
     </package>          
</struts>