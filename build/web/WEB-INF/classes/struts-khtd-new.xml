<!DOCTYPE struts PUBLIC
"-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
"http://struts.apache.org/dtds/struts-2.0.dtd">

<!-- Author: Home -->
 
<struts>
     <!-- Configuration for the default package. -->
    <package name="khtd-new" extends="struts-default,json-default">
        <action name="populateTreeKHTD" class="vbsp.ims.action.KhtdActionSupport" method="populateTree">
            <result type="json" >
                <param name="root">nodes</param>
            </result>  
        </action>
        
        <action name="redirectGridKHT" class="vbsp.ims.action.KhtdActionSupport" method="redirectGridKHT">
            <result name="success">/kehoachtindung/khtd-grid-kehoachton.jsp</result>  
        </action>
        
        <action name="redirectGridXDKH" class="vbsp.ims.action.KhtdActionSupport" method="redirectGridXDKH">
            <result name="success">/kehoachtindung/khtd-grid-xaydungkh.jsp</result>  
        </action>
        
        <action name="redirectGridGiaoKH" class="vbsp.ims.action.KhtdActionSupport" method="redirectGridGiaoKH">
            <result name="success">/kehoachtindung/khtn-grid-giaokh.jsp</result>  
        </action>
        
        <action name="redirectGridDieuChinhKH" class="vbsp.ims.action.KhtdActionSupport" method="redirectGridDieuChinhKH">
            <result name="success">/kehoachtindung/khtd-grid-dieuchinhkh.jsp</result>  
        </action>
        
        <action name="getDataGridXayDungKH" class="vbsp.ims.action.KhtdGridActionSupport" method="xayDungKH">
            <result type="json"/>
        </action>
        
        <action name="getDataGridGiaoKH" class="vbsp.ims.action.KhtdGridActionSupport" method="giaoKH">
            <result type="json"/>
        </action>
        
        <action name="getDataGridDieuChinhKH" class="vbsp.ims.action.KhtdGridActionSupport" method="dieuChinhKH">
            <result type="json"/>
        </action>
        
        <action name="saveKeHoachTon" class="vbsp.ims.action.KhtdSaveActionSupport" method="saveKeHoachTon">
            <result name="success">/success_kthd.jsp</result>
        </action>
        
        <action name="saveXayDungKH" class="vbsp.ims.action.KhtdSaveActionSupport" method="saveXayDungKH">
            <result name="success">/success_kthd.jsp</result>
            <result name="error">/login.jsp</result>
        </action>
        
        <action name="saveGiaoKH" class="vbsp.ims.action.KhtdSaveActionSupport" method="saveGiaoKH">
            <result name="success">/success_kthd.jsp</result>
            <result name="error">/login.jsp</result>
        </action>
        
        <action name="saveDieuChinhKH" class="vbsp.ims.action.KhtdSaveActionSupport" method="saveDieuChinhKH">
            <result name="success">/success_khtd.jsp</result>
            <result name="error">/login.jsp</result>
        </action>
        
        
    </package>
</struts>
