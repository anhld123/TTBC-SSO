<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE struts PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
        "http://struts.apache.org/dtds/struts-2.0.dtd">

<struts>
    <package name="webapi" extends="struts-default,json-default">
        <action name="loadPageMain" class="vbsp.ims.webapi.WebapiAction" method="loadPageMain">
            <result name="success">/webapi/main-webapi-info.jsp</result>
            <result name="error">/webapi/success.jsp</result>
        </action>
               
        <action name="loadModuleWebApi" class="vbsp.ims.webapi.WebapiAction"  method="loadModuleWebApi">
            <result name="success" type="json"></result>        
        </action> 
        <action name="apitruyvan" class="vbsp.ims.webapi.WebapiAction" method="apitruyvan">
            <result name="custid">/webapi/table-custid.jsp</result>
            <result name="loanid">/webapi/table-loanid.jsp</result>
            <result name="group">/webapi/table-group.jsp</result> 
            <result name="group_cust">/webapi/table-group-cust.jsp</result>
            <result name="tide">/webapi/table-tide.jsp</result>
            <result name="error">/webapi/success.jsp</result>
        </action>
            
        <action name="popup" class="vbsp.ims.webapi.WebapiAction" method="popup">
            <result name="custid">/webapi/table-custid.jsp</result>
            <result name="loanid">/webapi/table-loanid.jsp</result>
            <result name="group">/webapi/table-group.jsp</result> 
            <result name="group_cust">/webapi/table-group-cust.jsp</result>
            <result name="tide">/webapi/table-tide.jsp</result>
            <result name="error">/webapi/success.jsp</result>
        </action>
    </package>
</struts>