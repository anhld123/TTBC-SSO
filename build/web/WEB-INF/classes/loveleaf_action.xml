<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE struts PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
        "http://struts.apache.org/dtds/struts-2.0.dtd">

<struts>
    <package name="loveleaf_package" 
             extends="struts-default,json-default">                
        <action name="loveleaf_list_donator" class="vbsp.ims.loveleaf.DonatorAction"
                method="execute">
            <result name="success">WEB-INF/loveleaf-donator-tbl.jsp</result>            
        </action>                                                                                         
        <action name="loveleaf_load_donator" class="vbsp.ims.loveleaf.DonatorEditAction"
                method="load_donator">
            <result name="success">WEB-INF/loveleaf-donator-infor.jsp</result>            
        </action>                                                                                         
        <action name="loveleaf_update_donator" class="vbsp.ims.loveleaf.DonatorEditAction"
                method="update_donator">
            <result name="success">WEB-INF/pure_message.jsp</result>            
        </action>              
        
        <action name="loveleaf_download_donator" class="vbsp.ims.loveleaf.ExportFileAction">
            <result name="success" type="stream">
                <param name="contentType">application/octet-stream</param>
                <param name="inputName">fileInputStream</param>
                <param name="contentDisposition">attachment;filename="${fileName}"</param>
                <param name="bufferSize">4096</param>
            </result>
        </action>
        
        <action name="loveleaf_downloadFileUpload" class="vbsp.ims.loveleaf.ExportFileAction" 
                method="downloadFileUpload">
            <result name="success">/viewfilebc.jsp</result>
        </action>
        
        <action name="qtt_downloadFileUpload" class="vbsp.ims.loveleaf.ExportFileAction" 
                method="downloadQTTFileUpload">
            <result name="success">/viewfilebc.jsp</result>
        </action>
        
        <action name="vvc_downloadFileUpload" class="vbsp.ims.loveleaf.ExportFileAction" 
                method="downloadVVCFileUpload">
            <result name="success">/viewfilebc.jsp</result>
        </action>
                           
        <action name="loveleaf_upload_file" class="vbsp.ims.loveleaf.PoorUploadAction"
        method="upload_file">
            <result name="success">/WEB-INF/loveleaf-poor-upload-detail.jsp</result>
            <result name="error">/error.jsp</result>
        </action>        
                                                          
        <action name="loveleaf_view_upload_file" class="vbsp.ims.loveleaf.PoorUploadAction"
        method="view_upload_file">
            <result name="success">/WEB-INF/loveleaf-poor-upload-tbl.jsp</result>
            <result name="error">/error.jsp</result>
        </action>    
                                                              
        <action name="loveleaf_view_poor_infor" class="vbsp.ims.loveleaf.PoorUploadAction"
        method="view_poor_infor">
            <result name="success">/WEB-INF/loveleaf-poor-infor-tbl.jsp</result>
            <result name="error">/error.jsp</result>
            <result name="input">/error.jsp</result>
        </action>        
        
        <action name="loveleaf_list_wrong_poor" class="vbsp.ims.loveleaf.PoorUploadAction"
        method="list_wrong_poor">
            <result name="success">/WEB-INF/loveleaf-poor-infor-tbl.jsp</result>
            <result name="error">/error.jsp</result>
            <result name="input">/error.jsp</result>
        </action>        
                                                          
        <action name="loveleaf_open_upload" class="vbsp.ims.loveleaf.PoorUploadAction"
        method="open_upload">
            <result name="success">/WEB-INF/loveleaf-poor-upload-main.jsp</result>           
        </action>            
                                                      
        <action name="loveleaf_money_move" class="vbsp.ims.loveleaf.MoneyMoveAction"
        method="execute">
            <result name="success">/WEB-INF/loveleaf-money-move-tbl.jsp</result>           
        </action>                  
                                                
        <action name="loveleaf_pos_update_status" class="vbsp.ims.loveleaf.MoneyMoveAction"
        method="update_status">
            <result name="success">/WEB-INF/pure_message_T.jsp</result>           
        </action>                                                          
                                            
        <action  name="loveleaf_build_period_combo" 
                 class="vbsp.ims.loveleaf.DonatorAction"
                 method="build_period_combo" >                                            
            <result name="success" type="json"></result>                          
        </action>     
        
               <action  name="loveleaf_build_program_combo" 
                 class="vbsp.ims.loveleaf.DonatorAction"
                 method="buildProgramCombo" >                                            
            <result name="success" type="json"></result>                          
        </action>                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                                
    </package>          
</struts>