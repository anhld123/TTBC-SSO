<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE struts PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
        "http://struts.apache.org/dtds/struts-2.0.dtd">
<struts>    
    <package name="FastReportConfig_Pkg" 
             extends="struts-default,json-default">              
        <action  name="FRCFG_Build_Combo" 
                 class="vbsp.ims.fastreportconfig.FastReportConfigAction"
                 method="list_modules" >                                            
            <result name="success" type="json"></result>                          
        </action>  
        
        <action  name="FRCFG_Build_Group_Combo" 
                 class="vbsp.ims.fastreportconfig.FastReportConfigAction"
                 method="build_group_combo" >                                            
            <result name="success" type="json"></result>                          
        </action>  
                                            
        <action  name="FRCFG_Display_Form" 
                 class="vbsp.ims.fastreportconfig.FastReportConfigAction"
                 method="display" >                                            
            <result name="success" >/FASTREPORT-CONFIG/fastreport-group-configure.jsp</result>                          
            <result name="input" >/FASTREPORT-CONFIG/fastreport-variable-configure.jsp</result>                          
        </action>    
                                          
        <action  name="FRCFG_Display_Query_Table" 
                 class="vbsp.ims.fastreportconfig.FastReportConfigAction"
                 method="listGroupQuery" >                                            
            <result name="success" >/FASTREPORT-CONFIG/fastreport-group-configure-table.jsp</result>                                                            
        </action> 
           
        <action  name="FRCFG_Display_Variable_Table" 
                 class="vbsp.ims.fastreportconfig.FastReportParaAction"
                 method="listParaRptQueries" >                                            
            <result name="success" >/FASTREPORT-CONFIG/fastreport-variable-configure-table.jsp</result>                                                            
        </action>    
                                          
        <action  name="FRCFG_Get_NewId" 
                 class="vbsp.ims.fastreportconfig.FastReportConfigAction"
                 method="get_NewCode" >                                            
            <result name="success" >/FASTREPORT-CONFIG/fastreport-group-newid.jsp</result>                                                            
        </action>     
                                         
        <action  name="FRCFG_Update_Group" 
                 class="vbsp.ims.fastreportconfig.FastReportConfigAction"
                 method="update" >                                            
            <result name="success" >/message-success.jsp</result>                                                            
        </action> 
                                             
        <action  name="FRCFG_Update_ParaKey" 
                 class="vbsp.ims.fastreportconfig.FastReportParaAction"
                 method="update_ParaKey" >                                            
            <result name="success" >/message-success.jsp</result>                                                            
            <result name="error" >/message-success.jsp</result>                                                            
        </action>           
        
        <action name="GET_QUERYGROUP_PRI" class="vbsp.ims.fastreportconfig.FastReportConfigAction" 
                method="get_pri_list">
            <result name="success">/FASTREPORT-CONFIG/select_privileage.jsp</result>
        </action>                         
        
        <action name="SAVE_DATA_TEMP_QUERYGROUP" class="vbsp.ims.fastreportconfig.FastReportConfigAction"  
                method="save_data_temp">
            <result name="success">/WEB-INF/pure_message_T.jsp</result>
            <result name="error">/WEB-INF/pure_message_T.jsp</result>        
        </action>                                      
    </package>
</struts>
