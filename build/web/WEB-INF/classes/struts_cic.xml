<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE struts PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
        "http://struts.apache.org/dtds/struts-2.0.dtd">

<struts>
    <package name="bctc_cic" extends="struts-default,json-default">
        <action name="loadPageMainCic" class="vbsp.ims.bctccic.BCTCCICAction" method="loadPageMain">
            <result name="success">/bctc_cic/main-cic-info.jsp</result>
            <result name="error">/bctc_cic/success.jsp</result>
        </action>
               
        <action name="loadModuleCic" class="vbsp.ims.bctccic.BCTCCICAction"  method="loadModuleCic">
            <!--<result name="success" type="json"></result>-->     
             <result name="success">/bctc_cic/loai-module-cic.jsp</result>
            <result name="error">/bctc_cic/success.jsp</result>   
        </action> 
        
        
        <action name="loadDataDoanhnghiep" class="vbsp.ims.bctccic.BCTCCICAction" method="loadDataDoanhnghiep">
            <result name="CIC001">/bctc_cic/table-candoiketoan.jsp</result>
            <result name="CIC002">/bctc_cic/table-candoiketoan.jsp</result>
            <result name="CIC003">/bctc_cic/table-candoiketoan.jsp</result>
            <result name="CIC004">/bctc_cic/table-candoiketoan.jsp</result>
            <result name="checksend">/bctc_cic/table_unlock.jsp</result>
            <result name="error">/bctc_cic/success.jsp</result>
        </action>
        <action name="saveBctcCic" class="vbsp.ims.bctccic.BCTCCICAction" method="saveBctcCic">
            <result name="success">/bctc_cic/success.jsp</result>
            <result name="error">/bctc_cic/success.jsp</result>
        </action>
        
        <!--gui so lieu -->
        <action name="sendCIC" class="vbsp.ims.bctccic.BCTCCICAction"  method="sendCIC">
            <result name="success">/BCQT/success.jsp</result>
            <result name="error">/BCQT/success.jsp</result>        
        </action>
                
    </package>
</struts>