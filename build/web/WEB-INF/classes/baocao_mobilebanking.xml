<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE struts PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
        "http://struts.apache.org/dtds/struts-2.0.dtd">
<struts>           
    <package name="main_mobilebanking" extends="struts-default,json-default">                       
        <action name="loadAllmobilebanking" class="vbsp.ims.mobilebanking.action.ActionMobileBankingMain"  method="execute">
            <result name="success" type="json"></result>        
        </action>   
        
        <action name="LoadParaMobileBanking" class="vbsp.ims.mobilebanking.action.ActionMobileBankingMain"  method="loadPataMobileBanking">
            <result name="success">/mobilebanking/para-mb-main.jsp</result>
            <result name="error">/mobilebanking/success.jsp</result>        
        </action>  
        
        <action name="MOBILE_002" class="vbsp.ims.mobilebanking.action.MOBILE_002"  method="load">
            <result name="themsua">/mobilebanking/02-ttcb-themsua.jsp</result>
            <result name="truyvan">/mobilebanking/02-ttcb-truyvan.jsp</result>                  
        </action>
        
        
        <action name="MOBILE_004" class="vbsp.ims.mobilebanking.action.MOBILE_004"  method="load">
            <result name="themsua">/mobilebanking/04-ttxa-themsua.jsp</result>
            <result name="truyvan">/mobilebanking/04-ttxa-truyvan.jsp</result>                  
        </action>

        
        <action name="load_loaibc"  class="vbsp.ims.mobilebanking.action.ActionMobileBankingMain" method="loadAll_BC">
            <!--<result name="success" type="json"></result>-->
            <result name="success">/muasam-taisan/table_list_bc.jsp</result>
            <result name="error">sbv/success.jsp</result>
        </action>
    </package>
</struts>
