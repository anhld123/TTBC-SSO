<?xml version="1.0" encoding="UTF-8" ?>

<!DOCTYPE struts PUBLIC
        "-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
        "http://struts.apache.org/dtds/struts-2.0.dtd">
<struts>    
    <package name="SysParam" extends="struts-default,json-default">
        <action  name="listSysParam" class="vbsp.ims.action.SysParamAction"
                  method="list">
            <result name="success">/WEB-INF/sysparam-view.jsp</result>
            <result name="error"></result>        
        </action>        
        <action  name="sysncSysParam" class="vbsp.ims.action.SysParamAction"
                  method="update">
            <result name="success">/WEB-INF/message.jsp</result>
            <result name="error"></result>        
        </action>                 
    </package>
</struts>
