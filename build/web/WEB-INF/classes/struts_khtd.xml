<!DOCTYPE struts PUBLIC
"-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
"http://struts.apache.org/dtds/struts-2.0.dtd">

<!-- Author: Home -->
 
<struts>
     <!-- Configuration for the default package. -->﻿    
    <package name="glkhtd" extends="struts-default,json-default">
            <result-types>
                <result-type name="json" class="org.apache.struts2.json.JSONResult" />
            </result-types>  


            <action name="GLKHTDTree" class="vbsp.ims.khtd.GLKHTD" >
                <result name="success" type="json" >
                    <param name="root">nodes</param>
                 </result>  
            </action>  
            
            <action name="GLKHTD_KH" class="vbsp.ims.khtd.GLKHTD" method="GLKHTD_KH">
                <result name="success" > GLKHTD_KH.jsp </result>  
                <result name="error">GLKHTD.jsp</result>
            </action>  
            
            <action name="GLKHTD_TH" class="vbsp.ims.khtd.GLKHTD" method="GLKHTD_TH">
                <result name="success" > GLKHTD.jsp </result>  
                <result name="error">GLKHTD.jsp</result>
            </action>

            <action name="GLKHTD_OUT" class="vbsp.ims.khtd.GLKHTD" method="GLKHTD_OUT">
                <result name="success" > index.jsp </result>  
            </action>
            
            <action name="GLKHTDGrid" class="vbsp.ims.khtd.GLKHTD_KH_View" >
                <result name="success" type="json" />
            </action> 

            <action name="GLKHTDGrid-Edit" class="vbsp.ims.khtd.GLKHTD_KH_Edit" >
                <result name="success" type="json"> GLKHTD_KH.jsp    </result>
                <result name="input" type="json">   GLKHTD_KH.jsp    </result>
            </action>       

            <action name="GLKHTD_KH_Action" class="vbsp.ims.khtd.GLKHTD_KH_Action" >
                <result >   GLKHTD.jsp  </result>
            </action>  
            
            <action name="GLKHTD_Save" class="vbsp.ims.khtd.GLKHTD_KH_Action" method="GLKHTD_Save">
                <result name="success"> GLKHTD_KH.jsp </result>
                <result name="error">   GLKHTD_KH.jsp </result>
            </action>                                  

            <action name="DownloadFile1_TH" class="vbsp.ims.khtd.GLKHTD" method="DownloadFile1_TH">
                <result name="success" type="stream">
                    <param name="contentDisposition">attachment;filename=${downloadFile1}</param>
                    <param name="contentType">application/octet-stream</param>
                    <param name="inputName">fileInputStream</param>
                    <param name="bufferSize">1024</param>
                </result>
            </action>                        

            <action name="DownloadFile2_TH" class="vbsp.ims.khtd.GLKHTD" method="DownloadFile2_TH">
                <result name="success" type="stream">
                    <param name="contentDisposition">attachment;filename=${downloadFile2}</param>
                    <param name="contentType">application/octet-stream</param>
                    <param name="inputName">fileInputStream</param>
                    <param name="bufferSize">1024</param>
                </result>
            </action>                             
	</package>
</struts>