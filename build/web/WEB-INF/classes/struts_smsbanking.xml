<!DOCTYPE struts PUBLIC
"-//Apache Software Foundation//DTD Struts Configuration 2.0//EN"
"http://struts.apache.org/dtds/struts-2.0.dtd">

<struts>        
    <package name="SMSBanking" extends="struts-default,json-default">
        
        <action name="SMSListCustomer" 
                class="vbsp.smsbanking.CustomerQueryAction" 
                method="listCustomers">
            <result name="success">/SMSBanking/smsbankingcustomer-view.jsp</result>
        </action>
        
        <action name="SMSViewCustomer" 
                class="vbsp.smsbanking.CustomerQueryAction" 
                method="viewCustomer">
            <result name="success">/SMSBanking/smsbankingcustomer-infor.jsp</result>
        </action>
        
        <action name="SMSUpdateCustomer" 
                class="vbsp.smsbanking.CustomerQueryAction" 
                method="updateCustomer">
            <result name="success">/SMSBanking/message.jsp</result>
        </action>
        
        
                                       
    </package>    
</struts>
