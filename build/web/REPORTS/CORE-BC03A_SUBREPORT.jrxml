<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="CORE-BC03A_SUBREPORT" language="groovy" pageWidth="595" pageHeight="842" columnWidth="595" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_NGAYBC" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_TONGHOP" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString language="plsql">
		<![CDATA[select gdv TELLER_NAME, sbt REF_NO, tk ||'-'|| AC_DESC AC_NO, DECODE(noco,'D',sotien,0) DEBIT_AMT,DECODE(noco,'C',sotien,0) CREDIT_AMT,
     DECODE(noco,'D',sotien,0) DEBIT_CONV_AMT,DECODE(noco,'C',sotien,0) CREDIT_CONV_AMT,
     'VND' CCY_DESC
  from hsbt,dmpos y, (select po_posflg,po_ma,po_macn from dmpos where po_ma = $P{PARA_MAPGD}) z, dmtkgl
 where MAPGD = Y.PO_MA
    AND substr(tk,1,2) not in ('95','96')
    AND ngaybc = $P{PARA_NGAYBC}
	AND tk = bank_ac
    AND DECODE(z.PO_POSFLG,'H',1,'S',y.PO_MA, y.PO_MACN) = DECODE(z.PO_POSFLG,'H',1,z.po_ma)
    AND DECODE('Y',$P{PARA_TONGHOP},1,y.po_ma) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD})
UNION ALL
SELECT * FROM (
select gdv TELLER_NAME, sbt REF_NO, tk_no ||'-'|| AC_DESC AC_NO, DECODE(noco,'D',sotien,0) DEBIT_AMT,DECODE(noco,'C',sotien,0) CREDIT_AMT,
     DECODE(noco,'D',sotien,0) DEBIT_CONV_AMT,DECODE(noco,'C',sotien,0) CREDIT_CONV_AMT,
     'VND' CCY_DESC
  from hsbt,dmpos y, (select po_posflg,po_ma,po_macn from dmpos where po_ma = $P{PARA_MAPGD}) z, dmtkgl
 where MAPGD = Y.PO_MA
    AND substr(tk,1,2) not in ('95','96')
    AND ngaybc = $P{PARA_NGAYBC}
	AND tk_no = bank_ac
	AND substr(tk,1,1)='0'
    AND DECODE(z.PO_POSFLG,'H',1,'S',y.PO_MA, y.PO_MACN) = DECODE(z.PO_POSFLG,'H',1,z.po_ma)
    AND DECODE('Y',$P{PARA_TONGHOP},1,y.po_ma) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD})
UNION  ALL
select gdv TELLER_NAME, sbt REF_NO, tk_co ||'-'|| AC_DESC AC_NO, DECODE(noco,'D',sotien,0) DEBIT_AMT,DECODE(noco,'C',sotien,0) CREDIT_AMT,
     DECODE(noco,'D',sotien,0) DEBIT_CONV_AMT,DECODE(noco,'C',sotien,0) CREDIT_CONV_AMT,
     'VND' CCY_DESC
  from hsbt,dmpos y, (select po_posflg,po_ma,po_macn from dmpos where po_ma = $P{PARA_MAPGD}) z, dmtkgl
 where MAPGD = Y.PO_MA
    AND substr(tk,1,2) not in ('95','96')
    AND ngaybc = $P{PARA_NGAYBC}
	AND tk_co = bank_ac
	AND substr(tk,1,1)='0'
    AND DECODE(z.PO_POSFLG,'H',1,'S',y.PO_MA, y.PO_MACN) = DECODE(z.PO_POSFLG,'H',1,z.po_ma)
    AND DECODE('Y',$P{PARA_TONGHOP},1,y.po_ma) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) )
 order by AC_NO,TELLER_NAME]]>
	</queryString>
