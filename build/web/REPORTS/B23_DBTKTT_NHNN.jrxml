	<parameter name="PARA_NGAYBC" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString language="plsql">
		<![CDATA[SELECT
        NVL((select sum(ct_giatri)  from ct_vbsp where ct_mact like '1A2%' and CT_CAPTH ='H' and CT_MACN ='000100'
             and trunc(CT_NGAYBC) = $P{PARA_NGAYBC}),0) dsctd_vnd,
         NVL((select sum(ct_giatri)  from ct_vbsp where ct_mact like '1A3%' and CT_CAPTH ='H' and CT_MACN ='000100'
             and trunc(CT_NGAYBC) = $P{PARA_NGAYBC}),0)   dstntd_vnd,'0' dsctd_nt,'0' dstntd_nt FROM DUAL]]>
	</queryString>
	<field name="DSCTD_VND" class="java.math.BigDecimal"/>
	<field name="DSTNTD_VND" class="java.math.BigDecimal"/>
