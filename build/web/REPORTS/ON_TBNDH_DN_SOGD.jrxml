					<rightPen lineWidth="0.0" lineColor="#666666"/>
				</box>
				<textElement textAlignment="Justified" verticalAlignment="Middle" rotation="None" markup="none">
					<font fontName="Times New Roman" size="14" isBold="false" isItalic="false" isUnderline="false" isStrikeThrough="false" pdfEncoding="Identity-H" isPdfEmbedded="false"/>
					<paragraph lineSpacing="Single" firstLineIndent="27"/>
				</textElement>
				<textFieldExpression><![CDATA["Kính gửi: Giám đốc " + $P{PARA_TENDN}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement uuid="fce5aac3-d5e2-4d1e-a1d0-f1704560c51e" mode="Transparent" x="0" y="37" width="454" height="113" isRemoveLineWhenBlank="true" forecolor="#000000" backcolor="#FFFFFF"/>
				<box leftPadding="3" bottomPadding="3">
					<pen lineWidth="0.0" lineColor="#666666"/>
					<topPen lineWidth="0.0" lineColor="#666666"/>
					<leftPen lineWidth="0.0" lineColor="#666666"/>
					<bottomPen lineWidth="0.0" lineColor="#666666"/>
					<rightPen lineWidth="0.0" lineColor="#666666"/>
				</box>
				<textElement textAlignment="Justified" verticalAlignment="Top" rotation="None" markup="styled">
					<font fontName="Times New Roman" size="14" isBold="false" isItalic="false" isUnderline="false" isStrikeThrough="false" pdfEncoding="Identity-H" isPdfEmbedded="false"/>
					<paragraph lineSpacing="1_1_2" firstLineIndent="27" spacingBefore="6" spacingAfter="3"/>
				</textElement>
				<textFieldExpression><![CDATA["Căn cứ hợp đồng tín dụng số ……………, ký kết ngày …./…./…... giữa Sở giao dịch NHCSXH và "+$P{PARA_TENDN}+" về việc vay vốn chương trình " + $P{TEN_CHTRINH}+". Theo nội dung thỏa thuận tại Điều 1, Điều 3 của Hợp đồng của Quý khách hàng sẽ đến hạn trả nợ vào ngày " +$P{PARA_NGAYDH} + ", cụ thể như sau:"+ '\n' +"<style isBold='true'>1. Số tiền gốc: </style>"+(new DecimalFormat("#,###")).format($P{PARA_GOCDH}) + "đ (Bằng chữ: <style isItalic='true'>"+$P{DOC_GOC}+"</style>)."+ '\n' +"<style isBold='true'>2. Số tiền lãi </style>(từ ngày "+$P{PARA_LAITUNGAY}+"- "+$P{PARA_LAIDENNGAY}+"): "+(new DecimalFormat("#,###")).format($P{PARA_LAIDH})+"đ (Bằng chữ: <style isItalic='true'>"+$P{DOC_LAI}+"</style>).\nSở Giao dịch NHCSXH thông báo đến "+$P{PARA_TENDN}+" được biết để có kế hoạch trả nợ đúng hạn. Nếu đến hạn Quý khách hàng không trả nợ, số tiền gốc trên sẽ chuyển nợ quá hạn với lãi suất nợ quá hạn bằng 130% lãi suất trong hạn."+'\n'+"Rất mong được sự hợp tác của Quý khách hàng!"]]></textFieldExpression>
			</textField>
		</band>
	</detail>
