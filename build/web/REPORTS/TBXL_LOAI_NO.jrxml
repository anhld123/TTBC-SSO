		<band height="109">
			<textField isStretchWithOverflow="true">
				<reportElement uuid="23a68a78-f2cf-4707-be6f-4a623ad5be9b" positionType="Float" x="0" y="74" width="462" height="20" isRemoveLineWhenBlank="true"/>
				<box leftPadding="0"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="14" pdfEncoding="Identity-H"/>
					<paragraph lineSpacing="1_1_2" lineSpacingSize="1.3" firstLineIndent="40"/>
				</textElement>
				<textFieldExpression><![CDATA["Nhận được công văn này, yêu cầu chi nhánh NHCSXH" + $F{TEN} + " triển khai thực hiện. Quá trình thực hiện nếu có vướng mắc đề nghị phản ánh về Hội sở chính (Ban Quản lý và xử lý nợ rủi ro) để xem xét, giải quyết./."]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement uuid="f03c3e55-92bc-4fd0-8965-94906996fe31" positionType="Float" x="0" y="3" width="462" height="61" isRemoveLineWhenBlank="true"/>
				<box leftPadding="0"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="14" pdfEncoding="Identity-H"/>
					<paragraph lineSpacing="1_1_2" lineSpacingSize="1.3" firstLineIndent="40"/>
				</textElement>
				<textFieldExpression><![CDATA["Căn cứ nguyên nhân không được chấp thuận đề nghị Giám đốc chi nhánh NHCSXH"
+$F{TEN} +
" chỉ đạo Giám đốc NHCSXH nơi cho vay rà soát lại nếu đủ điều kiện xử lý nợ rủi ro thì bổ sung thủ tục và trình xử lý rủi ro theo quy định."]]></textFieldExpression>
			</textField>
