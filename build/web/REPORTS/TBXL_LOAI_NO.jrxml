	<detail>
		<band height="193" splitType="Stretch">
			<textField isStretchWithOverflow="true">
				<reportElement uuid="78e67922-80dd-48d3-96b0-7f5278eacf88" positionType="Float" x="0" y="103" width="462" height="20"/>
				<box leftPadding="0"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="14" pdfEncoding="Identity-H"/>
					<paragraph lineSpacing="Proportional" firstLineIndent="40"/>
				</textElement>
				<textFieldExpression><![CDATA["Kính gửi: Chi nhánh Ngân hàng Chính sách xã hội"+ $F{TEN}]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement uuid="969f5e96-c6b1-4181-baa4-15ee97e713e9" positionType="Float" x="0" y="138" width="462" height="20"/>
				<box leftPadding="0"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="14" pdfEncoding="Identity-H"/>
					<paragraph lineSpacing="1_1_2" firstLineIndent="40" tabStopWidth="20"/>
				</textElement>
				<textFieldExpression><![CDATA["Căn cứ Quyết định số 15/QĐ-HĐQT ngày 27/01/2011 của Chủ tịch Hội đồng quản trị Ngân hàng Chính sách xã hội (NHCSXH) về Ban hành Quy định xử lý nợ bị rủi ro trong hệ thống NHCSXH; "]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement uuid="786523be-11af-4ea6-9cc7-ae4d9e77952d" positionType="Float" x="0" y="167" width="462" height="20"/>
				<box leftPadding="0"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="14" pdfEncoding="Identity-H"/>
					<paragraph lineSpacing="1_1_2" firstLineIndent="40" tabStopWidth="20"/>
				</textElement>
				<textFieldExpression><![CDATA["Sau khi xem xét Tờ trình và hồ sơ đề nghị xử lý nợ rủi ro đợt " + $F{DOTRR} + " năm " + $P{PARA_NAMBC}  +
" chi nhánh gửi Hội sở chính, Tổng Giám đốc NHCSXH thông báo không chấp thuận xử lý nợ bị rủi ro đợt " +
$F{DOTRR}+ " năm " + $P{PARA_NAMBC}  + " của chi nhánh như sau:"]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement uuid="43909b7f-9339-4583-9d72-5efaa942660c" x="0" y="0" width="183" height="32"/>
