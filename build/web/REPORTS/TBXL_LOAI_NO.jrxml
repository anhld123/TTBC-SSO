<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="TBXL_LOAI_NO" language="groovy" pageWidth="595" pageHeight="842" columnWidth="462" leftMargin="85" rightMargin="48" topMargin="56" bottomMargin="0" uuid="f7f0da09-270c-4e4d-8a79-45bac27ad0c4">
	<property name="ireport.zoom" value="1.3636363636363658"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="557"/>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_NAMBC" class="java.lang.String"/>
	<parameter name="PARA_DOTRR" class="java.lang.String"/>
	<parameter name="PARA_KYDUYET" class="java.lang.String"/>
	<queryString>
		<![CDATA[select
rr_macn, (case when  MA IN ('45','53','03','06','34') then ' thành phố ' else ' tỉnh ' end)||INITCAP (trim(replace( TEN,'TP',''))) TEN,
trim( replace(to_char(count(case when rr_nhomrr = '02' then rr_soku end ),'999,999,999,999,999,999'),',','.'))  somon_khoanh,
trim( replace(to_char(sum(case when rr_nhomrr = '02' then RR_DNGHI_DNO + RR_DNGHI_LAI end ),'999,999,999,999,999,999'),',','.'))  sotien_khoanh,
trim( replace(to_char(sum(case when rr_nhomrr = '02' then RR_DNGHI_DNO  end ),'999,999,999,999,999,999'),',','.')) goc_khoanh,
trim( replace(to_char(sum(case when rr_nhomrr = '02' then RR_DNGHI_LAI end ),'999,999,999,999,999,999'),',','.')) lai_khoanh,
trim( replace(to_char(count(case when rr_nhomrr = '03' then rr_soku end ),'999,999,999,999,999,999'),',','.')) somon_xoa,
trim( replace(to_char(sum(case when rr_nhomrr = '03' then RR_DNGHI_DNO + RR_DNGHI_LAI end ),'999,999,999,999,999,999'),',','.')) sotien_xoa,
trim( replace(to_char(sum(case when rr_nhomrr = '03' then RR_DNGHI_DNO  end ),'999,999,999,999,999,999'),',','.')) goc_xoa,
trim( replace(to_char(sum(case when rr_nhomrr = '03' then RR_DNGHI_LAI end ),'999,999,999,999,999,999'),',','.')) lai_xoa,
DECODE ($P{PARA_DOTRR},1, 'I',2,'II',3,'III') DOTRR,
$P{PARA_KYDUYET} pho_tgd
 from hsrr_wb, dmtinh where to_char(rr_ngaybc,'yyyy') = $P{PARA_NAMBC}
     and rr_dotrr = $P{PARA_DOTRR}
     and rr_macn  = $P{PARA_MAPGD}
     and RR_PDUYET_CAP = 'H'
     and rr_trangthai = 'R'
     and substr(rr_macn,3,2) = MA
 group by  rr_macn, (case when  MA IN ('45','53','03','06','34') then ' thành phố ' else ' tỉnh ' end)||INITCAP (trim(replace( TEN,'TP','')))]]>
	</queryString>
	<field name="RR_MACN" class="java.lang.String"/>
	<field name="TEN" class="java.lang.String"/>
	<field name="SOMON_KHOANH" class="java.lang.String"/>
	<field name="SOTIEN_KHOANH" class="java.lang.String"/>
	<field name="GOC_KHOANH" class="java.lang.String"/>
	<field name="LAI_KHOANH" class="java.lang.String"/>
	<field name="SOMON_XOA" class="java.lang.String"/>
	<field name="SOTIEN_XOA" class="java.lang.String"/>
	<field name="GOC_XOA" class="java.lang.String"/>
	<field name="LAI_XOA" class="java.lang.String"/>
	<field name="DOTRR" class="java.lang.String"/>
	<field name="PHO_TGD" class="java.lang.String"/>
