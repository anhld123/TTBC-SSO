<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="sub_title" language="groovy" pageWidth="350" pageHeight="842" columnWidth="350" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select ten from DMHUYEN where ma = substr($P{PARA_MAPGD},3,4)]]>
	</queryString>
	<field name="TEN" class="java.lang.String"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="50" splitType="Stretch">
			<image>
				<reportElement x="0" y="2" width="55" height="48"/>
				<imageExpression class="java.lang.String"><![CDATA["/vbsp_LOGO.JPG"]]></imageExpression>
			</image>
			<textField>
				<reportElement x="59" y="23" width="281" height="17"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="true" pdfEncoding="Identity-H"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["Phòng giao dịch " + $F{TEN}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement x="59" y="6" width="281" height="17"/>
				<textElement textAlignment="Left" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="true" pdfEncoding="Identity-H"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["NGÂN HÀNG CHÍNH SÁCH XÃ HỘI"]]></textFieldExpression>
			</textField>
		</band>
	</title>
</jasperReport>
