	<parameter name="GROUP_ID" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["D:\\VBSPREPORTS\\MODIFIEDREPORTS\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT MPI_CUST_ID CUSTOMER_CODE,
       NVL(LL_NAME,F_NAME||' '||M_NAME||' '|| L_NAME)     CUSTOMER_NAME,
       SUBSTR(PSP_SPEC_DESC,1,INSTR(PSP_SPEC_DESC,'-',1)-1) LOAN_PRODUCT,
       MPI_LEGACY_ID LOAN_CODE,
       MPF_PRIN_BALANCE PRIN_BALANCE,
       MPF_RPA          RPA_BALANCE,
       MPF_INST_INT_BALANCE INT_DUE_BALANCE,
       TO_CHAR(MPI_ST_DT,'DD/MM/YYYY')    BOOKING_DATE,
       TO_CHAR(MPI_ORG_MAT_DT,'DD/MM/YYYY') MATURITY_DATE
  FROM GR010MB A,
       M_PROJ_INFO B,
       M_PROJ_FINBAL_VIEW C,
       P_SPECIFIC_PRD D,
        gm001mb E
  WHERE MPI_CUST_ID = CIF_NO
   AND B.REC_ST    = 'A'
   AND MPI_CUST_ID = MPF_CUST_ID
   AND MPI_CON_ID  = MPF_CON_ID
   AND MPI_PROJ_ID = MPF_PROJ_ID
   AND MPF_TOT_DISB_AMT > 0
   AND MPI_SPRD_CD = PSP_SPEC_CD
   AND NVL(MPI_GROUP_ID,'X') <> 'X'
   AND MPI_GROUP_ID = NVL($P{GROUP_ID},MPI_GROUP_ID)
   AND MPI_GROUP_ID =E.GROUP_ID
    AND MPI_ORG_POS_CD = NVL($P{POS_CD},MPI_ORG_POS_CD)
  ORDER BY commune_desc,mass_org,group_id,mpi_cust_id,SUBSTR(PSP_SPEC_DESC,1,INSTR(PSP_SPEC_DESC,'-',1)-1),NVL(LL_NAME,F_NAME||' '||M_NAME||' '|| L_NAME),MPI_LEGACY_ID]]>
	</queryString>
