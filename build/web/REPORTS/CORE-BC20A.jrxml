<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="CORE-BC20A" language="groovy" pageWidth="985" pageHeight="685" orientation="Landscape" columnWidth="952" leftMargin="20" rightMargin="13" topMargin="20" bottomMargin="20" uuid="d08e1e60-5033-4996-8664-7198925a58f1">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_NGAYBC" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_MAXA" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[--CORE-BC20A
SELECT *
FROM
	(SELECT KU_MAKH CUSTOMER_CODE,
			TENKH CUSTOMER_NAME,
			KU_SOKU LOAN_CODE,
			KU_NGAYVAY DISBURSAL_DATE,
			KU_NGAYDHAN_1 MATURITY_DATE,
			KU_GNGAN  DISB_AMT,
			KU_DNOTHAN PRIN_BALANCE,
			KU_DNOQHAN OVERDUE_BALANCE,
			KU_DNOKHOANH FREEZE_BALANCE,
			KU_TON_RPA RPA_BALANCE,
			NVL(KU_LAITONTHAN,0) + NVL(KU_LAITONQHAN,0) INT_DUE_BALANCE,
			KU_NGAYGDGN LAST_TRAN_DATE,
			C.MA COMMUNE_ID,
			C.TEN COMMUNE_NAME,
			KU_SCHEM_CD SPEC_CD,
			SC_TEN SPEC_DESC
		FROM HSKU A, DMXA C, DM_SCHEME D,
			(SELECT KH_MAKH MAKH, KH_TENKH TENKH FROM HSKH where KH_MAPGD = $P{PARA_MAPGD} and KH_TTRANG <> 'C'
				UNION SELECT DN_MA MAKH, DN_TEN TENKH FROM HSKH_DN where DN_MAPGD = $P{PARA_MAPGD} and  DN_TTRANG <> 'C') B
		WHERE A.KU_MAKH = B.MAKH
				AND SUBSTR(KU_MADP, 1, 6) = C.MA
				AND KU_SCHEM_CD = SC_MA
				AND NVL(KU_TTMONVAY,'OPEN') <> 'CLOSE'
				AND KU_NGAYBC = TO_DATE($P{PARA_NGAYBC})
				AND KU_MAPGD = $P{PARA_MAPGD}
				AND KU_DNOTHAN+KU_DNOQHAN+KU_DNOKHOANH+NVL(KU_LAITONTHAN,0) + NVL(KU_LAITONQHAN,0)>0
				AND DECODE($P{PARA_MAXA}, '000000', 1, SUBSTR(KU_MADP,1,6))= DECODE($P{PARA_MAXA}, '000000', 1, $P{PARA_MAXA})
	UNION ALL
	SELECT KU_MAKH CUSTOMER_CODE,
			TENKH CUSTOMER_NAME,
			KU_SOKU LOAN_CODE,
			KU_NGAYVAY DISBURSAL_DATE,
			KU_NGAYDHAN_1 MATURITY_DATE,
			KU_GNGAN  DISB_AMT,
			KU_DNOTHAN PRIN_BALANCE,
			KU_DNOQHAN OVERDUE_BALANCE,
			KU_DNOKHOANH FREEZE_BALANCE,
			KU_TON_RPA RPA_BALANCE,
			NVL(KU_LAITONTHAN,0) + NVL(KU_LAITONQHAN,0) INT_DUE_BALANCE,
			KU_NGAYGDGN LAST_TRAN_DATE,
			SUBSTR(KU_MADP,1,6) COMMUNE_ID,
			'Vay truc tiep' COMMUNE_NAME,
			KU_SCHEM_CD SPEC_CD,
			SC_TEN SPEC_DESC
		FROM HSKU A, DM_SCHEME D,
			(SELECT KH_MAKH MAKH, KH_TENKH TENKH FROM HSKH where KH_MAPGD = $P{PARA_MAPGD} and KH_TTRANG <> 'C'
				UNION SELECT DN_MA MAKH, DN_TEN TENKH FROM HSKH_DN where DN_MAPGD = $P{PARA_MAPGD} and  DN_TTRANG <> 'C') B
		WHERE A.KU_MAKH = B.MAKH
				AND SUBSTR(KU_MADP, 5, 4) = '0000'
				AND KU_SCHEM_CD = SC_MA
				AND NVL(KU_TTMONVAY,'OPEN') <> 'CLOSE'
				AND KU_NGAYBC = TO_DATE($P{PARA_NGAYBC})
				AND KU_MAPGD = $P{PARA_MAPGD}
				AND KU_DNOTHAN+KU_DNOQHAN+KU_DNOKHOANH+NVL(KU_LAITONTHAN,0) + NVL(KU_LAITONQHAN,0)>0
				AND DECODE($P{PARA_MAXA}, '000000', '1', '0')= '1')
ORDER BY SPEC_CD, COMMUNE_ID, CUSTOMER_CODE]]>
	</queryString>
