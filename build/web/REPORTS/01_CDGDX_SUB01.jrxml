			<staticText>
				<reportElement uuid="11b759ac-1d85-44ad-855c-722fe1e994ee" x="471" y="0" width="40" height="72"/>
				<box>
					<topPen lineWidth="0.25"/>
					<leftPen lineWidth="0.25"/>
					<bottomPen lineWidth="0.25"/>
					<rightPen lineWidth="0.25"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="true" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[5]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="9a3b19cc-39c8-4b9f-8ff6-ae781baf792c" x="102" y="0" width="369" height="72"/>
				<box>
					<pen lineWidth="0.25"/>
					<topPen lineWidth="0.25"/>
					<leftPen lineWidth="0.25"/>
					<bottomPen lineWidth="0.25"/>
					<rightPen lineWidth="0.25"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="false" pdfEncoding="Identity-H"/>
					<paragraph leftIndent="5"/>
				</textElement>
				<text><![CDATA[- Tổ giao dịch xã được thành lập đủ số lượng cán bộ tối thiểu (Tối thiểu 03 cán bộ để đảm nhiệm các vị trí chức danh công việc), đảm bảo đủ các thành phần Tổ trưởng Tổ giao dịch xã, Kiểm soát viên, Giao dịch viên.
- Vi phạm: Không đủ số cán bộ tối thiểu 0 điểm và lập Biên bản vi phạm.]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="0471c7b9-752d-4ff0-b94a-05adc1007c94" x="102" y="149" width="369" height="84"/>
				<box>
					<pen lineWidth="0.25"/>
					<topPen lineWidth="0.0"/>
					<leftPen lineWidth="0.25"/>
					<bottomPen lineWidth="0.25"/>
					<rightPen lineWidth="0.25"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="false" pdfEncoding="Identity-H"/>
					<paragraph leftIndent="5"/>
				</textElement>
				<text><![CDATA[- Phân quyền trên hệ thống Intellect offline cho từng cán bộ Tổ giao dịch xã theo nhiệm vụ đã được phân công trên Sổ phân công can bộ Tổ giao dịch xã.
- Vi phạm: Người phân quyền không đúng thẩm quyền, phân quyền trên hệ thống không đúng với Sổ phân công Tổ giao dịch xã 0 điểm và lập Biên bản vi phạm]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="7adf0a9a-ee0f-466f-9022-cde204caf7e1" x="102" y="72" width="369" height="77"/>
				<box>
					<pen lineWidth="0.0"/>
					<topPen lineWidth="0.25"/>
					<leftPen lineWidth="0.25"/>
					<bottomPen lineWidth="0.0"/>
					<rightPen lineWidth="0.25"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="false" isItalic="false" pdfEncoding="Identity-H"/>
					<paragraph leftIndent="5"/>
				</textElement>
				<text><![CDATA[- Phân công cán bộ đảm nhiệm cho từng vị trí chức danh công việc đúng quy định. Thực hiện phân công phải thông qua Sổ phân công cán bộ Tổ giao dịch xã, có đầy đủ họ tên, chữ ký thành viên tham gia Tổ giao dịch xã, chữ ký của Giám đốc NHCSXH nơi cho vay.
- Vi phạm một trong các nội dung trên 0 điểm và lập biên bản vi phạm.]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="b34a244e-acc5-4a43-949a-f0c203dbc0bb" x="0" y="233" width="24" height="278"/>
				<box>
					<topPen lineWidth="0.25"/>
					<leftPen lineWidth="0.25"/>
					<bottomPen lineWidth="0.25"/>
					<rightPen lineWidth="0.25"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="true" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[2]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="352c397c-632f-4028-b2a1-f8240d71f9c5" x="24" y="233" width="78" height="278"/>
				<box>
					<topPen lineWidth="0.25"/>
					<leftPen lineWidth="0.25"/>
					<bottomPen lineWidth="0.25"/>
					<rightPen lineWidth="0.25"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="true" pdfEncoding="Identity-H"/>
					<paragraph leftIndent="5"/>
				</textElement>
				<text><![CDATA[Giao nhận tiền; ấn chỉ quan trọng; phương tiện, trang thiết bị, công cụ làm việc của Tổ giao dịch xã]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="569cec3a-aa42-4b1b-a437-21338f952c3c" x="102" y="250" width="369" height="175"/>
				<box>
					<pen lineWidth="0.25"/>
					<topPen lineWidth="0.25"/>
					<leftPen lineWidth="0.25"/>
					<bottomPen lineWidth="0.25"/>
					<rightPen lineWidth="0.25"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="false" pdfEncoding="Identity-H"/>
					<paragraph leftIndent="5"/>
				</textElement>
				<text><![CDATA[- Thực hiện giao nhận tiền; ấn chỉ quan trọng, hồ sơ cho vay; phương tiện, trang thiết bị, công cụ làm việc của Tổ giao dịch xã theo đúng quy định.
- Vi phạm:
+ Thực hiện bàn giao phương tiện, trang thiết bị, công cụ làm việc của Tổ giao dịch xã không đúng quy định, hồ sơ cho vay không đầy đủ 0 điểm.
+ Vi phạm một trong các nội dung sau 0 điểm và lập biên bản Vi phạm:
Giao nhận tiền, ấn chỉ quan trọng không đúng quy định: không lập giấy tờ đề nghị tiếp quỹ kiêm tạm ứng và sổ tiết kiêm trắng, không lập phiếu xuất kho; giấy đề nghị tiếp quỹ kiệm tạm ứng tiền và sổ tiết kiệm trắng, phiếu xuất kho chưa được Giám đốc NHCSXH nơi cho vay phê duyệt; ấn chỉ quan trọng không đầy đủ, người lập giấy đề nghị không đúng vị trí chức danh công việc được phân công]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="89f884e0-3ec9-43fd-b763-2abc7baa1e43" x="471" y="72" width="40" height="77"/>
