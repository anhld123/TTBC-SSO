			<staticText>
				<reportElement uuid="9382d7dd-0901-4e34-af49-5a5b231282c4" x="102" y="425" width="369" height="86"/>
				<box>
					<pen lineWidth="0.25"/>
					<topPen lineWidth="0.0"/>
					<leftPen lineWidth="0.25"/>
					<bottomPen lineWidth="0.25"/>
					<rightPen lineWidth="0.25"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="false" pdfEncoding="Identity-H"/>
					<paragraph leftIndent="5"/>
				</textElement>
				<text><![CDATA[- Đầy đủ phương tiện, trang thiết bị, công cụ làm việc của Tổ giao dịch xã được quy định tại văn bản số 4030/NHCS-TDNN của Tổng giám đốc NHCSXH.
- Cứ thiếu hoặc không sử dụng được 01 phương tiện, trang thiết bị, công cụ làm việc của Tổ giao dịch xã trừ 0,5 điểm. (Trừ tối đa 5 điểm)]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="4f9faa4d-a865-4c80-940a-5b29e1d98944" x="102" y="524" width="329" height="27"/>
