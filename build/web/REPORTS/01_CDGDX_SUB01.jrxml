				</textElement>
				<text><![CDATA[Trang 1]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="7eaa2a95-8a9c-4b67-8b98-587ef7921e26" x="471" y="425" width="40" height="86"/>
