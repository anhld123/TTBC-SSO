	<variable name="TOT_MPF_PRIN_BALANCE" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{MPF_PRIN_BALANCE}]]></variableExpression>
	</variable>
	<variable name="TOT_HDPP_INST_INT_PAID" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{HDPP_INST_INT_PAID}]]></variableExpression>
	</variable>
	<variable name="TOT_HDSP_SUBINT_PAID" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{HDSP_SUBINT_PAID}]]></variableExpression>
	</variable>
	<variable name="GRP_HDSP_SUBINT_PAID" class="java.math.BigDecimal" resetType="Group" resetGroup="COMMUNE_GRP" calculation="Sum">
		<variableExpression><![CDATA[$F{HDSP_SUBINT_PAID}]]></variableExpression>
	</variable>
	<variable name="GRP_HDPP_INST_INT_PAID" class="java.math.BigDecimal" resetType="Group" resetGroup="COMMUNE_GRP" calculation="Sum">
		<variableExpression><![CDATA[$F{HDPP_INST_INT_PAID}]]></variableExpression>
	</variable>
	<variable name="GRP_MPF_PRIN_BALANCE" class="java.math.BigDecimal" resetType="Group" resetGroup="COMMUNE_GRP" calculation="Sum">
		<variableExpression><![CDATA[$F{MPF_PRIN_BALANCE}]]></variableExpression>
	</variable>
	<variable name="GRP_COUNT" class="java.lang.Integer" incrementType="Group" incrementGroup="COMMUNE_GRP" calculation="Count">
		<variableExpression><![CDATA[$V{GRP_COUNT}++]]></variableExpression>
		<initialValueExpression><![CDATA[new Integer(1)]]></initialValueExpression>
	</variable>
