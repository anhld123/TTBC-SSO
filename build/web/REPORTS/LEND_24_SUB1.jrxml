	<field name="MPF_PRIN_BALANCE" class="java.math.BigDecimal"/>
	<field name="HDPP_INST_INT_PAID" class="java.math.BigDecimal"/>
	<field name="HDSP_SUBINT_PAID" class="java.math.BigDecimal"/>
