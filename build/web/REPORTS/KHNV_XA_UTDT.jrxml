<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="KHNV_XA_UTDT" language="groovy" pageWidth="1584" pageHeight="595" orientation="Landscape" columnWidth="1544" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="a1cf0f28-bf9c-4234-a2b5-0ebea8fb8bc4">
	<property name="ireport.zoom" value="0.6830134553650729"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT A.*,B.KH_MAPGD KH_MAPGD, NVL(B.KH_NVUTDT,0) KH_NVUTDT FROM
(
(SELECT
SUBSTR(MADP,1,6) MAXA, TEN,
NVL(SUM(D3 +D4 +D5),0) TONG_DUNO,
NVL(SUM(CASE WHEN D14 = '01' THEN (D3 +D4 +D5) END),0) DUNO_HN,
NVL(SUM(CASE WHEN D14 = '02' THEN (D3 +D4 +D5) END),0) DUNO_HSSV,
NVL(SUM(CASE WHEN D14 = '03' THEN (D3 +D4 +D5) END ),0) DUNO_GQVL,
NVL(SUM(CASE WHEN D14 = '04' THEN (D3 +D4 +D5) END),0)DUNO_XKLD_1034,
NVL(SUM(CASE WHEN D14 = '16' THEN (D3 +D4 +D5) END),0) DUNO_XKLD_QD71,
NVL(SUM(CASE WHEN D14 = '06' THEN (D3 +D4 +D5) END),0) DUNO_NSVSMT,
NVL(SUM(CASE WHEN D14 = '10' THEN (D3 +D4 +D5) END),0) DUNO_SXKDVKK,
NVL(SUM(CASE WHEN D14 = '05' THEN (D3 +D4 +D5) END),0) DUNO_NHATRACHAM,
NVL(SUM(CASE WHEN D14 = '11' AND D15 = '11' THEN (D3 +D4 +D5) END),0) DUNO_DTTS_QD32,
NVL(SUM(CASE WHEN D14 = '14' THEN (D3 +D4 +D5) END),0) DUNO_DTTS_QD74,
NVL(SUM(CASE WHEN D14 = '07' THEN (D3 +D4 +D5) END),0) DUNO_NHA_167,
NVL(SUM(CASE WHEN D14 = '15' THEN (D3 +D4 +D5) END),0)  DUNO_THUONGNHAN,
NVL(SUM(CASE WHEN D14 = '08' THEN (D3 +D4 +D5) END),0) DUNO_KFW,
NVL(SUM(CASE WHEN D14 = '15' THEN (D3 +D4 +D5) END),0) DUNO_DUAN_NN,
NVL(SUM(CASE WHEN D14 = '15' THEN (D3 +D4 +D5) END),0) DUNO_TRONGRUNG,
NVL(SUM(CASE WHEN D14 = '18' AND D15 = '18' THEN (D3 +D4 +D5) END),0)  DUNO_CHOI_176,
NVL(SUM(CASE WHEN D14 = '19' THEN (D3 +D4 +D5) END),0)  DUNO_CANNGHEO,
NVL(SUM(CASE WHEN D14 = '99' AND D15 = '99' THEN (D3 +D4 +D5) END),0) DUNO_NVDP_KHAC
FROM BCTD_DAILY, (select * from DMXA where pgd_ql = $P{PARA_MAPGD})
WHERE khoa = 'BCTD_CHTRINH'
AND NGAYBC = $P{PARA_NGAYBC}
AND MAPGD = $P{PARA_MAPGD}
AND D1 = '2'
AND SUBSTR(MADP,1,6) = MA
GROUP BY SUBSTR(MADP,1,6),TEN) A
LEFT JOIN
(SELECT KH_MAPGD KH_MAPGD,
NVL(SUM(NVL(KH_KH_NAM,0)),0) KH_NVUTDT
 FROM KHNV WHERE KH_LOAI_NV = 'XDKH_XA' AND KH_STT_HT = 'B' AND KH_MA_CT = '8' AND SUBSTR(KH_MAPGD,1,4) = SUBSTR( $P{PARA_MAPGD},3,4)
AND KH_NAMBC = TO_CHAR(TO_DATE( $P{PARA_NGAYBC},'DD-MON-YYYY'),'YYYY')
GROUP BY KH_MAPGD
ORDER BY KH_MAPGD) B
ON A.MAXA = B.KH_MAPGD)
ORDER BY MAXA]]>
	</queryString>
