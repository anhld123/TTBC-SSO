<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="KHTD_XAPHUONG" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="69021f42-983f-4f4d-bcc0-8d2bced611c7">
	<property name="ireport.zoom" value="0.75"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["D:\\02. Official dispatch of IT\\04. CHI TIEU\\XD chi tieu thon xa\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT TEN,SUBSTR(MADP,1,6) MAXA,CASE WHEN D1 IN ('11','12','13','14') then D1 else '99' end DVUT,giatri,
 SUM(TO_NUMBER(D2)) D2 ,
 SUM(TO_NUMBER(D3)) D3,
 SUM(TO_NUMBER(D4)) D4,
 SUM(TO_NUMBER(D5))/1000000 D5,
 SUM(TO_NUMBER(D6))/1000000 D6,
 SUM(TO_NUMBER(D7))/1000000 D7
 FROM BCTD_DAILY, (select * from DMXA WHERE PGD_QL = $P{PARA_MAPGD}),
 (select(case when khoa_2 in ('11','12','13','14') then KHOA_2 else '99' end) KHOA_2, giatri
 from dmkhac where khoa_1 = '17' and khoa_2 in ('11','12','13','14','1'))
 WHERE  KHOA = 'BCTD_DIABAN' AND MAPGD = $P{PARA_MAPGD} AND NGAYBC = $P{PARA_NGAYBC}
 ANd D1 = KHOA_2
 AND SUBSTR(MADP,1,6) = MA
GROUP BY SUBSTR(MADP,1,6),TEN, D1,giatri
ORDER BY SUBSTR(MADP,1,6),TEN, D1,giatri]]>
	</queryString>
