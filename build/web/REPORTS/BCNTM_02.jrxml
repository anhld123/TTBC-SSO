<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="BCNTMOI_02" language="groovy" pageWidth="1350" pageHeight="925" orientation="Landscape" columnWidth="1311" leftMargin="20" rightMargin="19" topMargin="20" bottomMargin="20" uuid="dd2ed902-5a80-462a-b1b5-edf06055f1f8">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_TONGHOP" class="java.lang.String"/>
	<parameter name="PARA_NGAYBC" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
        CHTRINH MACT, SC_TEN TENCT, THUTU STT,
        NVL(sum(D2)/1000000,0) DS_CHOVAYT,
        NVL(sum(D3)/1000000,0) DS_CHOVAYN,
        NVL(sum(D4)/1000000,0) DS_THUNOT,
        NVL(sum(D5)/1000000,0) DS_THUNON,
        NVL(sum(D6)/1000000,0) DS_XOANOT,
        NVL(sum(D7)/1000000,0) DS_XOANON,
        NVL(sum(D8)/1000000,0) TONG_DN,
        NVL(sum(D9)/1000000,0) NO_THAN,
        NVL(sum(D10)/1000000,0) NO_QHAN,
        NVL(sum(D11)/1000000,0) NO_KHOANH,
        NVL(sum(D12)/1000000,0) NO_NGANHAN,
        NVL(sum(D13)/1000000,0) NO_TRUNGHAN,
        NVL(sum(D14)/1000000,0) NO_DAIHAN,
        NVL(sum(D15),0) SKH_DUNO,
        NVL(sum(D16),0) SKH_VVON,
        NVL(sum(D17),0) HQDT
        FROM BCTD_NONGTHONMOI A, DM_SCHEME B, (SELECT * FROM DMXA_NTMOI_NEW ) C, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z
        WHERE A.KEY = 'NONGTHONMOI'
              AND A.NGAYBC = $P{PARA_NGAYBC}
			  AND A.MAXA = C.MA
        AND A.CHTRINH = SUBSTR(B.SC_MA,3,2)
        AND A.MAPGD = Y.PO_MA
        AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA)
        AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD})
        group by CHTRINH,SC_TEN, THUTU
        order by THUTU]]>
	</queryString>
