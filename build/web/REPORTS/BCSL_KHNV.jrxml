	<subDataset name="dataset2" uuid="e63da4aa-7260-437c-8c99-a64fe386a2d7">
		<parameter name="MAPGD" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="NGAYBC" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select rownum STT, TENCT, DS_CHOVAYT, DS_CHOVAYN, DS_THUNOT, DS_THUNON, DS_XOANOT, DS_XOANON, TONG_DN, TYLE_NO_QHAN, TYLE_NO_KHOANH
from (SELECT GIATRI TENCT, KHOA_2 MACT,  'SDV',
                         case when (KHOA_2 = '92' OR KHOA_2 = '93' OR KHOA_2 = '94' OR KHOA_2 = '96') then 'Cho vay một số dự án vốn nước ngoài khác'
                                 else GIATRI
                        end as CHTRINH,
                    NVL(sum(CTR_D1)/1000000,0) DS_CHOVAYT,
                    NVL(sum(CTR_D2)/1000000,0) DS_CHOVAYN,
                    NVL(sum(CTR_D3)/1000000,0) DS_THUNOT,
                    NVL(sum(CTR_D4)/1000000,0) DS_THUNON,
                    NVL(sum(CTR_D5)/1000000,0) DS_XOANOT,
                    NVL(sum(CTR_D6)/1000000,0) DS_XOANON,
                    NVL(sum(CTR_D7)/1000000,0) TONG_DN,
                    CASE
                    WHEN SUM(CTR_D7) > 0 THEN  NVL(sum(CTR_D9)/1000000,0)*100/NVL(sum(CTR_D7)/1000000,0)
                    ELSE
                        0
                     END TYLE_NO_QHAN,
                    CASE
                    WHEN SUM(CTR_D7) > 0 THEN   NVL(sum(CTR_D10)/1000000,0)*100/NVL(sum(CTR_D7)/1000000,0)
                    ELSE
                        0
                    END  TYLE_NO_KHOANH
                    FROM DMKHAC A, BCTD_CHTRINH B, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{MAPGD}) Z
                    WHERE KHOA_1 = '07'
                    AND CTR_CHTRINH = A.KHOA_2
                    AND B.CTR_MAPGD = Y.PO_MA
                    AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA)
                    AND CTR_NGAYBC = TO_DATE($P{NGAYBC})
                    group by KHOA_2,GIATRI, THUTU
                    order by THUTU, KHOA_2)]]>
		</queryString>
		<field name="STT" class="java.math.BigDecimal"/>
		<field name="TENCT" class="java.lang.String"/>
		<field name="DS_CHOVAYT" class="java.math.BigDecimal"/>
		<field name="DS_CHOVAYN" class="java.math.BigDecimal"/>
		<field name="DS_THUNOT" class="java.math.BigDecimal"/>
		<field name="DS_THUNON" class="java.math.BigDecimal"/>
		<field name="DS_XOANOT" class="java.math.BigDecimal"/>
		<field name="DS_XOANON" class="java.math.BigDecimal"/>
		<field name="TONG_DN" class="java.math.BigDecimal"/>
		<field name="TYLE_NO_QHAN" class="java.math.BigDecimal"/>
		<field name="TYLE_NO_KHOANH" class="java.math.BigDecimal"/>
	</subDataset>
