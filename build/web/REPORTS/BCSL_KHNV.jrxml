	<subDataset name="dataset4" uuid="122bbbd2-a60d-474a-9bef-4c94924b9a11">
		<parameter name="MAPGD" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="NGAYBC" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT            SUBSTR(DVUT_DVUT,2,1) TT, M.GIATRI TENTCH,
                            SUM (NVL (DVUT_D7, 0)) / 1000000 TONGDN,
                            SUM (NVL (DVUT_D9, 0)) / 1000000  QUAHAN,
                            SUM (NVL (DVUT_D10, 0)) / 1000000  KHOANH
                       FROM BCTD_DVUT_RG, DMPOS Y, (SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{MAPGD}) Z, (SELECT KHOA_2, GIATRI FROM DMKHAC WHERE KHOA_1='17' AND KHOA_2 IN ('11','12','13','14')) M
                      WHERE DVUT_NGAYBC = $P{NGAYBC}
                       AND DVUT_DVUT = M.KHOA_2
                       AND DVUT_MAPGD = Y.PO_MA
                       AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA)
                   GROUP BY DVUT_DVUT, M.GIATRI
                   ORDER BY DVUT_DVUT]]>
		</queryString>
		<field name="TT" class="java.lang.String"/>
		<field name="TENTCH" class="java.lang.String"/>
		<field name="TONGDN" class="java.math.BigDecimal"/>
		<field name="QUAHAN" class="java.math.BigDecimal"/>
		<field name="KHOANH" class="java.math.BigDecimal"/>
	</subDataset>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["D:\\05. Official dispatch of IT\\07. REPORTS\\"]]></defaultValueExpression>
	</parameter>
	<queryString language="plsql">
		<![CDATA[{call  INTELLECT.BCSL_KHNV($P{PARA_MAPGD},$P{PARA_NGAYBC},$P{ORACLE_REF_CURSOR})}]]>
	</queryString>
