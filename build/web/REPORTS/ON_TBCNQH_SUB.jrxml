<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ON_TBCNQH_SUB" language="groovy" pageWidth="595" pageHeight="842" columnWidth="515" leftMargin="45" rightMargin="35" topMargin="45" bottomMargin="45" uuid="e3b6b9ac-82d2-497a-8728-d2b693fa76e8">
	<property name="ireport.zoom" value="1.2396694214876032"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="64"/>
	<parameter name="PARA_MATO" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_TENTT" class="java.lang.String"/>
	<parameter name="PARA_DIACHI" class="java.lang.String"/>
	<parameter name="PARA_DVUT" class="java.lang.String"/>
	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT KH_MAKH MAKH,
        KH_TENKH TENKH,
        HSKU.KU_SOKU SOKU,
        TO_CHAR(KU_NGAYCNQH,'DD/MM/YYYY')NGAY_CNQH,
        nvl(KU_M_CHUYENQH, 0) - nvl(KU_M_DKCHUYENQH, 0) SOTIEN_CNQH,
        (SELECT SC_TENVT FROM DM_SCHEME WHERE SUBSTR(SC_MA, 3, 2) = HSKU.KU_CHTRINH) CHTRINH
  FROM
        (SELECT * FROM HSKH WHERE kh_mapgd = $P{PARA_MAPGD}) hskh,
        (SELECT * FROM HSCV_DAILY
            WHERE KU_NGAYBC = $P{PARA_NGAYBC}
            and ku_mapgd = $P{PARA_MAPGD}
            AND NVL(KU_TTMONVAY,'OPEN') <> 'CLOSE'
            and nvl(KU_M_CHUYENQH, 0) - nvl(KU_M_DKCHUYENQH, 0) >0
            AND KU_MATO = $P{PARA_MATO}) HSKU
 WHERE HSKH.KH_MAKH = HSKU.KU_MAKH
ORDER BY 1, 3]]>
	</queryString>
	<field name="MAKH" class="java.lang.String"/>
	<field name="TENKH" class="java.lang.String"/>
	<field name="SOKU" class="java.lang.String"/>
	<field name="NGAY_CNQH" class="java.lang.String"/>
	<field name="SOTIEN_CNQH" class="java.math.BigDecimal"/>
	<field name="CHTRINH" class="java.lang.String"/>
	<variable name="TONG_ST_CNQH" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{SOTIEN_CNQH}]]></variableExpression>
	</variable>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="211">
			<textField>
				<reportElement uuid="ec87a0b5-c1ab-4342-b30d-a9d354c09a54" x="0" y="111" width="515" height="20"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="13" isBold="true" pdfEncoding="Identity-H"/>
					<paragraph firstLineIndent="27"/>
				</textElement>
				<textFieldExpression><![CDATA["Kính gửi: Ông/bà " + $P{PARA_TENTT}+ " - Tổ trưởng tổ TK&VV " + $P{PARA_MATO}]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement uuid="6d86e5ba-a68c-49c0-87a5-8fefe531f66c" positionType="Float" x="0" y="191" width="515" height="20"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="13" isBold="true" pdfEncoding="Identity-H"/>
					<paragraph firstLineIndent="27"/>
				</textElement>
				<textFieldExpression><![CDATA["Danh sách người vay chuyển nợ quá hạn như sau:"]]></textFieldExpression>
			</textField>
			<textField isStretchWithOverflow="true">
				<reportElement uuid="8737b2eb-1ad2-4257-bbff-8401c60dbdf8" stretchType="RelativeToBandHeight" mode="Transparent" x="0" y="131" width="515" height="60" backcolor="#CCCCCC"/>
				<box>
					<pen lineWidth="0.0" lineColor="#000000"/>
					<topPen lineWidth="0.0" lineColor="#000000"/>
					<leftPen lineWidth="0.0" lineColor="#000000"/>
					<bottomPen lineWidth="0.0" lineColor="#000000"/>
					<rightPen lineWidth="0.0" lineColor="#000000"/>
				</box>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="13" isBold="false" pdfEncoding="Identity-H"/>
					<paragraph lineSpacing="AtLeast" lineSpacingSize="1.5" firstLineIndent="27" spacingBefore="3"/>
				</textElement>
				<textFieldExpression><![CDATA["Địa chỉ: " + $P{PARA_DIACHI}+ '\n'+"Thuộc tổ chức hội: " + $P{PARA_DVUT} + " quản lý."+ '\n'+"Ngân hàng Chính sách xã hội (NHCSXH) thông báo cho ông/bà biết về việc chuyển sang nợ quá hạn do sử dụng vốn vay sai mục đích hoặc không trả nợ vay đúng hạn. Lãi quá hạn là 130% lãi suất khi cho vay."]]></textFieldExpression>
			</textField>
			<textField pattern="" isBlankWhenNull="false">
				<reportElement uuid="64c434f9-a32b-45b9-b4b6-e78ae361ed55" mode="Transparent" x="354" y="20" width="161" height="43" forecolor="#000000" backcolor="#FFFFFF"/>
				<box leftPadding="3" rightPadding="3">
