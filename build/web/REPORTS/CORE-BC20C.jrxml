	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<parameter name="PARA_MANHADAUTU" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_TONGHOP" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["D:\\PCBC\\REPORT CSDL TG\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select distinct KU_MAKH CUSTOMER_ID,
 KH_TENKH CUSTOMER_NAME,
 KU_SOKU LOAN_ID,
 KU_NGAYVAY  LOAN_START_DATE,
 KU_NGAYDHAN_1 LOAN_MATURITY_DATE,
 KU_GNGAN  DISBURSAL_AMOUNT,
 KU_DNOTHAN MPF_PRIN_BALANCE,
 KU_DNOQHAN OVERDUE_BALANCE,
 KU_DNOKHOANH FREEZE_BALANCE,
  KU_SPRD_CD MPI_SPRD_CD,
  KU_MANDT INVESTOR_ID,
 m.DT_TENDT INVESTOR_NAME
  from hsku a, hskh b , HSDT m , dmpos Y,
       (SELECT PO_MACN, PO_POSFLG, PO_MA FROM dmpos WHERE PO_MA = $P{PARA_MAPGD}) Z
 where a.ku_makh = b.kh_makh
and KU_MANDT = M.DT_MADT
and KU_MAPGD = $P{PARA_MAPGD}
 and KU_TTMONVAY = 'OPEN'
  and KU_MANDT = $P{PARA_MANHADAUTU}
   and KU_NGAYVAY <= TO_DATE($P{PARA_NGAYBC})
     AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA, Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA)
   AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD})
 order by KU_SPRD_CD, KU_MANDT, KU_MAKH]]>
	</queryString>
