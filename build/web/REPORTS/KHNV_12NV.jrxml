	<property name="ireport.zoom" value="1.3310000000000004"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<queryString>
		<![CDATA[select kyhan kyhan_1,
(case when
  KYHAN = 2 then 'TP KỲ HẠN 2 NĂM'
  when KYHAN = 3  then 'TP KỲ HẠN 3 NĂM'
  when KYHAN = 5  then 'TP KỲ HẠN 5 NĂM'
  when KYHAN = 7  then 'TP KỲ HẠN 7 NĂM'
  when KYHAN = 10  then 'TP KỲ HẠN 10 NĂM'
  when KYHAN = 15  then 'TP KỲ HẠN 15 NĂM'
  end )kyhan, NVL(SO_PH,0)SO_PH,NVL(SO_DTRA,0) SO_DTRA,NVL(SO_PH,0) - NVL(SO_DTRA,0) SO_PHAITR
 from KHNV_TRAIPHIEU
where ngaybc = $P{PARA_NGAYBC}
order by kyhan_1]]>
	</queryString>
	<field name="KYHAN_1" class="java.math.BigDecimal"/>
	<field name="KYHAN" class="java.lang.String"/>
	<field name="SO_PH" class="java.math.BigDecimal"/>
	<field name="SO_DTRA" class="java.math.BigDecimal"/>
	<field name="SO_PHAITR" class="java.math.BigDecimal"/>
	<variable name="SO_PH_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{SO_PH}]]></variableExpression>
	</variable>
	<variable name="SO_DTRA_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{SO_DTRA}]]></variableExpression>
	</variable>
	<variable name="SO_PHAITR_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{SO_PHAITR}]]></variableExpression>
	</variable>
