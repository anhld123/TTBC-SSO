<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="BCDP-B28" language="groovy" pageWidth="595" pageHeight="880" orientation="Landscape" columnWidth="560" leftMargin="20" rightMargin="15" topMargin="20" bottomMargin="20" uuid="eba9045f-873c-4a56-bfac-77d74fe90fe6">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_DENNGAY" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_MAXA" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_TONGHOP" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT UPPER(D.SC_TEN) TENCT, D.SC_MA MACT,A.TEN TENXA,F.KU_MATO MATO, B.TO_TENTT TENTT, E.KH_TENKH TENKH,
F.KU_SOKU SOKU,(F.KU_DNOTHAN + F.KU_DNOQHAN + F.KU_DNOKHOANH) DUNO,
case when KU_NGUONVON = '1' then G.KH_GOCDHAN
        when KU_HTHUCVAY <> '1' then TO_NUMBER('0')
end as NGVON_TW,
case when KU_NGUONVON = '2' then G.KH_GOCDHAN
        when KU_HTHUCVAY <> '2' then TO_NUMBER('0')
end as NGVON_ĐP,
G.KH_NGDHAN NGDHAN, F.KU_NGAYBC
FROM DMXA A, HSTO B, DM_SCHEME D,HSKU F, HSKH E, KHTN G
WHERE  F.KU_MAKH = E.KH_MAKH
AND F.KU_SOKU = G.KH_SOKU
AND A.MA = SUBSTR(F.KU_MADP,1,6)
AND F.KU_MATO = B.TO_MATO
AND B.TO_MAPGD = $P{PARA_MAPGD}
AND A.MA = $P{PARA_MAXA}
AND F.KU_SCHEM_CD = D.SC_MA
AND G.KH_GOCDHAN > 0
AND (TO_CHAR(G.KH_NGDHAN,'mm') =  TO_CHAR(TO_DATE($P{PARA_DENNGAY}),'mm') AND TO_CHAR(G.KH_NGDHAN,'yyyy') = TO_CHAR(TO_DATE($P{PARA_DENNGAY}),'yyyy'))
AND G.NG_CAPNHAT = TO_DATE($P{PARA_DENNGAY})
AND F.KU_NGAYBC = TO_DATE($P{PARA_DENNGAY})
ORDER BY A.TEN, D.SC_MA, F.KU_MATO, E.KH_TENKH]]>
	</queryString>
