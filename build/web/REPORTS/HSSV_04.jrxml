	<queryString>
		<![CDATA[select UPPER(SUBSTR(lower(TRNCT),1,1))||SUBSTR(lower(TRNCT),2) TRNCT,    VDATA_2,    CV_TRONGKY/1000000 CV_TRONGKY,CV_LKE_DAUNAM/1000000    CV_LKE_DAUNAM,
CV_THANGTRUOC/1000000    CV_THANGTRUOC,TN_TRONGKY/1000000    TN_TRONGKY,
TN_LKE_DAUNAM/1000000    TN_LKE_DAUNAM,TN_THANGTRUOC/1000000    TN_THANGTRUOC,
XOANO/1000000    XOANO,DN_TRONGKY/1000000    DN_TRONGKY,DN_THANGTRUOC/1000000    DN_THANGTRUOC,
DNTC_TRONGHAN/1000000    DNTC_TRONGHAN,DNTC_TRONGKY/1000000    DNTC_TRONGKY,DNTC_THANGTRUOC/1000000    DNTC_THANGTRUOC,
DNTC_KHOANH/1000000    DNTC_KHOANH,    SOKH    from dulieu_gb where  ngay_tao = $P{para_denngay} and
CV_TRONGKY +TN_TRONGKY + DN_TRONGKY >0 order by 2]]>
	</queryString>
