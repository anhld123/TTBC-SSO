<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="CORE_BC04_Subreport1" language="groovy" pageWidth="595" pageHeight="842" columnWidth="595" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="a94395b5-e07f-4ada-bb70-3f69fc4e61e0">
	<property name="ireport.zoom" value="1.1269722013523664"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_GDVIEN" class="java.lang.String"/>
	<parameter name="PARA_LOAITIEN" class="java.lang.String"/>
	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<queryString language="plsql">
		<![CDATA[select 0 OPEB_BAL, sbt REF_NO, tk AC_NO, 'VND' CCY_CD, ghichu_2 txn_desc, decode(noco,'D',sotien,0) AMT2,decode(noco,'C',sotien,0) AMT1 from hsbt
    where tk in ('9100017046','9100018401','9100027049','9100037042','9100047045','9100057048','9100067041','9100077044','9100087047','9100097040','9100107040' )
          AND gdv = $P{PARA_GDVIEN}
          AND TIENTE = $P{PARA_LOAITIEN}
          AND mapgd = $P{PARA_MAPGD}
	AND ngaybc = $P{PARA_NGAYBC}
order by ngaygd]]>
	</queryString>
	<field name="OPEB_BAL" class="java.math.BigDecimal"/>
	<field name="REF_NO" class="java.lang.String"/>
	<field name="AC_NO" class="java.lang.String"/>
	<field name="CCY_CD" class="java.lang.String"/>
	<field name="TXN_DESC" class="java.lang.String"/>
	<field name="AMT2" class="java.math.BigDecimal"/>
	<field name="AMT1" class="java.math.BigDecimal"/>
	<variable name="TOT_AMT1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{AMT1}]]></variableExpression>
	</variable>
	<variable name="TOT_AMT2" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{AMT2}]]></variableExpression>
	</variable>
	<variable name="CLOSE_BAL" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$F{OPEB_BAL}.subtract($V{TOT_AMT1}).add($V{TOT_AMT2})]]></variableExpression>
	</variable>
	<variable name="TOTAL1" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$F{OPEB_BAL}.add($V{TOT_AMT2})]]></variableExpression>
	</variable>
	<variable name="TOTAL2" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$V{CLOSE_BAL}.add($V{TOT_AMT1})]]></variableExpression>
	</variable>
