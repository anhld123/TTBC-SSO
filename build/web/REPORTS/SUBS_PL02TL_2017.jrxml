				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="10" isBold="false" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[ 1- Chi trả lãi nguồn vốn A = Dư nợ cuối năm GL 930 - Dư nợ cuối năm GL 9302057040 : ]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="b6e1500d-4d12-4d37-9fb3-c18a35a4ede5" x="0" y="17" width="492" height="18"/>
				<box leftPadding="5">
					<pen lineWidth="0.0"/>
					<topPen lineWidth="0.0"/>
					<leftPen lineWidth="0.0"/>
					<bottomPen lineWidth="0.0"/>
					<rightPen lineWidth="0.0"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="10" isBold="false" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[ 2- Lãi suất huy động bình quân = Chi trả lãi nguồn vốn A (1) /Số dư nguồn vốn bình quân cả năm (NV)]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="4becee36-9a98-4e1a-9210-579998566ff4" x="0" y="35" width="492" height="18"/>
				<box leftPadding="5">
					<pen lineWidth="0.0"/>
					<topPen lineWidth="0.0"/>
					<leftPen lineWidth="0.0"/>
					<bottomPen lineWidth="0.0"/>
					<rightPen lineWidth="0.0"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="10" isBold="false" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[ 3- Tỷ lệ thưởng = Mức phí điều hòa vốn (PL 04/TL) - [Mức phí huy động vốn (1.8%/năm) + Lãi suất huy động BQ (2)]]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="264eec92-7792-4b5a-b2f8-fb02d044b871" x="0" y="53" width="492" height="18"/>
				<box leftPadding="5">
					<pen lineWidth="0.0"/>
					<topPen lineWidth="0.0"/>
					<leftPen lineWidth="0.0"/>
					<bottomPen lineWidth="0.0"/>
					<rightPen lineWidth="0.0"/>
				</box>
				<textElement verticalAlignment="Top">
					<font fontName="Times New Roman" size="10" isBold="false" isItalic="true" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[(Tỷ lệ thưởng = 0 nếu: Mức phí điều hòa vốn < (Mức phí huy động vốn (1.8%/năm) + Lãi suất huy động BQ)]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="1b3a898a-ebd5-452b-9733-38c2ddfc09d3" x="0" y="66" width="492" height="18"/>
				<box leftPadding="5">
					<pen lineWidth="0.0"/>
					<topPen lineWidth="0.0"/>
					<leftPen lineWidth="0.0"/>
					<bottomPen lineWidth="0.0"/>
					<rightPen lineWidth="0.0"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="10" isBold="false" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[ 4- Số phí huy động vốn = Số dư NV bình quân cả năm (NV) x [Mức phí huy động vốn (1.8%/năm)+ tỷ lệ thưởng ]]]></text>
			</staticText>
