<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="BCGB_HSSV" language="groovy" pageWidth="1123" pageHeight="595" orientation="Landscape" whenNoDataType="NoDataSection" columnWidth="1083" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0000000000000007"/>
	<property name="ireport.x" value="429"/>
	<property name="ireport.y" value="0"/>
	<parameter name="para_denngay" class="java.lang.String">
