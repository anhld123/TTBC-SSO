<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="BCTD_03.9" language="groovy" pageWidth="842" pageHeight="600" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_DENNGAY" class="java.lang.String"/>
	<parameter name="PARA_MAPGD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_TONGHOP" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
Case when SUBSTR(MOTA,1,1) = '1' then 'Cho vay học sinh, sinh viên'
        when SUBSTR(MOTA,1,1) = '2' then 'Cho vay giải quyết việc làm'
        when SUBSTR(MOTA,1,1) = '3' then 'Cho vay XKLĐ có thời hạn ở nước ngoài'
        when SUBSTR(MOTA,1,1) = '4' then 'Cho vay XKLĐ tại huyện nghèo'
        when SUBSTR(MOTA,1,1) = '5' then 'Cho vay nhà ở vùng thường xuyên ngập lũ ĐB Sông Cửu Long và Tây Nguyên'
End AS CHTRINH,
Case when (SUBSTR(MOTA,1,1) = '1') AND (SUBSTR(MOTA,2,1) = 'A') then 'Theo đối tượng thụ hưởng'
        when (SUBSTR(MOTA,1,1) = '1') AND (SUBSTR(MOTA,2,1) = 'B') then 'Theo phương thức vay vốn'
        when (SUBSTR(MOTA,1,1) = '2') AND (SUBSTR(MOTA,2,1) = 'A') then 'Quỹ GQVL do TW'
        when (SUBSTR(MOTA,1,1) = '2') AND (SUBSTR(MOTA,2,1) = 'B') then 'QUỸ GQVL do ĐP'
        else ''
End AS SUB_CT,
MOTA,GIATRI CHITIEU, THUTU STT,SUBSTR(MOTA,2,1) STT_SUB,
Case when SUBSTR(MOTA,1,1) = '1' then 'I'
        when SUBSTR(MOTA,1,1) = '2' then 'II'
        when SUBSTR(MOTA,1,1) = '3' then 'III'
        when SUBSTR(MOTA,1,1) = '4' then 'IV'
        when SUBSTR(MOTA,1,1) = '5' then 'V'
End AS STT_CHTRINH,
(select NVL(sum(CTDT_D1)/1000000,0) from BCTD_CTDT, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z where SUBSTR(CTDT_CODE,4,2) = A.KHOA_2 and CTDT_MAPGD = Y.PO_MA AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) and  CTDT_NGAYBC = TO_DATE ($P{PARA_DENNGAY}) ) DS_NODH,
(select NVL(sum(CTDT_D2)/1000000,0) from BCTD_CTDT, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z where SUBSTR(CTDT_CODE,4,2) = A.KHOA_2 and CTDT_MAPGD = Y.PO_MA AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) and  CTDT_NGAYBC = TO_DATE ($P{PARA_DENNGAY}) ) TNODH_THANG,
(select NVL(sum(CTDT_D3),0) from BCTD_CTDT, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z where SUBSTR(CTDT_CODE,4,2) = A.KHOA_2 and CTDT_MAPGD = Y.PO_MA AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) and  CTDT_NGAYBC = TO_DATE ($P{PARA_DENNGAY}) ) SOHSSV_GN,
(select NVL(sum(CTDT_D4),0) from BCTD_CTDT, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z where SUBSTR(CTDT_CODE,4,2) = A.KHOA_2 and CTDT_MAPGD = Y.PO_MA AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) and  CTDT_NGAYBC = TO_DATE ($P{PARA_DENNGAY}) ) SOHSSV_GNLD,
(select NVL(sum(CTDT_D5),0) from BCTD_CTDT, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z where SUBSTR(CTDT_CODE,4,2) = A.KHOA_2 and CTDT_MAPGD = Y.PO_MA AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) and  CTDT_NGAYBC = TO_DATE ($P{PARA_DENNGAY}) ) SOHSSV_TT,
(select NVL(sum(CTDT_D6),0) from BCTD_CTDT, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z where SUBSTR(CTDT_CODE,4,2) = A.KHOA_2 and CTDT_MAPGD = Y.PO_MA AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) and  CTDT_NGAYBC = TO_DATE ($P{PARA_DENNGAY}) ) SOHSSV_DNO,
(select NVL(sum(CTDT_D7),0) from BCTD_CTDT, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z where SUBSTR(CTDT_CODE,4,2) = A.KHOA_2 and CTDT_MAPGD = Y.PO_MA AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) and  CTDT_NGAYBC = TO_DATE ($P{PARA_DENNGAY}) ) SODA_DNO,
(select NVL(sum(CTDT_D8),0) from BCTD_CTDT, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z where SUBSTR(CTDT_CODE,4,2) = A.KHOA_2 and CTDT_MAPGD = Y.PO_MA AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) and  CTDT_NGAYBC = TO_DATE ($P{PARA_DENNGAY}) ) SO_LD,
(select NVL(sum(CTDT_D9),0) from BCTD_CTDT, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z where SUBSTR(CTDT_CODE,4,2) = A.KHOA_2 and CTDT_MAPGD = Y.PO_MA AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) and  CTDT_NGAYBC = TO_DATE ($P{PARA_DENNGAY}) ) SOLD_XKLD,
(select NVL(sum(CTDT_D10),0) from BCTD_CTDT, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z where SUBSTR(CTDT_CODE,4,2) = A.KHOA_2 and CTDT_MAPGD = Y.PO_MA AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) and  CTDT_NGAYBC = TO_DATE ($P{PARA_DENNGAY}) ) SO_NHA
FROM DMKHAC A
WHERE KHOA_1 = '44'
ORDER BY MOTA, THUTU]]>
	</queryString>
