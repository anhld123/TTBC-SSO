				</textElement>
				<text><![CDATA[Bảo vệ cho Tổ giao dịch xã]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="9a3b19cc-39c8-4b9f-8ff6-ae781baf792c" x="102" y="135" width="369" height="42"/>
				<box>
					<pen lineWidth="0.25"/>
					<topPen lineWidth="0.25"/>
					<leftPen lineWidth="0.25"/>
					<bottomPen lineWidth="0.25"/>
					<rightPen lineWidth="0.25"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="false" pdfEncoding="Identity-H"/>
					<paragraph leftIndent="5"/>
				</textElement>
				<text><![CDATA[- Giám đốc NHCSXH nơi cho vay và Tổ trưởng Tổ giao dịch xã xây dựng phương án bảo vệ đảm bảo an toàn tài sản và con người trên đường đi, về và trong thời gian giao dịch tại Điểm giao dịch xã; có người bảo vệ (bảo vệ chuyên trách hoặc thành viên trong Tổ giao dịch xã kiêm nhiệm theo đúng quy định).
- Vi phạm: Không có người bảo vệ Tổ giao dịch xã 0 điểm và lập Biên bản vi phạm]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="0471c7b9-752d-4ff0-b94a-05adc1007c94" x="102" y="233" width="369" height="47"/>
				<box>
					<pen lineWidth="0.25"/>
					<topPen lineWidth="0.0"/>
					<leftPen lineWidth="0.25"/>
					<bottomPen lineWidth="0.25"/>
					<rightPen lineWidth="0.25"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="false" pdfEncoding="Identity-H"/>
					<paragraph leftIndent="5"/>
				</textElement>
				<text><![CDATA[- Phối hợp với Ủy ban nhân dân cấp xã trong việc bảo vệ Tổ giao dịch xã (Việc phối hợp phải được thể hiện trong phương án bảo vệ).
- Vi phạm: Không phối hợp: 0 điểm.]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="7adf0a9a-ee0f-466f-9022-cde204caf7e1" x="102" y="177" width="369" height="56"/>
				<box>
					<pen lineWidth="0.0"/>
					<topPen lineWidth="0.25"/>
					<leftPen lineWidth="0.25"/>
					<bottomPen lineWidth="0.0"/>
					<rightPen lineWidth="0.25"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="false" isItalic="false" pdfEncoding="Identity-H"/>
					<paragraph leftIndent="5"/>
				</textElement>
				<text><![CDATA[- Có trang bị công cụ hỗ trợ bảo vệ.
- Vi phạm: Không trang bị; có trang bị nhưng không sử dụng được hoặc không biết cách sử dụng hoặc không được người bảo vệ của Tổ giao dịch xã mang theo: 0 điểm.]]></text>
			</staticText>
