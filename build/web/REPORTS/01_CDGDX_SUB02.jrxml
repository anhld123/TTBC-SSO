					<paragraph leftIndent="5"/>
				</textElement>
				<text><![CDATA[- Điểm giao dịch xã được đặt trong khuôn viên trụ sở Ủy ban nhân dân cấp xã.
Vi phạm: Đặt ngoài khuôn viên trụ sở Uỷ ban nhân dân cấp xã sai quy định 0 điểm và lập Biên bản vi phạm.]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="b0859970-0817-4ce0-ba4c-a02ea7b88dbd" x="102" y="353" width="369" height="89"/>
				<box>
					<pen lineWidth="0.25"/>
					<topPen lineWidth="0.0"/>
					<leftPen lineWidth="0.25"/>
					<bottomPen lineWidth="0.25"/>
					<rightPen lineWidth="0.25"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="false" pdfEncoding="Identity-H"/>
					<paragraph leftIndent="5"/>
				</textElement>
				<text><![CDATA[- Không gian giao dịch: đảm bảo trong một không gian chung; thuận lợi cho các thành viên trong Tổ giao dịch xã giám sát lẫn nhau và luân chuyển chứng từ; vị trí khách hàng tạo được khoảng cách an toàn cho Giao dịch viên và Kiểm soát viên.
- Vi phạm một trong các nội dung trên trừ 0,5 điểm/lỗi vi phạm. (Trừ tối đa 2 điểm).]]></text>
			</staticText>
