				</textElement>
				<text><![CDATA[Thực hiện quy trình
giao dịch xã]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="569cec3a-aa42-4b1b-a437-21338f952c3c" x="102" y="459" width="369" height="64"/>
				<box>
					<pen lineWidth="0.25"/>
					<topPen lineWidth="0.25"/>
					<leftPen lineWidth="0.25"/>
					<bottomPen lineWidth="0.25"/>
					<rightPen lineWidth="0.25"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="false" pdfEncoding="Identity-H"/>
					<paragraph leftIndent="5"/>
				</textElement>
				<text><![CDATA[- Các thành viên Tổ giao dịch xã làm việc độc lập, đúng nhiệm vụ được giao, bảo mật thông tin đăng nhập của mình và giám sát lẫn nhau trong suốt phiên giao dịch xã.
- Vi phạm một trong các nội dung trên 0 điểm và lập Biên bản vi phạm.]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="89f884e0-3ec9-43fd-b763-2abc7baa1e43" x="471" y="177" width="40" height="56"/>
