<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="BCTH_B26" language="groovy" pageWidth="1190" pageHeight="842" orientation="Landscape" columnWidth="1150" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.000000000000001"/>
	<property name="ireport.x" value="20"/>
	<property name="ireport.y" value="34"/>
	<subDataset name="dataset1">
		<parameter name="STT" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select TRIM(to_char($P{STT},'RM')) STTH from dual]]>
		</queryString>
		<field name="STTH" class="java.lang.String"/>
	</subDataset>
	<parameter name="PARA_TONGHOP" class="java.lang.String"/>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_DENNGAY" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT G.MATINH,
G.MAHUYEN,
G.MAXA,
G.SODU_TK,
G.SODUTK_11,
G.SODUTK_12,
G.SODUTK_13,
G.SODUTK_14,
G.soto_tg,
G.soho_tg,
G.soto_11,
G.soto_12,
G.soto_13,
G.soto_14,
G.TONGKH_11,
TONGKH_12,
TONGKH_13,
TONGKH_14,
H.soto,
H.sokh,
H.LAITON,
H.LAION_11,
H.LAION_12,
H.LAION_13,
H.LAION_14,
G.TENTINH,
G.TENHUYEN,
G.TENXA
FROM
(
SELECT SUBSTR(C.CS_MADP,1,6) MAXA,
         SUBSTR(C.CS_MADP,1,4) MAHUYEN,
         SUBSTR(C.CS_MADP,1,2) MATINH,
    round(SUM(C.CS_SODU_TK)/1000000,2) SODU_TK,
    count(distinct D.TO_mato) soto_tg,
    count(distinct C.CS_MAKH) soho_tg,
    COUNT( distinct decode(D.TO_DVUT,11,D.TO_MATO)) soto_11,
    count(distinct  decode(D.TO_DVUT,12,D.TO_MATO)) soto_12,
    count( distinct decode(D.TO_DVUT,13,D.TO_MATO)) soto_13,
    count( distinct decode(D.TO_DVUT,14,D.TO_MATO)) soto_14,
    count(distinct DECODE(D.TO_DVUT,'11',C.CS_MAKH)) TONGKH_11,
    count(distinct DECODE(D.TO_DVUT,'12',C.CS_MAKH)) TONGKH_12,
    count(distinct DECODE(D.TO_DVUT,'13',C.CS_MAKH)) TONGKH_13,
    count(distinct DECODE(D.TO_DVUT,'14',C.CS_MAKH)) TONGKH_14,
    round(SUM(DECODE(D.TO_DVUT,'11',C.CS_SODU_TK,0))/1000000,2) SODUTK_11,
    round(SUM(DECODE(D.TO_DVUT,'12',C.CS_SODU_TK,0))/1000000,2) SODUTK_12,
    round(SUM(DECODE(D.TO_DVUT,'13',C.CS_SODU_TK,0))/1000000,2) SODUTK_13,
    round(SUM(DECODE(D.TO_DVUT,'14',C.CS_SODU_TK,0))/1000000,2) SODUTK_14,
         F.TEN TENTINH,
         P.TEN TENXA,
         Q.POS_DESC TENHUYEN
  FROM  CASA C, HSTO D, DMTINH F, DMXA P,PO850MB Q
  WHERE
  TRUNC(C.CS_NGAYBC) =  to_char(to_date($P{PARA_DENNGAY},'DD-MON-YYYY'),'DD-MON-YYYY')
	AND DECODE( $P{PARA_TONGHOP}, 'N', C.CS_MAPGD,SUBSTR(C.CS_MAPGD,3,2)) = DECODE($P{PARA_TONGHOP},'N',$P{PARA_MAPGD},SUBSTR($P{PARA_MAPGD},3,2))
    AND C.CS_MADP = D.TO_MADP
    AND   SUBSTR(C.CS_MADP,1,6) = P.MA
    AND  C.CS_MAPGD = Q.POS_CD
    AND  SUBSTR(C.CS_MADP,1,2) = F.MA
    AND C.CS_MATO = D.TO_MATO
    AND C.CS_SODU_TK > 0
    GROUP BY  SUBSTR(C.CS_MADP,1,2),SUBSTR(C.CS_MADP,1,4),SUBSTR(C.CS_MADP,1,6), F.TEN,Q.POS_DESC, P.TEN ) G
  INNER JOIN
 ( SELECT SUBSTR(KU_MADP,1,2) MATINH,SUBSTR(KU_MADP,1,4) MAHUYEN,SUBSTR(KU_MADP,1,6) MAXA,COUNT(DISTINCT KU_MATO) SOTO, COUNT(DISTINCT KU_MAKH) SOKH,
 round(SUM(KU_LAITONTHAN+KU_LAITONQHAN)/1000000,2) LAITON,
round(SUM(DECODE( TO_DVUT,'11',KU_LAITONTHAN+KU_LAITONQHAN,0))/1000000,2) LAION_11,
round(SUM(DECODE( TO_DVUT,'12',KU_LAITONTHAN+KU_LAITONQHAN,0))/1000000,2) LAION_12,
round(SUM(DECODE( TO_DVUT,'13',KU_LAITONTHAN+KU_LAITONQHAN,0))/1000000,2) LAION_13 ,
round(SUM(DECODE( TO_DVUT,'14',KU_LAITONTHAN+KU_LAITONQHAN,0))/1000000,2) LAION_14
FROM (
SELECT A.KU_MADP,A.KU_MATO,A.KU_MAKH,A.KU_SOKU,A.KU_LAITONTHAN,A.KU_LAITONQHAN,B.TO_DVUT
 FROM HSKU A, HSTO B
WHERE TRUNC(A.KU_NGAYBC) = to_char(to_date($P{PARA_DENNGAY},'DD-MON-YYYY'),'DD-MON-YYYY')
 AND DECODE($P{PARA_TONGHOP}, 'N', A.KU_MAPGD,SUBSTR(A.KU_MAPGD,3,2)) = DECODE($P{PARA_TONGHOP},'N',$P{PARA_MAPGD},SUBSTR($P{PARA_MAPGD},3,2))
 AND A.KU_MADP =  B.TO_MADP
 AND KU_MATO = B.TO_MATO ORDER BY KU_MATO)
GROUP BY SUBSTR(KU_MADP,1,2),SUBSTR(KU_MADP,1,4),SUBSTR(KU_MADP,1,6)) H
ON G.MAXA =H.MAXA
 AND G.MAHUYEN= H.MAHUYEN
 AND G.MATINH = H.MATINH]]>
	</queryString>
