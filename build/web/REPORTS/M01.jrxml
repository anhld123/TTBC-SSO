<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="M01" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="5b2a571e-d357-4b27-b288-71d3afe7dfd0">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["E:\\CVTTBC\\VB819\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_TONGHOP" class="java.lang.String"/>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<parameter name="PARA_MAXA" class="java.lang.String"/>
	<queryString>
		<![CDATA[select distinct A.pos_cd, COMMUNE_ID maxa,
(select x.ten xa FROM dmxa x WHERE x.ma = COMMUNE_ID) tenxa,REPORT_DT
from DG_COMMUNE_ASSESS_DTLS A, dmpos Y,
     (SELECT PO_POSFLG, PO_MACN, PO_MA FROM dmpos WHERE PO_MA = $P{PARA_MAPGD}) Z
WHERE
 a.pos_cd = y.PO_MA
and REPORT_DT = $P{PARA_NGAYBC}
and DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA, Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA)
and decode(trim($P{PARA_MAXA}),null,'A',trim($P{PARA_MAXA})) = decode(trim($P{PARA_MAXA}),null,'A',COMMUNE_ID)
  AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD})
ORDER BY a.pos_cd,maxa]]>
	</queryString>
	<field name="POS_CD" class="java.lang.String"/>
	<field name="MAXA" class="java.lang.String"/>
	<field name="TENXA" class="java.lang.String"/>
	<field name="REPORT_DT" class="java.sql.Timestamp"/>
