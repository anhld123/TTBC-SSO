<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="TDNN_SUB_DATE" language="groovy" pageWidth="432" pageHeight="432" columnWidth="432" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="bdea3ecf-685c-4bc2-a95d-8dab51007047">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT TRUNC(ADD_MONTHS(To_Date($P{PARA_NGAYBC}), -1), 'MONTH')+24 FROM_DATE, TRUNC(To_Date($P{PARA_NGAYBC}), 'MONTH')+24 TO_DATE from DUAL]]>
	</queryString>
	<field name="FROM_DATE" class="java.sql.Timestamp"/>
	<field name="TO_DATE" class="java.sql.Timestamp"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="19" splitType="Stretch">
			<textField evaluationTime="Report">
				<reportElement uuid="ef21a970-0755-451c-8aef-ee13544b1cbe" x="0" y="0" width="432" height="18"/>
				<textElement textAlignment="Center" verticalAlignment="Top">
					<font fontName="Times New Roman" size="11" isBold="true" isItalic="true" pdfEncoding="Identity-H"/>
				</textElement>
				<textFieldExpression><![CDATA["Từ " + (new SimpleDateFormat("dd/MM/yyyy")).format($F{FROM_DATE}) + " đến " + (new SimpleDateFormat("dd/MM/yyyy")).format($F{TO_DATE})]]></textFieldExpression>
			</textField>
		</band>
	</title>
</jasperReport>
