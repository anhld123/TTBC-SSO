					<font fontName="Times New Roman" size="11" isBold="true" isItalic="true" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[19. Các hoạt động uỷ thác chịu rủi ro của TCTD: NHCSXH không có]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="a1c985f0-a77e-41be-a8e9-0c46df3448e5" x="0" y="201" width="555" height="15"/>
