<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="CORE-BC20B_sudreport2" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="842" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<queryString>
		<![CDATA[select distinct KU_MAKH CUSTOMER_CODE,
 KH_TENKH CUSTOMER_NAME,
 KU_SOKU LOAN_CODE,
 KU_NGAYVAY BOOKING_DATE,
 KU_NGAYDHAN_1 MATURITY_DATE,
 KU_DNOTHAN PRIN_BALANCE,
 KU_TON_RPA RPA_BALANCE,
 KU_A_LAI_DT INT_DUE_BALANCE,
SUBSTR( e.SP_TEN,1,INSTR( e.SP_TEN ,'-',1)-1) LOAN_PRODUCT
  from hsku a, hskh b , DM_SPRODUCT e
 where a.ku_makh = b.kh_makh
 and KU_MAPGD = $P{PARA_MAPGD}
 and KU_NGAYBC = $P{PARA_NGAYBC}
 and KU_TTMONVAY = 'OPEN'
 and KU_DNOTHAN > 0
 and KU_SPRD_CD = e.SP_MA
 order by SUBSTR( e.SP_TEN,1,INSTR( e.SP_TEN ,'-',1)-1),KU_MAKH,KH_TENKH, KU_SOKU]]>
	</queryString>
