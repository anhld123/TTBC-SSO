	<field name="INT_DUE_BALANCE" class="java.math.BigDecimal"/>
	<field name="LOAN_PRODUCT" class="java.lang.String"/>
	<variable name="TOT_PRIN_BALANCE" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{PRIN_BALANCE}]]></variableExpression>
	</variable>
	<variable name="TOT_RPA_BALANCE" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{RPA_BALANCE}]]></variableExpression>
	</variable>
	<variable name="TOT_INT_DUE_BALANCE" class="java.math.BigDecimal" calculation="Sum">
