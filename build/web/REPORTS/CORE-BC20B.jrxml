<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="CORE-BC20B" language="groovy" pageWidth="842" pageHeight="625" orientation="Landscape" whenNoDataType="NoDataSection" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="bfefce5d-43b3-4930-8c00-23ac13cf4ff5">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="15"/>
	<parameter name="PARA_MAPGD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["D:\\VBSPREPORTS\\MODIFIEDREPORTS\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_MAXA" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<parameter name="PARA_DVUT" class="java.lang.String"/>
	<parameter name="PARA_MATO" class="java.lang.String"/>
	<queryString>
		<![CDATA[--CORE-BC20B
SELECT *
FROM
    (select distinct KU_MAKH CUSTOMER_CODE,
        INITCAP(TENKH) CUSTOMER_NAME,
        KU_MATO GROUP_ID,
        TO_TENTT GROUP_LEADER_NAME,
        TO_DVUT MASS_ORG,
        D.TEN ||'--'||C.TEN  GROUP_LEADER_ADDRESS,
        KU_SOKU LOAN_CODE,
        case when KU_CHTRINH = '02' then KU_NGAYVAY else case when KU_NGAYVAY<KU_NGAYGNDT then KU_NGAYGNDT else KU_NGAYVAY end end BOOKING_DATE,
        KU_NGAYDHAN_2 MATURITY_DATE,
        KU_GNGAN  DISB_AMT,
        NVL(KU_DNOTHAN,0) PRIN_BALANCE,
        NVL(KU_DNOQHAN,0) dnqh,
        NVL(KU_DNOKHOANH,0) dnkh,
        KU_TON_RPA RPA_BALANCE,
        NVL(KU_LAITONTHAN,0) + NVL(KU_LAITONQHAN,0) INT_DUE_BALANCE,
        C.MA COMMUNE_ID,
        C.TEN COMMUNE_NAME,
        SUBSTR(e.SP_TEN,1,INSTR( e.SP_TEN ,'-',1)-1) LOAN_PRODUCT,
        KU_SCHEM_CD
    from hsku a, dmxa c, dmthon d , DM_SPRODUCT e,hsto g,
        (SELECT KH_MAKH MAKH, KH_TENKH TENKH FROM HSKH where KH_MAPGD = $P{PARA_MAPGD} and nvl(KH_TTRANG, 'A') <> 'C'
                UNION SELECT DN_MA MAKH, DN_TEN TENKH FROM HSKH_DN where DN_MAPGD = $P{PARA_MAPGD} and  NVL(DN_TTRANG, 'A') <> 'C') B
    where a.ku_makh = b.makh
        and a.ku_MADP = d.MA
        and c.ma = d.xa
        and KU_MAPGD = $P{PARA_MAPGD}
        and KU_NGAYBC = TO_DATE($P{PARA_NGAYBC})
        and decode($P{PARA_MAXA},'000000', '1', SUBSTR(KU_MADP,1,6)) = decode($P{PARA_MAXA},'000000', '1', $P{PARA_MAXA})
        and decode($P{PARA_DVUT},'10', '1', TO_DVUT) = decode($P{PARA_DVUT},'10', '1',$P{PARA_DVUT})
        and decode($P{PARA_MATO},'0000000', '1', TO_MATO) = decode($P{PARA_MATO},'0000000', '1',$P{PARA_MATO})
        --and to_loaito = '01'
        and NVL(KU_TTMONVAY,'OPEN') = 'OPEN'
        and KU_SPRD_CD = e.SP_MA
and ku_mato is not null
        and KU_MATO = g.TO_MATO(+)
    UNION
    select distinct KU_MAKH CUSTOMER_CODE,
        INITCAP(TENKH) CUSTOMER_NAME,
        KU_MATO GROUP_ID,
        ' ' GROUP_LEADER_NAME,
        ' ' MASS_ORG,
        (select D.TEN ||'--'||C.TEN  from dmthon d, dmxa c where c.ma = d.xa and a.ku_MADP = d.MA) GROUP_LEADER_ADDRESS,
        KU_SOKU LOAN_CODE,
        case when KU_CHTRINH = '02' then KU_NGAYVAY else case when KU_NGAYVAY<KU_NGAYGNDT then KU_NGAYGNDT else KU_NGAYVAY end end BOOKING_DATE,
        KU_NGAYDHAN_2 MATURITY_DATE,
        KU_GNGAN  DISB_AMT,
        NVL(KU_DNOTHAN,0) PRIN_BALANCE,
        NVL(KU_DNOQHAN,0) dnqh,
        NVL(KU_DNOKHOANH,0) dnkh,
        KU_TON_RPA RPA_BALANCE,
        NVL(KU_LAITONTHAN,0) + NVL(KU_LAITONQHAN,0) INT_DUE_BALANCE,
        SUBSTR(KU_MADP,1,6) COMMUNE_ID,
        'Vay trực tiếp' COMMUNE_NAME,
        SUBSTR(e.SP_TEN,1,INSTR( e.SP_TEN ,'-',1)-1) LOAN_PRODUCT,
        KU_SCHEM_CD
    from hsku a, DM_SPRODUCT e,
        (SELECT KH_MAKH MAKH, KH_TENKH TENKH FROM HSKH where KH_MAPGD = $P{PARA_MAPGD} and nvl(KH_TTRANG, 'A') <> 'C'
                UNION SELECT DN_MA MAKH, DN_TEN TENKH FROM HSKH_DN where DN_MAPGD = $P{PARA_MAPGD} and  NVL(DN_TTRANG, 'A') <> 'C') B
    where a.ku_makh = b.makh
 and KU_mato is null
and decode($P{PARA_DVUT},'10', '1','0') = '1'
 and decode($P{PARA_MAXA},'000000', '1', SUBSTR(KU_MADP,1,6)) = decode($P{PARA_MAXA},'000000', '1', $P{PARA_MAXA})
    --    AND SUBSTR(KU_MADP, 5, 4) = '0000'
        and KU_MAPGD = $P{PARA_MAPGD}
        and KU_NGAYBC = TO_DATE($P{PARA_NGAYBC})
        and NVL(KU_TTMONVAY,'OPEN') = 'OPEN'
        and KU_SPRD_CD = e.SP_MA)
    order by COMMUNE_ID, MASS_ORG, GROUP_ID, CUSTOMER_CODE, KU_SCHEM_CD]]>
	</queryString>
