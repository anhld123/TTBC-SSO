<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="SUB_REPORT_V_15_6" language="groovy" pageWidth="555" pageHeight="802" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<style name="Crosstab Data Text" hAlign="Center"/>
	<parameter name="PARA_MAPGD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_TONGHOP" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_NGAYBC" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[/* Formatted on 6/24/2014 3:46:08 PM (QP5 v5.252.13127.32847) */
SELECT A.DESCRIPT,
       A.CAPITAL,
       A.eval_back_asset,
       A.exchange_rate,
       A.dev_invest_fund,
       A.reserve_fund,
       A.add_cap_reserve_fund,
       A.other_funds_equity,
       A.Undist_profit_after_tax,
       A.other_equity,
       A.GROUP_TYPE,
       A.GROUP_NAME
  FROM ((
SELECT 'Số dư đầu kỳ' DESCRIPT, DN_TK_SBV ($P{PARA_NGAYBC},$P{PARA_MAPGD},$P{PARA_TONGHOP},'601','P') capital,
0 eval_back_asset,
DN_TK_SBV(ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_MAPGD},$P{PARA_TONGHOP},'631','P') exchange_rate,
DN_TK_SBV(ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_MAPGD},$P{PARA_TONGHOP},'612','P') dev_invest_fund,
DN_TK_SBV(ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_MAPGD},$P{PARA_TONGHOP},'613','P') reserve_fund,
DN_TK_SBV(ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_MAPGD},$P{PARA_TONGHOP},'611','P') add_cap_reserve_fund,
(DN_TK_SBV(ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_MAPGD},$P{PARA_TONGHOP},'62','P')+
DN_TK_SBV(ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_MAPGD},$P{PARA_TONGHOP},'619','P')) other_funds_equity,
DN_TK_SBV(ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_MAPGD},$P{PARA_TONGHOP},'69','P') Undist_profit_after_tax,
(DN_TK_SBV(ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_MAPGD},$P{PARA_TONGHOP},'602','P')+
DN_TK_SBV(ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_MAPGD},$P{PARA_TONGHOP},'609','P')) other_equity,
1 GROUP_TYPE,'Số dư đầu kỳ' GROUP_NAME, 1 SEQ FROM DUAL)
UNION
(SELECT '- Tăng vốn trong kỳ' DESCRIPT,
NVL (FUNC_TOT_CR_DR_AMT('601',$P{PARA_MAPGD},$P{PARA_TONGHOP},ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_NGAYBC},'FCY','C',1), 0) CAPITAL,
0 eval_back_asset,
NVL (FUNC_TOT_CR_DR_AMT('631',$P{PARA_MAPGD},$P{PARA_TONGHOP},ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_NGAYBC},'FCY','C',1), 0) exchange_rate,
NVL (FUNC_TOT_CR_DR_AMT('612',$P{PARA_MAPGD},$P{PARA_TONGHOP},ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_NGAYBC},'FCY','C',1), 0) dev_invest_fund,
NVL (FUNC_TOT_CR_DR_AMT('613',$P{PARA_MAPGD},$P{PARA_TONGHOP},ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_NGAYBC},'FCY','C',1), 0) reserve_fund,
NVL (FUNC_TOT_CR_DR_AMT('611',$P{PARA_MAPGD},$P{PARA_TONGHOP},ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_NGAYBC},'FCY','C',1), 0) add_cap_reserve_fund,
(NVL (FUNC_TOT_CR_DR_AMT('62',$P{PARA_MAPGD},$P{PARA_TONGHOP},ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_NGAYBC},'FCY','C',1), 0) +
NVL (FUNC_TOT_CR_DR_AMT('619',$P{PARA_MAPGD},$P{PARA_TONGHOP},ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_NGAYBC},'FCY','C',1), 0) )other_funds_equity,
NVL (FUNC_TOT_CR_DR_AMT('69',$P{PARA_MAPGD},$P{PARA_TONGHOP},ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_NGAYBC},'FCY','C',1), 0) Undist_profit_after_tax,
(NVL (FUNC_TOT_CR_DR_AMT('602',$P{PARA_MAPGD},$P{PARA_TONGHOP},ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_NGAYBC},'FCY','C',1), 0)+
NVL (FUNC_TOT_CR_DR_AMT('609',$P{PARA_MAPGD},$P{PARA_TONGHOP},ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_NGAYBC},'FCY','C',1), 0)) other_equity,
2 GROUP_TYPE,'Tăng trong kỳ' GROUP_NAME, 1 SEQ FROM DUAL)
UNION
(SELECT '- Lợi nhuận tăng trong kỳ' DESCRIPT,
NULL CAPITAL, NULL eval_back_asset, NULL exchange_rate,
NULL dev_invest_fund,NULL reserve_fund, NULL add_cap_reserve_fund, NULL other_funds_equity,
NULL Undist_profit_after_tax,
NULL other_equity,2 GROUP_TYPE,'Tăng trong kỳ' GROUP_NAME, 2 SEQ FROM DUAL)
UNION
(SELECT '- Trích bổ sung các quỹ cho kỳ trước' DESCRIPT,NULL CAPITAL, NULL eval_back_asset, NULL exchange_rate,
NULL dev_invest_fund,NULL reserve_fund, NULL add_cap_reserve_fund, NULL other_funds_equity,
NULL Undist_profit_after_tax, NULL other_equity,2 GROUP_TYPE,'Tăng trong kỳ' GROUP_NAME, 3 SEQ FROM DUAL)
UNION
(SELECT '- Tạm trích lập các quỹ dự trữ cho kỳ' DESCRIPT,NULL CAPITAL, NULL eval_back_asset, NULL exchange_rate,
NULL dev_invest_fund,NULL reserve_fund, NULL add_cap_reserve_fund, NULL other_funds_equity,
NULL Undist_profit_after_tax, NULL other_equity, 2 GROUP_TYPE,'Tăng trong kỳ' GROUP_NAME, 4 SEQ FROM DUAL)
UNION
(SELECT '- Chuyển từ quỹ dự trữ sang vốn' DESCRIPT,NULL CAPITAL, NULL eval_back_asset, NULL exchange_rate,
NULL dev_invest_fund,NULL reserve_fund, NULL add_cap_reserve_fund, NULL other_funds_equity,
NULL Undist_profit_after_tax, NULL other_equity, 2 GROUP_TYPE,'Tăng trong kỳ' GROUP_NAME, 5 SEQ FROM DUAL)
UNION
(SELECT '- Chuyển khoản thu sử dụng vốn sang quỹ dự trữ bổ sung vốn điều lệ' DESCRIPT,NULL CAPITAL,
NULL eval_back_asset, NULL exchange_rate, NULL dev_invest_fund,NULL reserve_fund,
NULL add_cap_reserve_fund, NULL other_funds_equity,
NULL Undist_profit_after_tax, NULL other_equity, 2 GROUP_TYPE,'Tăng trong kỳ' GROUP_NAME, 6 SEQ FROM DUAL)
UNION
(SELECT '- Trích bổ sung quỹ lương theo kết quả hoạt động kinh doanh kỳ trước theo quy định của nhà nước' DESCRIPT,
NULL CAPITAL, NULL eval_back_asset, NULL exchange_rate,
NULL dev_invest_fund,NULL reserve_fund, NULL add_cap_reserve_fund, NULL other_funds_equity,
NULL Undist_profit_after_tax, NULL other_equity, 2 GROUP_TYPE,'Tăng trong kỳ' GROUP_NAME, 7 SEQ FROM DUAL)
UNION
(SELECT '- Sử dụng trong kỳ' DESCRIPT,
NVL (FUNC_TOT_CR_DR_AMT('601',$P{PARA_MAPGD},$P{PARA_TONGHOP},ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_NGAYBC},'FCY','D',1), 0) CAPITAL,
0 eval_back_asset,
NVL (FUNC_TOT_CR_DR_AMT('631',$P{PARA_MAPGD},$P{PARA_TONGHOP},ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_NGAYBC},'FCY','D',1), 0) exchange_rate,
NVL (FUNC_TOT_CR_DR_AMT('612',$P{PARA_MAPGD},$P{PARA_TONGHOP},ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_NGAYBC},'FCY','D',1), 0) dev_invest_fund,
NVL (FUNC_TOT_CR_DR_AMT('613',$P{PARA_MAPGD},$P{PARA_TONGHOP},ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_NGAYBC},'FCY','D',1), 0) reserve_fund,
NVL (FUNC_TOT_CR_DR_AMT('611',$P{PARA_MAPGD},$P{PARA_TONGHOP},ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_NGAYBC},'FCY','D',1), 0) add_cap_reserve_fund,
(NVL (FUNC_TOT_CR_DR_AMT('62',$P{PARA_MAPGD},$P{PARA_TONGHOP},ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_NGAYBC},'FCY','D',1), 0) +
NVL (FUNC_TOT_CR_DR_AMT('619',$P{PARA_MAPGD},$P{PARA_TONGHOP},ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_NGAYBC},'FCY','D',1), 0)) other_funds_equity,
NVL (FUNC_TOT_CR_DR_AMT('69',$P{PARA_MAPGD},$P{PARA_TONGHOP},ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_NGAYBC},'FCY','D',1), 0) Undist_profit_after_tax,
(NVL (FUNC_TOT_CR_DR_AMT('602',$P{PARA_MAPGD},$P{PARA_TONGHOP},ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_NGAYBC},'FCY','D',1), 0)+
NVL (FUNC_TOT_CR_DR_AMT('609',$P{PARA_MAPGD},$P{PARA_TONGHOP},ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_NGAYBC},'FCY','D',1), 0)) other_equity,
3 GROUP_TYPE,'Giảm trong kỳ' GROUP_NAME, 1 SEQ FROM DUAL)
UNION
(SELECT '- Các khoản giảm khác' DESCRIPT,NULL CAPITAL,
NULL eval_back_asset, NULL exchange_rate, NULL dev_invest_fund,NULL reserve_fund,
NULL add_cap_reserve_fund, NULL other_funds_equity,
NULL Undist_profit_after_tax, NULL other_equity, 3 GROUP_TYPE,'Giảm trong kỳ' GROUP_NAME, 2 SEQ FROM DUAL)
UNION
(SELECT 'Số dư cuối kỳ' DESCRIPT,
DN_TK_SBV(ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_MAPGD},$P{PARA_TONGHOP},'601','P') capital,
0 eval_back_asset,
DN_TK_SBV($P{PARA_NGAYBC},$P{PARA_MAPGD},$P{PARA_TONGHOP},'631','P') exchange_rate,
DN_TK_SBV($P{PARA_NGAYBC},$P{PARA_MAPGD},$P{PARA_TONGHOP},'612','P') dev_invest_fund,
DN_TK_SBV($P{PARA_NGAYBC},$P{PARA_MAPGD},$P{PARA_TONGHOP},'613','P') reserve_fund,
DN_TK_SBV($P{PARA_NGAYBC},$P{PARA_MAPGD},$P{PARA_TONGHOP},'611','P') add_cap_reserve_fund,
(DN_TK_SBV($P{PARA_NGAYBC},$P{PARA_MAPGD},$P{PARA_TONGHOP},'62','P')+
DN_TK_SBV($P{PARA_NGAYBC},$P{PARA_MAPGD},$P{PARA_TONGHOP},'619','P')) other_funds_equity,
DN_TK_SBV($P{PARA_NGAYBC},$P{PARA_MAPGD},$P{PARA_TONGHOP},'69','P') Undist_profit_after_tax,
(DN_TK_SBV($P{PARA_NGAYBC},$P{PARA_MAPGD},$P{PARA_TONGHOP},'602','P')+
DN_TK_SBV($P{PARA_NGAYBC},$P{PARA_MAPGD},$P{PARA_TONGHOP},'609','P')) other_equity,
4 GROUP_TYPE,'Số dư cuối kỳ' GROUP_NAME, 1 SEQ FROM DUAL)) A ORDER BY A.GROUP_TYPE,A.SEQ]]>
	</queryString>
	<field name="DESCRIPT" class="java.lang.String"/>
	<field name="CAPITAL" class="java.math.BigDecimal"/>
	<field name="EVAL_BACK_ASSET" class="java.math.BigDecimal"/>
	<field name="EXCHANGE_RATE" class="java.math.BigDecimal"/>
	<field name="DEV_INVEST_FUND" class="java.math.BigDecimal"/>
	<field name="RESERVE_FUND" class="java.math.BigDecimal"/>
	<field name="ADD_CAP_RESERVE_FUND" class="java.math.BigDecimal"/>
	<field name="OTHER_FUNDS_EQUITY" class="java.math.BigDecimal"/>
	<field name="UNDIST_PROFIT_AFTER_TAX" class="java.math.BigDecimal"/>
	<field name="OTHER_EQUITY" class="java.math.BigDecimal"/>
	<field name="GROUP_TYPE" class="java.math.BigDecimal"/>
	<field name="GROUP_NAME" class="java.lang.String"/>
	<variable name="ROW_TOTAL" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$F{CAPITAL}.add($F{EXCHANGE_RATE}).add($F{DEV_INVEST_FUND}).add($F{RESERVE_FUND}).add($F{ADD_CAP_RESERVE_FUND}).add($F{OTHER_FUNDS_EQUITY}).add($F{UNDIST_PROFIT_AFTER_TAX}).add($F{OTHER_EQUITY})]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="CAPITAL_1" class="java.math.BigDecimal" resetType="Group" resetGroup="GROUP_TYPE" calculation="Sum">
		<variableExpression><![CDATA[$F{CAPITAL}]]></variableExpression>
	</variable>
	<variable name="EVAL_BACK_ASSET_1" class="java.math.BigDecimal" resetType="Group" resetGroup="GROUP_TYPE" calculation="Sum">
		<variableExpression><![CDATA[$F{EVAL_BACK_ASSET}]]></variableExpression>
	</variable>
	<variable name="EXCHANGE_RATE_1" class="java.math.BigDecimal" resetType="Group" resetGroup="GROUP_TYPE" calculation="Sum">
		<variableExpression><![CDATA[$F{EXCHANGE_RATE}]]></variableExpression>
	</variable>
	<variable name="DEV_INVEST_FUND_1" class="java.math.BigDecimal" resetType="Group" resetGroup="GROUP_TYPE" calculation="Sum">
		<variableExpression><![CDATA[$F{DEV_INVEST_FUND}]]></variableExpression>
	</variable>
	<variable name="RESERVE_FUND_1" class="java.math.BigDecimal" resetType="Group" resetGroup="GROUP_TYPE" calculation="Sum">
		<variableExpression><![CDATA[$F{RESERVE_FUND}]]></variableExpression>
	</variable>
	<variable name="ADD_CAP_RESERVE_FUND_1" class="java.math.BigDecimal" resetType="Group" resetGroup="GROUP_TYPE" calculation="Sum">
		<variableExpression><![CDATA[$F{ADD_CAP_RESERVE_FUND}]]></variableExpression>
	</variable>
	<variable name="OTHER_FUNDS_EQUITY_1" class="java.math.BigDecimal" resetType="Group" resetGroup="GROUP_TYPE" calculation="Sum">
		<variableExpression><![CDATA[$F{OTHER_FUNDS_EQUITY}]]></variableExpression>
	</variable>
	<variable name="UNDIST_PROFIT_AFTER_TAX_1" class="java.math.BigDecimal" resetType="Group" resetGroup="GROUP_TYPE" calculation="Sum">
		<variableExpression><![CDATA[$F{UNDIST_PROFIT_AFTER_TAX}]]></variableExpression>
	</variable>
	<variable name="UNDIST_PROFIT_AFTER_TAX_2" class="java.math.BigDecimal" resetType="Group" resetGroup="GROUP_TYPE" calculation="Sum">
		<variableExpression><![CDATA[$F{UNDIST_PROFIT_AFTER_TAX}]]></variableExpression>
	</variable>
	<variable name="UNDIST_PROFIT_AFTER_TAX_3" class="java.math.BigDecimal" resetType="Group" resetGroup="GROUP_TYPE" calculation="Sum">
		<variableExpression><![CDATA[$F{UNDIST_PROFIT_AFTER_TAX}]]></variableExpression>
	</variable>
	<variable name="OTHER_EQUITY_1" class="java.math.BigDecimal" resetType="Group" resetGroup="GROUP_TYPE" calculation="Sum">
		<variableExpression><![CDATA[$F{OTHER_EQUITY}]]></variableExpression>
	</variable>
	<variable name="GROUP_TOTAL" class="java.math.BigDecimal" resetType="Group" resetGroup="GROUP_TYPE" calculation="Sum">
		<variableExpression><![CDATA[$F{CAPITAL} + $F{EVAL_BACK_ASSET} + $F{EXCHANGE_RATE} + $F{DEV_INVEST_FUND}
+ $F{RESERVE_FUND} + $F{ADD_CAP_RESERVE_FUND} + $F{OTHER_FUNDS_EQUITY}
+ $F{UNDIST_PROFIT_AFTER_TAX} + $F{OTHER_EQUITY}]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<group name="GROUP_TYPE">
		<groupExpression><![CDATA[$F{GROUP_TYPE}]]></groupExpression>
		<groupHeader>
			<band height="20">
