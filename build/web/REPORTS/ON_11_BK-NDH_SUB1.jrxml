	<queryString>
		<![CDATA[select distinct KU_MAKH MPI_CUST_ID,
 KH_TENKH MC_CUST_NAME_LOCAL,
 KU_MATO GROUP_ID,
 KU_SOKU MPI_LEGACY_ID,
TO_CHAR(KU_NGAYVAY,'DD/MM/YY')   MPI_ST_DT,
 TO_CHAR(KU_NGAYDHAN_1,'DD/MM/YY')  MPI_MAT_DT,
 KU_GOCDHAN MPF_PRIN_BALANCE
  from hsku a, hskh b , dmxa c, dmthon d , hsto g
 where a.ku_makh = b.kh_makh
 and b.KH_MADP = d.MA
 and c.ma = d.xa
 and KU_TTMONVAY = 'OPEN'
 AND TO_DATE(TO_CHAR(KU_NGAYDHAN_1,'DD-MON-YYYY'),'DD-MON-YYYY') BETWEEN ADD_MONTHS($P{PARA_DENNGAY},-1) AND $P{PARA_DENNGAY}
 and KU_GOCDHAN > 0
 and KU_MATO = $P{PARA_MATO}
 order by KU_MAKH]]>
	</queryString>
