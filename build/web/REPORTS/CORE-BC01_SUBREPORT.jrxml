	<property name="ireport.zoom" value="1.0245201830476058"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_GDVIEN" class="java.lang.String"/>
	<parameter name="PARA_NGAYBC" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString language="plsql">
		<![CDATA[select * from (
select gdv,sbt REF_NO,tk ACCOUNT_NO,DECODE(NOCO,'D','Nợ','Có') DR_CR_FLG,sotien lcy_amt, ghichu_2 INTERNAL_REMARKS, ngaygd, sotien as ccy_amt,
'VND' CCY_DESC from hsbt where trunc(ngaygd) = $P{PARA_NGAYBC}
    AND mapgd = $P{PARA_MAPGD}
    AND gdv = $P{PARA_GDVIEN}
    and mod_Cd||TXN_CD<>'CT25'
union all
select gdv,sbt REF_NO,'' ACCOUNT_NO,DECODE(NOCO,'D','Nợ','Có') DR_CR_FLG,sum(sotien) lcy_amt, ghichu_2 INTERNAL_REMARKS, ngaygd, sum(sotien) as ccy_amt,
'VND' CCY_DESC from hsbt where trunc(ngaygd) = $P{PARA_NGAYBC}
    AND mapgd = $P{PARA_MAPGD}
    AND gdv = $P{PARA_GDVIEN}
    and mod_Cd='CT'
    and txn_cd='25'
group by gdv, sbt,DECODE(NOCO,'D','Nợ','Có'),ghichu_2,ngaygd)
ORDER BY REF_NO,DR_CR_FLG,ACCOUNT_NO]]>
	</queryString>
	<field name="GDV" class="java.lang.String"/>
	<field name="REF_NO" class="java.lang.String"/>
	<field name="ACCOUNT_NO" class="java.lang.String"/>
	<field name="DR_CR_FLG" class="java.lang.String"/>
	<field name="LCY_AMT" class="java.math.BigDecimal"/>
	<field name="INTERNAL_REMARKS" class="java.lang.String"/>
	<field name="NGAYGD" class="java.sql.Timestamp"/>
	<field name="CCY_AMT" class="java.math.BigDecimal"/>
	<field name="CCY_DESC" class="java.lang.String"/>
	<variable name="AMT_TOTAL" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{CCY_AMT}]]></variableExpression>
	</variable>
	<variable name="TOT_DEBIT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{DR_CR_FLG}.equals("Nợ")?$F{LCY_AMT}:new BigDecimal(0)]]></variableExpression>
	</variable>
	<variable name="TOT_CREDIT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{DR_CR_FLG}.equals("Có")?$F{LCY_AMT}:new BigDecimal(0)]]></variableExpression>
	</variable>
	<variable name="LCY_AMT" class="java.lang.String"/>
	<variable name="CCY_AMT_1" class="java.math.BigDecimal" resetType="Group" resetGroup="ACCOUNT_NO" calculation="Sum">
		<variableExpression><![CDATA[$F{CCY_AMT}]]></variableExpression>
	</variable>
	<variable name="LCY_AMT_1" class="java.math.BigDecimal" resetType="Group" resetGroup="ACCOUNT_NO" calculation="Sum">
		<variableExpression><![CDATA[$F{LCY_AMT}]]></variableExpression>
	</variable>
	<variable name="COUNT_FROUP" class="java.lang.Integer" incrementType="Group" incrementGroup="ACCOUNT_NO" calculation="Count">
		<variableExpression><![CDATA[$V{ACCOUNT_NO_COUNT}]]></variableExpression>
		<initialValueExpression><![CDATA[new Integer(0)]]></initialValueExpression>
	</variable>
	<group name="ACCOUNT_NO">
		<groupExpression><![CDATA[$F{REF_NO}.substring( 0, 5 )=="BPYMT"?$F{ACCOUNT_NO}+$F{REF_NO}:$F{REF_NO}+$F{ACCOUNT_NO}+$F{DR_CR_FLG}+$F{CCY_AMT}.toString()+$F{LCY_AMT}]]></groupExpression>
