<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="BCDHTD_03.2" language="groovy" pageWidth="1125" pageHeight="780" orientation="Landscape" columnWidth="1087" leftMargin="20" rightMargin="18" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="266"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_TONGHOP" class="java.lang.String"/>
	<parameter name="PARA_DENNGAY" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT A.GIATRI DTTH, A.KHOA_2 MA_DTTH,
(select NVL(sum(DTTH_D1)/1000000,0) from BCTD_DTTH, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE DTTH_MAPGD = Y.PO_MA AND DTTH_MAQD = '02' AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND DTTH_DTTH = A.KHOA_2 AND DTTH_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) DS_CHOVAYT,
(select NVL(sum(DTTH_D2)/1000000,0) from BCTD_DTTH, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE DTTH_MAPGD = Y.PO_MA AND DTTH_MAQD = '02' AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND DTTH_DTTH = A.KHOA_2 AND DTTH_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) DS_CHOVAYN,
(select NVL(sum(DTTH_D3)/1000000,0) from BCTD_DTTH, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE DTTH_MAPGD = Y.PO_MA AND DTTH_MAQD = '02' AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND DTTH_DTTH = A.KHOA_2 AND DTTH_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) DS_THUNOT,
(select NVL(sum(DTTH_D4)/1000000,0) from BCTD_DTTH, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE DTTH_MAPGD = Y.PO_MA AND DTTH_MAQD = '02' AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND DTTH_DTTH = A.KHOA_2 AND DTTH_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) DS_THUNON,
(select NVL(sum(DTTH_D5)/1000000,0) from BCTD_DTTH, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE DTTH_MAPGD = Y.PO_MA AND DTTH_MAQD = '02' AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND DTTH_DTTH = A.KHOA_2 AND DTTH_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) DS_XOANOT,
(select NVL(sum(DTTH_D6)/1000000,0) from BCTD_DTTH, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE DTTH_MAPGD = Y.PO_MA AND DTTH_MAQD = '02' AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND DTTH_DTTH = A.KHOA_2 AND DTTH_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) DS_XOANON,
(select NVL(sum(DTTH_D7)/1000000,0) from BCTD_DTTH, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE DTTH_MAPGD = Y.PO_MA AND DTTH_MAQD = '02' AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND DTTH_DTTH = A.KHOA_2 AND DTTH_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) TONG_DN,
(select NVL(sum(DTTH_D8)/1000000,0) from BCTD_DTTH, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE DTTH_MAPGD = Y.PO_MA AND DTTH_MAQD = '02' AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND DTTH_DTTH = A.KHOA_2 AND DTTH_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) NO_THAN,
(select NVL(sum(DTTH_D9)/1000000,0) from BCTD_DTTH, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE DTTH_MAPGD = Y.PO_MA AND DTTH_MAQD = '02' AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND DTTH_DTTH = A.KHOA_2 AND DTTH_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) NO_QHAN,
(select NVL(sum(DTTH_D10)/1000000,0) from BCTD_DTTH, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE DTTH_MAPGD = Y.PO_MA AND DTTH_MAQD = '02' AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND DTTH_DTTH = A.KHOA_2 AND DTTH_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) NO_KHOANH,
(select NVL(sum(DTTH_D11)/1000000,0) from BCTD_DTTH, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE DTTH_MAPGD = Y.PO_MA AND DTTH_MAQD = '02' AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND DTTH_DTTH = A.KHOA_2 AND DTTH_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) NO_NGANHAN,
(select NVL(sum(DTTH_D12)/1000000,0) from BCTD_DTTH, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE DTTH_MAPGD = Y.PO_MA AND DTTH_MAQD = '02' AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND DTTH_DTTH = A.KHOA_2 AND DTTH_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) NO_TRUNGHAN,
(select NVL(sum(DTTH_D13)/1000000,0) from BCTD_DTTH, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE DTTH_MAPGD = Y.PO_MA AND DTTH_MAQD = '02' AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND DTTH_DTTH = A.KHOA_2 AND DTTH_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) NO_DAIHAN,
(select NVL(sum(DTTH_D14),0) from BCTD_DTTH, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE DTTH_MAPGD = Y.PO_MA AND DTTH_MAQD = '02' AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND DTTH_DTTH = A.KHOA_2 AND DTTH_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) SKH_DUNO,
(select NVL(sum(DTTH_D15),0) from BCTD_DTTH, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE DTTH_MAPGD = Y.PO_MA AND DTTH_MAQD = '02' AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND DTTH_DTTH = A.KHOA_2 AND DTTH_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) SKH_VVON
FROM DMKHAC A, BCTD_DTTH B, DMPOS Y
WHERE A.KHOA_1= '16'
AND (A.KHOA_2 = '01' OR A.KHOA_2 = '02' OR A.KHOA_2 = '03' OR A.KHOA_2 = '06' OR A.KHOA_2 = '07' OR A.KHOA_2 = '08' OR A.KHOA_2 = '19')
AND B.DTTH_MAPGD = Y.PO_MA
group by A.KHOA_2, A.GIATRI
order by A.KHOA_2]]>
	</queryString>
