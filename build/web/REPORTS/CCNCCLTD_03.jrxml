					<rightPen lineWidth="0.25"/>
				</box>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="13" isBold="true"/>
				</textElement>
				<textFieldExpression><![CDATA[$V{YEU_2}/$V{SOPGD_2}*100-$V{S_YEU_2}/$V{S_SOPGD_2}*100]]></textFieldExpression>
			</textField>
		</band>
	</summary>
</jasperReport>
