<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="TT21_13B_SUBREPORT_2" language="groovy" pageWidth="1190" pageHeight="842" orientation="Landscape" columnWidth="1150" leftMargin="20" rightMargin="20" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="0.75"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_NGAYBC" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_MAPGD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_TONGHOP" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT  currency_denom,
case
    when instr(currency_denom,'P') > 0 then 1
    when instr(currency_denom,'C') > 0 then 2
    when instr(currency_denom,'K') > 0 then 3
 end loaitien,
 length(currency_denom) dodai,
SUM(NVL(OPEN_RESERVE_FUND_II,0)) open_reserve_fund,
SUM(NVL(INCOME_TOTAL_II,0)) income_total,
SUM(nvl(EXPENSE_TOTAL_II,0)) expense_total,
SUM(NVL(CLOSE_RESERVE_FUND_II,0)) close_reserve_fund,
EOD_DT,
POS_FLAG
 FROM REP_13B where EOD_DT =  $P{PARA_NGAYBC} and POS_FLAG = 'Y'
 AND DECODE($P{PARA_MAPGD},'000100','00',POS_CD) = DECODE($P{PARA_MAPGD},'000100','00',$P{PARA_MAPGD})
 group by currency_denom,EOD_DT,
POS_FLAG
order by
case
    when instr(currency_denom,'P') > 0 then 1
    when instr(currency_denom,'C') > 0 then 2
    when instr(currency_denom,'K') > 0 then 3
 end ,
 length(currency_denom) desc,
 currency_denom desc]]>
	</queryString>
