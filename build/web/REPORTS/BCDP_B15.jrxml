		<initialValueExpression><![CDATA[new Integer(0)]]></initialValueExpression>
	</variable>
	<variable name="DS_GNGAN_1" class="java.math.BigDecimal" resetType="Group" resetGroup="HUYEN_grp" calculation="Sum">
