<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="BCDP-B15" language="groovy" pageWidth="1000" pageHeight="670" orientation="Landscape" columnWidth="965" leftMargin="20" rightMargin="15" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_QUY" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_NAM" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_TONGHOP" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT A.MA MAH,A.TEN HUYEN, B.TEN XA, B.MA MAXA,
(select NVL(sum(KU_A_GNGAN)/1000000,0) from  HSKU, HSKH where  B.MA = SUBSTR(KH_MADP,1,6) and SUBSTR(KU_MAPGD,3,4) = A.MA and KU_MAKH = KH_MAKH and (to_number(to_char(KU_NGAYBC,'mm')) = to_number($P{PARA_QUY})*3 AND to_char(ku_ngaybc,'yyyy') = $P{PARA_NAM})) DS_GNGAN,
(select NVL(sum(KU_DNOTHAN+KU_DNOQHAN+KU_DNOKHOANH),0)/1000000 from  HSKU, HSKH where   B.MA = SUBSTR(KH_MADP,1,6) and SUBSTR(KU_MAPGD,3,4) = A.MA and KU_MAKH = KH_MAKH  and (to_number(to_char(KU_NGAYBC,'mm')) = to_number($P{PARA_QUY})*3 AND to_char(ku_ngaybc,'yyyy') = $P{PARA_NAM})) DU_NO,
(select count(distinct(KU_MAKH)) from  HSKU, HSKH where B.MA = SUBSTR(KH_MADP,1,6) and SUBSTR(KU_MAPGD,3,4) = A.MA and KU_MAKH = KH_MAKH and (to_number(to_char(KU_NGAYBC,'mm')) = to_number($P{PARA_QUY})*3 AND to_char(ku_ngaybc,'yyyy') = $P{PARA_NAM})) KH_DN
FROM DMHUYEN A, DMXA B,HSKU C, HSKH D, DMPOS Y,
       (SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z
WHERE A.MA = SUBSTR(C.KU_MAPGD,3,4)
AND B.MA = SUBSTR(KU_MADP,1,6)
AND B.MA = SUBSTR(D.KH_MADP,1,6)
AND C.KU_MAKH = D.KH_MAKH
AND KU_MAPGD = Y.PO_MA
AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA)
   AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD})
group by A.MA,A.TEN, B.MA, B.TEN
order by A.TEN, B.TEN]]>
	</queryString>
