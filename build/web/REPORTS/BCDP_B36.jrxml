	<parameter name="PARA_MAPGD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_DENNGAY" class="java.lang.String"/>
	<parameter name="PARA_TONGHOP" class="java.lang.String"/>
	<queryString language="plsql">
		<![CDATA[select a.*,SUBSTR(B.giatri,INSTR(B.giatri,'-',1)+1) TEN_CT from
(select ku_chtrinh,
round(sum(decode(KU_MAPNKT51,'01230' ,KU_M_GNGAN,0))/1000000,2) gngna_dieu,
round(sum( decode (KU_MAPNKT51, '01250' ,KU_M_GNGAN,0))/1000000,2) gngna_caosu,
round(sum( decode (KU_MAPNKT51, '01240' ,KU_M_GNGAN,0))/1000000,2) gngna_hotieu,
round(sum( decode (KU_MAPNKT51,'01260' ,KU_M_GNGAN,0))/1000000,2) gngna_caphe,
round(sum( decode (KU_MAPNKT51,'41000' ,KU_M_GNGAN,0))/1000000,2) gngna_nhao,
round(sum(case when KU_MAPNKT51 like '%85' then KU_M_GNGAN else 0end )/1000000,2) as gngna_gddt,
round(sum(case when KU_MAPNKT51 in ('36000','39000')then KU_M_GNGAN else 0end )/1000000,2) as gngna_nsvsmt,
round(sum(case when KU_MAPNKT51 not in ('01230','01250','01240','01260' ,'41000' ,'36000','39000') and KU_MAPNKT51 not like '%85' then KU_M_GNGAN else 0 end )/1000000,2) as gngna_khac
from hsku,DMPOS Y, (select PO_POSFLG, PO_MACN, PO_MA from dmpos where PO_MA = $P{PARA_MAPGD}) Z
where KU_MAPGD = Y.PO_MA and decode(Z.PO_POSFLG, 'H', 1, 'S', Y.PO_MA , Y.PO_MACN) = decode(Z.PO_POSFLG, 'H', 1, Z.PO_MA) AND
            decode($P{PARA_TONGHOP}, 'Y', 1, Y.PO_MA) = decode($P{PARA_TONGHOP}, 'Y', 1, $P{PARA_MAPGD}) and  ku_m_gngan > 0 and KU_M_LUUVU = 0 and KU_NGAYBC = TO_DATE($P{PARA_DENNGAY})
group by KU_CHTRINH order by KU_CHTRINH) A,(select  * from dmkhac where khoa_1 = '07') B
where A.KU_CHTRINH = B.KHOA_2]]>
	</queryString>
	<field name="KU_CHTRINH" class="java.lang.String"/>
	<field name="GNGNA_DIEU" class="java.math.BigDecimal"/>
	<field name="GNGNA_CAOSU" class="java.math.BigDecimal"/>
