<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="RR_04" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_NGUONVON" class="java.lang.String"/>
	<parameter name="PARA_NAMBC" class="java.lang.String"/>
	<parameter name="PARA_DOTRR" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["D:\\PCBC\\REPORT CSDL TG\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT A.KH_MAKH,
       A.KH_TENKH,
       A.KH_DIACHI,
       B.KU_MACN,
       B.KU_MAHUYEN,
       B.MA_CHTRINH,
       B.NG_VON,
       C.RR_SOKU,
       C.RR_NHOMNO,
       C.RR_NGAYDN,
       C.RR_NGAYRR,
       C.RR_DOT,
       C.RR_TTDUYET,
       C.RR_NGAYRR,
       C.RR_GOCDN,
       C.RR_LAIDN,
       C.RR_TYLE,
       C.RR_SOTHGDN,
       D.TEN TENHUYEN,
       E.SC_TEN TEN_CHTRINH
  FROM HSKH A,
       (SELECT DISTINCT KU_MACN,KU_SOKU,KU_MAKH,
                        SUBSTR (KU_MAPGD, 3, 4) KU_MAHUYEN,
                        KU_SCHEM_CD MA_CHTRINH,SUBSTR(KU_SPRD_CD,5,1) NG_VON
          FROM HSKU) B,
       HSRR C,
       DMHUYEN D,
       (SELECT DISTINCT SC_MA, SC_TEN FROM DM_SCHEME) E
 WHERE     A.KH_MAKH = B.KU_MAKH
       AND B.KU_SOKU = C.RR_SOKU
       AND B.KU_MAHUYEN = D.MA
       AND B.MA_CHTRINH = E.SC_MA
       AND B.NG_VON = $P{PARA_NGUONVON}
       AND B.KU_MACN = $P{PARA_MAPGD}
       AND C.RR_DOT = $P{PARA_DOTRR}
       AND C.RR_NHOMNO IN ('02','03')
       AND TRIM(EXTRACT(YEAR FROM C.RR_NGAYDN)) = $P{PARA_NAMBC}
ORDER BY RR_NHOMNO,RR_TTDUYET,TEN_CHTRINH,TENHUYEN,KH_TENKH]]>
	</queryString>
