<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="RR_09XLN" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="828" leftMargin="7" rightMargin="7" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.1000000000000003"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["D:\\2. Bao cao\\1. Rui ro\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_MACN" class="java.lang.String"/>
	<parameter name="PARA_TONGHOP" class="java.lang.String"/>
	<parameter name="PARA_NAM" class="java.lang.String"/>
	<parameter name="PARA_DOT" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT  SUBSTR(giatri,INSTR(giatri,'C',1)-1 ) LOAN_PROGRAM_DESC ,
       ADD_CITY POS_DESCRIPTION,KHOA_2,
       COUNT(CASE WHEN RR_NHOMNO   = '03' AND RR_SOTHGDN <= 36 THEN RR_SOKU END ) COL3_CNT,
       NVL(SUM(CASE WHEN RR_NHOMNO = '03' AND RR_SOTHGDN <= 36 THEN NVL(RR_GOCDN,0) + NVL(RR_LAIDN,0) END),0) COL4_AMT,
       NVL(SUM(CASE WHEN RR_NHOMNO = '03' AND RR_SOTHGDN <= 36 THEN NVL(RR_GOCDN,0) END),0) COL5_AMT,
       NVL(SUM(CASE WHEN RR_NHOMNO = '03' AND RR_SOTHGDN <= 36 THEN  NVL(RR_LAIDN,0) END),0) COL6_AMT,
       COUNT(CASE WHEN RR_NHOMNO   = '03' AND ( RR_SOTHGDN > 36 AND RR_SOTHGDN <= 60 ) THEN RR_SOKU END ) COL7_CNT,
       NVL(SUM(CASE WHEN RR_NHOMNO = '03' AND ( RR_SOTHGDN > 36 AND RR_SOTHGDN <= 60 ) THEN NVL(RR_GOCDN,0) + NVL(RR_LAIDN,0) END),0) COL8_AMT,
       NVL(SUM(CASE WHEN RR_NHOMNO = '03' AND ( RR_SOTHGDN > 36 AND RR_SOTHGDN <= 60 ) THEN NVL(RR_GOCDN,0) END),0) COL9_AMT,
       NVL(SUM(CASE WHEN RR_NHOMNO = '03' AND ( RR_SOTHGDN > 36 AND RR_SOTHGDN <= 60 ) THEN  NVL(RR_LAIDN,0) END),0) COL10_AMT,
       COUNT(CASE WHEN RR_NHOMNO   = '04'  THEN RR_SOKU END ) COL11_CNT,
       NVL(SUM(CASE WHEN RR_NHOMNO = '04'  THEN NVL(RR_GOCDN,0) + NVL(RR_LAIDN,0) END),0) COL12_AMT,
       NVL(SUM(CASE WHEN RR_NHOMNO = '04'  THEN NVL(RR_GOCDN,0) END),0) COL13_AMT,
       NVL(SUM(CASE WHEN RR_NHOMNO = '04'  THEN  NVL(RR_LAIDN,0) END),0) COL14_AMT
       FROM HSKU A,
       HSRR C,
      (select * from DMKHAC where KHOA_1 = '07') D,
       PO850MB Y
    WHERE KU_SOKU = RR_SOKU
   AND KU_CHTRINH = KHOA_2
   AND RR_TTDUYET ='2'
   AND RR_DOT = $P{PARA_DOT}
   AND RR_MACN = $P{PARA_MACN}
   AND to_char(RR_NGAYDN,'yyyy') = $P{PARA_NAM}
   AND RR_NHOMNO IN ('03','04')
   AND KU_MAPGD = Y.POS_CD
   GROUP BY GIATRI,ADD_CITY,KHOA_2
   ORDER BY KHOA_2,LOAN_PROGRAM_DESC,POS_DESCRIPTION]]>
	</queryString>
