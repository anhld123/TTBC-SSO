<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="BCTD_ND100_TK" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="301ec292-e0bd-4bc3-83e5-1f1b050af9c7">
	<property name="ireport.zoom" value="1.0000000000000009"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="18"/>
	<parameter name="PARA_TONGHOP" class="java.lang.String"/>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<queryString>
		<![CDATA[select a.*, b.*
from
(select ma ma,ten ten from dmtinh where ma <> '00') A
left join
(select cs_macn cs_macn,
count( distinct case when CS_M_GUITK > 0 then cs_makh end) kh_gui_trong_ky,
count( distinct case when CS_SODU_TK > 0 then cs_makh end) kh_du_tk,
SUM( CS_M_GUITK)/1000000 ds_gui_tk,
SUM( CS_SODU_TK)/1000000 du_tiengui,
0.048 LAI_SUAT
from casa where cs_ngaybc = $P{PARA_NGAYBC} and cs_sp_tk = '145'
and CS_SODU_TK > 0
  group by cs_macn) B
  on A.MA = substr(b.cs_macn,3,2)]]>
	</queryString>
	<field name="MA" class="java.lang.String"/>
	<field name="TEN" class="java.lang.String"/>
	<field name="CS_MACN" class="java.lang.String"/>
	<field name="KH_GUI_TRONG_KY" class="java.math.BigDecimal"/>
	<field name="KH_DU_TK" class="java.math.BigDecimal"/>
	<field name="DS_GUI_TK" class="java.math.BigDecimal"/>
	<field name="DU_TIENGUI" class="java.math.BigDecimal"/>
	<field name="LAI_SUAT" class="java.math.BigDecimal"/>
	<background>
		<band splitType="Stretch"/>
	</background>
