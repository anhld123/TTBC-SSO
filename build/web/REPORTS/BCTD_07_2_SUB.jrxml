<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="BCDHTD_07.2_SUB" language="groovy" pageWidth="580" pageHeight="300" orientation="Landscape" columnWidth="580" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="12900c22-4e65-4327-9383-5fd986881301">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_TONGHOP" class="java.lang.String"/>
	<parameter name="PARA_DENNGAY" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT MA_TDDT,TDDT,
	NVL(sum(HSSV_D7)/1000000,0) TONG_DN,
	NVL(sum(HSSV_D16),0) SOHSSV_DN,
	NVL(sum(HSSV_D1)/1000000,0) ST_GN,
	NVL(sum(HSSV_D17),0) SOHSSV_GN,
	NVL(sum(HSSV_D18)/1000000,0) ST_GN_LD,
	NVL(sum(HSSV_D19),0) SOHSSV_GN_LD
FROM (
	SELECT DECODE(B.KHOA_2,'07', '01',B.KHOA_2) MA_TDDT,
		DECODE(B.KHOA_2,'07', 'Đại học',B.GIATRI) TDDT,
		HSSV_D7,
		HSSV_D16,
		HSSV_D1,
		HSSV_D17,
		HSSV_D18,
		HSSV_D19
	FROM DMKHAC B, BCTD_HSSV_TDDT C, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z
	WHERE KHOA_1 = '03'
		AND HSSV_MAPGD = Y.PO_MA
		AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA)
		AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD})
		AND HSSV_TDDT = B.KHOA_2
		AND HSSV_NGAYBC = TO_DATE ($P{PARA_DENNGAY})
	)
group by MA_TDDT, TDDT
order by  MA_TDDT]]>
	</queryString>
	<field name="MA_TDDT" class="java.lang.String"/>
	<field name="TDDT" class="java.lang.String"/>
	<field name="TONG_DN" class="java.math.BigDecimal"/>
	<field name="SOHSSV_DN" class="java.math.BigDecimal"/>
	<field name="ST_GN" class="java.math.BigDecimal"/>
	<field name="SOHSSV_GN" class="java.math.BigDecimal"/>
	<field name="ST_GN_LD" class="java.math.BigDecimal"/>
	<field name="SOHSSV_GN_LD" class="java.math.BigDecimal"/>
