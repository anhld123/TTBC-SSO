<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="BCDP-B14-SUB2" language="groovy" pageWidth="807" pageHeight="555" orientation="Landscape" columnWidth="807" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_QUY" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_NAM" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_TONGHOP" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[Select * from
(SELECT A.MA, A.TEN HUYEN, B.TEN XA, B.MA MAX,
            ROUND(SUM(NVL(DS_GNGAN, 0)) / 1000000, 2) DS_GNGAN,
            ROUND(SUM(NVL(DS_TNO, 0)) / 1000000, 2) DS_TNO,
            ROUND(SUM(NVL(NO_NHAN, 0)) / 1000000, 2) NO_NHAN,
            ROUND(SUM(NVL(NO_DHAN, 0)) / 1000000, 2) NO_DHAN,
            ROUND(SUM(NVL(NO_XAU, 0)) / 1000000, 2) NO_XAU,
            COUNT(DISTINCT KH_CN) KH_CN, COUNT(DISTINCT KH_DN) KH_DN
FROM DMHUYEN A, DMXA B,
(
SELECT KU_MAPGD, KH_MADP, KU_MADP,
            NVL(KU_A_GNGAN, 0) DS_GNGAN,
            NVL(KU_A_TNTHAN, 0) + NVL(KU_A_TNQHAN, 0) + NVL(KU_A_TNKHOANH, 0) DS_TNO,
            CASE WHEN KU_TTMONVAY = 'OPEN' AND SUBSTR(KU_SPRD_CD,4,1) = 'S'
                    THEN NVL(KU_DNOTHAN, 0) + NVL(KU_DNOQHAN, 0) + NVL(KU_DNOKHOANH, 0)
            ELSE 0 END NO_NHAN,
            CASE WHEN KU_TTMONVAY = 'OPEN' AND SUBSTR(KU_SPRD_CD,4,1) <> 'S'
                    THEN NVL(KU_DNOTHAN, 0) + NVL(KU_DNOQHAN, 0) + NVL(KU_DNOKHOANH, 0)
            ELSE 0 END NO_DHAN,
            CASE WHEN KU_TTMONVAY = 'OPEN' THEN NVL(KU_DNOQHAN, 0) + NVL(KU_DNOKHOANH, 0)
            ELSE 0 END NO_XAU,
            CASE WHEN KU_TTMONVAY = 'OPEN' THEN KU_MAKH ELSE NULL END KH_CN,
            NULL KH_DN
FROM HSKU, HSKH, DMPOS Y, (SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z
WHERE KU_MAKH = KH_MAKH
AND KU_MAPGD = KH_MAPGD
AND KU_MAPGD = Y.PO_MA
AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA)
AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) =DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD})
AND KU_NGAYBC = LAST_DAY(TO_DATE('01/' || $P{PARA_QUY} * 3 || '/' || $P{PARA_NAM}, 'DD/MM/YYYY'))
UNION ALL
SELECT KU_MAPGD, DN_MADP KH_MADP, KU_MADP,
            NVL(KU_A_GNGAN, 0) DS_GNGAN,
            NVL(KU_A_TNTHAN, 0) + NVL(KU_A_TNQHAN, 0) + NVL(KU_A_TNKHOANH, 0) DS_TNO,
           CASE WHEN KU_TTMONVAY = 'OPEN' AND SUBSTR(KU_SPRD_CD,4,1) = 'S'
                    THEN NVL(KU_DNOTHAN, 0) + NVL(KU_DNOQHAN, 0) + NVL(KU_DNOKHOANH, 0)
            ELSE 0 END NO_NHAN,
            CASE WHEN KU_TTMONVAY = 'OPEN' AND SUBSTR(KU_SPRD_CD,4,1) <> 'S'
                    THEN NVL(KU_DNOTHAN, 0) + NVL(KU_DNOQHAN, 0) + NVL(KU_DNOKHOANH, 0)
            ELSE 0 END NO_DHAN,
            CASE WHEN KU_TTMONVAY = 'OPEN' THEN NVL(KU_DNOQHAN, 0) + NVL(KU_DNOKHOANH, 0)
            ELSE 0 END NO_XAU,
            NULL KH_CN,
            CASE WHEN KU_TTMONVAY = 'OPEN' THEN KU_MAKH ELSE NULL END KH_DN
FROM HSKU, HSKH_DN,DMPOS Y, (SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z
WHERE KU_MAKH = DN_MA
AND KU_MAPGD = DN_MAPGD
AND KU_MAPGD = Y.PO_MA
AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA)
AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) =DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD})
AND KU_NGAYBC = LAST_DAY(TO_DATE('01/' || $P{PARA_QUY} * 3 || '/' || $P{PARA_NAM}, 'DD/MM/YYYY'))
) KU
WHERE A.MA = SUBSTR(KU_MAPGD, 3) AND B.MA = SUBSTR(KU_MADP, 1, 6) AND B.NONGTHONMOI_FLG = 'Y'
GROUP BY A.MA, A.TEN, B.MA, B.TEN)
ORDER BY MA, MAX]]>
	</queryString>
