<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="TT_01_RR" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="62e03e0f-f16b-4f23-98cb-ccf2a54c4a98">
	<property name="ireport.zoom" value="1.1"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<parameter name="PARA_NGAYBC_SS" class="java.lang.String"/>
	<parameter name="PARA_CHTRINH" class="java.lang.String"/>
	<queryString>
		<![CDATA[select
A.MA, A.TEN,A.giatri, NVL(B.SOKH,0)SOKH, NVL(B.SOTIEN,0)SOTIEN,NVL( B.LAI,0)LAI , NVL(C.SOKH_36,0)SOKH_36, NVL(C.SOTIEN_36,0)SOTIEN_36,
NVL(C.LAI_36,0) LAI_36, NVL(C.SOKH_60,0)SOKH_60, NVL(C.SOTIEN_60,0)SOTIEN_60 , NVL(C.LAI_60,0)LAI_60 ,NVL(D.SOKH_XN,0) SOKH_XN,
NVL(D.SOTIEN_XOA,0)SOTIEN_XOA , NVL(D.LAI_XOA,0)LAI_XOA
from
(select MA,TEN,giatri from dmtinh, dmkhac  where ma <> '00' and khoa_1 = '07' and khoa_2 = $P{PARA_CHTRINH}) A
left join
(select substr(macn,3,2) MACN, count(distinct makh) sokh, sum(GH_SOTIEN)/1000000 sotien, sum(KU_LAITONTHAN + KU_LAITONQHAN)/1000000 lai
from hsgh_history, hscv_2018
 where GH_LOAINV = '1' and GH_NGAY between $P{PARA_NGAYBC} and $P{PARA_NGAYBC_SS} and ku_ngaybc = $P{PARA_NGAYBC_SS}
 and ku_maqd = $P{PARA_CHTRINH} and ku_nguonvon = 1
 and macn = ku_macn and mapgd = ku_mapgd and makh = ku_makh
 and soku = ku_soku
 group by substr(macn,3,2)) B
 on a.ma = b.macn
 left join
 (select substr(macn,3,2) macn,
 count(distinct case when SOTHANG = 36 then  ku_makh end) sokh_36,
 sum(case when SOTHANG = 36 then ST_KHOANH end )/1000000 sotien_36,
 sum(case when SOTHANG = 36 and NVL(KU_LAITONTHAN,0) + NVL(KU_LAITONQHAN,0) > 0 then NVL(KU_LAITONTHAN,0) + NVL(KU_LAITONQHAN,0) end )/1000000 lai_36,
 count(distinct case when SOTHANG = 60 then  ku_makh end) sokh_60,
 sum(case when SOTHANG = 60 then ST_KHOANH end )/1000000 sotien_60,
 sum(case when SOTHANG = 60 and NVL(KU_LAITONTHAN,0) + NVL(KU_LAITONQHAN,0) > 0 then KU_LAITONTHAN + KU_LAITONQHAN end )/1000000 lai_60
  from hskn_history , hscv_2018
 where NGAYHL between $P{PARA_NGAYBC} and $P{PARA_NGAYBC_SS} and TRANGTHAI = 'MR'
 and ku_ngaybc = $P{PARA_NGAYBC_SS} and ku_maqd = $P{PARA_CHTRINH} and ku_nguonvon = 1
 and macn = ku_macn and ku_mapgd = mapgd  and soku = ku_soku
 group by macn) C
  on a.ma = C.macn
 left join
 (select substr(macn,3,2) macn,count(distinct makh) sokh_xn, sum(ST_GOC)/1000000 sotien_xoa, sum(ST_LAITH+ ST_LAIQH)/1000000 lai_xoa
  from hsxn_history, hscv_2018
 where NGAYHL between $P{PARA_NGAYBC} and $P{PARA_NGAYBC_SS} and TRANGTHAI = 'A'
 and soku = ku_soku and ku_maqd = $P{PARA_CHTRINH} and ku_ngaybc = $P{PARA_NGAYBC_SS} and ku_nguonvon = 1
  group by macn) D
 on a.ma = D.macn
 order by ma]]>
	</queryString>
	<field name="MA" class="java.lang.String"/>
	<field name="TEN" class="java.lang.String"/>
	<field name="GIATRI" class="java.lang.String"/>
	<field name="SOKH" class="java.math.BigDecimal"/>
	<field name="SOTIEN" class="java.math.BigDecimal"/>
	<field name="LAI" class="java.math.BigDecimal"/>
	<field name="SOKH_36" class="java.math.BigDecimal"/>
	<field name="SOTIEN_36" class="java.math.BigDecimal"/>
	<field name="LAI_36" class="java.math.BigDecimal"/>
	<field name="SOKH_60" class="java.math.BigDecimal"/>
