<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="RR_08" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["D:\\2. Bao cao\\1. Rui ro\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_NGUONVON" class="java.lang.String"/>
	<parameter name="PARA_DOTRR" class="java.lang.String"/>
	<parameter name="PARA_NAMBC" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT  CASE
            WHEN B.RR_NHOMNO = '02' THEN 'Khoanh nợ tối đa 3 năm'
            WHEN B.RR_NHOMNO = '03' THEN 'Khoanh nợ tối đa 5 năm'
         END
            FRZ_DURATION,
         A.SC_TEN LOAN_PROGRAM_DESC,
         Y.PO_TEN POS_DESCRIPTION,
         COUNT (B.RR_SOKU) COL3_CNT,
         SUM (NVL (B.RR_GOCDN, 0) + NVL (B.RR_LAIDN, 0)) COL4_AMT,
         SUM (NVL (B.RR_GOCDN, 0)) COL5_AMT,
         SUM (NVL (B.RR_LAIDN, 0)) COL6_AMT,
         COUNT (DECODE (B.RR_TTDUYET, '2', B.RR_SOKU)) COL7_CNT,
         SUM (
            DECODE (B.RR_TTDUYET, '2', NVL (B.RR_GOCXL, 0) + NVL (RR_LAIXL, 0)))
            COL8_AMT,
         SUM (DECODE (B.RR_TTDUYET, '2', NVL (B.RR_GOCXL, 0))) COL9_AMT,
         SUM (DECODE (B.RR_TTDUYET, '2', NVL (B.RR_LAIXL, 0))) COL10_AMT
    FROM DM_SCHEME A,
         HSRR B,
         (SELECT DISTINCT KU_SOKU,KU_SPRD_CD,KU_SCHEM_CD, KU_MAPGD FROM HSKU) D,
         DMPOS Y,
         (SELECT PO_POSFLG, PO_MA, PO_MACN
            FROM DMPOS
           WHERE PO_MA = $P{PARA_MAPGD}) Z
   WHERE     B.RR_DOT = $P{PARA_DOTRR}
         AND B.RR_MAPGD = Y.PO_MA
         AND D.KU_SCHEM_CD = SC_MA
         AND B.RR_MAPGD = D.KU_MAPGD
         AND SUBSTR (D.KU_SPRD_CD, 5, 1) = $P{PARA_NGUONVON}
         AND B.RR_SOKU = D.KU_SOKU
         AND D.KU_SCHEM_CD = SC_MA
         AND TRIM (EXTRACT (YEAR FROM B.RR_NGAYDN)) = $P{PARA_NAMBC}
         AND DECODE (Z.PO_POSFLG,  'H', 1,  'S', Y.PO_MA,  Y.PO_MACN) =
                DECODE (Z.PO_POSFLG, 'H', 1, Z.PO_MA)
         AND DECODE ('Y', 'Y', 1, Y.PO_MA) = DECODE ('Y', 'Y', 1, $P{PARA_MAPGD})
         AND B.RR_NHOMNO ='04'
GROUP BY A.SC_TEN,
         Y.PO_TEN,
         CASE
            WHEN B.RR_NHOMNO = '02' THEN 'Khoanh nợ tối đa 3 năm'
            WHEN B.RR_NHOMNO = '03' THEN 'Khoanh nợ tối đa 5 năm'
         END
ORDER BY FRZ_DURATION, LOAN_PROGRAM_DESC, POS_DESCRIPTION]]>
	</queryString>
