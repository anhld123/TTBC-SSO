	<parameter name="GROUP_ID" class="java.lang.String"/>
	<queryString>
		<![CDATA[select a.pos_cd,a.group_id,a.report_dt,a.code,b.descript,a.value,a.mark
from DG_GROUP_ASSESS_DTLS A, DG_GROUP_ASSESS_INFO B
where pos_cd = $P{POS_CD} and report_dt = $P{EOD_DATE} and group_id = $P{GROUP_ID} and a.code = b.code
order by 1,2,3,4]]>
	</queryString>
	<field name="POS_CD" class="java.lang.String"/>
	<field name="GROUP_ID" class="java.lang.String"/>
