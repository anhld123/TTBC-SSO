<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="RR_06" language="groovy" pageWidth="555" pageHeight="842" columnWidth="500" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["D:\\2. Bao cao\\1. Rui ro\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_NAMBC" class="java.lang.String"/>
	<parameter name="PARA_DOTRR" class="java.lang.String"/>
	<parameter name="PARA_NGUONVON" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
SC_TEN,
PO_TEN,
COUNT(RR_SOKU) SOHO_DN,
SUM(DECODE(RR_TTDUYET,'1', NVL(RR_GOCDN,0) ) ) SOTIEN_DN,
COUNT(DECODE(RR_TTDUYET,'2',RR_SOKU )) SOHO_DD,
SUM(DECODE(RR_TTDUYET,'2', NVL(RR_GOCDN,0) ) ) SOTIEN_DD
 FROM HSRR A, DM_SCHEME B, (SELECT DISTINCT KU_SOKU, KU_SPRD_CD, KU_SCHEM_CD FROM HSKU) C,
 DMPOS Y,(SELECT PO_POSFLG, PO_MA, PO_MACN
                FROM DMPOS
               WHERE PO_MA = $P{PARA_MAPGD}) Z
 WHERE A.RR_SOKU = C.KU_SOKU
        AND C.KU_SCHEM_CD = B.SC_MA
        AND SUBSTR(KU_SPRD_CD,5,1) = $P{PARA_NGUONVON}
        AND A.RR_DOT = $P{PARA_DOTRR}
        AND A.RR_NHOMNO ='01'
        AND A.RR_MAPGD = Y.PO_MA
        AND DECODE (Z.PO_POSFLG,  'H', 1,  'S', Y.PO_MA,  Y.PO_MACN) =
            DECODE (Z.PO_POSFLG, 'H', 1, Z.PO_MA)
       AND DECODE ('Y', 'Y', 1, Y.PO_MA) =
            DECODE ('Y', 'Y', 1, $P{PARA_MAPGD})
        AND TRIM(EXTRACT(YEAR FROM A.RR_NGAYDN)) = $P{PARA_NAMBC}
 GROUP BY  SC_TEN, PO_TEN]]>
	</queryString>
	<field name="SC_TEN" class="java.lang.String"/>
	<field name="PO_TEN" class="java.lang.String"/>
	<field name="SOHO_DN" class="java.math.BigDecimal"/>
	<field name="SOTIEN_DN" class="java.math.BigDecimal"/>
	<field name="SOHO_DD" class="java.math.BigDecimal"/>
	<field name="SOTIEN_DD" class="java.math.BigDecimal"/>
	<variable name="SOHO_DN_1" class="java.math.BigDecimal" resetType="Group" resetGroup="loan_pgm_grp" calculation="Sum">
		<variableExpression><![CDATA[$F{SOHO_DN}]]></variableExpression>
	</variable>
	<variable name="SOTIEN_DN_1" class="java.math.BigDecimal" resetType="Group" resetGroup="loan_pgm_grp" calculation="Sum">
		<variableExpression><![CDATA[$F{SOTIEN_DN}]]></variableExpression>
	</variable>
	<variable name="SOHO_DD_1" class="java.math.BigDecimal" resetType="Group" resetGroup="loan_pgm_grp" calculation="Sum">
		<variableExpression><![CDATA[$F{SOHO_DD}]]></variableExpression>
	</variable>
	<variable name="SOTIEN_DD_1" class="java.math.BigDecimal" resetType="Group" resetGroup="loan_pgm_grp" calculation="Sum">
		<variableExpression><![CDATA[$F{SOTIEN_DD}]]></variableExpression>
	</variable>
	<variable name="count_pos" class="java.math.BigDecimal" resetType="Group" resetGroup="loan_pgm_grp" calculation="Count">
		<variableExpression><![CDATA[$V{count_chtrinh}++]]></variableExpression>
		<initialValueExpression><![CDATA[1]]></initialValueExpression>
	</variable>
	<variable name="count_chtrinh" class="java.math.BigDecimal" calculation="Count">
		<variableExpression><![CDATA[$V{count_chtrinh}++]]></variableExpression>
