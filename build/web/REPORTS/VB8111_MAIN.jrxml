<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="VB8111_MAIN" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="f34d0500-78c7-4c20-baab-e9cd850111ef">
	<property name="ireport.zoom" value="1.2100000000000004"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<parameter name="PARA_KYBC" class="java.lang.String"/>
	<parameter name="PARA_NGAYBC_SS" class="java.lang.String"/>
	<parameter name="PARA_TONGHOP" class="java.lang.String"/>
	<queryString>
		<![CDATA[select
   case when
        $P{PARA_KYBC} = '4'
        then 'Tháng '||to_char(to_date($P{PARA_NGAYBC}),'mm') ||' Năm ' ||to_char(to_date($P{PARA_NGAYBC}),'yyyy')
        when
        $P{PARA_KYBC} = '5' and to_char(to_date($P{PARA_NGAYBC}),'ddmm') = '3103'
        then 'Quý 1 Năm '||to_char(to_date($P{PARA_NGAYBC}),'yyyy')
         when
        $P{PARA_KYBC}= '5' and to_char(to_date($P{PARA_NGAYBC}),'ddmm') = '3006'
        then 'Quý 2 Năm '||to_char(to_date($P{PARA_NGAYBC}),'yyyy')
         when
        $P{PARA_KYBC}= '5' and to_char(to_date($P{PARA_NGAYBC}),'ddmm') = '3009'
        then 'Quý 3 Năm '||to_char(to_date($P{PARA_NGAYBC}),'yyyy')
         when
        $P{PARA_KYBC}= '5' and to_char(to_date($P{PARA_NGAYBC}),'ddmm') = '3112'
        then 'Quý 4 Năm '||to_char(to_date($P{PARA_NGAYBC}),'yyyy')
        when
        $P{PARA_KYBC} = '7'
        then 'Năm '||to_char(to_date($P{PARA_NGAYBC}),'yyyy')
        when
        $P{PARA_KYBC}= '9'
        then 'Từ '||to_char(TO_DATE((select '01-jan- '||to_char(to_date($P{PARA_NGAYBC}),'YYYY') from dual)),'dd/mm/yyyy')
         || ' đến '|| to_char(to_date($P{PARA_NGAYBC}),'dd/mm/yyyy')
        END KYBC,
(select PO_MACN  from dmpos where po_ma = $P{PARA_MAPGD}) MAPGD
 from dual]]>
	</queryString>
	<field name="KYBC" class="java.lang.String"/>
	<field name="MAPGD" class="java.lang.String"/>
