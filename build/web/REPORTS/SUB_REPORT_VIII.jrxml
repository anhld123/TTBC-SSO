		<band height="269">
			<staticText>
				<reportElement uuid="2d252612-1124-47bf-9077-7aa246998b0d" x="31" y="49" width="524" height="17"/>
				<textElement>
					<font fontName="Times New Roman" size="11" isBold="true" isItalic="false" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[40. Hoạt động uỷ thác và đại lý TCTD không chịu rủi ro: NHCSXH không có]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="45294ac4-784b-4a3f-b75c-87d1ddd92d23" x="31" y="65" width="524" height="17"/>
				<textElement>
					<font fontName="Times New Roman" size="11" isBold="true" isItalic="false" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[41. Các hoạt động ngoại bảng khác mà TCTD phải chịu rủi ro đáng kể: NHCSXH không có]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="34785c8e-4900-4b20-a202-0205c0668d70" x="31" y="17" width="524" height="17"/>
				<textElement>
					<font fontName="Times New Roman" size="11" isBold="true" isItalic="false" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[38. Loại hình và giá trị tài sản thế chấp của khách hàng]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="673cbc21-7f88-4425-851c-b7942d109e83" x="31" y="113" width="524" height="30"/>
				<textElement>
					<font fontName="Times New Roman" size="11" isBold="true" isItalic="false" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[44. Mức độ tập trung theo khu vực địa lý của các tài sản, công nợ và các khoản mục ngoại bảng: NHCSXH chưa thực hiện quản lý tài sản, công nợ và các khoản mục ngoại bảng tập trung theo khu vực địa lý.]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="dc3daf71-bc04-4867-b9f3-27749c9403f2" x="31" y="33" width="524" height="17"/>
				<textElement>
					<font fontName="Times New Roman" size="11" isBold="true" isItalic="false" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[39. Nghĩa vụ nợ tiềm ẩn và các cam kết đưa ra: NHCSXH không có]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="df34f71d-392c-405d-b653-bc90a8616350" x="31" y="81" width="524" height="17"/>
				<textElement>
					<font fontName="Times New Roman" size="11" isBold="true" isItalic="false" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[42. Giao dịch với các bên liên quan: NHCSXH không có]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="7a7e7aae-e8e2-468d-91c2-bc342c33466c" x="31" y="97" width="524" height="17"/>
				<textElement>
					<font fontName="Times New Roman" size="11" isBold="true" isItalic="false" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[43. Các sự kiện sau ngày lập bảng CĐKT: Các TCTD thuyết minh các sự kiện trọng yếu.]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="3844cf85-4700-4f55-bb1d-d7dc7834acd4" x="31" y="207" width="524" height="30"/>
				<textElement>
					<font fontName="Times New Roman" size="11" isBold="false" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[NHCSXH phối hợp với các tổ chức chính trị xã hội và Chính quyền địa phương để đôn đốc, xử lý thu hồi nợ hạn chế rủi ro tín dụng.]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="790e3958-5e46-469e-ba96-5557e41c1da8" x="31" y="252" width="524" height="17"/>
				<textElement>
					<font fontName="Times New Roman" size="11" isBold="false" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[NHCSXH chưa thực hiện vì hiện tại đang thực hiện cho vay theo lãi suất chỉ định.]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="4e23945b-6386-4f46-b12f-0ed3a13b5a0d" x="31" y="190" width="524" height="17"/>
				<textElement>
					<font fontName="Times New Roman" size="11" isBold="true" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[45. Rủi ro tín dụng]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="249828c8-f434-4768-a8d6-60f6df452c03" x="31" y="174" width="524" height="17"/>
				<textElement>
					<font fontName="Times New Roman" size="11" isBold="false" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[NHCSXH chưa thực hiện vì hiện tại số lượng các công cụ tài chính còn ít.]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="9e1b03ee-90c0-40fe-a368-556149e2b2ac" x="31" y="158" width="524" height="17"/>
				<textElement>
					<font fontName="Times New Roman" size="11" isBold="true" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[44. Chính sách quản lý rủi ro liên quan đến các công cụ tài chính: ]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="b8a2d7ee-9188-48f5-a54f-36e18ddfc49d" x="31" y="236" width="524" height="17"/>
				<textElement>
					<font fontName="Times New Roman" size="11" isBold="true" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[46. Rủi ro thị trường: ]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="78911052-747c-494e-840d-1eb4065743d0" x="31" y="142" width="524" height="17"/>
				<textElement>
					<font fontName="Times New Roman" size="11" isBold="true" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[IX- Quản lý rủi ro tài chính]]></text>
			</staticText>
			<staticText>
				<reportElement uuid="b7e8dbee-d905-4b8f-aa8f-524eefea6e93" x="30" y="0" width="525" height="17"/>
				<textElement>
					<font fontName="Times New Roman" size="11" isBold="false" isItalic="false" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[NHCSXH hoạt động không vì mục đích lợi nhuận, được miễn thuế và các khoản nộp phải nộp Ngân sách Nhà nước.]]></text>
			</staticText>
		</band>
	</detail>
