	<subDataset name="dataset1" uuid="2902f5be-6ba1-4657-aca7-fb162ab678eb">
		<parameter name="PARA_STT" class="java.lang.String"/>
		<parameter name="PARA_DVUT" class="java.lang.String"/>
		<queryString>
			<![CDATA[select
case when $P{PARA_DVUT} = 'Cho Vay Trực tiêp'
THEN trim(to_char(to_number($P{PARA_STT}) +1))
ELSE
trim(to_char(to_number($P{PARA_STT}) +1,'RM'))
END STT from dual]]>
		</queryString>
		<field name="STT" class="java.lang.String"/>
	</subDataset>
