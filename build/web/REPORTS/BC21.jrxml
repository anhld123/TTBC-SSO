<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="BC21" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="POS_CD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="CONS_FLAG" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
    <parameter name="PARA_MAXA" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT KU_MAPGD MAPOS, SUBSTR(KU_MADP, 1, 6) MAXA, DMXA.TEN TENXA, KU_MATO MATO, TO_TENTT TENTT,
            KU_MAKH MAKH, KH_TENKH TENKH, KU_SOKU SOKU, NULL TKDUTHU,
            NVL(KU_DNOTHAN, 0) + NVL(KU_DNOQHAN, 0) + NVL(KU_DNOKHOANH, 0) DUNO,
            NVL(KU_LAITHAN, 0) + NVL(KU_LAIQHAN, 0) LAIDATRA,
            NVL(KU_LAITONTHAN, 0) + NVL(KU_LAITONQHAN, 0) LAITON,
            NVL(KU_LCDHAN_DT, 0) LAIDT_CDH
FROM HSKU, HSKH, HSTO, DMXA
WHERE KU_MAKH = KH_MAKH AND KU_MATO = TO_MATO (+) AND KU_MAPGD = $P{POS_CD} AND
	NVL(KU_LAITHAN, 0) + NVL(KU_LAIQHAN, 0) + NVL(KU_LAITONTHAN, 0) + NVL(KU_LAITONQHAN, 0) <> 0 AND
            KU_TTMONVAY <> 'CLOSE' AND SUBSTR(KU_MADP, 1, 6) = DMXA.MA AND KU_NGAYBC = TO_DATE($P{PARA_NGAYBC})
            AND DMXA.MA=$P{PARA_MAXA}
ORDER BY MAPOS, MAXA, MATO, MAKH]]>
	</queryString>
	<field name="MAPOS" class="java.lang.String"/>
	<field name="MAXA" class="java.lang.String"/>
	<field name="TENXA" class="java.lang.String"/>
	<field name="MATO" class="java.lang.String"/>
	<field name="TENTT" class="java.lang.String"/>
