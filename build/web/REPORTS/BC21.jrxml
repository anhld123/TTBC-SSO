	<field name="TKDUTHU" class="java.lang.String"/>
	<field name="DUNO" class="java.math.BigDecimal"/>
	<field name="LAIDATRA" class="java.math.BigDecimal"/>
	<field name="LAITON" class="java.math.BigDecimal"/>
	<field name="LAIDT_CDH" class="java.math.BigDecimal"/>
	<variable name="STT" class="java.math.BigDecimal" resetType="Group" resetGroup="MATO">
		<variableExpression><![CDATA[$V{STT} + 1]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="LAIDT_PS_1" class="java.math.BigDecimal" resetType="Group" resetGroup="MATO" calculation="Sum">
		<variableExpression><![CDATA[$F{LAIDATRA}+$F{LAITON} - $F{LAIDT_CDH}]]></variableExpression>
	</variable>
	<variable name="TONG_LAIDT_PS_1" class="java.math.BigDecimal" resetType="Group" resetGroup="MATO" calculation="Sum">
		<variableExpression><![CDATA[$F{LAIDATRA} + $F{LAITON}]]></variableExpression>
	</variable>
	<variable name="TONG_LAIDT_PS_2" class="java.math.BigDecimal" resetType="Group" resetGroup="MAXA" calculation="Sum">
		<variableExpression><![CDATA[$F{LAIDATRA} + $F{LAITON}]]></variableExpression>
	</variable>
	<variable name="LAIDT_PS_2" class="java.math.BigDecimal" resetType="Group" resetGroup="MAXA" calculation="Sum">
