<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="LEND_01_subreport1" language="groovy" pageWidth="555" pageHeight="802" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<subDataset name="dataset1">
		<parameter name="POS_CD" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT ADD_CITY PROVINCE ,POS_CD HEAD_POS , POS_DESC POS_DESC ,  TO_CHAR(LAST_DAY(ADD_MONTHS(PC_BUSINESS_DT,-1)),'DD/MM/YYYY') BUSDT FROM PO850MB , P_CTRL
WHERE  POS_CD = $P{POS_CD}]]>
		</queryString>
		<field name="PROVINCE" class="java.lang.String"/>
		<field name="HEAD_POS" class="java.lang.String"/>
		<field name="POS_DESC" class="java.lang.String"/>
		<field name="BUSDT" class="java.lang.String"/>
	</subDataset>
	<parameter name="POS_CD" class="java.lang.String"/>
	<parameter name="CONS_FLAG" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="MAPGD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select TK,TK_CO,TK_NO,SOTIEN,CS_TENTK,MAPGD from (
select A.TK,A.TK_NO,A.TK_CO,A.SOTIEN ,B.CS_TENTK,B.CS_MAKH,A.MAPGD as MAPGD from hsbt a, casa b where A.TK = b.CS_SO_TK and a.mapgd = b.cs_mapgd)
where MAPGD = $P{MAPGD}]]>
	</queryString>
	<field name="TK" class="java.lang.String"/>
	<field name="TK_CO" class="java.lang.String"/>
	<field name="TK_NO" class="java.lang.String"/>
	<field name="SOTIEN" class="java.math.BigDecimal"/>
	<field name="CS_TENTK" class="java.lang.String"/>
	<field name="MAPGD" class="java.lang.String"/>
	<variable name="SOTIEN" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{SOTIEN}]]></variableExpression>
	</variable>
	<group name="TK">
		<groupExpression><![CDATA[$F{TK}]]></groupExpression>
