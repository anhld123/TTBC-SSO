	<parameter name="PARA_MAPGD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_TONGHOP" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_NGAYBC" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select 1, 'Nguyên giá TSCĐ vô hình' a1, 'Số dư đầu kỳ' a2,
DN_TK_SBV (ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_MAPGD},$P{PARA_TONGHOP},'3021','P') C1,
NULL C2, NULL C3,
DN_TK_SBV (ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_MAPGD},$P{PARA_TONGHOP},'3024','P') C4,
DN_TK_SBV (ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_MAPGD},$P{PARA_TONGHOP},'3029','P') C5,
NULL C6 from dual
union
select 2, 'Nguyên giá TSCĐ vô hình' a1, '- Mua trong kỳ' a2,
NULL C1, NULL C2, NULL C3, NULL C4, NULL C5, NULL C6 from dual
union
select 3,'Nguyên giá TSCĐ vô hình' a1, '- Đầu tư XDCB hoàn thành' a2,
NULL C1, NULL C2, NULL C3, NULL C4, NULL C5, NULL C6 from dual
union
select 4, 'Nguyên giá TSCĐ vô hình' a1, '- Tăn khác' a2,
NULL C1, NULL C2, NULL C3, NULL C4, NULL C5, NULL C6 from dual
union
select 5,'Nguyên giá TSCĐ vô hình' a1, '- Thanh lý, nhượng bán' a2,
NULL C1, NULL C2, NULL C3, NULL C4, NULL C5, NULL C6 from dual
union
select 6,'Nguyên giá TSCĐ vô hình' a1, '- Giảm khác' a2,
NULL C1, NULL C2, NULL C3, NULL C4, NULL C5, NULL C6 from dual
union
select 7,'Nguyên giá TSCĐ vô hình' a1, 'Số dư cuối kỳ' a2,
DN_TK_SBV ($P{PARA_NGAYBC},$P{PARA_MAPGD},$P{PARA_TONGHOP},'3021','P') C1,
NULL C2, NULL C3,
DN_TK_SBV ($P{PARA_NGAYBC},$P{PARA_MAPGD},$P{PARA_TONGHOP},'3024','P') C4,
DN_TK_SBV ($P{PARA_NGAYBC},$P{PARA_MAPGD},$P{PARA_TONGHOP},'3029','P') C5,
NULL C6 from dual
union
select 8,'Giá trị hao mòn luỹ kế a1', 'Sô dư đầu kỳ' a2,
NULL C1, NULL C2, NULL C3, NULL C4, NULL C5,
DN_TK_SBV (ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_MAPGD},$P{PARA_TONGHOP},'3052','P') C6 from dual
union
select 9,'Giá trị hao mòn lũy kế' a1, '- Khấu hao trong kỳ' a2,
NULL C1, NULL C2, NULL C3, NULL C4, NULL C5, NULL C6 from dual
union
select 10,'Giá trị hao mòn lũy kế' a1, '- Tăng khác' a2,
NULL C1, NULL C2, NULL C3, NULL C4, NULL C5, NULL C6 from dual
union
select 11,'Giá trị hao mòn lũy kế' a1, '- Thanh lý, nhượng bán' a2,
NULL C1, NULL C2, NULL C3, NULL C4, NULL C5, NULL C6 from dual
union
select 12,'Giá trị hao mòn lũy kế' a1, '- Giảm khác' a2,
NULL C1, NULL C2, NULL C3, NULL C4, NULL C5, NULL C6 from dual
union
select 13,'Giá trị hao mòn lũy kế' a1, 'Sô dư cuối kỳ' a2,
NULL C1, NULL C2, NULL C3, NULL C4, NULL C5,
DN_TK_SBV ($P{PARA_NGAYBC},$P{PARA_MAPGD},$P{PARA_TONGHOP},'3021','P') C6 from dual
union
select 14,'Giá trị còn lại của TSCĐ vô hình' a1, 'Tại ngày đầu kỳ' a2,
NULL C1, NULL C2, NULL C3, NULL C4, NULL C5, NULL C6 from dual
union
select 15,'Giá trị còn lại của TSCĐ vô hình' a1, 'Tại ngày cuối kỳ' a2,
NULL C1, NULL C2, NULL C3, NULL C4, NULL C5, NULL C6 from dual]]>
	</queryString>
