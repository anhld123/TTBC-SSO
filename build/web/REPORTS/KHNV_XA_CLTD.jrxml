<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="KHNV_XA_CLTD" language="groovy" pageWidth="841" pageHeight="595" orientation="Landscape" columnWidth="801" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="a1cf0f28-bf9c-4234-a2b5-0ebea8fb8bc4">
	<property name="ireport.zoom" value="1.1000000000000043"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT
MAXA, TEN,NVL(TONG_DUNO,0) TONG_DUNO,
NVL(DUNO_QHAN_HT,0) DUNO_QHAN_HT,
NVL(DUNO_QHAN_THANGTRUOC,0) DUNO_QHAN_THANGTRUOC,
NVL(DUNO_QHAN_NAMTRUOC,0) DUNO_QHAN_NAMTRUOC,
ROUND((NVL(DUNO_QHAN_HT,0)/NVL(TONG_DUNO,0))*100,2) TYLE_QUAHAN,
NVL(DUNO_QHAN_HT,0) - NVL(DUNO_QHAN_THANGTRUOC,0) TANG_GIAM_THANG_TRUOC,
NVL(DUNO_QHAN_HT,0) - NVL(DUNO_QHAN_NAMTRUOC,0) TANG_GIAM_NAM_TRUOC,
NVL(DUNO_KHOANH_HT,0) DUNO_KHOANH_HT,
NVL(DUNO_KHOANH_THANGTRUOC,0) DUNO_KHOANH_THANGTRUOC,
NVL(DUNO_KHOANH_NAMTRUOC,0) DUNO_KHOANH_NAMTRUOC,
round((NVL(DUNO_KHOANH_HT,0)/NVL(TONG_DUNO,0))*100,2) TYLE_KHOANH,
NVL(DUNO_KHOANH_HT,0)- NVL(DUNO_KHOANH_NAMTRUOC,0) KHOANH_TANGGIAM_NAMTRC,TO_CHAR(TO_DATE(TRUNC(TO_DATE($P{PARA_NGAYBC}),'MONTH')) -1,'dd/mm/yyyy') THANG_TRUOC,
TO_CHAR(TO_DATE(TRUNC(TO_DATE($P{PARA_NGAYBC}),'year')) -1,'dd/mm/yyyy') NAM_TRUOC,
TO_CHAR(TO_DATE($P{PARA_NGAYBC}),'dd/mm/yyyy') NGAYBC
FROM ( SELECT SUBSTR(MADP,1,6) MAXA,TEN,
SUM(CASE WHEN NGAYBC = $P{PARA_NGAYBC} THEN  NVL(D3,0) + NVL(D4,0) + NVL(D5,0) END) TONG_DUNO,
SUM(CASE WHEN NGAYBC = $P{PARA_NGAYBC} THEN  NVL(D4,0) END) DUNO_QHAN_HT,
SUM(CASE WHEN NGAYBC = TO_CHAR(TO_DATE(TRUNC(TO_DATE($P{PARA_NGAYBC}),'MONTH')) -1,'dd-mon-yyyy') THEN  NVL(D4,0) END) DUNO_QHAN_THANGTRUOC,
SUM(CASE WHEN NGAYBC = TO_CHAR(TO_DATE(TRUNC(TO_DATE($P{PARA_NGAYBC}),'year')) -1,'dd-mon-yyyy') THEN  NVL(D4,0) END) DUNO_QHAN_NAMTRUOC,
SUM(CASE WHEN NGAYBC = $P{PARA_NGAYBC} THEN  NVL(D5,0) END) DUNO_KHOANH_HT,
SUM(CASE WHEN NGAYBC = TO_CHAR(TO_DATE(TRUNC(TO_DATE($P{PARA_NGAYBC}),'MONTH')) -1,'dd-mon-yyyy') THEN  NVL(D5,0) END) DUNO_KHOANH_THANGTRUOC,
SUM(CASE WHEN NGAYBC = TO_CHAR(TO_DATE(TRUNC(TO_DATE($P{PARA_NGAYBC}),'year')) -1,'dd-mon-yyyy') THEN  NVL(D5,0) END) DUNO_KHOANH_NAMTRUOC
FROM BCTD_DAILY,(SELECT * FROM DMXA WHERE PGD_QL = $P{PARA_MAPGD})
WHERE KHOA = 'BCTD_CHTRINH' AND MAPGD = $P{PARA_MAPGD}
AND SUBSTR(MADP,1,6) = MA
GROUP BY SUBSTR(MADP,1,6),TEN)
ORDER BY MAXA]]>
	</queryString>
	<field name="MAXA" class="java.lang.String"/>
	<field name="TEN" class="java.lang.String"/>
	<field name="TONG_DUNO" class="java.math.BigDecimal"/>
	<field name="DUNO_QHAN_HT" class="java.math.BigDecimal"/>
	<field name="DUNO_QHAN_THANGTRUOC" class="java.math.BigDecimal"/>
	<field name="DUNO_QHAN_NAMTRUOC" class="java.math.BigDecimal"/>
	<field name="TYLE_QUAHAN" class="java.math.BigDecimal"/>
	<field name="TANG_GIAM_THANG_TRUOC" class="java.math.BigDecimal"/>
	<field name="TANG_GIAM_NAM_TRUOC" class="java.math.BigDecimal"/>
	<field name="DUNO_KHOANH_HT" class="java.math.BigDecimal"/>
	<field name="DUNO_KHOANH_THANGTRUOC" class="java.math.BigDecimal"/>
	<field name="DUNO_KHOANH_NAMTRUOC" class="java.math.BigDecimal"/>
	<field name="TYLE_KHOANH" class="java.math.BigDecimal"/>
	<field name="KHOANH_TANGGIAM_NAMTRC" class="java.math.BigDecimal"/>
	<field name="THANG_TRUOC" class="java.lang.String"/>
	<field name="NAM_TRUOC" class="java.lang.String"/>
	<field name="NGAYBC" class="java.lang.String"/>
	<variable name="TONG_DUNO_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TONG_DUNO}]]></variableExpression>
	</variable>
	<variable name="DUNO_QHAN_HT_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{DUNO_QHAN_HT}]]></variableExpression>
	</variable>
