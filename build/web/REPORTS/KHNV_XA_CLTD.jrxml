	</variable>
	<variable name="TYLE_KHOANH_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TYLE_KHOANH}]]></variableExpression>
	</variable>
	<variable name="KHOANH_TANGGIAM_NAMTRC_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{KHOANH_TANGGIAM_NAMTRC}]]></variableExpression>
	</variable>
