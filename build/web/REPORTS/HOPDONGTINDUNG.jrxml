<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="HOPDONGTINDUNG" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="ea5e9b5c-16a0-4637-9962-711a4619be28">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="493"/>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<parameter name="PARA_SOKU" class="java.lang.String"/>
	<parameter name="PARA_LANHDAO" class="java.lang.String"/>
	<parameter name="PARA_CHUCVU" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["G:\\ireport\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
       A.ku_makh,
       B.KH_TENKH,
       to_char(B.KH_NGAYSINH,'DD/MM/YYYY') KH_NGAYSINH,
       SUBSTR(round(months_between($P{PARA_NGAYBC},B.KH_NGAYSINH)/12,2),1,2) TUOI,
       B.KH_CMT CMT,
       to_char(B.KH_NGAYCAP,'DD/MM/YYYY') NGAYCAP,
       B.KH_NOICAP NOICAP,
       substr(B.KH_DIACHI,3,20) DIACHI,
       C.TEN TENPHUONG,
       D.TEN TENCN,
       B.KH_MOBILE MOBILE,
       A.ku_soku SO_KU,
       A.KU_LSUAT LSUAT,
       A.KU_MUCVAY SOTIEN_VAY,
       F_AMOUNT_IN_WORDS(A.KU_MUCVAY,'704') work,
       to_char(A.KU_NGAYDHAN_1,'DD/MM/YYYY') NGAYDENHAN,
       $P{PARA_LANHDAO} TEN_LD,
       $P{PARA_CHUCVU} CHUCVU,
       round(MONTHS_BETWEEN (A.KU_NGAYDHAN_1,sysdate),0) SOTHANG,
       TO_CHAR(sysdate, 'dd') NGAY,
       TO_CHAR(sysdate, 'mm') THANG,
       TO_CHAR(sysdate, 'yyyy') NAM
  FROM hscv_daily A,
       hskh B,
       DMXA C,
       DMTINH D
 WHERE     ku_mapgd = $P{PARA_MAPGD}
       AND ku_ngaybc = $P{PARA_NGAYBC}
       AND A.KU_GNGAN = 0
       AND A.KU_MAKH = B.KH_MAKH
       AND SUBSTR (A.KU_MADP, 1, 6) = C.MA
       AND C.TRANGTHAI = 'A'
       and a.ku_soku = $P{PARA_SOKU}
       AND SUBSTR (A.KU_MADP, 1, 2) = D.MA]]>
	</queryString>
	<field name="KU_MAKH" class="java.lang.String"/>
	<field name="KH_TENKH" class="java.lang.String"/>
	<field name="KH_NGAYSINH" class="java.lang.String"/>
	<field name="TUOI" class="java.lang.String"/>
	<field name="CMT" class="java.lang.String"/>
	<field name="NGAYCAP" class="java.lang.String"/>
	<field name="NOICAP" class="java.lang.String"/>
	<field name="DIACHI" class="java.lang.String"/>
	<field name="TENPHUONG" class="java.lang.String"/>
	<field name="TENCN" class="java.lang.String"/>
	<field name="MOBILE" class="java.lang.String"/>
	<field name="SO_KU" class="java.lang.String"/>
	<field name="LSUAT" class="java.math.BigDecimal"/>
	<field name="SOTIEN_VAY" class="java.math.BigDecimal"/>
	<field name="WORK" class="java.lang.String"/>
	<field name="NGAYDENHAN" class="java.lang.String"/>
	<field name="TEN_LD" class="java.lang.String"/>
	<field name="CHUCVU" class="java.lang.String"/>
	<field name="SOTHANG" class="java.math.BigDecimal"/>
	<field name="NGAY" class="java.lang.String"/>
	<field name="THANG" class="java.lang.String"/>
	<field name="NAM" class="java.lang.String"/>
