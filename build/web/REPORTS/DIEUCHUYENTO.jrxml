	<field name="MA_MOI" class="java.lang.String"/>
	<field name="TEN_CU" class="java.lang.String"/>
	<field name="TEN_MOI" class="java.lang.String"/>
	<field name="HOI_CU" class="java.lang.String"/>
	<field name="HOI_MOI" class="java.lang.String"/>
	<field name="TEN_XA" class="java.lang.String"/>
	<variable name="D4_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{D4}]]></variableExpression>
	</variable>
	<variable name="D5_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{D5}]]></variableExpression>
	</variable>
	<variable name="D6_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{D6}]]></variableExpression>
	</variable>
