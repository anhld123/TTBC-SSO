<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="LEND_15_FREEEZE" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="807" leftMargin="20" rightMargin="15" topMargin="15" bottomMargin="15">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="POS_CD" class="java.lang.String"/>
	<parameter name="CONS_FLAG" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT KU_MAPGD MAPOS, PO_TEN TENPOS, KH_MAKH MAKH, KH_TENKH TENKH, KU_SOKU SOKU,
	SUBSTR(KU_MADP, 1, 6) MAXA, DMXA.TEN TENXA,KU_MATO MATO, TO_TENTT TENTT,
	KU_SPRD_CD SPRD_CD, TK_TRUOC, TK_SAU, SOTIEN
FROM HSKU, HSKH, HSTO, DMXA, DMPOS Y,
        (SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{POS_CD}) Z,
        (
            SELECT SBT BB_SBT, TK TK_TRUOC
            FROM HSBT
            WHERE NOCO = 'C' AND GHICHU_1 = 'PARDLBALMOV' AND
                        ((SUBSTR(TK, 5, 1) IN ('5', '6') AND SUBSTR(TK, 1, 3) IN ('913', '914', '915', '916')) OR SUBSTR(TK, 1, 3) = '919') AND
                        DECODE($P{CONS_FLAG}, 'Y', 1, MAPGD) = DECODE($P{CONS_FLAG}, 'Y', 1, $P{POS_CD}) AND NGAYBC = TO_DATE($P{PARA_NGAYBC})
        ) BB,
        (
            SELECT SBT CC_SBT, TK TK_SAU, SOTIEN
            FROM HSBT
            WHERE NOCO = 'D' AND GHICHU_1 = 'PARDLBALMOV' AND
                        SUBSTR(TK, 5, 1) IN ('0', '1') AND SUBSTR(TK, 1, 3) IN ('913', '914', '915', '916') AND
                        DECODE($P{CONS_FLAG}, 'Y', 1, MAPGD) = DECODE($P{CONS_FLAG}, 'Y', 1, $P{POS_CD}) AND NGAYBC = TO_DATE($P{PARA_NGAYBC})
        ) CC
WHERE KU_MATO = TO_MATO (+) AND KU_MAKH = KH_MAKH AND KU_SOKU = CC_SBT AND CC_SBT = BB_SBT AND SUBSTR(KU_MADP, 1, 6) = DMXA.MA AND
            KU_MAPGD = Y.PO_MA AND DECODE(Z.PO_POSFLG, 'H', 1, 'S', Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG, 'H', 1, Z.PO_MA) AND
            DECODE($P{CONS_FLAG}, 'Y', 1, Y.PO_MA) = DECODE($P{CONS_FLAG}, 'Y', 1, $P{POS_CD}) AND KU_NGAYBC = TO_DATE($P{PARA_NGAYBC})
ORDER BY MAPOS, MAXA, MATO, MAKH]]>
	</queryString>
	<field name="MAPOS" class="java.lang.String"/>
	<field name="TENPOS" class="java.lang.String"/>
	<field name="MAKH" class="java.lang.String"/>
	<field name="TENKH" class="java.lang.String"/>
