		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="SOTIEN_1" class="java.math.BigDecimal" resetType="Group" resetGroup="MATO" calculation="Sum">
		<variableExpression><![CDATA[$F{SOTIEN}]]></variableExpression>
	</variable>
	<variable name="SOTIEN_2" class="java.math.BigDecimal" resetType="Group" resetGroup="MAXA" calculation="Sum">
