<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="LEND_22" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="807" leftMargin="20" rightMargin="15" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<parameter name="PARA_MAXA" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT KU.MAXA,
	   DMXA.TEN TENXA,
	   KU.MATO,
	   HSTO.TO_TENTT TENTT,
	   KU.MAKH,
	   HSKH.KH_TENKH TENKH,
	   KU.SOKU,
	   KU.DUDAU,
	   KU.DUCUOI
	FROM DMXA,
		HSTO,
		HSKH,
		(SELECT A1.MAXA, A1.MATO, A1.MAKH, A1.SOKU, B1.DUDAU, A1.DUCUOI
			FROM (SELECT SUBSTR(KU_MADP, 1, 6) MAXA, KU_MATO MATO, KU_MAKH MAKH, KU_SOKU SOKU, NVL(KU_DNOTHAN, 0) DUCUOI
					FROM HSKU
					WHERE KU_TTMONVAY <> 'CLOSE' AND KU_MATO IS NOT NULL
						AND KU_SPRD_CD IN (SELECT SP_MA from dm_sproduct WHERE SP_COMM_TYPE = 'P')
						AND SUBSTR(KU_MADP, 1, 6) = $P{PARA_MAXA}
						AND KU_MAPGD = $P{PARA_MAPGD}
						AND KU_NGAYBC = TO_DATE($P{PARA_NGAYBC})
				) A1,
				(SELECT SUBSTR(KU_MADP, 1, 6) MAXA, KU_MATO MATO, KU_MAKH MAKH, KU_SOKU SOKU, NVL(KU_DNOTHAN, 0) DUDAU
					FROM HSKU
					WHERE KU_TTMONVAY <> 'CLOSE' AND KU_MATO IS NOT NULL
						AND KU_SPRD_CD IN (SELECT SP_MA from dm_sproduct WHERE SP_COMM_TYPE = 'P')
						AND SUBSTR(KU_MADP, 1, 6) = $P{PARA_MAXA}
						AND KU_MAPGD = $P{PARA_MAPGD}
						AND KU_NGAYBC = LAST_DAY(ADD_MONTHS(TO_DATE($P{PARA_NGAYBC}), -1))
				) B1
			WHERE A1.MATO = B1.MATO (+) AND A1.MAXA = B1.MAXA (+) AND A1.MAKH = B1.MAKH (+) AND A1.SOKU = B1.SOKU(+)
			) KU
	WHERE DMXA.MA = KU.MAXA AND HSTO.TO_MATO = KU.MATO AND HSKH.KH_MAKH = KU.MAKH AND (KU.DUDAU+KU.DUCUOI) > 0
	ORDER BY KU.MAXA,
	   KU.MATO,
	   KU.MAKH,
	   KU.SOKU]]>
	</queryString>
	<field name="MAXA" class="java.lang.String"/>
	<field name="TENXA" class="java.lang.String"/>
	<field name="MATO" class="java.lang.String"/>
	<field name="TENTT" class="java.lang.String"/>
	<field name="MAKH" class="java.lang.String"/>
	<field name="TENKH" class="java.lang.String"/>
	<field name="SOKU" class="java.lang.String"/>
	<field name="DUDAU" class="java.math.BigDecimal"/>
	<field name="DUCUOI" class="java.math.BigDecimal"/>
	<variable name="DUDAU_1" class="java.math.BigDecimal" resetType="Group" resetGroup="MATO" calculation="Sum">
		<variableExpression><![CDATA[$F{DUDAU}]]></variableExpression>
	</variable>
	<variable name="DUCUOI_1" class="java.math.BigDecimal" resetType="Group" resetGroup="MATO" calculation="Sum">
		<variableExpression><![CDATA[$F{DUCUOI}]]></variableExpression>
	</variable>
	<variable name="DUDAU_2" class="java.math.BigDecimal" resetType="Group" resetGroup="MAXA" calculation="Sum">
		<variableExpression><![CDATA[$F{DUDAU}]]></variableExpression>
	</variable>
	<variable name="DUCUOI_2" class="java.math.BigDecimal" resetType="Group" resetGroup="MAXA" calculation="Sum">
		<variableExpression><![CDATA[$F{DUCUOI}]]></variableExpression>
	</variable>
	<variable name="DNBQ_1" class="java.math.BigDecimal" resetType="Group" resetGroup="MATO" calculation="Sum">
		<variableExpression><![CDATA[($F{DUDAU} + $F{DUCUOI}) / 2]]></variableExpression>
	</variable>
	<variable name="HOAHONG_1" class="java.math.BigDecimal" resetType="Group" resetGroup="MATO" calculation="Sum">
		<variableExpression><![CDATA[($F{DUDAU} + $F{DUCUOI}) / 2 * 0.0005]]></variableExpression>
	</variable>
	<variable name="DNBQ_2" class="java.math.BigDecimal" resetType="Group" resetGroup="MAXA" calculation="Sum">
		<variableExpression><![CDATA[($F{DUDAU} + $F{DUCUOI}) / 2]]></variableExpression>
	</variable>
	<variable name="HOAHONG_2" class="java.math.BigDecimal" resetType="Group" resetGroup="MAXA" calculation="Sum">
		<variableExpression><![CDATA[($F{DUDAU} + $F{DUCUOI}) / 2 * 0.0005]]></variableExpression>
	</variable>
	<variable name="DNBQ_3" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[($F{DUDAU} + $F{DUCUOI}) / 2]]></variableExpression>
	</variable>
	<variable name="HOAHONG_3" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[($F{DUDAU} + $F{DUCUOI}) / 2 * 0.0005]]></variableExpression>
	</variable>
