<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="DS3TKPS" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="07ec2208-76cf-4c56-bed5-17a7e0b3f5ae">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<parameter name="PARA_MAPGD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_MAXA" class="java.lang.String"/>
	<parameter name="PARA_MATO" class="java.lang.String"/>
	<queryString>
		<![CDATA[select
        KU_macn,
        (SELECT TEN
            FROM DMTINH
           WHERE MA = SUBSTR (KU_macn, 3, 2)) TEN_TINH,
        KU_mapgd,
        (SELECT TEN
            FROM DMHUYEN
           WHERE MA = SUBSTR (KU_mapgd, 3, 4)) TEN_HUYEN,
        SUBSTR(KU_MADP, 1, 6) maxa,
        (SELECT TEN
            FROM DMXA
           WHERE MA = SUBSTR(KU_MADP, 1, 6)) TEN_XA,
        KU_MATO MA_TO,
        TO_TENTT TEN_TT,
        KU_MAKH ma_kh,
        KH_TENKH ten_kh,
        KH_DIACHI dia_chi,
        TONG_DNO,
        NVL(CS_SODU_TK,0) TIEN_GUI,
        SO_THG_KHD,
        to_char(to_date($P{PARA_NGAYBC}), 'DD/MM/YYYY') NGAYBC
from
    (select KU_macn,
            KU_mapgd,
            KU_MADP,
            KU_MATO,
            KU_MAKH,
            sum(KU_DNOTHAN+KU_DNOQHAN+KU_DNOKHOANH) TONG_DNO,
            MIN(ROUND(MONTHS_BETWEEN (TO_DATE ($P{PARA_NGAYBC},'DD/MM/YYYY'), KU_NGAYGDGN),1)) SO_THG_KHD
        FROM HSKU
        where KU_NGAYBC = $P{PARA_NGAYBC}
            AND KU_MAPGD = $P{PARA_MAPGD}
            and KU_TTMONVAY <> 'CLOSE'
            AND KU_MATO IS NOT NULL
            AND ROUND(MONTHS_BETWEEN (TO_DATE ($P{PARA_NGAYBC},'DD/MM/YYYY'), KU_NGAYGDGN),1) > 3
            AND DECODE(KU_CHTRINH,'02', nvl(KU_NGAY_TLAI,TO_DATE($P{PARA_NGAYBC})+1),TO_DATE($P{PARA_NGAYBC})-1) < TO_DATE($P{PARA_NGAYBC})
            and decode(nvl($P{PARA_MAXA}, '000000'), '000000', '1', SUBSTR(KU_MADP, 1, 6)) = decode(nvl($P{PARA_MAXA}, '000000'), '000000', '1', $P{PARA_MAXA})
            and decode(nvl($P{PARA_MATO}, '0'), '0', '1', KU_MATO) = decode(nvl($P{PARA_MATO}, '0'), '0', '1', $P{PARA_MATO})
            AND KU_DNOTHAN+KU_DNOQHAN+KU_DNOKHOANH > 0
            AND (KU_DNOKHOANH = 0 OR KU_M_GHANNO=0)
            AND (CASE
                     WHEN     KU_CHTRINH IN ('05', '07', '18')
                          AND ADD_MONTHS (KU_NGAYGNDT, 60 +3) > $P{PARA_NGAYBC}
                     THEN
                        0
                     WHEN     KU_CHTRINH = '01'
                          AND KU_SPRD_CD IN ('011SC2', '011MC2', '011LC2')
                          AND ADD_MONTHS (KU_NGAYGNDT, 24 +3) > $P{PARA_NGAYBC}
                     THEN
                        0
                     WHEN KU_CHTRINH = '06' AND ADD_MONTHS (KU_NGAYGNDT, 6 + 3) > $P{PARA_NGAYBC}
                     THEN
                        0
                     WHEN     KU_LSUAT = 0 --KU_CHTRINH = '11'
                     THEN
                        0
                     ELSE
                        1
                  END) = 1
            group by KU_macn,
                    KU_mapgd,
                    KU_MADP,
                    KU_MATO,
                    KU_MAKH) HSKU,
    (select kh_makh, kh_tenkh, kh_diachi, KH_MADP
            from HSKH
            where Kh_MAPGD = $P{PARA_MAPGD}
        union all
        select dn_ma kh_makh, dn_ten kh_tenkh, dn_diachi kh_diachi, dn_MADP KH_MADP
            from hskh_dn
            where dn_MAPGD = $P{PARA_MAPGD}) HSKH,
    (select *
        from  CASA
        where  CS_NGAYBC = $P{PARA_NGAYBC}
			and cs_mapgd = $P{PARA_MAPGD}
			AND CS_MATO IS NOT NULL
			AND CS_SP_TK = '105'
            and decode(nvl($P{PARA_MAXA}, '000000'), '000000', '1', SUBSTR(CS_MADP, 1, 6)) = decode(nvl($P{PARA_MAXA}, '000000'), '000000', '1', $P{PARA_MAXA})
			and decode(nvl($P{PARA_MATO}, '0'), '0', '1', CS_MATO) = decode(nvl($P{PARA_MATO}, '0'), '0', '1', $P{PARA_MATO})) CASA,
    (SELECT * FROM HSTO WHERE TO_LOAITO = '01' AND TO_MAPGD = $P{PARA_MAPGD}) HSTO
   WHERE KU_MAKH = KH_MAKH
         AND KU_MATO = CS_MATO(+)
         AND KU_MAKH = CS_MAKH(+)
         AND KU_MATO = TO_MATO
ORDER BY ku_macn,
        KU_MAPGD,
        SUBSTR(KU_MADP, 1, 6),
        KU_MATO,
        KU_MAKH]]>
	</queryString>
	<field name="KU_MACN" class="java.lang.String"/>
	<field name="TEN_TINH" class="java.lang.String"/>
	<field name="KU_MAPGD" class="java.lang.String"/>
	<field name="TEN_HUYEN" class="java.lang.String"/>
	<field name="MAXA" class="java.lang.String"/>
