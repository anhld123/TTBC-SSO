	<field name="TONG_DNO" class="java.math.BigDecimal"/>
	<field name="TIEN_GUI" class="java.math.BigDecimal"/>
	<field name="SO_THG_KHD" class="java.math.BigDecimal"/>
	<field name="NGAYBC" class="java.lang.String"/>
	<variable name="TONG_DNO_1" class="java.math.BigDecimal" resetType="Group" resetGroup="to" calculation="Sum">
		<variableExpression><![CDATA[$F{TONG_DNO}]]></variableExpression>
	</variable>
	<variable name="MA_KH_1" class="java.lang.Integer" resetType="Group" resetGroup="to" calculation="Count">
