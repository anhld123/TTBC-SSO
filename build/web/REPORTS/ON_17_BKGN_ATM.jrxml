			</textField>
			<textField>
				<reportElement x="7" y="91" width="365" height="18"/>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" isBold="false" isItalic="false" pdfFontName="" pdfEncoding="Identity-H"/>
				</textElement>
				<textFieldExpression class="java.lang.String"><![CDATA["Tên đơn vị giải ngân:"+ $F{POS_DESC}]]></textFieldExpression>
			</textField>
