<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="BCDHTD_07.6" language="groovy" pageWidth="1120" pageHeight="780" orientation="Landscape" columnWidth="1082" leftMargin="20" rightMargin="18" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_TONGHOP" class="java.lang.String"/>
	<parameter name="PARA_DENNGAY" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT A.SC_MA MACT, A.SC_TEN TENCT,
(select NVL(sum(KYQUY_D1)/1000000,0) from BCTD_KYQUY, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE KYQUY_MAPGD = Y.PO_MA AND KYQUY_CHTRINH = SUBSTR(A.SC_MA,3,2) AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND KYQUY_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) DS_CHOVAYT,
(select NVL(sum(KYQUY_D2)/1000000,0) from BCTD_KYQUY, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE KYQUY_MAPGD = Y.PO_MA AND KYQUY_CHTRINH = SUBSTR(A.SC_MA,3,2) AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND KYQUY_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) DS_CHOVAYN,
(select NVL(sum(KYQUY_D3)/1000000,0) from BCTD_KYQUY, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE KYQUY_MAPGD = Y.PO_MA AND KYQUY_CHTRINH = SUBSTR(A.SC_MA,3,2) AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND KYQUY_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) DS_THUNOT,
(select NVL(sum(KYQUY_D4)/1000000,0) from BCTD_KYQUY, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE KYQUY_MAPGD = Y.PO_MA AND KYQUY_CHTRINH = SUBSTR(A.SC_MA,3,2) AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND KYQUY_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) DS_THUNON,
(select NVL(sum(KYQUY_D5)/1000000,0) from BCTD_KYQUY, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE KYQUY_MAPGD = Y.PO_MA AND KYQUY_CHTRINH = SUBSTR(A.SC_MA,3,2) AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND KYQUY_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) DS_XOANOT,
(select NVL(sum(KYQUY_D6)/1000000,0) from BCTD_KYQUY, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE KYQUY_MAPGD = Y.PO_MA AND KYQUY_CHTRINH = SUBSTR(A.SC_MA,3,2) AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND KYQUY_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) DS_XOANON,
(select NVL(sum(KYQUY_D7)/1000000,0) from BCTD_KYQUY, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE KYQUY_MAPGD = Y.PO_MA AND KYQUY_CHTRINH = SUBSTR(A.SC_MA,3,2) AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND KYQUY_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) TONG_DN,
(select NVL(sum(KYQUY_D8)/1000000,0) from BCTD_KYQUY, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE KYQUY_MAPGD = Y.PO_MA AND KYQUY_CHTRINH = SUBSTR(A.SC_MA,3,2) AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND KYQUY_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) NO_THAN,
(select NVL(sum(KYQUY_D9)/1000000,0) from BCTD_KYQUY, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE KYQUY_MAPGD = Y.PO_MA AND KYQUY_CHTRINH = SUBSTR(A.SC_MA,3,2) AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND KYQUY_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) NO_QHAN,
(select NVL(sum(KYQUY_D10)/1000000,0) from BCTD_KYQUY, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE KYQUY_MAPGD = Y.PO_MA AND KYQUY_CHTRINH = SUBSTR(A.SC_MA,3,2) AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND KYQUY_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) NO_KHOANH,
(select NVL(sum(KYQUY_D11)/1000000,0) from BCTD_KYQUY, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE KYQUY_MAPGD = Y.PO_MA AND KYQUY_CHTRINH = SUBSTR(A.SC_MA,3,2) AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND KYQUY_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) NO_NGANHAN,
(select NVL(sum(KYQUY_D12)/1000000,0) from BCTD_KYQUY, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE KYQUY_MAPGD = Y.PO_MA AND KYQUY_CHTRINH = SUBSTR(A.SC_MA,3,2) AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND KYQUY_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) NO_TRUNGHAN,
(select NVL(sum(KYQUY_D13)/1000000,0) from BCTD_KYQUY, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE KYQUY_MAPGD = Y.PO_MA AND KYQUY_CHTRINH = SUBSTR(A.SC_MA,3,2) AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND KYQUY_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) NO_DAIHAN,
(select NVL(sum(KYQUY_D14),0) from BCTD_KYQUY, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE KYQUY_MAPGD = Y.PO_MA AND KYQUY_CHTRINH = SUBSTR(A.SC_MA,3,2) AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND KYQUY_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) SKH_DUNO,
(select NVL(sum(KYQUY_D15),0) from BCTD_KYQUY, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE KYQUY_MAPGD = Y.PO_MA AND KYQUY_CHTRINH = SUBSTR(A.SC_MA,3,2) AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND KYQUY_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) SKH_VVON
FROM DM_SCHEME A
WHERE SC_MA = 'S00400' OR SC_MA = 'S01600'
order by SC_MA]]>
	</queryString>
