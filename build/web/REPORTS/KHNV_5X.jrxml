	<parameter name="PARA_NGAYBC" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_MACN" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT DISTINCT  A.MACN,B.TEN TENCN, TO_CHAR(TO_DATE(A.NGAYBC),'DD/MM/YYYY') NGAYBC
from KHNV_DAILY A,DMTINH B
WHERE
 SUBSTR(MACN,3,2) = B.MA
 AND NGAYBC = $P{PARA_NGAYBC}
AND substr(macn,3,2)= $P{PARA_MACN}
ORDER BY SUBSTR(MACN,3,2)]]>
	</queryString>
	<field name="MACN" class="java.lang.String"/>
	<field name="TENCN" class="java.lang.String"/>
	<field name="NGAYBC" class="java.lang.String"/>
	<group name="GRP_CN" isStartNewPage="true" isResetPageNumber="true" isReprintHeaderOnEachPage="true">
