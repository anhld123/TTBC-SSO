					<font fontName="Times New Roman" size="11" isBold="false" pdfEncoding="Identity-H"/>
					<paragraph lineSpacing="Proportional" lineSpacingSize="1.3"/>
				</textElement>
				<text><![CDATA[ NHCSXH chưa thực hiện quản lý tài sản, công nợ và các khoản mục ngoại bảng tập trung theo khu vực địa lý.
]]></text>
			</staticText>
