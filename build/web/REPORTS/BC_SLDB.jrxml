<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="BC_SLDB" language="groovy" pageWidth="421" pageHeight="595" orientation="Landscape" columnWidth="381" leftMargin="20" rightMargin="20" topMargin="0" bottomMargin="0" uuid="0e77cae3-876c-415d-a350-b5d7aaa55fa4">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_DENNGAY" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select * from (
select substr(ct_macn,3,2) macn, ct_mact mact,  NVL(SUM(CT_GIATRI),0) giatri FROM CT_VBSP where ct_ngaybc = $P{PARA_DENNGAY} and ct_capth = 'M' and ct_giatri > 0 and substr(ct_macn,3,2) <> '01' group by substr(ct_macn,3,2), ct_mact
UNION ALL
select substr(ct_macn,5,2) macn, ct_mact mact,  NVL(SUM(CT_GIATRI),0) giatri FROM CT_VBSP where ct_ngaybc = $P{PARA_DENNGAY} and ct_capth = 'M' AND ct_giatri <> 0 and substr(ct_macn,3,2) = '01' group by substr(ct_macn,5,2), ct_mact
)
order by macn,mact]]>
	</queryString>
	<field name="MACN" class="java.lang.String"/>
	<field name="MACT" class="java.lang.String"/>
	<field name="GIATRI" class="java.math.BigDecimal"/>
	<variable name="DEN_NGAY" class="java.util.Date">
		<variableExpression><![CDATA[new Date($P{PARA_DENNGAY})]]></variableExpression>
	</variable>
