<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="BCDHTD_03.1" language="groovy" pageWidth="1335" pageHeight="500" orientation="Landscape" columnWidth="1335" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_TONGHOP" class="java.lang.String"/>
	<parameter name="PARA_DENNGAY" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT case when (THUTU <> 4 AND THUTU <>  11 AND THUTU <> 12 AND THUTU <>  15) then GIATRI
                   when THUTU = 4 then 'Cho vay đối tượng chính sách đi XKLĐ NN'
                   when THUTU = 11 then 'Cho vay hộ đồng bào DTTS ĐBKK theo QĐ số 32 và QĐ số 54'
                   when THUTU = 12 then 'Cho vay ĐB DTTS nghèo, khó khăn theo QĐ số 74 và QĐ số 29'
                   when THUTU = 15 then 'Cho vay một số dự án vốn nước ngoài khác'
end as CHTRINH,
KHOA_2 MACT, GIATRI TENCT, THUTU STT,
(select NVL(sum(DTTH_D1)/1000000,0) from BCTD_DTTH, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE DTTH_MAPGD = Y.PO_MA AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND DTTH_MAQD = A.KHOA_2 AND (DTTH_DTTH = '01' OR DTTH_DTTH = '02')  AND DTTH_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) DS_CHOVAYT,
(select NVL(sum(DTTH_D2)/1000000,0) from BCTD_DTTH, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE DTTH_MAPGD = Y.PO_MA AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND DTTH_MAQD = A.KHOA_2 AND (DTTH_DTTH = '01' OR DTTH_DTTH = '02')  AND DTTH_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) DS_CHOVAYN,
(select NVL(sum(DTTH_D3)/1000000,0) from BCTD_DTTH, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE DTTH_MAPGD = Y.PO_MA AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND DTTH_MAQD = A.KHOA_2 AND (DTTH_DTTH = '01' OR DTTH_DTTH = '02')  AND DTTH_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) DS_THUNOT,
(select NVL(sum(DTTH_D4)/1000000,0) from BCTD_DTTH, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE DTTH_MAPGD = Y.PO_MA AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND DTTH_MAQD = A.KHOA_2 AND (DTTH_DTTH = '01' OR DTTH_DTTH = '02')  AND DTTH_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) DS_THUNON,
(select NVL(sum(DTTH_D5)/1000000,0) from BCTD_DTTH, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE DTTH_MAPGD = Y.PO_MA AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND DTTH_MAQD = A.KHOA_2 AND (DTTH_DTTH = '01' OR DTTH_DTTH = '02')  AND DTTH_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) DS_XOANOT,
(select NVL(sum(DTTH_D6)/1000000,0) from BCTD_DTTH, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE DTTH_MAPGD = Y.PO_MA AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND DTTH_MAQD = A.KHOA_2 AND (DTTH_DTTH = '01' OR DTTH_DTTH = '02')  AND DTTH_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) DS_XOANON,
(select NVL(sum(DTTH_D7)/1000000,0) from BCTD_DTTH, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE DTTH_MAPGD = Y.PO_MA AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND DTTH_MAQD = A.KHOA_2 AND (DTTH_DTTH = '01' OR DTTH_DTTH = '02')  AND DTTH_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) TONG_DN,
(select NVL(sum(DTTH_D8)/1000000,0) from BCTD_DTTH, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE DTTH_MAPGD = Y.PO_MA AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND DTTH_MAQD = A.KHOA_2 AND (DTTH_DTTH = '01' OR DTTH_DTTH = '02')  AND DTTH_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) NO_THAN,
(select NVL(sum(DTTH_D9)/1000000,0) from BCTD_DTTH, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE DTTH_MAPGD = Y.PO_MA AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND DTTH_MAQD = A.KHOA_2 AND (DTTH_DTTH = '01' OR DTTH_DTTH = '02')  AND DTTH_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) NO_QHAN,
(select NVL(sum(DTTH_D10)/1000000,0) from BCTD_DTTH, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE DTTH_MAPGD = Y.PO_MA AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND DTTH_MAQD = A.KHOA_2 AND (DTTH_DTTH = '01' OR DTTH_DTTH = '02')  AND DTTH_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) NO_KHOANH,
(select NVL(sum(DTTH_D11)/1000000,0) from BCTD_DTTH, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE DTTH_MAPGD = Y.PO_MA AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND DTTH_MAQD = A.KHOA_2 AND (DTTH_DTTH = '01' OR DTTH_DTTH = '02')  AND DTTH_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) NO_NGANHAN,
(select NVL(sum(DTTH_D12)/1000000,0) from BCTD_DTTH, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE DTTH_MAPGD = Y.PO_MA AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND DTTH_MAQD = A.KHOA_2 AND (DTTH_DTTH = '01' OR DTTH_DTTH = '02')  AND DTTH_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) NO_TRUNGHAN,
(select NVL(sum(DTTH_D13)/1000000,0) from BCTD_DTTH, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE DTTH_MAPGD = Y.PO_MA AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND DTTH_MAQD = A.KHOA_2 AND (DTTH_DTTH = '01' OR DTTH_DTTH = '02')  AND DTTH_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) NO_DAIHAN,
(select NVL(sum(DTTH_D14),0) from BCTD_DTTH, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE DTTH_MAPGD = Y.PO_MA AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND DTTH_MAQD = A.KHOA_2 AND (DTTH_DTTH = '01' OR DTTH_DTTH = '02')  AND DTTH_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) SKH_DUNO,
(select NVL(sum(DTTH_D15),0) from BCTD_DTTH, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z  WHERE DTTH_MAPGD = Y.PO_MA AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND DTTH_MAQD = A.KHOA_2 AND (DTTH_DTTH = '01' OR DTTH_DTTH = '02')  AND DTTH_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))) SKH_VVON
FROM DMKHAC A,  BCTD_DTTH B, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z
WHERE KHOA_1 = '07'
AND A.KHOA_2 = B.DTTH_MAQD
AND (DTTH_DTTH = '01' OR DTTH_DTTH = '02')
AND DTTH_NGAYBC BETWEEN LAST_DAY (ADD_MONTHS (TO_DATE ($P{PARA_DENNGAY}), -1)) + 1 AND LAST_DAY (TO_DATE ($P{PARA_DENNGAY}))
AND B.DTTH_MAPGD = Y.PO_MA
AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA)
AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD})
group by A.THUTU,A.KHOA_2, A.GIATRI
order by A.THUTU]]>
	</queryString>
