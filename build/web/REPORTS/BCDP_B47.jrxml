<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="BCDP_B47" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" whenNoDataType="AllSectionsNoDetail" columnWidth="817" leftMargin="15" rightMargin="10" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_NGAYBC" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_TONGHOP" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT AA.LOAI, BB.GN_THANG, BB.TN_THANG, BB.DUNO, BB.NOXAU, BB.SL_KH_1, BB.SOHO, BB.DSCHOVAY, BB.SL_KH_2
FROM
(
SELECT '01' LOAI FROM DUAL
UNION
SELECT '011' LOAI FROM DUAL
UNION
SELECT '012' LOAI FROM DUAL
UNION
SELECT '013' LOAI FROM DUAL
UNION
SELECT '02' LOAI FROM DUAL
) AA,
(
SELECT LOAI, ROUND(SUM(GN_THANG) / 1000000, 2) GN_THANG,
            ROUND(SUM(TN_THANG) / 1000000, 2) TN_THANG,
            ROUND(SUM(DUNO) / 1000000, 2) DUNO,
            ROUND(SUM(NOXAU) / 1000000, 2) NOXAU,
            COUNT(DISTINCT SL_KH_1) SL_KH_1,
            COUNT(DISTINCT SOHO) SOHO,
            ROUND(SUM(DSCHOVAY) / 1000000, 2) DSCHOVAY,
            COUNT(DISTINCT SL_KH_2) SL_KH_2
FROM
(
SELECT CASE
                WHEN KU_MAPNKT51 IN ('01410','01440') THEN '011'
                WHEN KU_MAPNKT51 IN ('01461','01462','01463','01469' ) THEN '012'
                WHEN KU_MAPNKT51 IN ('03210','03221','03222','03230' ) THEN '013'
                WHEN KU_MAPNKT51 NOT IN  ('01410','01440','01461','01462','01463','01469','03210','03221','03222','03230') THEN '02'
            ELSE NULL END LOAI,
            NVL(KU_M_GNGAN, 0) GN_THANG,
            NVL(KU_M_TNTHAN, 0) + NVL(KU_M_TNQHAN, 0) + NVL(KU_M_TNKHOANH, 0) TN_THANG,
            NVL(KU_DNOTHAN, 0) + NVL(KU_DNOQHAN, 0) + NVL(KU_DNOKHOANH, 0) DUNO,
            NVL(KU_DNOQHAN, 0) + NVL(KU_DNOKHOANH, 0) NOXAU,
            CASE WHEN KU_M_GNGAN > 0 THEN KU_MAKH ELSE NULL END SL_KH_1,
            CASE WHEN KU_TTMONVAY <> 'CLOSE' THEN KU_MAKH ELSE NULL END SOHO,
            NVL(KU_DSCHOVAY, 0) DSCHOVAY,
            CASE WHEN NVL(KU_DSCHOVAY, 0) > 0 THEN KU_MAKH ELSE NULL END SL_KH_2
FROM HSKU AA, DMPOS YY, (SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) ZZ,
        (
            SELECT KU_SOKU, SUM(NVL(KU_M_GNGAN, 0)) KU_DSCHOVAY
            FROM HSKU,  DMPOS Y, (SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z
            WHERE KU_MAPGD = Y.PO_MA AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND
                        DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND KU_M_GNGAN > 0 AND
                        EXISTS (SELECT MA  FROM DMHUYEN WHERE HUYEN30AFLG = 'Y' AND MA = SUBSTR(KU_MAPGD, 3, 6)) AND
                        KU_MAPNKT51 IN ('01410','01440','01461','01462','01463','01469','03210','03221','03222','03230') AND
                        KU_NGAYBC BETWEEN TO_DATE('01-JAN-14') AND TO_DATE($P{PARA_NGAYBC})
            GROUP BY KU_SOKU
        ) BB
WHERE AA.KU_SOKU = BB.KU_SOKU (+) AND KU_MAPGD = YY.PO_MA AND
            DECODE(ZZ.PO_POSFLG,'H',1,'S',YY.PO_MA , YY.PO_MACN) = DECODE(ZZ.PO_POSFLG,'H',1,ZZ.PO_MA) AND
            EXISTS (SELECT MA  FROM DMHUYEN WHERE HUYEN30AFLG = 'Y' AND MA = SUBSTR(AA.KU_MAPGD, 3, 6)) AND
            DECODE('Y',$P{PARA_TONGHOP},1,YY.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND KU_NGAYBC = TO_DATE($P{PARA_NGAYBC})
UNION
SELECT '01' LOAI,
            NVL(KU_M_GNGAN, 0) GN_THANG,
            NVL(KU_M_TNTHAN, 0) + NVL(KU_M_TNQHAN, 0) + NVL(KU_M_TNKHOANH, 0) TN_THANG,
            NVL(KU_DNOTHAN, 0) + NVL(KU_DNOQHAN, 0) + NVL(KU_DNOKHOANH, 0) DUNO,
            NVL(KU_DNOQHAN, 0) + NVL(KU_DNOKHOANH, 0) NOXAU,
            CASE WHEN KU_M_GNGAN > 0 THEN KU_MAKH ELSE NULL END SL_KH_1,
            CASE WHEN KU_TTMONVAY <> 'CLOSE' THEN KU_MAKH ELSE NULL END SOHO,
            NVL(KU_DSCHOVAY, 0) DSCHOVAY,
            CASE WHEN NVL(KU_DSCHOVAY, 0) > 0 THEN KU_MAKH ELSE NULL END SL_KH_2
FROM HSKU AA, DMPOS YY, (SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) ZZ,
        (
            SELECT KU_SOKU, SUM(NVL(KU_M_GNGAN, 0)) KU_DSCHOVAY
            FROM HSKU,  DMPOS Y, (SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z
            WHERE KU_MAPGD = Y.PO_MA AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA) AND
                        DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND KU_M_GNGAN > 0 AND
                        EXISTS (SELECT MA  FROM DMHUYEN WHERE HUYEN30AFLG = 'Y' AND MA = SUBSTR(KU_MAPGD, 3, 6)) AND
                        KU_MAPNKT51 IN ('01410','01440','01461','01462','01463','01469','03210','03221','03222','03230') AND
                        KU_NGAYBC BETWEEN TO_DATE('01-JAN-14') AND TO_DATE($P{PARA_NGAYBC})
            GROUP BY KU_SOKU
        ) BB
WHERE AA.KU_SOKU = BB.KU_SOKU (+) AND KU_MAPGD = YY.PO_MA AND
            DECODE(ZZ.PO_POSFLG,'H',1,'S',YY.PO_MA , YY.PO_MACN) = DECODE(ZZ.PO_POSFLG,'H',1,ZZ.PO_MA) AND
            EXISTS (SELECT MA  FROM DMHUYEN WHERE HUYEN30AFLG = 'Y' AND MA = SUBSTR(AA.KU_MAPGD, 3, 6)) AND
            KU_MAPNKT51 IN ('01410','01440','01461','01462','01463','01469','03210','03221','03222','03230') AND
            DECODE('Y',$P{PARA_TONGHOP},1,YY.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD}) AND KU_NGAYBC = TO_DATE($P{PARA_NGAYBC})
)
GROUP BY LOAI
) BB
WHERE AA.LOAI = BB.LOAI(+)
ORDER BY LOAI]]>
	</queryString>
	<field name="LOAI" class="java.lang.String"/>
	<field name="GN_THANG" class="java.math.BigDecimal"/>
	<field name="TN_THANG" class="java.math.BigDecimal"/>
	<field name="DUNO" class="java.math.BigDecimal"/>
	<field name="NOXAU" class="java.math.BigDecimal"/>
	<field name="SL_KH_1" class="java.math.BigDecimal"/>
	<field name="SOHO" class="java.math.BigDecimal"/>
	<field name="DSCHOVAY" class="java.math.BigDecimal"/>
	<field name="SL_KH_2" class="java.math.BigDecimal"/>
	<variable name="GN_THANG_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{GN_THANG}]]></variableExpression>
	</variable>
	<variable name="TN_THANG_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TN_THANG}]]></variableExpression>
	</variable>
	<variable name="DUNO_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{DUNO}]]></variableExpression>
	</variable>
	<variable name="NOXAU_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{NOXAU}]]></variableExpression>
	</variable>
	<variable name="SL_KH_1_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{SL_KH_1}]]></variableExpression>
	</variable>
	<variable name="SOHO_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{SOHO}]]></variableExpression>
	</variable>
	<variable name="DSCHOVAY_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{DSCHOVAY}]]></variableExpression>
	</variable>
	<variable name="SL_KH_2_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{SL_KH_2}]]></variableExpression>
	</variable>
