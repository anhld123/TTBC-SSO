<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="BC23" language="groovy" pageWidth="1270" pageHeight="842" columnWidth="1060" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="POS_CD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="CONS_FLAG" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="REPORT_DATE" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT NULL CREDIT_STAFF_NAME,
            DECODE(TS_TTRANG, 'FRE', NULL, TS_SOKU) LOAN_ID,
            KH_TENKH CUSTOMER_NAME,
            TS_NGAYDKY BOOKING_DATE,
            TS_GTRITK CURRENT_VALUE,
            TS_MA ASSET_CODE,
            TS_MACTHE TYPE_CODE,
            TS_TENCTHE DESCRIPTION,
            TS_MOTA DETAILS
FROM HSKU, TSDB, HSKH, DMPOS Y,
        (SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{POS_CD}) Z
WHERE KU_SOKU = TS_SOKU AND KU_MAKH = KH_MAKH AND KU_MAPGD = Y.PO_MA AND
            DECODE(Z.PO_POSFLG, 'H', 1, 'S', Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG, 'H', 1, Z.PO_MA) AND
            DECODE($P{CONS_FLAG}, 'Y', 1, Y.PO_MA) = DECODE($P{CONS_FLAG}, 'Y', 1, $P{POS_CD}) AND
            (TRANGTHAI = 'A' OR TS_TTRANG = 'FRE') AND NVL(TS_GTRITK, 0) > 0 AND KU_NGAYBC = TO_DATE($P{REPORT_DATE})
ORDER BY ASSET_CODE]]>
	</queryString>
	<field name="CREDIT_STAFF_NAME" class="java.lang.String"/>
	<field name="LOAN_ID" class="java.lang.String"/>
	<field name="CUSTOMER_NAME" class="java.lang.String"/>
	<field name="BOOKING_DATE" class="java.sql.Timestamp"/>
	<field name="CURRENT_VALUE" class="java.math.BigDecimal"/>
	<field name="ASSET_CODE" class="java.lang.String"/>
	<field name="TYPE_CODE" class="java.lang.String"/>
	<field name="DESCRIPTION" class="java.lang.String"/>
	<field name="DETAILS" class="java.lang.String"/>
	<variable name="GRP_SUM" class="java.math.BigDecimal" resetType="Group" resetGroup="COLLATERAL_GRP">
		<variableExpression><![CDATA[$V{COLLATERAL_GRP_COUNT}==1?$F{CURRENT_VALUE}:new BigDecimal(0)]]></variableExpression>
	</variable>
	<variable name="tot_sum" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$V{GRP_SUM}]]></variableExpression>
		<initialValueExpression><![CDATA[new BigDecimal(0)]]></initialValueExpression>
	</variable>
	<group name="COLLATERAL_GRP">
		<groupExpression><![CDATA[$F{ASSET_CODE}]]></groupExpression>
