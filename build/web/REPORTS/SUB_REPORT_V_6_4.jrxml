<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="SUB_REPORT_V_6_4" language="groovy" pageWidth="555" pageHeight="802" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_TONGHOP" class="java.lang.String"/>
	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT A.DESCRIPT, A.ACCOUNT, A.FIRST_PRE_AMT, A.LAST_PRE_AMT FROM
((SELECT 'Cho vay các TCKT' DESCRIPT,'Tk 211101, 211104, 211106, 211204, 211304, 211404, 212101, 212104, 212204, 212304, 212404, 213101, 213104, 252151, 252152, 252153, 252251, 252252, 252253, 252351, 252352, 252363, 252451, 252452, 252453, 291001, 291004, 291006, 292001, 292004, 293001, 293004' ACCOUNT, 0 FIRST_PRE_AMT, 0 LAST_PRE_AMT FROM DUAL)
UNION
(SELECT 'Cho vay cá nhân' DESCRIPT,'Tk 211103, 211105, 211107, 211207, 211407, 211403, 211405, 212103, 212105, 212107, 212203, 212207, 212403, 212405, 212407, 213103, 213107, 213403, 251103, 251105, 251107, 251203, 251205, 251207, 251303, 251305, 251307, 251403, 251405, 251407, 253103, 253105, 253107, 253203, 253205, 253207, 253303, 253305, 253307, 253403, 253405, 253407, 291003, 291005, 291007, 292003, 292005, 292007, 293003, 293005, 293007 ' ACCOUNT, 0 FIRST_PRE_AMT, 0 LAST_PRE_AMT FROM DUAL)
UNION
(SELECT 'Cho vay khác' DESCRIPT,'tổng dư nợ cho vay trừ (-) [cho vay các TCKT và Cho vay cá nhân]' ACCOUNT, (DN_TK_SBV (ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_MAPGD},$P{PARA_TONGHOP},'21','D') +
DN_TK_SBV (ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_MAPGD},$P{PARA_TONGHOP},'25','D') +
DN_TK_SBV (ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_MAPGD},$P{PARA_TONGHOP},'27','D') +
DN_TK_SBV (ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_MAPGD},$P{PARA_TONGHOP},'29','D')) FIRST_PRE_AMT, (DN_TK_SBV ($P{PARA_NGAYBC},$P{PARA_MAPGD},$P{PARA_TONGHOP},'21','D') +
DN_TK_SBV ($P{PARA_NGAYBC},$P{PARA_MAPGD},$P{PARA_TONGHOP},'25','D') +
DN_TK_SBV ($P{PARA_NGAYBC},$P{PARA_MAPGD},$P{PARA_TONGHOP},'27','D') +
DN_TK_SBV ($P{PARA_NGAYBC},$P{PARA_MAPGD},$P{PARA_TONGHOP},'29','D')) LAST_PRE_AMT FROM DUAL)
) A ORDER BY A.ACCOUNT]]>
	</queryString>
	<field name="DESCRIPT" class="java.lang.String"/>
	<field name="ACCOUNT" class="java.lang.String"/>
	<field name="FIRST_PRE_AMT" class="java.math.BigDecimal"/>
	<field name="LAST_PRE_AMT" class="java.math.BigDecimal"/>
	<variable name="LAST_PRE_AMT_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{LAST_PRE_AMT}]]></variableExpression>
	</variable>
	<variable name="FIRST_PRE_AMT_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{FIRST_PRE_AMT}]]></variableExpression>
	</variable>
