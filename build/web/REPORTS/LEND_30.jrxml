	<field name="THUNO" class="java.math.BigDecimal"/>
	<field name="DUNO" class="java.math.BigDecimal"/>
	<variable name="STT" class="java.math.BigDecimal" resetType="Group" resetGroup="MATO">
		<variableExpression><![CDATA[$V{STT} + 1]]></variableExpression>
		<initialValueExpression><![CDATA[0]]></initialValueExpression>
	</variable>
	<variable name="GNGAN_1" class="java.math.BigDecimal" resetType="Group" resetGroup="MATO" calculation="Sum">
		<variableExpression><![CDATA[$F{GNGAN}]]></variableExpression>
	</variable>
	<variable name="THUNO_1" class="java.math.BigDecimal" resetType="Group" resetGroup="MATO" calculation="Sum">
