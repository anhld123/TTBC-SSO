	<parameter name="PARA_MAPGD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_TONGHOP" class="java.lang.String"/>
	<parameter name="PARA_DENNGAY" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["C:\\Users\\nhung\\Desktop\\JasperReport\\BC DIAPHUONG\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT HT_VAY, SC_MA MACT, SC_TEN TENCT,
            COUNT(DISTINCT TS_KH_HTLS) TS_KH_HTLS,
            COUNT(DISTINCT KH_HTLS_FULL) KH_HTLS_FULL,
            ROUND(SUM(TS_DN_HTLS) / 1000000, 2) TS_DN_HTLS,
            ROUND(SUM(DN_HTLS_FULL) / 1000000, 2) DN_HTLS_FULL,
            ROUND(SUM(LAI_CHUA_HTLS) / 1000000, 2) LAI_CHUA_HTLS,
            ROUND(SUM(LAI_DA_HTLS) / 1000000, 2) LAI_DA_HTLS
FROM DM_SCHEME,
(
SELECT KU_SCHEM_CD CHTRINH,
    CASE
        WHEN KU_HTHUCVAY = '1' THEN 'Cho vay ngắn hạn'
        ELSE 'Cho vay trung, dài hạn'
    END HT_VAY,
    CASE WHEN KU_LAIHT_TONG > 0 THEN KU_MAKH ELSE NULL END TS_KH_HTLS,
    CASE WHEN KU_LAIHT_TONG > 0 AND KU_LSUAT <= 4 THEN KU_MAKH ELSE NULL END KH_HTLS_FULL,
    CASE WHEN KU_LAIHT_TONG > 0 THEN NVL(KU_DNOTHAN, 0) + NVL(KU_DNOQHAN, 0) + NVL(KU_DNOKHOANH, 0)
    ELSE 0 END TS_DN_HTLS,
    CASE WHEN KU_LAIHT_TONG > 0 AND KU_LSUAT <= 4
            THEN NVL(KU_DNOTHAN, 0) + NVL(KU_DNOQHAN, 0) + NVL(KU_DNOKHOANH, 0)
    ELSE 0 END DN_HTLS_FULL,
   CASE WHEN  KU_LAIHT_TONG > 0 THEN NVL(KU_LAITHAN, 0) + NVL(KU_LAIQHAN, 0) + NVL(KU_LAITONTHAN, 0) + NVL(KU_LAITONQHAN, 0)
   ELSE 0 END LAI_CHUA_HTLS,
   CASE WHEN  KU_LAIHT_TONG > 0 THEN NVL(KU_LAIHT_TONG, 0) - NVL(KU_LAIHT_CHT, 0)
    ELSE 0 END LAI_DA_HTLS
FROM HSKU, DMPOS Y, (SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z
WHERE KU_TTMONVAY <> 'CLOSE' AND KU_NGAYBC = TO_DATE($P{PARA_DENNGAY})
AND KU_MAPGD = Y.PO_MA
AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA)
AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD})
) KU
WHERE SC_MA = CHTRINH
GROUP BY HT_VAY, SC_MA, SC_TEN
ORDER BY HT_VAY, SC_MA]]>
	</queryString>
