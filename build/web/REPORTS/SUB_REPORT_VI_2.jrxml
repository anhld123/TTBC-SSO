<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="SUB_REPORT_VI_2" language="groovy" pageWidth="555" pageHeight="802" columnWidth="555" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_TONGHOP" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_NGAYBC" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT NVL(DN_TK_SBV($P{PARA_NGAYBC},$P{PARA_MAPGD},$P{PARA_TONGHOP},'10','D'),0) A1,
NVL (DN_TK_SBV(ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_MAPGD},$P{PARA_TONGHOP},'10','D'),0) A2,
NVL(DN_TK_SBV($P{PARA_NGAYBC},$P{PARA_MAPGD},$P{PARA_TONGHOP},'11','D'),0) A3,
NVL (DN_TK_SBV(ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_MAPGD},$P{PARA_TONGHOP},'11','D'),0) A4,
(NVL(DN_TK_SBV($P{PARA_NGAYBC},$P{PARA_MAPGD},$P{PARA_TONGHOP},'1311','D'),0)+
NVL(DN_TK_SBV($P{PARA_NGAYBC},$P{PARA_MAPGD},$P{PARA_TONGHOP},'1321','D'),0)) A5,
(NVL (DN_TK_SBV($P{PARA_NGAYBC},$P{PARA_MAPGD},$P{PARA_TONGHOP},'1331','D'),0)+
NVL (DN_TK_SBV(ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_MAPGD},$P{PARA_TONGHOP},'1321','D'),0)) A6
FROM DUAL]]>
	</queryString>
	<field name="A1" class="java.math.BigDecimal"/>
	<field name="A2" class="java.math.BigDecimal"/>
	<field name="A3" class="java.math.BigDecimal"/>
	<field name="A4" class="java.math.BigDecimal"/>
	<field name="A5" class="java.math.BigDecimal"/>
	<field name="A6" class="java.math.BigDecimal"/>
	<variable name="A7" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$F{A1}.add($F{A3}).add($F{A5})]]></variableExpression>
	</variable>
	<variable name="A8" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$F{A2}.add($F{A4}).add($F{A6})]]></variableExpression>
	</variable>
