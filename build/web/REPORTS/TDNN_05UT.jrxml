<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="TDNN_05UT" language="groovy" pageWidth="1010" pageHeight="595" orientation="Landscape" whenNoDataType="NoDataSection" columnWidth="990" leftMargin="10" rightMargin="10" topMargin="10" bottomMargin="10" uuid="e0e1108b-0cdd-453f-a08d-4f011a6b1ba0">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MACN" class="java.lang.String"/>
	<parameter name="PARA_NGAYBC" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false"/>
	<queryString>
		<![CDATA[SELECT   a.macn macn,
         b.ten tencn,
         a.mapgd mapgd,
         c.po_ten tenpgd,
         a.maxa maxa,
         d.ten tenxa,
         sum(a.tong_dn)/1000000  Tongdn,
         sum(a.no_qh)/1000000 dn_qh,
         SUM (CASE WHEN a.dvut = '11' THEN a.tong_dn/1000000 ELSE 0 END) HND_Tongdn_ut,
         SUM (CASE WHEN a.dvut = '12' THEN a.tong_dn/1000000 ELSE 0 END) HPN_Tongdn_ut,
         SUM (CASE WHEN a.dvut = '13' THEN a.tong_dn/1000000 ELSE 0 END) HCCB_Tongdn_ut,
         SUM (CASE WHEN a.dvut = '14' THEN a.tong_dn/1000000 ELSE 0 END) DTN_Tongdn_ut,
         SUM (CASE WHEN a.dvut = '11' THEN a.no_qh/1000000 ELSE 0 END) HND_no_qh,
         SUM (CASE WHEN a.dvut = '12' THEN a.no_qh/1000000 ELSE 0 END) HPN_no_qh,
         SUM (CASE WHEN a.dvut = '13' THEN a.no_qh/1000000 ELSE 0 END) HCCB_no_qh,
         SUM (CASE WHEN a.dvut = '14' THEN a.no_qh/1000000 ELSE 0 END) DTN_no_qh
from
(SELECT dvut_macn macn,
                   dvut_mapgd mapgd,
                   dvut_xa maxa,
                   dvut_dvut dvut,
                   sum (dvut_d7) tong_dn,
                   sum (dvut_d9) no_qh
              FROM BCTD_DVUT
             WHERE     dvut_ngaybc = $P{PARA_NGAYBC}
                   AND dvut_dvut IN ('11',
                                     '12',
                                     '13',
                                     '14')
                  AND decode($P{PARA_MACN},'99',1,substr(dvut_macn,3,2)) = decode($P{PARA_MACN},'99',1,$P{PARA_MACN})
                  AND dvut_macn in ('005720','006101','006220')
          GROUP BY dvut_macn, dvut_mapgd, dvut_xa, dvut_dvut
) a, dmtinh b, dmpos c, dmxa d
where substr(a.macn,3,2) = b.ma and a.mapgd=c.po_ma and A.mapgd = d.pgd_ql and a.maxa=substr(d.ma,5,2)
group by a.macn,b.ten,a.mapgd,c.po_ten,a.maxa,d.ten
order by a.macn,a.mapgd,a.maxa]]>
	</queryString>
