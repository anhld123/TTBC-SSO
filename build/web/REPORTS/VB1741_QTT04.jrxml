	<field name="FULL_ADDRESS" class="java.lang.String"/>
	<field name="TRAN_DT" class="java.sql.Timestamp"/>
	<field name="LEGACY_AC" class="java.lang.String"/>
	<field name="CONTACT" class="java.lang.String"/>
