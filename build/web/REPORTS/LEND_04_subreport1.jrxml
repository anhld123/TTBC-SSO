<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="LEND_04_subreport1" language="groovy" pageWidth="595" pageHeight="842" columnWidth="560" leftMargin="20" rightMargin="15" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<subDataset name="dataset1">
		<parameter name="POS_CD" class="java.lang.String"/>
		<parameter name="PARA_MAPGD" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT B.ADD_CITY PROVINCE ,B.POS_CD POS_CD , B.POS_DESC POS_DESC, TO_CHAR(PC_BUSINESS_DT,'MM') MNTH1 ,
TO_CHAR(LAST_DAY(ADD_MONTHS(PC_BUSINESS_DT,-1)),'DD/MM/YYYY')  BUSDT
,TO_CHAR(PC_BUSINESS_DT,'YYYY') YEAR1 ,MFM_ACC_NO GL_ACC FROM PO850MB B , P_CTRL ,
(SELECT MFM_ACC_NO  FROM M_FIN_MAP WHERE MFM_VARIABLE='EXPENS'
AND ROWNUM < 2)
WHERE B.POS_CD = $P{POS_CD}]]>
		</queryString>
		<field name="PROVINCE" class="java.lang.String"/>
		<field name="POS_CD" class="java.lang.String"/>
		<field name="POS_DESC" class="java.lang.String"/>
		<field name="MNTH1" class="java.lang.String"/>
		<field name="BUSDT" class="java.lang.String"/>
		<field name="YEAR1" class="java.lang.String"/>
		<field name="GL_ACC" class="java.lang.String"/>
	</subDataset>
	<parameter name="PARA_MAPGD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT D.SBT,D.TKNO,D.DESC1,D.TKCO,E.CS_TENTK,D.SOTIEN,D.GHICHU_2,D.MAPGD FROM
(SELECT A.SBT,A.TKNO,B.TK TKCO ,B.SOTIEN,B.GHICHU_2,A.MAPGD,A.DESC1 FROM
HSBT B,
(SELECT DISTINCT SBT,TK TKNO, GHICHU_2,MAPGD,NGAYGD, 'Chi hoa hồng cho tổ vay vốn theo dư nợ' DESC1 FROM
HSBT
 WHERE
 NOCO = 'D'
 AND SUBSTR(TK,1,9) = '931402704'
 AND MAPGD = '003460'
 AND TO_CHAR(NGAYGD,'DD-MON-YYYY') =  $P{PARA_NGAYBC}) A
WHERE
 B.SBT = A.SBT
 AND B.NOCO = 'C'
 AND B.GHICHU_2 = A.GHICHU_2
 AND B.NGAYGD = A.NGAYGD
 AND B.MAPGD = $P{PARA_MAPGD} ) D, CASA E
WHERE D.TKCO = E.CS_SO_TK  AND D.MAPGD = E.CS_MACN
UNION ALL
SELECT D.SBT,D.TKNO,D.DESC1,D.TKCO,E.CS_TENTK,D.SOTIEN,D.GHICHU_2,D.MAPGD FROM
(SELECT A.SBT,A.TKNO,B.TK TKCO ,B.SOTIEN,B.GHICHU_2,A.MAPGD,A.DESC1 FROM
HSBT B,
(SELECT DISTINCT SBT,TK TKNO, GHICHU_2,MAPGD,NGAYGD, 'Chi hoa hồng cho tổ vay vốn theo dư nợ' DESC1 FROM
HSBT
 WHERE
 NOCO = 'D'
 AND SUBSTR(TK,1,9) = '931402704'
 AND MAPGD = '003460'
 AND TO_CHAR(NGAYGD,'DD-MON-YYYY') = $P{PARA_NGAYBC} ) A
WHERE
 B.SBT = A.SBT
 AND B.NOCO = 'C'
 AND B.GHICHU_2 = A.GHICHU_2
 AND B.NGAYGD = A.NGAYGD
 AND B.MAPGD =  $P{PARA_MAPGD}) D, CASA E
WHERE D.TKCO = E.CS_SO_TK  AND D.MAPGD = E.CS_MACN]]>
	</queryString>
	<field name="SBT" class="java.lang.String"/>
	<field name="TKNO" class="java.lang.String"/>
	<field name="DESC1" class="java.lang.String"/>
	<field name="TKCO" class="java.lang.String"/>
	<field name="CS_TENTK" class="java.lang.String"/>
	<field name="SOTIEN" class="java.math.BigDecimal"/>
	<field name="GHICHU_2" class="java.lang.String"/>
	<field name="MAPGD" class="java.lang.String"/>
	<variable name="SOTIEN" class="java.math.BigDecimal" resetType="Group" resetGroup="TKNO" calculation="Sum">
		<variableExpression><![CDATA[$F{SOTIEN}]]></variableExpression>
	</variable>
	<variable name="SOTIEN_TOT" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{SOTIEN}]]></variableExpression>
	</variable>
	<variable name="GRP_COUNT" class="java.lang.Integer" incrementType="Group" incrementGroup="TKNO" calculation="Count">
		<variableExpression><![CDATA[$V{GRP_COUNT}++]]></variableExpression>
		<initialValueExpression><![CDATA[1]]></initialValueExpression>
	</variable>
