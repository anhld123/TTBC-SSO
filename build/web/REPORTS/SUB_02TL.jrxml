	<parameter name="PARA_DENNGAY" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_MAPGD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_TONGHOP" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_KY" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_COT10" class="java.math.BigDecimal"/>
	<parameter name="PARA_THANG" class="java.math.BigDecimal"/>
	<queryString language="plsql">
		<![CDATA[{call  SUB_02TL_LUAN_GOP_2($P{PARA_MAPGD},$P{PARA_TONGHOP},$P{PARA_DENNGAY},$P{PARA_KY},$P{PARA_COT10},$P{PARA_THANG},$P{ORACLE_REF_CURSOR})}]]>
	</queryString>
	<field name="MAPGD_1" class="java.lang.String"/>
	<field name="PHI_SDTW" class="java.math.BigDecimal"/>
	<field name="DNBQ_NAM" class="java.math.BigDecimal"/>
	<field name="GL_CAN_DOI" class="java.math.BigDecimal"/>
	<field name="LS_BQ" class="java.math.BigDecimal"/>
	<field name="thang" class="java.math.BigDecimal"/>
	<field name="GT_COT10" class="java.math.BigDecimal"/>
	<variable name="gt_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[(($F{GT_COT10}/$F{thang})*0.0336*$F{thang})/12]]></variableExpression>
	</variable>
	<variable name="gt_2" class="java.math.BigDecimal">
		<variableExpression><![CDATA[$F{DNBQ_NAM}*$F{thang}/12 - (($F{GL_CAN_DOI}/($F{LS_BQ}*$F{thang}))*0.03)*($F{thang}/12)]]></variableExpression>
	</variable>
	<variable name="TONG_GT" class="java.math.BigDecimal">
		<variableExpression><![CDATA[($V{gt_1}.round( java.math.MathContext.DECIMAL32 ) + $V{gt_2}.round( java.math.MathContext.DECIMAL32 )).round( java.math.MathContext.DECIMAL32 )]]></variableExpression>
	</variable>
