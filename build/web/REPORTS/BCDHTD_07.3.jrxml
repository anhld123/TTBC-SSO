<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="BCTD_03.9" language="groovy" pageWidth="630" pageHeight="880" orientation="Landscape" columnWidth="590" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_DENNGAY" class="java.lang.String"/>
	<parameter name="PARA_MAPGD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_TONGHOP" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT
Case when (SUBSTR(MOTA,1,1) = '1') AND (SUBSTR(MOTA,2,1) = 'A') then 'Theo đối tượng thụ hưởng'
        when (SUBSTR(MOTA,1,1) = '1') AND (SUBSTR(MOTA,2,1) = 'B') then 'Theo phương thức vay vốn'
End AS SUB_CT,
MOTA,GIATRI CHITIEU, THUTU STT,SUBSTR(MOTA,2,1) STT_SUB,
NVL(sum(CTDT_D1)/1000000,0) DS_NODH,
NVL(sum(CTDT_D2)/1000000,0) TNODH_THANG,
NVL(sum(CTDT_D3),0) SOHSSV_GN,
NVL(sum(CTDT_D4),0) SOHSSV_GNLD,
NVL(sum(CTDT_D5),0) SOHSSV_TT,
NVL(sum(CTDT_D6),0) SOHSSV_DNO
FROM DMKHAC A, BCTD_CTDT, DMPOS Y,(SELECT PO_POSFLG, PO_MACN, PO_MA FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) Z
WHERE KHOA_1 = '44' and MOTA like '1%'
AND SUBSTR(CTDT_CODE,4,2) = A.KHOA_2
AND CTDT_MAPGD = Y.PO_MA
AND DECODE(Z.PO_POSFLG,'H',1,'S',Y.PO_MA , Y.PO_MACN) = DECODE(Z.PO_POSFLG,'H',1,Z.PO_MA)
AND DECODE('Y',$P{PARA_TONGHOP},1,Y.PO_MA) = DECODE('Y',$P{PARA_TONGHOP},1,$P{PARA_MAPGD})
AND  CTDT_NGAYBC = TO_DATE ($P{PARA_DENNGAY})
GROUP BY  MOTA,GIATRI,THUTU,SUBSTR(MOTA,2,1)
ORDER BY MOTA, THUTU]]>
	</queryString>
