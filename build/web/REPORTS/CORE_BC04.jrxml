	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["D:\\PCBC\\REPORT CSDL TG\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT PO_TEN,PO_MA POS_CD, TO_DATE ($P{PARA_NGAYBC},'DD-MON-YYYY') EOD_DT, IU_MA USER_DESC, '9100017046' AC_NO,
            $P{PARA_LOAITIEN} SWIFT_CD,'Tiền mặt tại teller 01' AC_DESC
        FROM DMPOS, I_USER
            WHERE PO_MA = $P{PARA_MAPGD}
                  AND PO_MA = IU_MAPGD
                 AND IU_MA = $P{PARA_GDVIEN}]]>
	</queryString>
