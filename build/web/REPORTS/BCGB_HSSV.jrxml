<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="BCGB_HSSV" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="802" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="0.8264462809917354"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="5"/>
	<parameter name="para_denngay" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="para_trinhdodt" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[---------MAU_1
SELECT vungkt, DECODE (
                      vungkt,
                      '01', 'ÐỒNG BẰNG SÔNG HỒNG',
                      '02', 'ÐÔNG BẮC',
                      '03', 'TÂY BẮC',
                      '04', 'BAC TRUNG BỘ',
                      '05', 'DUYÊN HẢI MIỀN TRUNG',
                      '06', 'TÂY NGUYÊN',
                      '07', 'ÐÔNG NAM BỘ',
                      '08', 'ÐỒNG BẰNG SÔNG CỬU LONG') TENVUNG,
A.MA_CN,TEN,ROUND(SUM(KHPT)/1000000,2) KE_HOACH,
ROUND(( SUM(A.AN_HAN) + SUM(A.GIA_HAN) +  SUM(QUA_HAN) + SUM(A.DUNG_PKY) + SUM(A.TRUOC_PKY) + SUM(A.KYCON_KYCUOI) + SUM(A.KYCUOI))/1000000,2) TONG,
ROUND(SUM(TONG_LAI)/1000000,2) THUC,
 ROUND(SUM(A.AN_HAN)/1000000,2) AN_HAN,
ROUND(SUM(A.GIA_HAN)/1000000,2) GIA_HAN,ROUND(SUM(QUA_HAN)/1000000,2) QUA_HAN,
ROUND(SUM(A.DUNG_PKY)/1000000,2) DUNG_PKY,ROUND(SUM(A.TRUOC_PKY)/1000000,2) TRUOC_PKY,
ROUND(SUM(A.KYCON_KYCUOI)/1000000,2) KYCON_KYCUOI, ROUND(SUM(A.KYCUOI)/1000000,2) KYCUOI FROM
DLGB_HSSV A, PO850MB D,dmtinh
WHERE  A.MA_CN = D.MAIN_POS
and MA = SUBSTR(A.MA_CN,3,2)
and NGAY_BC = $P{para_denngay}
AND POS_FLAG ='M'
and tddt = $P{para_trinhdodt}
group by vungkt, DECODE (
                      vungkt,
                      '01', 'ÐỒNG BẰNG SÔNG HỒNG',
                      '02', 'ÐÔNG BẮC',
                      '03', 'TÂY BẮC',
                      '04', 'BAC TRUNG BỘ',
                      '05', 'DUYÊN HẢI MIỀN TRUNG',
                      '06', 'TÂY NGUYÊN',
                      '07', 'ÐÔNG NAM BỘ',
                      '08', 'ÐỒNG BẰNG SÔNG CỬU LONG') ,
A.MA_CN,TEN
ORDER BY 1,3]]>
	</queryString>
