					<textFieldExpression><![CDATA[" BÁO CÁO DƯ NỢ CÁC CHƯƠNG TRÌNH TÍN DỤNG VÀ NGUỒN VỐN UTĐT ĐỊA PHƯƠNG TẠI CHI NHÁNH: " + $F{TENCN}.toUpperCase()]]></textFieldExpression>
