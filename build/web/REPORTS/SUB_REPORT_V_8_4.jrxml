					<font fontName="Times New Roman" size="11" isBold="true" isItalic="true" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[14.3. Dự phòng rủi ro các tài sản Có nội bảng khác: NHCSXH không có]]></text>
