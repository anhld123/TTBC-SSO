<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="SUB_REPORT_V_8_4" language="groovy" pageWidth="554" pageHeight="802" columnWidth="554" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_TONGHOP" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_NGAYBC" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT b1,NVL(C1,0) C1,NVL(C2,0) C2,ABS(C1) C1_ABS,ABS(C2) C2_ABS,ABS(C1) C1_ABS,ABS(C2) C2_ABS FROM
(select 'Các khoản phải thu nội bộ' b1,
DN_TK_SBV ($P{PARA_NGAYBC},$P{PARA_MAPGD},$P{PARA_TONGHOP},'36','D') C1,
DN_TK_SBV (ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_MAPGD},$P{PARA_TONGHOP},'36','D') C2 from dual
union
select 'Các khoản phải thu bên ngoài' b1,
DN_TK_SBV ($P{PARA_NGAYBC},$P{PARA_MAPGD},$P{PARA_TONGHOP},'35','D') C1,
DN_TK_SBV (ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_MAPGD},$P{PARA_TONGHOP},'35','D') C2 from dual)]]>
	</queryString>
	<field name="B1" class="java.lang.String"/>
	<field name="C1" class="java.math.BigDecimal"/>
	<field name="C2" class="java.math.BigDecimal"/>
	<field name="C1_ABS" class="java.math.BigDecimal"/>
	<field name="C2_ABS" class="java.math.BigDecimal"/>
	<variable name="C1_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{C1}]]></variableExpression>
	</variable>
	<variable name="C2_2" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{C2}]]></variableExpression>
	</variable>
	<background>
		<band splitType="Stretch"/>
	</background>
