				<text><![CDATA[Tổng]]></text>
			</staticText>
			<textField pattern="#,##0">
				<reportElement x="336" y="1" width="98" height="20"/>
				<box rightPadding="3"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="9" isBold="true" pdfEncoding="Identity-H"/>
				</textElement>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{C1_1}<0? $V{C1_1}* (-1):$V{C1_1}]]></textFieldExpression>
			</textField>
			<textField pattern="#,##0">
				<reportElement x="434" y="1" width="93" height="20"/>
				<box rightPadding="3"/>
				<textElement textAlignment="Right" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="9" isBold="true" pdfEncoding="Identity-H"/>
				</textElement>
				<textFieldExpression class="java.math.BigDecimal"><![CDATA[$V{C2_2}<0? $V{C2_2}* (-1):$V{C2_2}]]></textFieldExpression>
			</textField>
			<staticText>
				<reportElement x="0" y="21" width="527" height="20"/>
