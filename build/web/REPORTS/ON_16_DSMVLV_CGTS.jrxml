<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ON_16_DSMVLV-CGTS" language="groovy" pageWidth="595" pageHeight="900" orientation="Landscape" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_MAPGD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select distinct TO_DATE('06-MAY-2014' ,'DD-MON-YYYY') ROLLOVER_DATE, b.KH_TENKH CUSTOMER_NAME,KU_SOKU LOAN_ID,  SUBSTR(SP_TEN,1,INSTR(SP_TEN,'-',1)-1) LOAN_PRODUCT,KU_M_LUUVU ROLLOVER_PRIN
    from hsku a, hskh b, DM_SPRODUCT c
    where a.KU_MAKH = b.KH_MAKH and a.KU_MAPGD = b.KH_MAPGD
    and a.KU_PROD_CD = C.SP_PRD and a.KU_SPRD_CD = c.sp_ma
    and KU_TTMONVAY = 'OPEN'
    AND NOT EXISTS (SELECT 'X' FROM tsdb F WHERE KU_SOKU = F.TS_SOKU and KU_MAPGD = F.TS_MAPGD )
--    AND  '06-MAY-2014' >= (SELECT ADD_MONTHS(PC_BUSINESS_DT,-2) FROM P_CTRL)
    and a.KU_MAPGD = $P{PARA_MAPGD}
    and KU_M_LUUVU > 0
    order by b.KH_TENKH, KU_SOKU]]>
	</queryString>
	<field name="ROLLOVER_DATE" class="java.sql.Timestamp"/>
	<field name="CUSTOMER_NAME" class="java.lang.String"/>
	<field name="LOAN_ID" class="java.lang.String"/>
	<field name="LOAN_PRODUCT" class="java.lang.String"/>
	<field name="ROLLOVER_PRIN" class="java.math.BigDecimal"/>
	<variable name="TOT_ROLLOVER_PRIN" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{ROLLOVER_PRIN}]]></variableExpression>
	</variable>
