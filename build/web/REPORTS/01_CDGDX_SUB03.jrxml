			<staticText>
				<reportElement uuid="96fd7224-c47d-4e17-bac2-caee6f8a2296" x="102" y="518" width="369" height="104"/>
				<box>
					<pen lineWidth="0.25"/>
					<topPen lineWidth="0.0"/>
					<leftPen lineWidth="0.25"/>
					<bottomPen lineWidth="0.25"/>
					<rightPen lineWidth="0.25"/>
				</box>
				<textElement verticalAlignment="Middle">
					<font fontName="Times New Roman" size="12" isBold="false" pdfEncoding="Identity-H"/>
					<paragraph leftIndent="5"/>
				</textElement>
				<text><![CDATA[- Tổ chức họp giao ban đầy đủ các thành phần tham gia, nội dung họp đúng quy định.
- Vi phạm: (Trừ tối đa 4 điểm).
+ Không tổ chức họp giao ban: 0 điểm.
+ Cứ thiếu một Tổ chức Hội, đoàn thể nhận ủy thác cấp xã hoặc nội dung giao ban không đúng quy định trừ 1 điểm/lỗi vi phạm; Cứ thiếu 01 Tổ TK&VV trừ 0,2 điểm.]]></text>
