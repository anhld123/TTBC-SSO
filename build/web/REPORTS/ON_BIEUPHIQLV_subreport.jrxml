<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="ON_BIEUPHIQLV_subreport" language="groovy" pageWidth="842" pageHeight="595" orientation="Landscape" columnWidth="784" leftMargin="38" rightMargin="20" topMargin="20" bottomMargin="20">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="PARA_DVUT" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT E.MASS_ORG,E.MACN, F.TEN, E.TOT_FEES_AMOUNT_QLV120, E.TOT_FEES_AMOUNT_QLV, E.FFOD_MONTH, H.PCD_DESC
  FROM
              (SELECT MASS_ORG,MACN,SUM(TOT_FEES_AMOUNT_QLV120) TOT_FEES_AMOUNT_QLV120 ,SUM(TOT_FEES_AMOUNT_QLV)  TOT_FEES_AMOUNT_QLV, FFOD_MONTH
              FROM
                         (SELECT  B.MASS_ORG,
                                D.macn,
                                SUM (B.  TOT_FEES_AMOUNT_QLV)    TOT_FEES_AMOUNT_QLV120,
                                0   TOT_FEES_AMOUNT_QLV,
                                B.FFOD_MONTH
                            FROM  READONLY.NGUYETLM_PHIQLV120 B,
                                 (select POS_CD, main_pos, substr(main_pos,3,2) as macn, substr(ADD_CITY,23) as ten from  intellect.po850mb where substr(main_pos,3,2) not in ('01', '03','06','45','34','99')  union all
                                select POS_CD, main_pos, substr(main_pos,3,2) as macn, substr(ADD_CITY,28) as ten from  intellect.po850mb where substr(main_pos,3,2)  in ('03','06','45','34')  and pos_cd not in ('000630') union all
                                select POS_CD, main_pos, substr(main_pos,3,2) as macn, substr(ADD_CITY,5)  as ten from  intellect.po850mb where substr(main_pos,3,2)  in ('06') and pos_cd in ('000630')) D
                           WHERE   B.POS_CD = D.POS_CD
                          GROUP BY B.MASS_ORG,D.macn, B.FFOD_MONTH
                          UNION ALL
                          SELECT  C.MASS_ORG,
                                D.macn,
                                0    TOT_FEES_AMOUNT_QLV120,
                                SUM(TOT_FEES_AMOUNT_QLV)  TOT_FEES_AMOUNT_QLV,
                                C.FFOD_MONTH
                            FROM   READONLY.NGUYETLM_PHIQLV_KHAC120 C,
                                 (select POS_CD, main_pos, substr(main_pos,3,2) as macn, substr(ADD_CITY,23) as ten from  intellect.po850mb where substr(main_pos,3,2) not in ('01', '03','06','45','34','99')  union all
                                select POS_CD, main_pos, substr(main_pos,3,2) as macn, substr(ADD_CITY,28) as ten from  intellect.po850mb where substr(main_pos,3,2)  in ('03','06','45','34')  and pos_cd not in ('000630') union all
                                select POS_CD, main_pos, substr(main_pos,3,2) as macn, substr(ADD_CITY,5)  as ten from  intellect.po850mb where substr(main_pos,3,2)  in ('06') and pos_cd in ('000630')) D
                           WHERE  C.POS_CD = D.POS_CD
                           GROUP BY C.MASS_ORG,D.macn, C.FFOD_MONTH)

                           GROUP BY MASS_ORG,MACN, FFOD_MONTH)  E,
                           (select  pos_cd,main_pos, substr(main_pos,3,2) as macn, substr(ADD_CITY,23) as ten from  intellect.po850mb where substr(main_pos,3,2) not in ('01', '03','06','45','34','99') and POS_FLAG='M'   union all
                            select  pos_cd,main_pos, substr(main_pos,3,2) as macn, substr(ADD_CITY,28) as ten from  intellect.po850mb where substr(main_pos,3,2)  in ('03','06','45','34')  and pos_cd not in ('000630') and POS_FLAG='M'  union all
                            select  pos_cd,main_pos, substr(main_pos,3,2) as macn, substr(ADD_CITY,5)  as ten from  intellect.po850mb where substr(main_pos,3,2)   in ('06') and pos_cd in ('000630') and POS_FLAG='M') F,
                            (SELECT pcd_cd,pcd_desc FROM intellect.P_TYPE_CODES WHERE pcd_type_cd = 'FNDMGR' and pcd_cd not in ('11','12','13','14')) H
    WHERE E.MACN=F.MACN AND E.MASS_ORG=H.PCD_CD AND (E.TOT_FEES_AMOUNT_QLV120 > 0 or E.TOT_FEES_AMOUNT_QLV > 0) and  E.MASS_ORG=$P{PARA_DVUT} ORDER BY MASS_ORG,MACN]]>
	</queryString>
	<field name="MASS_ORG" class="java.lang.String"/>
	<field name="MACN" class="java.lang.String"/>
	<field name="TEN" class="java.lang.String"/>
	<field name="TOT_FEES_AMOUNT_QLV120" class="java.math.BigDecimal"/>
	<field name="TOT_FEES_AMOUNT_QLV" class="java.math.BigDecimal"/>
	<field name="FFOD_MONTH" class="java.sql.Timestamp"/>
	<field name="PCD_DESC" class="java.lang.String"/>
	<variable name="TOT_FEES_AMOUNT_QLV120_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TOT_FEES_AMOUNT_QLV120}]]></variableExpression>
	</variable>
	<variable name="TOT_FEES_AMOUNT_QLV_2" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TOT_FEES_AMOUNT_QLV}]]></variableExpression>
	</variable>
	<variable name="TOT_FEES_AMOUNT_QLV120_2" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TOT_FEES_AMOUNT_QLV120}]]></variableExpression>
	</variable>
	<variable name="TOT_FEES_AMOUNT_QLV_1" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TOT_FEES_AMOUNT_QLV}]]></variableExpression>
	</variable>
	<variable name="TOT_FEES_AMOUNT_QLV120_3" class="java.math.BigDecimal" calculation="Sum">
		<variableExpression><![CDATA[$F{TOT_FEES_AMOUNT_QLV120}]]></variableExpression>
	</variable>
