	<parameter name="PARA_MAPGD" class="java.lang.String"/>
	<parameter name="PARA_MAXA" class="java.lang.String"/>
	<parameter name="PARA_DENNGAY" class="java.lang.String"/>
	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["F:\\Trang's work\\2014\\04.2014\\Thiet ke report_TTBC tuong lai\\REPORTS\\"]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT  A.MAKH MAKH,
	    KH_TENKH TENKH,
	    A.SOKU SOKU,
	    KU_MATO MATO,
	    TO_TENTT TENTT,
	    SUBSTR(TO_MADP, 1, 6) MAXA,
	    D.TEN TENXA,
	    SUBSTR(TO_MAPGD, 3, 4) MAHUYEN,
	    TRIM(C.TEN) TENHUYEN,
	    TO_CHAR(KU_NGAYVAY,'DD/MM/YYYY') NGAYVAY,
	    TO_CHAR(KU_NGAYDHAN_1,'DD/MM/YYYY') NGAYDHANCU,
	    TO_CHAR(KU_NGAYDHAN_2,'DD/MM/YYYY') NGAYDHANMOI,
	    KU_SCHEM_CD SCHEM_CD,
	    B.SC_TENVT CHTRINH,
	    TO_CHAR(KU_NGAYCNQH,'DD/MM/YYYY') NGAYCNQH,
	    KU_GNGAN GNGAN,
		TO_CHAR(GH_NGAY,'DD/MM/YYYY') GH_NGAY,
		GH_SOTHG,
		GH_LAN,
	    A.GH_SOTIEN GHANNO,
	    KU_DNOTHAN+KU_DNOQHAN+KU_DNOKHOANH DUNO
   FROM (select * from hsgh_history where mapgd=$P{PARA_MAPGD}
			and SUBSTR(TO_CHAR(GH_NGAY, 'DD-MM-YYYY'),4,7) = SUBSTR(TO_CHAR(to_date($P{PARA_DENNGAY}),'DD-MM-YYYY'),4,7) ) a,
	    (SELECT * FROM HSKU WHERE KU_MAPGD = $P{PARA_MAPGD}
			AND KU_DNOTHAN+KU_DNOQHAN+KU_DNOKHOANH >0
			AND KU_PROD_CD NOT IN ('P00A01', 'P00A02')
			AND TRUNC (KU_NGAYBC) = TO_DATE ($P{PARA_DENNGAY})) HSKU,
		(SELECT * FROM HSTO WHERE TO_MAPGD = $P{PARA_MAPGD}) hsto,
	    hskh,
	    DM_SCHEME B,
	    DMHUYEN C,
	    DMXA D
   WHERE A.SOKU = KU_SOKU
		AND TO_MADP like D.MA||'%'
		AND TO_MAPGD like '%'|| C.MA
	    AND KU_SCHEM_CD = B.SC_MA
	    AND KU_MAKH = KH_MAKH
	    AND KU_MATO = TO_MATO
	    AND DECODE($P{PARA_MAXA},'000000','1',SUBSTR(TO_MADP, 1, 6))
	        = DECODE($P{PARA_MAXA},'000000','1',SUBSTR($P{PARA_MAXA}, 1, 6))
	ORDER BY SUBSTR(TO_MADP, 1, 6), KU_MATO, A.MAKH, A.SOKU, GH_LAN]]>
	</queryString>
