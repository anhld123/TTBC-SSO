	<queryString>
		<![CDATA[select a.pos_cd,
(SELECT po_ten FROM dmpos WHERE po_ma = pos_cd) pos_name,
a.group_id mato,a.total_mark diem,a.descript xeploai,b.to_tentt tento,b.to_dvut dvut,
(select x.ten xa FROM dmxa x,dmthon y WHERE y.ma = b.to_madp AND y.xa = x.ma) tenxa ,
(Select giatri  from dmkhac where khoa_1 = '17' and khoa_2 = TO_DVUT) tentch
from DG_GROUP_MARK A, hsto B
where a.group_id = b.TO_MATO
and b.trangthai = 'A'
and pos_cd = $P{POS_CD}
and REPORT_DT = $P{EOD_DATE}
order by pos_cd,to_dvut,GROUP_ID]]>
	</queryString>
