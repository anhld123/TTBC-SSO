<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="mainpos_subpos_bctuct_sua" language="groovy" pageWidth="250" pageHeight="842" columnWidth="250" leftMargin="0" rightMargin="0" topMargin="0" bottomMargin="0" uuid="191be967-d577-4d66-889b-9781f6e64baa">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="POS_CD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_CAPBC" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_MACN" class="java.lang.String"/>
	<queryString>
		<![CDATA[select pos_desc, add_city, $P{PARA_CAPBC} CAP_BC from po850mb
where POS_CD =
case when $P{PARA_CAPBC} = 1 then $P{POS_CD}
     when $P{PARA_CAPBC} = 2 and $P{POS_CD} is null then $P{PARA_MACN}
     when $P{PARA_CAPBC} = 2 and $P{POS_CD} is not null then $P{POS_CD}
     when $P{PARA_CAPBC} = 3 and $P{PARA_MACN} is null then '000100'
     when $P{PARA_CAPBC} = 3 and $P{PARA_MACN} is not null then $P{PARA_MACN} end]]>
	</queryString>
	<field name="POS_DESC" class="java.lang.String"/>
	<field name="ADD_CITY" class="java.lang.String"/>
	<field name="CAP_BC" class="java.lang.String"/>
	<background>
		<band splitType="Stretch"/>
	</background>
	<title>
		<band height="42" splitType="Stretch">
			<textField>
				<reportElement uuid="e994f4ad-f31d-4822-a7e9-eba471943f08" x="0" y="21" width="249" height="17"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="10" isBold="true" pdfEncoding="Identity-H"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{CAP_BC} == '1' ? $F{POS_DESC}.toUpperCase() : $F{CAP_BC} == '2' && $P{POS_CD} != "" ? $F{POS_DESC}.toUpperCase() : $F{CAP_BC} == '2' && $P{POS_CD} == "" ? $F{ADD_CITY}.toUpperCase() : $F{CAP_BC} == '2' && $P{POS_CD} != "" ? $F{ADD_CITY}.toUpperCase() : $F{CAP_BC} == '3' && $P{PARA_MACN} == "" ? "":$F{ADD_CITY}.toUpperCase()]]></textFieldExpression>
			</textField>
			<textField>
				<reportElement uuid="d6ea4336-f04d-49d1-94d3-bc86e45fe2fa" x="1" y="1" width="249" height="17"/>
				<textElement textAlignment="Center" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" isBold="true" pdfEncoding="Identity-H"/>
				</textElement>
				<textFieldExpression><![CDATA[$F{CAP_BC} == '3' ? "NGÂN HÀNG CHÍNH SÁCH XÃ HỘI VIỆT NAM" : $F{CAP_BC} == '2' && $P{POS_CD} == "" ? "NGÂN HÀNG CHÍNH SÁCH XÃ HỘI VIỆT NAM" : $F{CAP_BC} == '2' && $P{POS_CD} != "" ? $F{ADD_CITY}.toUpperCase():$F{CAP_BC} == '1' ? $F{ADD_CITY}.toUpperCase():""]]></textFieldExpression>
			</textField>
		</band>
	</title>
</jasperReport>
