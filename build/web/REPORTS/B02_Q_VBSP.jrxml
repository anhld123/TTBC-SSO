	<queryString>
		<![CDATA[SELECT TO_CHAR (TO_DATE($P{PARA_NGAYBC},'dd-mon-yyyy'), 'DD') AS SEP_DATE,
       TO_CHAR (TO_DATE($P{PARA_NGAYBC},'dd-mon-yyyy'), 'MM') AS SEP_MON,
       TO_CHAR (TO_DATE($P{PARA_NGAYBC},'dd-mon-yyyy'), 'YYYY') AS SEP_YEAR,
VBSP_PUBLIC_FUNCTION.F_GET_QUATER($P{PARA_NGAYBC}) SEP_QUATER,
DECODE($P{PARA_MAPGD},'000100','Hội sở chính',(SELECT PO_TEN FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD})) POS_DESC,
(SELECT PO_DIACHI FROM DMPOS WHERE PO_MA = $P{PARA_MAPGD}) POS_LOCATION
  FROM DUAL]]>
	</queryString>
