	<parameter name="SUBREPORT_DIR" class="java.lang.String" isForPrompting="false">
		<defaultValueExpression><![CDATA["D:\\1. Working\\Chung tu\\16NHNN\\"]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_MAPGD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_TONGHOP" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_NGAYBC" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[select 1, '1. Các loại thuế khác' a,
NVL(DN_TK_SBV(ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_MAPGD},$P{PARA_TONGHOP},'4538','P'),0) b,
NVL (FUNC_TOT_CR_DR_AMT('4538',$P{PARA_MAPGD},$P{PARA_TONGHOP},ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_NGAYBC},'FCY','D',1), 0) c,
NVL (FUNC_TOT_CR_DR_AMT('4538',$P{PARA_MAPGD},$P{PARA_TONGHOP},ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_NGAYBC},'FCY','C',1), 0) d,
NVL(DN_TK_SBV($P{PARA_NGAYBC},$P{PARA_MAPGD},$P{PARA_TONGHOP},'4538','P'),0) e from dual
union
select 1, '2. Các khoản phí, lệ phí và các khoản phải nộp khác' a,
NVL(DN_TK_SBV(ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_MAPGD},$P{PARA_TONGHOP},'4539','P'),0) b,
NVL (FUNC_TOT_CR_DR_AMT('4539',$P{PARA_MAPGD},$P{PARA_TONGHOP},ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_NGAYBC},'FCY','D',1), 0) c,
NVL (FUNC_TOT_CR_DR_AMT('4539',$P{PARA_MAPGD},$P{PARA_TONGHOP},ADD_MONTHS($P{PARA_NGAYBC},-12),$P{PARA_NGAYBC},'FCY','C',1), 0) d,
NVL(DN_TK_SBV($P{PARA_NGAYBC},$P{PARA_MAPGD},$P{PARA_TONGHOP},'4539','P'),0) e from dual]]>
	</queryString>
