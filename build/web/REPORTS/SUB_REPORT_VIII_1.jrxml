	<summary>
		<band height="212" splitType="Stretch">
			<staticText>
				<reportElement x="0" y="22" width="554" height="20"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" isBold="true" isItalic="false" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[38. Loại hình và giá trị tài sản thế chấp của khách hàng]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="43" width="554" height="20"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" isBold="true" isItalic="false" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[39. Nghĩa vụ nợ tiềm ẩn và các cam kết đưa ra: NHCSXH không có]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="124" width="554" height="20"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" isBold="true" isItalic="false" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[43. Các sự kiện sau ngày lập bảng CĐKT: Các TCTD thuyết minh các sự kiện trọng yếu.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="145" width="554" height="30"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" isBold="true" isItalic="false" pdfEncoding="Identity-H"/>
					<paragraph lineSpacing="Proportional" lineSpacingSize="1.2"/>
				</textElement>
				<text><![CDATA[44. Mức độ tập trung theo khu vực địa lý của các tài sản, công nợ và các khoản mục ngoại bảng: NHCSXH chưa thực hiện quản lý tài sản, công nợ và các khoản mục ngoại bảng tập trung theo khu vực địa lý.]]></text>
			</staticText>
			<staticText>
				<reportElement x="8" y="4" width="539" height="18"/>
				<textElement>
					<font fontName="Times New Roman" size="11" isBold="false" isItalic="false" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[NHCSXH hoạt động không vì mục đích lợi nhuận, được miễn thuế và các khoản nộp phải nộp Ngân sách Nhà nước.]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="103" width="554" height="20"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" isBold="true" isItalic="false" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[42. Giao dịch với các bên liên quan: NHCSXH không có]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="63" width="554" height="20"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" isBold="true" isItalic="false" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[40. Hoạt động uỷ thác và đại lý TCTD không chịu rủi ro: NHCSXH không có]]></text>
			</staticText>
			<staticText>
				<reportElement x="0" y="83" width="554" height="20"/>
				<textElement textAlignment="Justified" verticalAlignment="Middle">
					<font fontName="Times New Roman" size="11" isBold="true" isItalic="false" pdfEncoding="Identity-H"/>
				</textElement>
				<text><![CDATA[41. Các hoạt động ngoại bảng khác mà TCTD phải chịu rủi ro đáng kể: NHCSXH không có]]></text>
			</staticText>
