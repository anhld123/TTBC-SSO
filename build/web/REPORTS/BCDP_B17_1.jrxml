	<subDataset name="dataset1" uuid="18c6edc2-446c-4883-80c3-577aa4ef1641">
		<parameter name="POS_CD" class="java.lang.String"/>
		<parameter name="PARA_NGAYBC" class="java.lang.String"/>
		<queryString>
			<![CDATA[SELECT ADD_CITY PROVINCE ,POS_CD HEAD_POS , POS_DESC POS_DESC ,TO_CHAR( $P{PARA_NGAYBC},'DD/MM/YYYY') NGA_BC, TO_CHAR(LAST_DAY(ADD_MONTHS(PC_BUSINESS_DT,-1)),'DD/MM/YYYY') BUSDT FROM PO850MB , P_CTRL
WHERE  POS_CD = $P{POS_CD}]]>
		</queryString>
		<field name="PROVINCE" class="java.lang.String"/>
		<field name="HEAD_POS" class="java.lang.String"/>
		<field name="POS_DESC" class="java.lang.String"/>
		<field name="NGA_BC" class="java.lang.String"/>
		<field name="BUSDT" class="java.lang.String"/>
	</subDataset>
	<subDataset name="dataset2" uuid="0481cd86-f315-4b97-ae53-138249373523">
		<queryString>
			<![CDATA[select]]>
		</queryString>
	</subDataset>
	<subDataset name="dataset3" uuid="129c9e1c-1293-490b-873c-fb26cad83606">
		<queryString>
			<![CDATA[select * from dmkhac where khoa_1 = '17' and KHOA_2 in (11,12,13,14)]]>
		</queryString>
		<field name="STT" class="java.math.BigDecimal"/>
		<field name="KHOA_1" class="java.lang.String"/>
		<field name="KHOA_2" class="java.lang.String"/>
		<field name="GIATRI" class="java.lang.String"/>
		<field name="MOTA" class="java.lang.String"/>
		<field name="THUTU" class="java.math.BigDecimal"/>
		<field name="TRANGTHAI" class="java.lang.String"/>
	</subDataset>
	<parameter name="PARA_MAPGD" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="PARA_NGAYBC" class="java.lang.String"/>
	<parameter name="PARA_TONGHOP" class="java.lang.String"/>
	<queryString>
		<![CDATA[select
DSE,
UT_HUYEN,
D.POS_DESC TENHUYEN,
UT_DVUT,
UT_TONGTIEN,
UT_TONGPHIUT,
UT_UTXA,
UT_UTHUYEN,
UT_UTTINH,
UT_UTTW,
UT_MAPGD,
case when UT_DVUT = '11' then 'Hội Nông Dân'
       when UT_DVUT = '12' then 'Hội phụ nữ'
       when UT_DVUT = '13' then 'Hội cựu chiến Binh'
       when UT_DVUT = '14' then 'Ðoàn Thanh Niên'
end as ten_dvut
 from (
select   'Dư nợ bình quân' DSE ,UT_DVUT,UT_HUYEN,UT_MAPGD,sum(UT_TONGTIEN)  UT_TONGTIEN, sum(UT_TONGPHIUT) UT_TONGPHIUT,sum(UT_UTXA) UT_UTXA,sum(UT_UTHUYEN) UT_UTHUYEN,sum(UT_UTTINH) UT_UTTINH, sum(UT_UTTW) UT_UTTW
from PHIUT
where
UT_FLAG = '2'
AND DECODE($P{PARA_TONGHOP},'Y',SUBSTR(UT_MAPGD,3,2),SUBSTR(UT_MAPGD,3,4))
            = DECODE($P{PARA_TONGHOP},'Y',SUBSTR($P{PARA_MAPGD},3,2),SUBSTR($P{PARA_MAPGD},3,4))
and TRUNC(UT_NGAYBC)= TRUNC(TO_DATE($P{PARA_NGAYBC},'DD-MON-YYYY')) group by UT_DVUT,UT_HUYEN,UT_MAPGD
union all
select   'Lãi Thực thu' DSE ,UT_DVUT,UT_HUYEN,UT_MAPGD,sum(UT_TONGTIEN)  UT_TONGTIEN, sum(UT_TONGPHIUT) UT_TONGPHIUT,sum(UT_UTXA) UT_UTXA,sum(UT_UTHUYEN) UT_UTHUYEN,sum(UT_UTTINH) UT_UTTINH, sum(UT_UTTW) UT_UTTW
from PHIUT
where
UT_FLAG in ( '1','3')
AND DECODE($P{PARA_TONGHOP},'Y',SUBSTR(UT_MAPGD,3,2),SUBSTR(UT_MAPGD,3,4))
            = DECODE($P{PARA_TONGHOP},'Y',SUBSTR($P{PARA_MAPGD},3,2),SUBSTR($P{PARA_MAPGD},3,4))
and TRUNC(UT_NGAYBC)= TRUNC(TO_DATE($P{PARA_NGAYBC},'DD-MON-YYYY')) group by UT_DVUT,UT_HUYEN,UT_MAPGD) G, PO850MB D
 where G.UT_MAPGD = D.POS_CD order by UT_DVUT,UT_HUYEN]]>
	</queryString>
